@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@{
    string activeRole = User.Identity?.IsAuthenticated == true 
        ? (User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("UserRole")?.Value ?? "")
        : "";

    bool isAdminLoggedIn = activeRole == "Admin" || (string.IsNullOrEmpty(activeRole) && Context.Request.Cookies.TryGetValue("AdminAuth", out string? adminAuth) && adminAuth == "true");

    bool isShopLoggedIn = activeRole == "Seller" || (string.IsNullOrEmpty(activeRole) && Context.Request.Cookies.TryGetValue("ShopId", out string? shopIdCookie) && !string.IsNullOrEmpty(shopIdCookie));
    string shopName = Context.Request.Cookies.TryGetValue("ShopName", out string? sName) && !string.IsNullOrEmpty(sName) ? sName : (User.Identity?.Name ?? "Shop Owner");

    bool isRiderLoggedIn = activeRole == "Rider" || (string.IsNullOrEmpty(activeRole) && Context.Request.Cookies.TryGetValue("RiderId", out string? riderIdCookie) && !string.IsNullOrEmpty(riderIdCookie));
    string riderName = Context.Request.Cookies.TryGetValue("RiderName", out string? rName) && !string.IsNullOrEmpty(rName) ? rName : (User.Identity?.Name ?? "Rider");

    bool isCustLoggedIn = activeRole == "Customer" || activeRole == "User" || (string.IsNullOrEmpty(activeRole) && Context.Request.Cookies.TryGetValue("CustomerId", out string? custIdCookie) && !string.IsNullOrEmpty(custIdCookie));
    string customerName = Context.Request.Cookies.TryGetValue("CustomerName", out string? cName) && !string.IsNullOrEmpty(cName) ? cName : (User.Identity?.Name ?? "Customer");

    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool isDarkPortal = currentController.Equals("Vendor", StringComparison.OrdinalIgnoreCase) || 
                       currentController.Equals("Admin", StringComparison.OrdinalIgnoreCase) || 
                       currentController.Equals("Rider", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" class="notranslate" translate="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>@ViewData["Title"] - ShopNext</title>
    <!-- Modern Emoji Favicon & App Icon (Replaces browser default document icon) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛍️</text></svg>" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛍️</text></svg>" />

    <!-- Google Fonts: Outfit + Noto Sans Devanagari + Hind for Hindi/English support -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShopNext.styles.css" asp-append-version="true" />
</head>
<body class="@(isDarkPortal ? "theme-dark-portal" : "") notranslate" translate="no">
    <!-- Top Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark main-navbar mb-4 sticky-top">
            <div class="container-fluid px-3 px-md-5">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-badge d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%); border-radius: 12px; font-size: 1.25rem; border: 1px solid rgba(255,255,255,0.25); box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45);">
                        🛍️
                    </div>
                    <div class="d-flex flex-column leading-none">
                        <span class="fw-extrabold fs-4 lh-1" style="background: linear-gradient(135deg, #60a5fa 0%, #93c5fd 50%, #ffffff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -0.5px;">ShopNext</span>
                        <span class="small fw-semibold text-primary text-uppercase" style="font-size: 0.62rem; letter-spacing: 1.5px; opacity: 0.9;">Hyperlocal Mart</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" data-i18n="Nav_Home">
                                <i class="fa-solid fa-house me-1 text-primary"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Products" data-i18n="Nav_Marketplace">
                                <i class="fa-solid fa-basket-shopping me-1 text-info"></i> Marketplace
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="shopsGrid" data-i18n="Nav_Shops">
                                <i class="fa-solid fa-store me-1 text-warning"></i> Explore Shops
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-area="" asp-controller="Home" asp-action="Cart" id="layoutCartLink">
                                <i class="fa-solid fa-cart-shopping me-1 text-success"></i> <span data-i18n="Nav_Cart">Cart</span> 
                                <span class="badge bg-danger rounded-pill ms-1" id="navCartCount" style="display: none;">0</span>
                            </a>
                        </li>

                        @* Customer Portal Links *@
                        @if (isCustLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="MyOrders" data-i18n="Nav_MyOrders">
                                    <i class="fa-solid fa-bag-shopping me-1 text-info"></i> My Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Account" asp-route-tab="wishlist" data-i18n="Nav_Wishlist">
                                    <i class="fa-solid fa-heart me-1 text-danger"></i> Wishlist
                                </a>
                            </li>
                        }
                        
                        @* Admin Portal Links *@
                        @if (isAdminLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Admin" asp-action="Dashboard" data-i18n="Nav_AdminConsole">
                                    <i class="fa-solid fa-sliders me-1"></i> Admin Console
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-success fw-semibold" asp-controller="Admin" asp-action="SystemMonitoring">
                                    <i class="fa-solid fa-shield-halved me-1 text-success"></i> System Monitoring
                                </a>
                            </li>
                        }

                        @* Seller Portal Links *@
                        @if (isShopLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info" asp-controller="Vendor" asp-action="Products" data-i18n="Nav_MyProducts">
                                    <i class="fa-solid fa-boxes-stacked me-1"></i> My Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-success" asp-controller="Vendor" asp-action="Orders" data-i18n="Nav_ShopOrders">
                                    <i class="fa-solid fa-clipboard-list me-1"></i> Shop Orders
                                </a>
                            </li>
                        }

                        @* Rider Portal Links *@
                        @if (isRiderLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success" asp-controller="Rider" asp-action="Dashboard" data-i18n="Nav_DeliveryDashboard">
                                    <i class="fa-solid fa-motorcycle me-1"></i> Delivery Dashboard
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <!-- Multi-Language Selector (Point 173) -->
                        <li class="nav-item dropdown me-lg-2 my-1 my-lg-0">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill border border-secondary border-opacity-30 bg-dark bg-opacity-40 text-light shadow-sm" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.88rem;">
                                <span id="activeLangFlag" style="font-size: 1.1rem;">🌐</span>
                                <span id="activeLangName" class="fw-semibold font-monospace">English</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg p-2" aria-labelledby="langDropdown" style="background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(255,255,255,0.12); backdrop-filter: blur(16px); min-width: 200px; border-radius: 16px;">
                                <li><h6 class="dropdown-header text-uppercase text-secondary small fw-bold"><i class="fa-solid fa-language me-1 text-primary"></i> <span data-i18n="Lang_Select">Select Language</span></h6></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="en" onclick="switchLanguage('en')"><span>🇬🇧 English</span><span class="badge bg-secondary bg-opacity-25 text-light small">Default</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="hi" onclick="switchLanguage('hi')"><span>🇮🇳 हिन्दी</span><span class="badge bg-success bg-opacity-25 text-success small">Hindi</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="hi-Latn" onclick="switchLanguage('hi-Latn')"><span>🇮🇳 Hinglish</span><span class="badge bg-warning bg-opacity-25 text-warning small">Popular</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="bn" onclick="switchLanguage('bn')"><span>🇮🇳 বাংলা</span><span class="badge bg-info bg-opacity-25 text-info small">Bengali</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="mr" onclick="switchLanguage('mr')"><span>🇮🇳 मराठी</span><span class="badge bg-secondary bg-opacity-25 text-light small">Marathi</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="ta" onclick="switchLanguage('ta')"><span>🇮🇳 தமிழ்</span><span class="badge bg-secondary bg-opacity-25 text-light small">Tamil</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="te" onclick="switchLanguage('te')"><span>🇮🇳 తెలుగు</span><span class="badge bg-secondary bg-opacity-25 text-light small">Telugu</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="gu" onclick="switchLanguage('gu')"><span>🇮🇳 ગુજરાતી</span><span class="badge bg-secondary bg-opacity-25 text-light small">Gujarati</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="kn" onclick="switchLanguage('kn')"><span>🇮🇳 ಕನ್ನಡ</span><span class="badge bg-secondary bg-opacity-25 text-light small">Kannada</span></a></li>
                                <li><a class="dropdown-item lang-dropdown-item rounded-3 py-1.5 d-flex align-items-center justify-content-between text-light" href="javascript:void(0)" data-lang="pa" onclick="switchLanguage('pa')"><span>🇮🇳 ਪੰਜਾਬੀ</span><span class="badge bg-secondary bg-opacity-25 text-light small">Punjabi</span></a></li>
                            </ul>
                        </li>

                        @if (!isShopLoggedIn && !isAdminLoggedIn)
                        {
                            <li class="nav-item me-lg-2 my-1 my-lg-0">
                                <a class="btn btn-warning btn-sm px-3 py-2 fw-bold text-dark rounded-pill d-inline-flex align-items-center shadow-sm" asp-controller="Vendor" asp-action="Register" id="navBecomeSellerBtn" data-i18n="Nav_BecomeSeller">
                                    <i class="fa-solid fa-store me-1 text-primary"></i> Become a Seller
                                </a>
                            </li>
                        }

                        @if (isCustLoggedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-badge d-flex align-items-center px-3 rounded-pill text-white" href="#" id="customerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user me-2 text-info fs-5"></i> @customerName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end unified-dropdown" aria-labelledby="customerDropdown">
                                    <li><span class="dropdown-header">Customer Account</span></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Account" asp-route-tab="profile" data-i18n="Nav_MyProfile"><i class="fa-solid fa-id-card text-primary"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Account" asp-route-tab="orders" data-i18n="Nav_MyOrders"><i class="fa-solid fa-box text-info"></i>My Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Account" asp-route-tab="wishlist" data-i18n="Nav_Wishlist"><i class="fa-solid fa-heart text-danger"></i>Wishlist</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Account" asp-route-tab="addresses" data-i18n="Nav_MyAddresses"><i class="fa-solid fa-location-dot text-success"></i>My Addresses</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Account" asp-route-tab="coupons" data-i18n="Nav_Coupons"><i class="fa-solid fa-ticket text-warning"></i>Coupons & Offers</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Wallet" data-i18n="Nav_Wallet"><i class="fa-solid fa-wallet text-success"></i>Digital Wallet</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Cart" data-i18n="Nav_Cart"><i class="fa-solid fa-cart-shopping text-warning"></i>My Cart</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout" data-i18n="Nav_Logout"><i class="fa-solid fa-arrow-right-from-bracket"></i>Logout Account</a></li>
                                </ul>
                            </li>
                        }
                        else if (isAdminLoggedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-badge d-flex align-items-center px-3 rounded-pill" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-user-shield me-2 text-warning fs-5"></i> Admin Control
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end unified-dropdown" aria-labelledby="adminDropdown">
                                    <li><span class="dropdown-header">Administrator Active</span></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-sliders text-primary"></i>Management Console</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="SystemMonitoring"><i class="fa-solid fa-shield-halved text-success"></i>System Monitoring</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-arrow-right-from-bracket"></i>Logout Admin</a></li>
                                </ul>
                            </li>
                        }
                        else if (isShopLoggedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-badge d-flex align-items-center px-3 rounded-pill" href="#" id="vendorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-shop me-2 text-primary fs-5"></i> @shopName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end unified-dropdown" aria-labelledby="vendorDropdown">
                                    <li><span class="dropdown-header">Shop Owner Portal</span></li>
                                    <li><a class="dropdown-item" asp-controller="Vendor" asp-action="Dashboard"><i class="fa-solid fa-chart-line text-info"></i>Store Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Vendor" asp-action="Products"><i class="fa-solid fa-boxes-stacked text-primary"></i>Manage Products</a></li>
                                    <li><a class="dropdown-item" asp-controller="Vendor" asp-action="Orders"><i class="fa-solid fa-receipt text-success"></i>Customer Orders</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-arrow-right-from-bracket"></i>Logout Shop</a></li>
                                </ul>
                            </li>
                        }
                        else if (isRiderLoggedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-badge d-flex align-items-center px-3 rounded-pill" href="#" id="riderDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-motorcycle me-2 text-success fs-5"></i> @riderName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end unified-dropdown" aria-labelledby="riderDropdown">
                                    <li><span class="dropdown-header">Delivery Partner</span></li>
                                    <li><a class="dropdown-item" asp-controller="Rider" asp-action="Dashboard"><i class="fa-solid fa-route text-success"></i>Active Trips</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-arrow-right-from-bracket"></i>Logout Rider</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-white d-flex align-items-center bg-primary bg-opacity-25 px-3 rounded-pill" asp-controller="Account" asp-action="Login">
                                    <i class="fa-solid fa-right-to-bracket me-2 text-info"></i> Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <div class="container-fluid px-3 px-md-5">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- Mobile Bottom Navigation Bar (Sticky < 768px) -->
    <nav class="mobile-bottom-nav">
        <a asp-controller="Home" asp-action="Index" class="nav-item-btn">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </a>
        <a asp-controller="Home" asp-action="Products" class="nav-item-btn">
            <i class="fa-solid fa-basket-shopping"></i>
            <span>Shop</span>
        </a>
        <a asp-controller="Home" asp-action="Cart" class="nav-item-btn position-relative">
            <i class="fa-solid fa-cart-shopping"></i>
            <span>Cart</span>
            <span class="badge bg-danger rounded-pill position-absolute top-0 end-0 translate-middle-y" id="mobileNavCartCount" style="display: none; font-size: 0.65rem;">0</span>
        </a>
        @if (isCustLoggedIn)
        {
            <a asp-controller="Customer" asp-action="MyOrders" class="nav-item-btn">
                <i class="fa-solid fa-bag-shopping"></i>
                <span>Orders</span>
            </a>
            <a asp-controller="Customer" asp-action="Account" class="nav-item-btn">
                <i class="fa-solid fa-circle-user"></i>
                <span>Profile</span>
            </a>
        }
        else if (isShopLoggedIn)
        {
            <a asp-controller="Vendor" asp-action="Orders" class="nav-item-btn">
                <i class="fa-solid fa-clipboard-list"></i>
                <span>Orders</span>
            </a>
            <a asp-controller="Vendor" asp-action="Products" class="nav-item-btn">
                <i class="fa-solid fa-shop"></i>
                <span>Seller</span>
            </a>
        }
        else if (isRiderLoggedIn)
        {
            <a asp-controller="Rider" asp-action="Dashboard" class="nav-item-btn">
                <i class="fa-solid fa-motorcycle"></i>
                <span>Deliveries</span>
            </a>
            <a asp-controller="Rider" asp-action="Dashboard" class="nav-item-btn">
                <i class="fa-solid fa-route"></i>
                <span>Trips</span>
            </a>
        }
        else if (isAdminLoggedIn)
        {
            <a asp-controller="Admin" asp-action="Dashboard" class="nav-item-btn">
                <i class="fa-solid fa-sliders"></i>
                <span>Admin</span>
            </a>
            <a asp-controller="Admin" asp-action="SystemMonitoring" class="nav-item-btn">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Monitor</span>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="nav-item-btn">
                <i class="fa-solid fa-circle-user"></i>
                <span>Login</span>
            </a>
        }
    </nav>

    <!-- Global Universal Confirmation Modal -->
    <div class="modal fade" id="globalConfirmationModal" tabindex="-1" aria-labelledby="globalConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-2xl" style="border-radius: 22px; background: linear-gradient(145deg, #0f172a 0%, #1e1b4b 100%); border: 1px solid rgba(255, 255, 255, 0.15) !important; color: #ffffff;">
                <div class="modal-body text-center p-4 p-md-5">
                    <div class="d-inline-flex p-3 rounded-circle mb-3 shadow-lg" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3);">
                        <i id="globalConfirmIcon" class="fa-solid fa-triangle-exclamation text-warning fs-1"></i>
                    </div>
                    <h5 class="fw-bold mb-2 text-white" id="globalConfirmTitle">Confirmation Required</h5>
                    <p class="text-secondary mb-4" id="globalConfirmMessage">Are you sure you want to proceed with this action?</p>
                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-secondary px-4 py-2 rounded-3 fw-semibold border-0" data-bs-dismiss="modal" style="background: rgba(255,255,255,0.12);">Cancel</button>
                        <button type="button" class="btn btn-danger px-4 py-2 rounded-3 fw-bold shadow-sm" id="globalConfirmSubmitBtn">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Toast Container -->
    <div id="globalToastContainer"></div>

    <!-- Global Loading Spinner Overlay -->
