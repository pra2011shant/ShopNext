@{
    ViewData["Title"] = "Forgot Password - ShopNext";
    var selectedRole = (string?)ViewBag.Role ?? "Customer";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="glass-card p-4 p-md-5">
                <h2 class="fw-bold text-white mb-2">Forgot password</h2>
                <p class="text-muted">Choose the account type and enter the phone or email saved in the database.</p>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success">@ViewBag.Message</div>
                    <div class="alert alert-secondary text-break"><a href="@ViewBag.ResetLink">Open password reset page</a></div>
                }
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label text-white">Account type</label>
                        @if (selectedRole == "Admin")
                        {
                            <input type="hidden" name="role" value="Admin" />
                            <div class="form-control bg-dark text-warning">Administrator portal</div>
                        }
                        else
                        {
                            <select name="role" class="form-select" required>
                                <option value="Customer" selected="@(selectedRole == "Customer")">Customer</option>
                                <option value="Seller" selected="@(selectedRole == "Seller")">Seller</option>
                                <option value="Rider" selected="@(selectedRole == "Rider")">Rider</option>
                            </select>
                        }
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white">Phone or email</label>
                        <input name="identifier" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Generate reset link</button>
                </form>
                <div class="text-center mt-3"><a asp-controller="Account" asp-action="Login" asp-route-role="@selectedRole">Back to login</a></div>
            </div>
        </div>
    </div>
</div>
