@{
    ViewData["Title"] = "Unified Security Login - ShopNext";
    var selectedRole = (string?)ViewBag.Role ?? "Customer";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

<style>
    .login-wrapper {
        min-height: 82vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        font-family: 'Outfit', sans-serif;
    }

    .login-glass-card {
        width: 100%;
        max-width: 480px;
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.94) 0%, rgba(20, 29, 58, 0.92) 100%);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 26px;
        padding: 2.5rem 2.25rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55), 0 0 40px rgba(99, 102, 241, 0.12);
        position: relative;
        overflow: hidden;
    }

    .login-glass-card::before {
        content: '';
        position: absolute;
        top: -120px;
        right: -120px;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
        pointer-events: none;
    }

    .login-brand-icon {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.25) 0%, rgba(139, 92, 246, 0.3) 100%);
        border: 1px solid rgba(139, 92, 246, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: #38bdf8;
        margin: 0 auto 1.25rem;
        box-shadow: 0 10px 25px rgba(56, 189, 248, 0.2);
    }

    .role-grid-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        background: rgba(0, 0, 0, 0.45);
        padding: 6px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 440px) {
        .role-grid-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .role-tab-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 0.65rem 0.4rem;
        border-radius: 12px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        transition: all 0.25s ease;
        text-align: center;
        width: 100%;
    }

    .role-tab-btn i {
        font-size: 1.05rem;
    }

    .role-tab-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.06);
    }

    .role-tab-btn.active.role-customer {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
    }

    .role-tab-btn.active.role-seller {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
    }

    .role-tab-btn.active.role-rider {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }

    .role-tab-btn.active.role-admin {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
    }

    .custom-input-box {
        background: rgba(10, 15, 30, 0.7) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        color: #ffffff !important;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: all 0.25s ease;
    }

    .custom-input-box::placeholder {
        color: #64748b !important;
    }

    .custom-input-box:focus {
        border-color: #6366f1 !important;
        box-shadow: 0 0 20px rgba(99, 102, 241, 0.25) !important;
        background: rgba(15, 23, 42, 0.9) !important;
    }

    .custom-input-group-text {
        background: rgba(10, 15, 30, 0.7) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-right: none !important;
        color: #94a3b8 !important;
        border-radius: 12px 0 0 12px !important;
    }

    .btn-submit-login {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border: none;
        color: #ffffff;
        font-weight: 700;
        font-size: 1.02rem;
        padding: 0.85rem;
        border-radius: 14px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.25s ease;
        box-shadow: 0 8px 25px rgba(79, 70, 229, 0.35);
        cursor: pointer;
    }

    .btn-submit-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(79, 70, 229, 0.5);
        color: #ffffff;
    }
</style>

<div class="login-wrapper">
    <div class="login-glass-card">
        
        <!-- Brand Header -->
        <div class="text-center mb-4">
            <div class="login-brand-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h2 class="fw-bold text-white mb-1" style="font-size: 1.75rem; letter-spacing: -0.02em;">
                Sign In to <span style="background: linear-gradient(135deg, #60a5fa 0%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">ShopNext</span>
            </h2>
            <p class="text-secondary small mb-0">Select your role to access your dedicated workspace</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-20 border border-danger border-opacity-40 text-white rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa-solid fa-circle-exclamation fs-5 text-danger"></i>
                <div class="text-white fw-medium">@ViewBag.Error</div>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-20 border border-success border-opacity-40 text-white rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa-solid fa-circle-check fs-5 text-success"></i>
                <div class="text-white fw-medium">@TempData["Success"]</div>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" id="unifiedLoginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="hidden" name="role" id="selectedRoleInput" value="@selectedRole" />

            <!-- Quick Demo Credentials 1-Click Fill -->
            <div class="mb-3 p-2.5 rounded-3 border border-white border-opacity-10" style="background: rgba(255, 255, 255, 0.03);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        <i class="fa-solid fa-bolt text-warning me-1"></i> 1-Click Demo Logins
                    </span>
                    <span class="text-secondary" style="font-size: 0.7rem;">Click to auto-fill</span>
                </div>
                <div class="d-grid gap-1" style="grid-template-columns: repeat(2, 1fr);">
                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 text-start small d-flex align-items-center justify-content-between" style="font-size: 0.78rem; border-radius: 8px;" onclick="quickFill('Admin', 'admin@shopnext.com', 'Admin@123')">
                        <span><i class="fa-solid fa-crown me-1"></i> Admin</span>
                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25" style="font-size: 0.65rem;">admin</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2 text-start small d-flex align-items-center justify-content-between" style="font-size: 0.78rem; border-radius: 8px;" onclick="quickFill('Seller', 'techmart@shopnext.com', 'Seller@123')">
                        <span><i class="fa-solid fa-store me-1"></i> Seller</span>
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25" style="font-size: 0.65rem;">techmart</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 text-start small d-flex align-items-center justify-content-between" style="font-size: 0.78rem; border-radius: 8px;" onclick="quickFill('Rider', '9811223344', 'Rider@123')">
                        <span><i class="fa-solid fa-motorcycle me-1"></i> Rider</span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25" style="font-size: 0.65rem;">9811223344</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2 text-start small d-flex align-items-center justify-content-between" style="font-size: 0.78rem; border-radius: 8px;" onclick="quickFill('Customer', 'customer@shopnext.com', 'Customer@123')">
                        <span><i class="fa-solid fa-user me-1"></i> Customer</span>
                        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25" style="font-size: 0.65rem;">pooja</span>
                    </button>
                </div>
            </div>

            <!-- 100% Contained Responsive Role Grid -->
            <div class="mb-3">
                <label class="form-label text-secondary small fw-bold text-uppercase mb-2 d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-id-badge text-info me-1"></i> Choose Account Role</span>
                    <span class="badge bg-secondary bg-opacity-30 text-light px-2 py-0.5 rounded-pill" id="activeRoleLabelBadge">@selectedRole</span>
                </label>
                <div class="role-grid-container">
                    <button type="button" class="role-tab-btn role-customer @(selectedRole == "Customer" ? "active" : "")" onclick="setLoginRole('Customer', this)">
                        <i class="fa-solid fa-user"></i>
                        <span>Customer</span>
                    </button>
                    <button type="button" class="role-tab-btn role-seller @(selectedRole == "Seller" ? "active" : "")" onclick="setLoginRole('Seller', this)">
                        <i class="fa-solid fa-store"></i>
                        <span>Seller</span>
                    </button>
                    <button type="button" class="role-tab-btn role-rider @(selectedRole == "Rider" ? "active" : "")" onclick="setLoginRole('Rider', this)">
                        <i class="fa-solid fa-motorcycle"></i>
                        <span>Rider</span>
                    </button>
                    <button type="button" class="role-tab-btn role-admin @(selectedRole == "Admin" ? "active" : "")" onclick="setLoginRole('Admin', this)">
                        <i class="fa-solid fa-crown"></i>
                        <span>Admin</span>
                    </button>
                </div>
            </div>

            <!-- Login Identifier Input -->
            <div class="mb-3">
                <label class="form-label text-white small fw-bold mb-1" id="identifierLabel">
                    <i class="fa-solid fa-envelope-open-text me-1 text-info"></i> Phone or Email Address
                </label>
                <div class="input-group">
                    <span class="input-group-text custom-input-group-text">
                        <i class="fa-solid fa-id-card"></i>
                    </span>
                    <input name="identifier" id="loginIdentifier" class="form-control custom-input-box" style="border-radius: 0 12px 12px 0;" placeholder="e.g. 9876543210 or customer@shopnext.com" autocomplete="username" required />
                </div>
            </div>

            <!-- Password Input -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label text-white small fw-bold mb-0">
                        <i class="fa-solid fa-lock me-1 text-info"></i> Password
                    </label>
                    <a asp-controller="Account" asp-action="ForgotPassword" id="forgotPasswordLink" asp-route-role="@selectedRole" class="text-info text-decoration-none small fw-semibold">Forgot?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text custom-input-group-text">
                        <i class="fa-solid fa-key"></i>
                    </span>
                    <input type="password" name="password" id="loginPassword" class="form-control custom-input-box" style="border-radius: 0 !important;" placeholder="••••••••" autocomplete="current-password" required />
                    <button type="button" class="btn custom-input-box" style="border-left: none !important; border-radius: 0 12px 12px 0; color: #94a3b8;" onclick="togglePasswordVisibility()">
                        <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-submit-login mb-4" id="loginSubmitBtn">
                <i class="fa-solid fa-shield-halved"></i> Secure Sign In
            </button>

            <!-- Registration Links -->
            <div class="text-center pt-2 border-top border-secondary border-opacity-25">
                <span class="text-secondary small d-block mb-2">New to ShopNext platform?</span>
                <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap small">
                    <a asp-controller="Customer" asp-action="Register" class="text-info text-decoration-none fw-semibold">Customer Sign Up</a>
                    <span class="text-secondary opacity-50">•</span>
                    <a asp-controller="Vendor" asp-action="Register" class="text-warning text-decoration-none fw-semibold">Become a Seller</a>
                    <span class="text-secondary opacity-50">•</span>
                    <a asp-controller="Rider" asp-action="Register" class="text-success text-decoration-none fw-semibold">Join Rider Fleet</a>
                </div>
            </div>
        </form>

    </div>
</div>

@section Scripts {
<script>
    function setLoginRole(role, btnEl) {
        document.getElementById('selectedRoleInput').value = role;
        const badge = document.getElementById('activeRoleLabelBadge');
        if (badge) badge.innerText = role;

        document.querySelectorAll('.role-tab-btn').forEach(b => {
            b.classList.remove('active');
        });
        if (btnEl) {
            btnEl.classList.add('active');
        }

        const idInp = document.getElementById('loginIdentifier');
        if (role === 'Customer') {
            idInp.placeholder = 'e.g. 9876543210 or customer@shopnext.com';
        } else if (role === 'Seller') {
            idInp.placeholder = 'e.g. 9822334455 or techmart@shopnext.com';
        } else if (role === 'Rider') {
            idInp.placeholder = 'e.g. 9811223344 (Registered Phone)';
        } else if (role === 'Admin') {
            idInp.placeholder = 'e.g. admin or admin@shopnext.com';
        }

        const forgotLink = document.getElementById('forgotPasswordLink');
        if (forgotLink) {
            forgotLink.href = '/Account/ForgotPassword?role=' + encodeURIComponent(role);
        }
    }

    function quickFill(role, identifier, password) {
        const btn = document.querySelector('.role-tab-btn.role-' + role.toLowerCase());
        setLoginRole(role, btn);
        document.getElementById('loginIdentifier').value = identifier;
        document.getElementById('loginPassword').value = password;
        
        // Gentle flash animation on the submit button
        const submitBtn = document.getElementById('loginSubmitBtn');
        if (submitBtn) {
            submitBtn.style.transform = 'scale(1.03)';
            setTimeout(() => { submitBtn.style.transform = ''; }, 200);
        }
    }

    function togglePasswordVisibility() {
        const pwd = document.getElementById('loginPassword');
        const icon = document.getElementById('togglePasswordIcon');
        if (pwd.type === 'password') {
            pwd.type = 'text';
            icon.className = 'fa-solid fa-eye-slash';
        } else {
            pwd.type = 'password';
            icon.className = 'fa-solid fa-eye';
        }
    }
</script>
}
