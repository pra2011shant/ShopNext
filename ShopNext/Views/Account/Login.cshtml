@{
    ViewData["Title"] = "Unified Security Login - ShopNext";
    var selectedRole = (string?)ViewBag.Role ?? "Customer";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <!-- Modern Glassmorphic Login Card -->
            <div class="card border-0 rounded-4 shadow-2xl p-4 p-md-5" style="background: rgba(15, 23, 42, 0.82); border: 1px solid rgba(255, 255, 255, 0.12) !important; backdrop-filter: blur(20px);">
                
                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle mb-3 shadow-lg" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(99, 102, 241, 0.3) 100%); border: 1px solid rgba(99, 102, 241, 0.4);">
                        <i class="fa-solid fa-shield-halved fa-2x text-info"></i>
                    </div>
                    <h2 class="fw-extrabold text-white mb-1" style="letter-spacing: -0.02em;">Welcome to <span style="background: linear-gradient(135deg, #60a5fa 0%, #93c5fd 50%, #ffffff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">ShopNext</span></h2>
                    <p class="text-secondary small mb-0">Unified Access &bull; Customer &bull; Seller &bull; Rider &bull; Admin</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger bg-danger bg-opacity-15 border border-danger border-opacity-30 text-danger rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="fa-solid fa-circle-exclamation fs-5"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success bg-success bg-opacity-15 border border-success border-opacity-30 text-success rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="fa-solid fa-circle-check fs-5"></i>
                        <div>@TempData["Success"]</div>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" id="unifiedLoginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <input type="hidden" name="role" id="selectedRoleInput" value="@selectedRole" />

                    <!-- Role Switcher Segmented Tabs -->
                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold text-uppercase mb-2">Select Portal Role</label>
                        <div class="d-flex p-1 rounded-3 gap-1" style="background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <button type="button" class="btn btn-sm flex-fill rounded-2 role-tab-btn @(selectedRole == "Customer" ? "active btn-primary fw-bold" : "text-secondary")" onclick="setLoginRole('Customer', this)">
                                <i class="fa-solid fa-user me-1"></i> Customer
                            </button>
                            <button type="button" class="btn btn-sm flex-fill rounded-2 role-tab-btn @(selectedRole == "Seller" ? "active btn-warning fw-bold text-dark" : "text-secondary")" onclick="setLoginRole('Seller', this)">
                                <i class="fa-solid fa-store me-1"></i> Seller
                            </button>
                            <button type="button" class="btn btn-sm flex-fill rounded-2 role-tab-btn @(selectedRole == "Rider" ? "active btn-success fw-bold" : "text-secondary")" onclick="setLoginRole('Rider', this)">
                                <i class="fa-solid fa-motorcycle me-1"></i> Rider
                            </button>
                            <button type="button" class="btn btn-sm flex-fill rounded-2 role-tab-btn @(selectedRole == "Admin" ? "active btn-danger fw-bold" : "text-secondary")" onclick="setLoginRole('Admin', this)">
                                <i class="fa-solid fa-crown me-1"></i> Admin
                            </button>
                        </div>
                    </div>

                    <!-- Login Identifier (Phone / Email / Admin ID) -->
                    <div class="mb-3">
                        <label class="form-label text-light small fw-semibold" id="identifierLabel">
                            <i class="fa-solid fa-envelope-open-text me-1 text-info"></i> Phone or Email Address
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-black bg-opacity-40 border-secondary border-opacity-25 text-secondary">
                                <i class="fa-solid fa-id-card"></i>
                            </span>
                            <input name="identifier" id="loginIdentifier" class="form-control bg-black bg-opacity-40 border-secondary border-opacity-25 text-white shadow-none" placeholder="e.g. 9876543210 or customer@shopnext.com" autocomplete="username" required />
                        </div>
                    </div>

                    <!-- Password with Eye Toggle -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label text-light small fw-semibold mb-0">
                                <i class="fa-solid fa-lock me-1 text-info"></i> Password
                            </label>
                            <a asp-controller="Account" asp-action="ForgotPassword" id="forgotPasswordLink" asp-route-role="@selectedRole" class="text-info text-decoration-none small">Forgot?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-black bg-opacity-40 border-secondary border-opacity-25 text-secondary">
                                <i class="fa-solid fa-key"></i>
                            </span>
                            <input type="password" name="password" id="loginPassword" class="form-control bg-black bg-opacity-40 border-secondary border-opacity-25 text-white shadow-none" placeholder="••••••••" autocomplete="current-password" required />
                            <button type="button" class="btn btn-outline-secondary border-opacity-25 text-secondary" onclick="togglePasswordVisibility()">
                                <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-lg mb-3" style="background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%); border: none;">
                        <i class="fa-solid fa-right-to-bracket"></i> Secure Sign In
                    </button>

                    <!-- 1-Click Demo Fill Selector for Fast Testing -->
                    <div class="p-3 rounded-3 mb-3" style="background: rgba(0, 0, 0, 0.35); border: 1px dashed rgba(255, 255, 255, 0.15);">
                        <div class="text-secondary small fw-bold text-uppercase mb-2 d-flex align-items-center gap-1">
                            <i class="fa-solid fa-wand-magic-sparkles text-warning"></i> 1-Click Demo Credentials:
                        </div>
                        <div class="d-flex flex-wrap gap-1.5">
                            <button type="button" class="btn btn-outline-info btn-sm rounded-pill px-2.5 py-1" style="font-size: 11px;" onclick="fillDemo('Customer', '9876543210', 'Customer@123')">
                                👤 Customer
                            </button>
                            <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-2.5 py-1" style="font-size: 11px;" onclick="fillDemo('Seller', '9822334455', 'Seller@123')">
                                🏪 Seller
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-2.5 py-1" style="font-size: 11px;" onclick="fillDemo('Rider', '9811223344', 'Rider@123')">
                                🛵 Rider
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1" style="font-size: 11px;" onclick="fillDemo('Admin', 'admin', 'Admin@123')">
                                👑 Admin
                            </button>
                        </div>
                    </div>

                    <!-- Registration Links -->
                    <div class="text-center pt-2 border-top border-secondary border-opacity-20">
                        <span class="text-secondary small">Don't have an account?</span>
                        <div class="d-flex justify-content-center gap-3 mt-2 small">
                            <a asp-controller="Customer" asp-action="Register" class="text-info text-decoration-none fw-semibold">Customer Sign Up</a>
                            <span class="text-secondary">&bull;</span>
                            <a asp-controller="Vendor" asp-action="Register" class="text-warning text-decoration-none fw-semibold">Become a Seller</a>
                            <span class="text-secondary">&bull;</span>
                            <a asp-controller="Rider" asp-action="Register" class="text-success text-decoration-none fw-semibold">Join as Rider</a>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function setLoginRole(role, btnEl) {
        document.getElementById('selectedRoleInput').value = role;
        document.querySelectorAll('.role-tab-btn').forEach(b => {
            b.className = 'btn btn-sm flex-fill rounded-2 role-tab-btn text-secondary';
        });

        if (role === 'Customer') {
            btnEl.className = 'btn btn-sm flex-fill rounded-2 role-tab-btn active btn-primary fw-bold';
            document.getElementById('loginIdentifier').placeholder = 'e.g. 9876543210 or customer@shopnext.com';
        } else if (role === 'Seller') {
            btnEl.className = 'btn btn-sm flex-fill rounded-2 role-tab-btn active btn-warning fw-bold text-dark';
            document.getElementById('loginIdentifier').placeholder = 'e.g. 9822334455 or techmart@shopnext.com';
        } else if (role === 'Rider') {
            btnEl.className = 'btn btn-sm flex-fill rounded-2 role-tab-btn active btn-success fw-bold';
            document.getElementById('loginIdentifier').placeholder = 'e.g. 9811223344 (Registered Rider Phone)';
        } else if (role === 'Admin') {
            btnEl.className = 'btn btn-sm flex-fill rounded-2 role-tab-btn active btn-danger fw-bold';
            document.getElementById('loginIdentifier').placeholder = 'e.g. admin or admin@shopnext.com';
        }

        const forgotLink = document.getElementById('forgotPasswordLink');
        if (forgotLink) {
            forgotLink.href = '/Account/ForgotPassword?role=' + encodeURIComponent(role);
        }
    }

    function togglePasswordVisibility() {
        const pwd = document.getElementById('loginPassword');
        const icon = document.getElementById('togglePasswordIcon');
        if (pwd.type === 'password') {
            pwd.type = 'text';
            icon.className = 'fa-solid fa-eye-slash';
        } else {
            pwd.type = 'password';
            icon.className = 'fa-solid fa-eye';
        }
    }

    function fillDemo(role, id, pwd) {
        const btn = Array.from(document.querySelectorAll('.role-tab-btn')).find(b => b.innerText.includes(role));
        if (btn) setLoginRole(role, btn);
        document.getElementById('loginIdentifier').value = id;
        document.getElementById('loginPassword').value = pwd;
    }
</script>
}
