<script>
    let currentRatingFilter = 'all';
    let currentProductFilter = 'all';

    function filterReviewsByRating(rating, btn) {
        currentRatingFilter = rating;
        document.querySelectorAll('.star-filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        applyCombinedReviewFilters();
    }

    function filterReviewsByProduct(prodName) {
        currentProductFilter = prodName;
        applyCombinedReviewFilters();
    }

    function searchReviews() {
        applyCombinedReviewFilters();
    }

    function applyCombinedReviewFilters() {
        const query = document.getElementById('reviewSearchInput')?.value.toLowerCase().trim() || '';
        const cards = document.querySelectorAll('.review-card');

        cards.forEach(card => {
            const cardRating = card.getAttribute('data-rating') || '5';
            const cardProduct = (card.getAttribute('data-product') || '').toLowerCase();
            const cardText = card.textContent.toLowerCase();

            // Check rating filter
            let matchRating = false;
            if (currentRatingFilter === 'all') matchRating = true;
            else if (currentRatingFilter === '5' && cardRating === '5') matchRating = true;
            else if (currentRatingFilter === '4' && cardRating === '4') matchRating = true;
            else if (currentRatingFilter === '3' && parseInt(cardRating) <= 3) matchRating = true;

            // Check product filter
            let matchProduct = false;
            if (currentProductFilter === 'all' || cardProduct.includes(currentProductFilter.toLowerCase())) {
                matchProduct = true;
            }

            // Check search query
            let matchSearch = false;
            if (query === '' || cardText.includes(query)) {
                matchSearch = true;
            }

            if (matchRating && matchProduct && matchSearch) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
