                            </div>
                        </div>
                    </div>

                    <!-- 22. Product Variants (Professional Feature: Size, Color, Price, Stock, SKU) -->
                    <div class="mb-3 p-3 rounded-3" style="background: rgba(15, 23, 42, 0.75); border: 1px solid rgba(129, 140, 248, 0.35);">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <div>
                                <span class="fw-bold text-white fs-6"><i class="fa-solid fa-layer-group text-primary me-2"></i>22. Product Variants (Size, Color, Price, Stock, SKU)</span>
                                <div class="text-muted small">T-Shirt (S, M, L, XL / Black, White, Blue). Har variant ka Price, Stock &amp; SKU alag ho sakta hai.</div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="hasVariantsToggleModal" onchange="toggleVariantsSection('variantsContainerModal', this.checked)" style="cursor: pointer; width: 44px; height: 22px;">
                                <label class="form-check-label text-light small fw-semibold ms-1" for="hasVariantsToggleModal">Enable Variants</label>
                            </div>
                        </div>

                        <!-- Hidden Input for Form Submission -->
                        <input type="hidden" name="productVariantsJson" id="productVariantsJsonModal" value="" />

                        <!-- Collapsible Variants Matrix Container -->
                        <div id="variantsContainerModal" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed rgba(255,255,255,0.15);">
                            <!-- Quick Matrix Generator Row -->
                            <div class="row g-2 mb-3 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label text-muted small fw-bold mb-1">Sizes (e.g. S, M, L, XL)</label>
                                    <input type="text" id="quickSizesModal" class="form-control form-control-sm" placeholder="S, M, L, XL" value="S, M, L, XL" style="background: rgba(30, 41, 59, 0.8); color: white; border: 1px solid var(--glass-border);" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label text-muted small fw-bold mb-1">Colors (e.g. Black, White, Blue)</label>
                                    <input type="text" id="quickColorsModal" class="form-control form-control-sm" placeholder="Black, White, Blue" value="Black, White, Blue" style="background: rgba(30, 41, 59, 0.8); color: white; border: 1px solid var(--glass-border);" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-primary btn-sm w-100 fw-semibold" onclick="generateMatrix('Modal')">
                                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Generate
                                    </button>
                                </div>
                            </div>

                            <!-- Variants Table -->
                            <div class="table-responsive rounded-3 border border-secondary border-opacity-25 mb-2">
                                <table class="table table-dark table-sm mb-0 align-middle small text-center" id="variantsTableModal">
                                    <thead style="background: rgba(30, 41, 59, 0.9);">
                                        <tr>
                                            <th style="width: 15%;">Size</th>
                                            <th style="width: 20%;">Color</th>
                                            <th style="width: 20%;">Price (₹) *</th>
                                            <th style="width: 15%;">Stock *</th>
                                            <th style="width: 20%;">SKU *</th>
                                            <th style="width: 10%;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="variantsTbodyModal">
                                        <!-- Dynamic rows injected here -->
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <button type="button" class="btn btn-outline-light btn-sm" onclick="addCustomVariantRow('Modal')">
                                    <i class="fa-solid fa-plus me-1"></i> Add Custom Row
                                </button>
                                <span class="text-info small" id="variantCountNoticeModal">0 variants configured</span>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- 12. [Add Product] -->
                <div class="modal-footer modal-footer-glass">
                    <button type="button" class="btn-glass-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-action-primary px-4 fw-bold" id="btnModalAddProduct" onclick="syncVariantsJsonBeforeSubmit('Modal')">
                        <i class="fa-solid fa-plus-circle me-1"></i> Add Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function calculateDiscountModal() {
        const mrp = parseFloat(document.getElementById('mrpModal')?.value || 0);
        const sellingPrice = parseFloat(document.getElementById('sellingPriceModal')?.value || 0);
        const discountInput = document.getElementById('discountModal');
        if (mrp > 0 && sellingPrice > 0 && mrp >= sellingPrice) {
            const disc = ((mrp - sellingPrice) / mrp) * 100;
            if (discountInput) discountInput.value = disc.toFixed(1);
        }
    }

    function previewImgModal(input, previewId) {
        const previewContainer = document.getElementById(previewId);
        if (!previewContainer) return;
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = previewContainer.querySelector('img');
                if (img) img.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewUrlModal(url, previewId) {
        const previewContainer = document.getElementById(previewId);
        if (!previewContainer) return;
        if (url && url.trim().length > 5) {
            const img = previewContainer.querySelector('img');
            if (img) img.src = url.trim();
            previewContainer.style.display = 'block';
        } else {
            previewContainer.style.display = 'none';
        }
    }

    // ==========================================
    // 22. PRODUCT VARIANTS MANAGEMENT SCRIPTS
    // ==========================================
    function toggleVariantsSection(containerId, isChecked) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.style.display = isChecked ? 'block' : 'none';
        if (isChecked) {
            const suffix = containerId.replace('variantsContainer', '');
            const tbody = document.getElementById('variantsTbody' + suffix);
            if (tbody && tbody.children.length === 0) {
                generateMatrix(suffix);
            }
        }
    }

    function generateMatrix(suffix) {
        const sizesInput = document.getElementById('quickSizes' + suffix)?.value || '';
        const colorsInput = document.getElementById('quickColors' + suffix)?.value || '';
        const basePrice = parseFloat(document.getElementById('sellingPrice' + suffix)?.value || 499);
        const baseSku = document.getElementById('sku' + suffix)?.value.trim() || 'SN-PROD';

        const sizes = sizesInput.split(',').map(s => s.trim()).filter(s => s.length > 0);
        const colors = colorsInput.split(',').map(c => c.trim()).filter(c => c.length > 0);

        const tbody = document.getElementById('variantsTbody' + suffix);
        if (!tbody) return;
        tbody.innerHTML = '';

        if (sizes.length === 0 && colors.length === 0) {
            addCustomVariantRow(suffix, 'Standard', 'Default', basePrice, 10, baseSku + '-STD');
            updateVariantCountNotice(suffix);
            return;
        }

        const effectiveSizes = sizes.length > 0 ? sizes : ['OneSize'];
        const effectiveColors = colors.length > 0 ? colors : ['Standard'];

        effectiveSizes.forEach(sz => {
            effectiveColors.forEach(clr => {
                const skuCode = `${baseSku}-${sz.substring(0, 3).toUpperCase()}-${clr.substring(0, 3).toUpperCase()}`;
                addCustomVariantRow(suffix, sz, clr, basePrice, 15, skuCode);
            });
        });

        updateVariantCountNotice(suffix);
    }

    function addCustomVariantRow(suffix, size = '', color = '', price = 0, stock = 10, sku = '') {
        const tbody = document.getElementById('variantsTbody' + suffix);
        if (!tbody) return;

        const defaultPrice = price > 0 ? price : (parseFloat(document.getElementById('sellingPrice' + suffix)?.value || 499));
        const defaultSku = sku || `VAR-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;

        const tr = document.createElement('tr');
        tr.className = 'variant-row';
        tr.innerHTML = `
            <td><input type="text" class="form-control form-control-sm text-center var-size" value="${size}" placeholder="e.g. M" style="background: rgba(15,23,42,0.8); color: white; border: 1px solid var(--glass-border);" /></td>
            <td><input type="text" class="form-control form-control-sm text-center var-color" value="${color}" placeholder="e.g. Black" style="background: rgba(15,23,42,0.8); color: white; border: 1px solid var(--glass-border);" /></td>
            <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-center var-price" value="${defaultPrice}" style="background: rgba(15,23,42,0.8); color: #34d399; font-weight: bold; border: 1px solid var(--glass-border);" /></td>
            <td><input type="number" min="0" class="form-control form-control-sm text-center var-stock" value="${stock}" style="background: rgba(15,23,42,0.8); color: white; border: 1px solid var(--glass-border);" /></td>
            <td><input type="text" class="form-control form-control-sm text-center var-sku" value="${defaultSku}" style="background: rgba(15,23,42,0.8); color: #93c5fd; border: 1px solid var(--glass-border);" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="removeVariantRow(this, '${suffix}')"><i class="fa-solid fa-trash"></i></button></td>
        `;
        tbody.appendChild(tr);
        updateVariantCountNotice(suffix);
    }

    function removeVariantRow(btn, suffix) {
        btn.closest('tr')?.remove();
        updateVariantCountNotice(suffix);
    }

    function updateVariantCountNotice(suffix) {
        const tbody = document.getElementById('variantsTbody' + suffix);
        const notice = document.getElementById('variantCountNotice' + suffix);
        if (tbody && notice) {
            notice.textContent = `${tbody.children.length} variants configured`;
        }
    }

    function syncVariantsJsonBeforeSubmit(suffix) {
        const toggle = document.getElementById('hasVariantsToggle' + suffix);
        const jsonInput = document.getElementById('productVariantsJson' + suffix);
        if (!jsonInput) return;

        if (!toggle || !toggle.checked) {
            jsonInput.value = '';
            return;
        }

        const tbody = document.getElementById('variantsTbody' + suffix);
        if (!tbody) return;

        const rows = tbody.querySelectorAll('.variant-row');
        const variants = [];

        rows.forEach(r => {
            const sz = r.querySelector('.var-size')?.value.trim() || '';
            const clr = r.querySelector('.var-color')?.value.trim() || '';
            const pr = parseFloat(r.querySelector('.var-price')?.value || 0);
            const stk = parseInt(r.querySelector('.var-stock')?.value || 0);
            const sk = r.querySelector('.var-sku')?.value.trim() || '';

            if (sz || clr) {
                variants.push({
                    size: sz,
                    color: clr,
                    price: pr,
                    stock: stk,
                    sku: sk
                });
            }
        });

        jsonInput.value = JSON.stringify(variants);
    }

    // ==========================================
    // 23. INVENTORY MANAGEMENT VIEW TOGGLE & ACTIONS
    // ==========================================
    function setProductCatalogView(viewMode) {
        const gridEl = document.getElementById('productsGridView');
        const tableEl = document.getElementById('productsTableView');
        const btnGrid = document.getElementById('btnViewGrid');
        const btnTable = document.getElementById('btnViewTable');

        if (viewMode === 'grid') {
            if (gridEl) gridEl.style.display = 'grid';
            if (tableEl) tableEl.style.display = 'none';
            if (btnGrid) btnGrid.classList.add('active');
            if (btnTable) btnTable.classList.remove('active');
        } else {
            if (gridEl) gridEl.style.display = 'none';
            if (tableEl) tableEl.style.display = 'block';
            if (btnGrid) btnGrid.classList.remove('active');
            if (btnTable) btnTable.classList.add('active');
        }
    }

    function stepTableStock(productId, delta) {
        const input = document.getElementById('tableStockInput_' + productId);
        if (!input) return;
        let current = parseInt(input.value) || 0;
        let next = Math.max(0, current + delta);
        input.value = next;
        onTableStockChange(productId);
    }

    function onTableStockChange(productId) {
        const input = document.getElementById('tableStockInput_' + productId);
        const label = document.getElementById('tableUnitsLabel_' + productId);
        const badge = document.getElementById('tableStatusBadge_' + productId);
        if (!input) return;

        let val = parseInt(input.value) || 0;
        if (val < 0) { val = 0; input.value = 0; }
        if (label) label.textContent = `${val} units`;

        // 23. Inventory Rules: Stock 5 se kam: ⚠ Low Stock
        if (val === 0) {
            if (badge) {
                badge.className = 'badge bg-danger bg-opacity-25 text-danger border border-danger px-3 py-2 rounded-pill fw-bold';
                badge.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i> Out of Stock';
            }
        } else if (val < 5) {
            if (badge) {
                badge.className = 'badge bg-warning bg-opacity-25 text-warning border border-warning px-3 py-2 rounded-pill fw-bold';
                badge.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> ⚠ Low Stock';
            }
        } else {
            if (badge) {
                badge.className = 'badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill fw-bold';
                badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Available';
            }
        }
    }

    async function submitTableStockUpdate(productId) {
        const input = document.getElementById('tableStockInput_' + productId);
        const btn = document.getElementById('tableSaveStockBtn_' + productId);
        if (!input || !btn) return;

        const originalBtnHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

        const newStock = parseInt(input.value) || 0;

        try {
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('stock', newStock);

            const resp = await fetch('/Vendor/UpdateStock', {
                method: 'POST',
                body: formData
            });

            const data = await resp.json();
            if (data.success) {
                btn.className = 'btn btn-sm btn-success rounded-pill px-3';
                btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Saved!';
                onTableStockChange(productId);
                setTimeout(() => {
                    btn.className = 'btn btn-sm btn-outline-light rounded-pill px-3';
                    btn.innerHTML = originalBtnHtml;
                    btn.disabled = false;
                }, 2000);
            } else {
                alert(data.message || 'Error updating stock');
                btn.innerHTML = originalBtnHtml;
                btn.disabled = false;
            }
        } catch (err) {
            alert('Failed to connect to server: ' + err.message);
            btn.innerHTML = originalBtnHtml;
            btn.disabled = false;
        }
    }
</script>
