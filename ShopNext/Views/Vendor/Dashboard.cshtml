                    @{
                        var processingOrders = Model.RecentOrders?.Where(o => o.OrderStatus == "Accepted" || o.OrderStatus == "Processing" || o.OrderStatus == "Packed").ToList();
                    }

                    @if (processingOrders != null && processingOrders.Any())
                    {
                        foreach (var pord in processingOrders)
