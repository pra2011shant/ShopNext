<script>
    function toggleSubmenu(submenuId, toggleBtn) {
        const submenu = document.getElementById(submenuId);
        if (submenu) {
            submenu.classList.toggle('show');
            toggleBtn.classList.toggle('open');
        }
    }

    function switchSellerTab(tabId) {
        // 1. Hide all tab panels and show targeted one
        const panels = document.querySelectorAll('.tab-panel');
        panels.forEach(p => p.classList.remove('active'));
        
        const targetPanel = document.getElementById(tabId);
        if (targetPanel) {
            targetPanel.classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 2. Update active states on sidebar
        const allLinks = document.querySelectorAll('.sidebar-link, .submenu-link');
        allLinks.forEach(link => link.classList.remove('active'));

        if (tabId === 'tab-dashboard') {
            document.getElementById('nav-dashboard')?.classList.add('active');
        } else if (tabId === 'tab-all-products') {
            document.getElementById('subnav-all-products')?.classList.add('active');
            document.getElementById('nav-products-parent')?.classList.add('active');
        } else if (tabId === 'tab-add-product') {
            document.getElementById('subnav-add-product')?.classList.add('active');
            document.getElementById('nav-products-parent')?.classList.add('active');
        } else if (tabId === 'tab-categories') {
            document.getElementById('subnav-categories')?.classList.add('active');
            document.getElementById('nav-products-parent')?.classList.add('active');
        } else if (tabId === 'tab-stock') {
            document.getElementById('subnav-stock')?.classList.add('active');
            document.getElementById('nav-products-parent')?.classList.add('active');
        } else if (tabId === 'tab-all-orders') {
            document.getElementById('subnav-all-orders')?.classList.add('active');
            document.getElementById('nav-orders-parent')?.classList.add('active');
        } else if (tabId === 'tab-new-orders') {
            document.getElementById('subnav-new-orders')?.classList.add('active');
            document.getElementById('nav-orders-parent')?.classList.add('active');
        } else if (tabId === 'tab-processing') {
            document.getElementById('subnav-processing')?.classList.add('active');
            document.getElementById('nav-orders-parent')?.classList.add('active');
        } else if (tabId === 'tab-shipped') {
            document.getElementById('subnav-shipped')?.classList.add('active');
            document.getElementById('nav-orders-parent')?.classList.add('active');
        } else if (tabId === 'tab-delivered') {
            document.getElementById('subnav-delivered')?.classList.add('active');
            document.getElementById('nav-orders-parent')?.classList.add('active');
        } else if (tabId === 'tab-returns') {
            document.getElementById('nav-returns')?.classList.add('active');
        } else if (tabId === 'tab-reviews') {
            document.getElementById('nav-reviews')?.classList.add('active');
        } else if (tabId === 'tab-earnings') {
            document.getElementById('nav-earnings')?.classList.add('active');
        } else if (tabId === 'tab-coupons') {
            document.getElementById('nav-coupons')?.classList.add('active');
        } else if (tabId === 'tab-profile') {
            document.getElementById('nav-profile')?.classList.add('active');
        } else if (tabId === 'tab-notifications') {
            document.getElementById('nav-notifications')?.classList.add('active');
        } else if (tabId === 'tab-settings') {
            document.getElementById('nav-settings')?.classList.add('active');
        }
    }

    function calculateDiscountDash() {
        const mrp = parseFloat(document.getElementById('mrpDash')?.value || 0);
        const sellingPrice = parseFloat(document.getElementById('sellingPriceDash')?.value || 0);
        const discountInput = document.getElementById('discountDash');
        if (mrp > 0 && sellingPrice > 0 && mrp >= sellingPrice) {
            const disc = ((mrp - sellingPrice) / mrp) * 100;
            if (discountInput) discountInput.value = disc.toFixed(1);
        }
    }

    function previewImg(input, previewId) {
        const previewContainer = document.getElementById(previewId);
        if (!previewContainer) return;
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = previewContainer.querySelector('img');
                if (img) img.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewUrl(url, previewId) {
        const previewContainer = document.getElementById(previewId);
        if (!previewContainer) return;
        if (url && url.trim().length > 5) {
            const img = previewContainer.querySelector('img');
            if (img) img.src = url.trim();
            previewContainer.style.display = 'block';
        } else {
            previewContainer.style.display = 'none';
        }
    }

    // ==========================================
    // 22. PRODUCT VARIANTS MANAGEMENT SCRIPTS
    // ==========================================
    function toggleVariantsSection(containerId, isChecked) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.style.display = isChecked ? 'block' : 'none';
        if (isChecked) {
            // Auto generate initial matrix if table is currently empty
            const suffix = containerId.replace('variantsContainer', '');
            const tbody = document.getElementById('variantsTbody' + suffix);
            if (tbody && tbody.children.length === 0) {
                generateMatrix(suffix);
            }
        }
    }

    function generateMatrix(suffix) {
        const sizesInput = document.getElementById('quickSizes' + suffix)?.value || '';
        const colorsInput = document.getElementById('quickColors' + suffix)?.value || '';
        const basePrice = parseFloat(document.getElementById('sellingPrice' + suffix)?.value || 499);
        const baseSku = document.getElementById('sku' + suffix)?.value.trim() || 'SN-PROD';

        const sizes = sizesInput.split(',').map(s => s.trim()).filter(s => s.length > 0);
        const colors = colorsInput.split(',').map(c => c.trim()).filter(c => c.length > 0);

        const tbody = document.getElementById('variantsTbody' + suffix);
        if (!tbody) return;
        tbody.innerHTML = '';

        if (sizes.length === 0 && colors.length === 0) {
            addCustomVariantRow(suffix, 'Standard', 'Default', basePrice, 10, baseSku + '-STD');
            updateVariantCountNotice(suffix);
            return;
        }

        const effectiveSizes = sizes.length > 0 ? sizes : ['OneSize'];
        const effectiveColors = colors.length > 0 ? colors : ['Standard'];

        effectiveSizes.forEach(sz => {
            effectiveColors.forEach(clr => {
                const skuCode = `${baseSku}-${sz.substring(0, 3).toUpperCase()}-${clr.substring(0, 3).toUpperCase()}`;
                addCustomVariantRow(suffix, sz, clr, basePrice, 15, skuCode);
            });
        });

        updateVariantCountNotice(suffix);
    }

    function addCustomVariantRow(suffix, size = '', color = '', price = 0, stock = 10, sku = '') {
        const tbody = document.getElementById('variantsTbody' + suffix);
        if (!tbody) return;

        const defaultPrice = price > 0 ? price : (parseFloat(document.getElementById('sellingPrice' + suffix)?.value || 499));
        const defaultSku = sku || `VAR-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;

        const tr = document.createElement('tr');
        tr.className = 'variant-row';
        tr.innerHTML = `
            <td><input type="text" class="form-control form-control-sm text-center var-size" value="${size}" placeholder="e.g. M" style="background: rgba(15,23,42,0.8); color: white; border: 1px solid var(--glass-border);" /></td>
            <td><input type="text" class="form-control form-control-sm text-center var-color" value="${color}" placeholder="e.g. Black" style="background: rgba(15,23,42,0.8); color: white; border: 1px solid var(--glass-border);" /></td>
            <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-center var-price" value="${defaultPrice}" style="background: rgba(15,23,42,0.8); color: #34d399; font-weight: bold; border: 1px solid var(--glass-border);" /></td>
            <td><input type="number" min="0" class="form-control form-control-sm text-center var-stock" value="${stock}" style="background: rgba(15,23,42,0.8); color: white; border: 1px solid var(--glass-border);" /></td>
            <td><input type="text" class="form-control form-control-sm text-center var-sku" value="${defaultSku}" style="background: rgba(15,23,42,0.8); color: #93c5fd; border: 1px solid var(--glass-border);" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="removeVariantRow(this, '${suffix}')"><i class="fa-solid fa-trash"></i></button></td>
        `;
        tbody.appendChild(tr);
        updateVariantCountNotice(suffix);
    }

    function removeVariantRow(btn, suffix) {
        btn.closest('tr')?.remove();
        updateVariantCountNotice(suffix);
    }

    function updateVariantCountNotice(suffix) {
        const tbody = document.getElementById('variantsTbody' + suffix);
        const notice = document.getElementById('variantCountNotice' + suffix);
        if (tbody && notice) {
            notice.textContent = `${tbody.children.length} variants configured`;
        }
    }

    function syncVariantsJsonBeforeSubmit(suffix) {
        const toggle = document.getElementById('hasVariantsToggle' + suffix);
        const jsonInput = document.getElementById('productVariantsJson' + suffix);
        if (!jsonInput) return;

        if (!toggle || !toggle.checked) {
            jsonInput.value = '';
            return;
        }

        const tbody = document.getElementById('variantsTbody' + suffix);
        if (!tbody) return;

        const rows = tbody.querySelectorAll('.variant-row');
        const variants = [];

        rows.forEach(r => {
            const sz = r.querySelector('.var-size')?.value.trim() || '';
            const clr = r.querySelector('.var-color')?.value.trim() || '';
            const pr = parseFloat(r.querySelector('.var-price')?.value || 0);
            const stk = parseInt(r.querySelector('.var-stock')?.value || 0);
            const sk = r.querySelector('.var-sku')?.value.trim() || '';

            if (sz || clr) {
                variants.push({
                    size: sz,
                    color: clr,
                    price: pr,
                    stock: stk,
                    sku: sk
                });
            }
        });

        jsonInput.value = JSON.stringify(variants);
    }

    // ==========================================
    // 23. INVENTORY MANAGEMENT SCRIPTS
    // ==========================================
    function stepStockValue(productId, delta) {
        const input = document.getElementById('stockInput_' + productId);
        if (!input) return;
        let current = parseInt(input.value) || 0;
        let next = Math.max(0, current + delta);
        input.value = next;
        onStockInputChange(productId);
    }

    function onStockInputChange(productId) {
        const input = document.getElementById('stockInput_' + productId);
        const label = document.getElementById('stockUnitsLabel_' + productId);
        const badge = document.getElementById('statusBadge_' + productId);
        const row = document.getElementById('invRow_' + productId);
        if (!input) return;

        let val = parseInt(input.value) || 0;
        if (val < 0) { val = 0; input.value = 0; }
        if (label) label.textContent = `${val} units`;

        // 23. Inventory Rules: Stock 5 se kam: ⚠ Low Stock
        if (val === 0) {
            if (badge) {
                badge.className = 'badge bg-danger bg-opacity-25 text-danger border border-danger px-3 py-2 rounded-pill fw-bold inv-status-badge';
                badge.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i> Out of Stock';
            }
            if (row) row.setAttribute('data-filter', 'out');
        } else if (val < 5) {
            if (badge) {
                badge.className = 'badge bg-warning bg-opacity-25 text-warning border border-warning px-3 py-2 rounded-pill fw-bold inv-status-badge';
                badge.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> ⚠ Low Stock';
            }
            if (row) row.setAttribute('data-filter', 'low');
        } else {
            if (badge) {
                badge.className = 'badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill fw-bold inv-status-badge';
                badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Available';
            }
            if (row) row.setAttribute('data-filter', 'available');
        }
    }

    async function submitStockUpdate(productId) {
        const input = document.getElementById('stockInput_' + productId);
        const btn = document.getElementById('saveStockBtn_' + productId);
        if (!input || !btn) return;

        const originalBtnHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

        const newStock = parseInt(input.value) || 0;

        try {
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('stock', newStock);

            const resp = await fetch('/Vendor/UpdateStock', {
                method: 'POST',
                body: formData
            });

            const data = await resp.json();
            if (data.success) {
                btn.className = 'btn btn-sm btn-success rounded-pill px-3';
                btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Saved!';
                onStockInputChange(productId);
                recalcInventorySummary();
                setTimeout(() => {
                    btn.className = 'btn btn-sm btn-outline-light rounded-pill px-3';
                    btn.innerHTML = originalBtnHtml;
                    btn.disabled = false;
                }, 2000);
            } else {
                alert(data.message || 'Error updating stock');
                btn.innerHTML = originalBtnHtml;
                btn.disabled = false;
            }
        } catch (err) {
            alert('Failed to connect to server: ' + err.message);
            btn.innerHTML = originalBtnHtml;
            btn.disabled = false;
        }
    }

    function recalcInventorySummary() {
        const rows = document.querySelectorAll('.inv-row');
        let total = rows.length;
        let avail = 0;
        let low = 0;
        let out = 0;

        rows.forEach(r => {
            const f = r.getAttribute('data-filter');
            if (f === 'available') avail++;
            else if (f === 'low') low++;
            else if (f === 'out') out++;
        });

        const elTot = document.getElementById('invCountTotal');
        const elAvail = document.getElementById('invCountAvail');
        const elLow = document.getElementById('invCountLow');
        const elOut = document.getElementById('invCountOut');

        if (elTot) elTot.textContent = total;
        if (elAvail) elAvail.textContent = avail;
        if (elLow) elLow.textContent = low;
        if (elOut) elOut.textContent = out;
    }

    function filterInvTable(filterType, btn) {
        document.querySelectorAll('#tab-stock .btn-dark').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.inv-row');
        rows.forEach(r => {
            const rf = r.getAttribute('data-filter');
            if (filterType === 'all' || rf === filterType) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function searchInvTable() {
        const query = document.getElementById('invSearchInput')?.value.toLowerCase().trim() || '';
        const rows = document.querySelectorAll('.inv-row');

        rows.forEach(r => {
            const title = r.querySelector('.inv-prod-title')?.textContent.toLowerCase() || '';
            const sku = r.querySelector('.inv-prod-sku')?.textContent.toLowerCase() || '';
            if (query === '' || title.includes(query) || sku.includes(query)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    // ==========================================
    // 25. ORDER PROCESSING PIPELINE SCRIPT
    // Accept -> Processing -> Packed -> Shipped
    // ==========================================
    async function acceptSellerOrder(orderId, btn) {
        await progressOrderStage(orderId, 'Accepted', btn);
    }

    async function progressOrderStage(orderId, nextStatus, btn) {
        if (!btn) return;
        const origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin me-1.5"></i> Updating to ${nextStatus}...`;

        try {
            const formData = new FormData();
            formData.append('orderId', orderId);
            formData.append('status', nextStatus);

            const resp = await fetch('/Vendor/UpdateOrderStatus', {
                method: 'POST',
                body: formData
            });

            const data = await resp.json();
            if (data.success) {
                const badge = document.getElementById('orderStatusBadge_' + orderId);

                if (nextStatus === 'Accepted') {
                    btn.className = 'btn px-4 py-2 rounded-pill fw-bold text-white shadow-sm';
                    btn.style = 'background: linear-gradient(135deg, #a855f7 0%, #c084fc 100%); border: none;';
                    btn.innerHTML = '<i class="fa-solid fa-gears me-1.5"></i> Start Processing';
                    btn.onclick = () => progressOrderStage(orderId, 'Processing', btn);
                    btn.disabled = false;

                    if (badge) {
                        badge.className = 'badge bg-success bg-opacity-25 text-success border border-success px-3 py-1 rounded-pill fw-bold';
                        badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Status: Accepted';
                    }
                } else if (nextStatus === 'Processing') {
                    btn.className = 'btn px-4 py-2 rounded-pill fw-bold text-white shadow-sm';
                    btn.style = 'background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); border: none;';
                    btn.innerHTML = '<i class="fa-solid fa-box me-1.5"></i> Mark as Packed';
                    btn.onclick = () => progressOrderStage(orderId, 'Packed', btn);
                    btn.disabled = false;

                    if (badge) {
                        badge.className = 'badge bg-purple bg-opacity-25 text-purple border border-purple px-3 py-1 rounded-pill fw-bold';
                        badge.style = 'background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.4);';
                        badge.innerHTML = '<i class="fa-solid fa-gears fa-spin me-1"></i> Status: Processing';
                    }
                } else if (nextStatus === 'Packed') {
                    btn.className = 'btn px-4 py-2 rounded-pill fw-bold text-white shadow-sm';
                    btn.style = 'background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%); border: none;';
                    btn.innerHTML = '<i class="fa-solid fa-truck-fast me-1.5"></i> Ship Order';
                    btn.onclick = () => progressOrderStage(orderId, 'Shipped', btn);
                    btn.disabled = false;

                    if (badge) {
                        badge.className = 'badge bg-info bg-opacity-25 text-info border border-info px-3 py-1 rounded-pill fw-bold';
                        badge.innerHTML = '<i class="fa-solid fa-box-open me-1"></i> Status: Packed';
                    }
                } else if (nextStatus === 'Shipped') {
                    btn.className = 'btn btn-outline-info px-4 py-2 rounded-pill fw-bold shadow-sm';
                    btn.innerHTML = '<i class="fa-solid fa-truck-fast me-1.5"></i> Order Shipped';
                    btn.disabled = true;

                    if (badge) {
                        badge.className = 'badge bg-primary bg-opacity-25 text-info border border-primary px-3 py-1 rounded-pill fw-bold';
                        badge.innerHTML = '<i class="fa-solid fa-truck-fast me-1"></i> Status: Shipped';
                    }
                }
            } else {
                alert(data.message || 'Error updating order');
                btn.innerHTML = origHtml;
                btn.disabled = false;
            }
        } catch (err) {
            alert('Network error: ' + err.message);
            btn.innerHTML = origHtml;
            btn.disabled = false;
        }
    }

    // ==========================================
    // 28. DASHBOARD EARNINGS CHART.JS LOGIC
    // ==========================================
    const dashTodaySales = @(Model.TodaySales > 0 ? Model.TodaySales : 50000);
    const dashWeekSales = @(Model.WeeklySales > 0 ? Model.WeeklySales : 125000);
    const dashMonthSales = @(Model.MonthlySales > 0 ? Model.MonthlySales : 485000);
    const dashYearSales = @(Model.YearlySales > 0 ? Model.YearlySales : 2850000);

    const dashChartDatasets = {
        today: {
            title: "Today's Sales Trend",
            sub: "Live hourly revenue volume",
            labels: ["08 AM", "10 AM", "12 PM", "02 PM", "04 PM", "06 PM", "08 PM", "10 PM"],
            data: [
                Math.round(dashTodaySales * 0.05), Math.round(dashTodaySales * 0.15),
                Math.round(dashTodaySales * 0.30), Math.round(dashTodaySales * 0.50),
                Math.round(dashTodaySales * 0.65), Math.round(dashTodaySales * 0.80),
                Math.round(dashTodaySales * 0.92), dashTodaySales
            ],
            color: "#38bdf8"
        },
        weekly: {
            title: "Weekly Sales Performance",
            sub: "Day-by-day 7 days revenue",
            labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
            data: [
                Math.round(dashWeekSales * 0.12), Math.round(dashWeekSales * 0.22),
                Math.round(dashWeekSales * 0.38), Math.round(dashWeekSales * 0.55),
                Math.round(dashWeekSales * 0.72), Math.round(dashWeekSales * 0.88),
                dashWeekSales
            ],
            color: "#c084fc"
        },
        monthly: {
            title: "Monthly Sales Revenue",
            sub: "Current 30 days billing breakdown",
            labels: ["Week 1", "Week 2", "Week 3", "Week 4", "Month End"],
            data: [
                Math.round(dashMonthSales * 0.20), Math.round(dashMonthSales * 0.45),
                Math.round(dashMonthSales * 0.70), Math.round(dashMonthSales * 0.90),
                dashMonthSales
            ],
            color: "#34d399"
        },
        yearly: {
            title: "Yearly Sales Performance",
            sub: "12-month annual growth curve",
            labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
            data: [
                Math.round(dashYearSales * 0.06), Math.round(dashYearSales * 0.14),
                Math.round(dashYearSales * 0.22), Math.round(dashYearSales * 0.32),
                Math.round(dashYearSales * 0.42), Math.round(dashYearSales * 0.54),
                Math.round(dashYearSales * 0.66), Math.round(dashYearSales * 0.78),
                dashYearSales, Math.round(dashYearSales * 1.1),
                Math.round(dashYearSales * 1.22), Math.round(dashYearSales * 1.35)
            ],
            color: "#fbbf24"
        }
    };

    let dashChart = null;

    document.addEventListener("DOMContentLoaded", function () {
        const canvas = document.getElementById("dashSalesTrendChart");
        if (!canvas) return;

        dashChart = new Chart(canvas.getContext("2d"), {
            type: "line",
            data: {
                labels: dashChartDatasets.today.labels,
                datasets: [{
                    label: "Revenue (₹)",
                    data: dashChartDatasets.today.data,
                    borderColor: dashChartDatasets.today.color,
                    backgroundColor: "rgba(56, 189, 248, 0.15)",
                    borderWidth: 3,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: dashChartDatasets.today.color,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (c) { return " ₹" + Number(c.raw).toLocaleString("en-IN"); }
                        }
                    }
                },
                scales: {
                    x: { grid: { color: "rgba(255,255,255,0.05)" }, ticks: { color: "#94a3b8" } },
                    y: {
                        grid: { color: "rgba(255,255,255,0.05)" },
                        ticks: {
                            color: "#94a3b8",
                            callback: function (v) { return "₹" + Number(v).toLocaleString("en-IN"); }
                        }
                    }
                }
            }
        });
    });

    function switchDashSalesPeriod(key) {
        const d = dashChartDatasets[key];
        if (!d || !dashChart) return;

        document.getElementById("dashChartTitle").innerHTML = `<i class="fa-solid fa-chart-area me-2" style="color: ${d.color}"></i> ${d.title}`;
        document.getElementById("dashChartSub").innerText = d.sub;

        document.querySelectorAll("#tab-earnings .btn-group .btn").forEach(b => b.classList.remove("active"));
        if (key === "today") document.getElementById("btnDashToday")?.classList.add("active");
        else if (key === "weekly") document.getElementById("btnDashWeekly")?.classList.add("active");
        else if (key === "monthly") document.getElementById("btnDashMonthly")?.classList.add("active");
        else if (key === "yearly") document.getElementById("btnDashYearly")?.classList.add("active");

        dashChart.data.labels = d.labels;
        dashChart.data.datasets[0].data = d.data;
        dashChart.data.datasets[0].borderColor = d.color;
        dashChart.data.datasets[0].pointBackgroundColor = d.color;
        dashChart.data.datasets[0].backgroundColor = d.color === "#38bdf8" ? "rgba(56, 189, 248, 0.15)" : (d.color === "#c084fc" ? "rgba(192, 132, 252, 0.15)" : (d.color === "#34d399" ? "rgba(52, 211, 153, 0.15)" : "rgba(251, 191, 36, 0.15)"));
        dashChart.update();
    }
</script>