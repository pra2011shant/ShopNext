@* Views/Vendor/Dashboard.cshtml *@
@model ShopNext.Models.SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Sidebar Dashboard - ShopNext";
    var shopName = ViewBag.ShopName as string ?? Model.Shop?.ShopName ?? "My Store";
    var ownerName = Model.Shop?.OwnerName ?? "Rahul";
    var email = Model.Shop?.Email ?? "merchant@shopnext.local";
    var phone = Model.Shop?.PhoneNumber ?? "9876543210";
    var address = Model.Shop?.Address ?? "Main Market";
    var location = $"{Model.Shop?.City}, {Model.Shop?.State} - {Model.Shop?.Pincode}".Trim(' ', ',', '-');
    if (string.IsNullOrWhiteSpace(location)) { location = "New Delhi, Delhi - 110001"; }
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
        --card-bg: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        --sidebar-bg: #0f172a;
        --glass-border: rgba(255, 255, 255, 0.15);
        --text-muted: #cbd5e1;
        --text-light: #ffffff;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --info-color: #3b82f6;
    }

    body {
        background: #090d16 !important;
        color: #f8fafc !important;
        font-family: 'Outfit', sans-serif;
    }

    .seller-layout-wrapper {
        display: flex;
        gap: 1.75rem;
        padding: 1.5rem 0 3rem;
        animation: fadeIn 0.6s ease-out;
        min-height: 88vh;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* =========================================
       19. SELLER SIDEBAR
       ========================================= */
    .seller-sidebar {
        width: 290px;
        flex-shrink: 0;
        background: #0f172a;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 1.5rem 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
        height: fit-content;
        position: sticky;
        top: 20px;
    }

    .sidebar-store-card {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1.15rem;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 0.5rem;
    }

    .store-avatar {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
    }

    .store-meta {
        overflow: hidden;
    }

    .store-meta-name {
        font-weight: 700;
        font-size: 1.05rem;
        color: #ffffff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
    }

    .store-meta-badge {
        font-size: 0.76rem;
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.4);
        padding: 0.15rem 0.6rem;
        border-radius: 50px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 4px;
    }

    .sidebar-nav-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .sidebar-item {
        position: relative;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #e2e8f0;
        text-decoration: none;
        padding: 0.72rem 1rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.94rem;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .sidebar-link-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sidebar-link i.nav-icon {
        width: 20px;
        font-size: 1.05rem;
        text-align: center;
        color: #60a5fa;
        transition: color 0.2s ease;
    }

    .sidebar-link:hover {
        color: #ffffff;
        background: rgba(59, 130, 246, 0.18);
    }

    .sidebar-link:hover i.nav-icon {
        color: #93c5fd;
    }

    .sidebar-link.active {
        color: #ffffff !important;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.45) 0%, rgba(59, 130, 246, 0.35) 100%) !important;
        border: 1px solid rgba(96, 165, 250, 0.5) !important;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
    }

    .sidebar-link.active i.nav-icon {
        color: #93c5fd !important;
    }

    .sidebar-badge {
        font-size: 0.75rem;
        padding: 0.18rem 0.55rem;
        border-radius: 50px;
        font-weight: 700;
    }

    /* Submenu / Tree styling */
    .sidebar-tree-toggle i.chevron-icon {
        font-size: 0.8rem;
        color: #94a3b8;
        transition: transform 0.3s ease;
    }

    .sidebar-tree-toggle.open i.chevron-icon {
        transform: rotate(90deg);
        color: #60a5fa;
    }

    .sidebar-submenu {
        list-style: none;
        padding: 0.3rem 0 0.3rem 1.6rem;
        margin: 0;
        display: none;
        flex-direction: column;
        gap: 3px;
        position: relative;
    }

    .sidebar-submenu::before {
        content: '';
        position: absolute;
        left: 24px;
        top: 6px;
        bottom: 6px;
        width: 2px;
        background: rgba(255, 255, 255, 0.12);
    }

    .sidebar-submenu.show {
        display: flex;
    }

    .submenu-link {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #cbd5e1;
        text-decoration: none;
        padding: 0.5rem 0.85rem;
        border-radius: 9px;
        font-size: 0.88rem;
        font-weight: 500;
        transition: all 0.2s ease;
        position: relative;
    }

    .submenu-tree-symbol {
        color: #60a5fa;
        font-family: monospace;
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    .submenu-link:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
    }

    .submenu-link.active {
        color: #38bdf8 !important;
        background: rgba(56, 189, 248, 0.18) !important;
        font-weight: 700 !important;
        border-left: 3px solid #38bdf8;
    }

    .sidebar-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 0.5rem 0;
    }

    .sidebar-logout-link {
        color: #fca5a5 !important;
        border: 1px solid rgba(239, 68, 68, 0.3);
        background: rgba(239, 68, 68, 0.1);
        margin-top: 0.4rem;
    }

    .sidebar-logout-link:hover {
        background: var(--danger-color) !important;
        color: white !important;
        border-color: transparent !important;
    }

    .sidebar-logout-link:hover i.nav-icon {
        color: white !important;
    }

    /* =========================================
       MAIN CONTENT CONTAINER
       ========================================= */
    .seller-main-content {
        flex: 1;
        min-width: 0;
    }

    .tab-panel {
        display: none;
        animation: fadeIn 0.4s ease-out;
    }

    .tab-panel.active {
        display: block;
    }

    /* Dashboard Header Banner */
    .dashboard-hero {
        background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid var(--glass-border);
        border-radius: 22px;
        padding: 1.75rem 2rem;
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
    }

    .hero-text-block h1 {
        font-size: 1.9rem;
        font-weight: 800;
        margin-bottom: 0.35rem;
        letter-spacing: -0.02em;
        color: #ffffff;
    }

    .hero-text-block p {
        color: #cbd5e1 !important;
        font-size: 0.95rem;
    }

    .btn-quick-primary {
        background: var(--primary-gradient);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
    }

    .btn-quick-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.5);
        color: white;
    }

    /* Metric Grid (6 Key Cards from step 18) */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .metric-card {
        background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 20px;
        padding: 1.4rem 1.6rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    }

    .metric-card:hover {
        transform: translateY(-3px);
        border-color: rgba(96, 165, 250, 0.45);
        box-shadow: 0 16px 35px rgba(0, 0, 0, 0.35);
    }

    .metric-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 1rem;
    }

    .metric-title {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        color: #cbd5e1 !important;
        margin-bottom: 0.3rem;
    }

    .metric-val {
        font-size: 2.1rem;
        font-weight: 800;
        color: #ffffff !important;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .metric-subtitle {
        font-size: 0.82rem;
        margin-top: 0.45rem;
        color: #e2e8f0 !important;
        font-weight: 500;
    }

    .metric-products .metric-icon-wrap { background: rgba(99, 102, 241, 0.22); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.45); }
    .metric-orders .metric-icon-wrap { background: rgba(59, 130, 246, 0.22); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.45); }
    .metric-pending .metric-icon-wrap { background: rgba(245, 158, 11, 0.22); color: #fde047; border: 1px solid rgba(245, 158, 11, 0.45); }
    .metric-sales .metric-icon-wrap { background: rgba(16, 185, 129, 0.22); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.45); }
    .metric-returns .metric-icon-wrap { background: rgba(249, 115, 22, 0.22); color: #fdba74; border: 1px solid rgba(249, 115, 22, 0.45); }
    .metric-lowstock .metric-icon-wrap { background: rgba(239, 68, 68, 0.22); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.45); }

    /* Glass Panels */
    .glass-panel {
        background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid var(--glass-border);
        border-radius: 22px;
        padding: 1.75rem 2rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        margin-bottom: 2rem;
        color: #f8fafc;
    }

    .panel-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 1rem;
    }

    .panel-header-flex h3 {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 0;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .glass-panel label, .glass-panel .form-label {
        color: #e2e8f0 !important;
        font-weight: 600;
    }

    .glass-panel .text-muted {
        color: #cbd5e1 !important;
    }

    .glass-panel .form-control,
    .glass-panel .form-select {
        background: rgba(15, 23, 42, 0.85) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: #ffffff !important;
    }

    .glass-panel .form-control:focus,
    .glass-panel .form-select:focus {
        border-color: #60a5fa !important;
        box-shadow: 0 0 0 0.25rem rgba(96, 165, 250, 0.25) !important;
        background: rgba(15, 23, 42, 0.95) !important;
        color: #ffffff !important;
    }

    .glass-panel .form-control::placeholder {
        color: #94a3b8 !important;
    }

    /* Orders & Products Tables */
    .custom-table {
        width: 100%;
        color: #f8fafc !important;
        margin-bottom: 0;
    }

    .custom-table th {
        font-size: 0.82rem;
        color: #93c5fd !important;
        text-transform: uppercase;
        border-bottom: 2px solid rgba(255, 255, 255, 0.15);
        padding: 0.85rem 0.6rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        background: #0b1120 !important;
    }

    .custom-table td {
        padding: 1rem 0.6rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 0.93rem;
        vertical-align: middle;
        color: #f1f5f9 !important;
    }

    .custom-table tr:last-child td {
        border-bottom: none;
    }

    .badge-status {
        padding: 0.28rem 0.75rem;
        border-radius: 50px;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .status-delivered { background: rgba(16, 185, 129, 0.22); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
    .status-pending { background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
    .status-shipped { background: rgba(59, 130, 246, 0.22); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
    .status-return { background: rgba(249, 115, 22, 0.22); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.4); }
    .status-cancelled { background: rgba(239, 68, 68, 0.22); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }

    @@media (max-width: 992px) {
        .seller-layout-wrapper {
            flex-direction: column;
        }
        .seller-sidebar {
            width: 100%;
            position: static;
        }
    }
</style>

<div class="container-fluid px-lg-4">
    <div class="seller-layout-wrapper">
        
        <!-- ====================================================
             19. SELLER SIDEBAR DASHBOARD NAVIGATION
             ========================================= -->
        <aside class="seller-sidebar" id="sellerSidebar">
            <!-- Merchant Brand Card -->
            <div class="sidebar-store-card">
                <div class="store-avatar">
                    <i class="fa-solid fa-store"></i>
                </div>
                <div class="store-meta">
                    <div class="store-meta-name" title="@shopName">@shopName</div>
                    <span class="store-meta-badge">
                        <i class="fa-solid fa-circle-check"></i> Active Seller
                    </span>
                </div>
            </div>

            <!-- Navigation Links according to Step 19 Spec -->
            <ul class="sidebar-nav-list" id="sellerSidebarNav">
                <!-- Dashboard Home -->
                <li class="sidebar-item">
                    <a class="sidebar-link active" onclick="switchSellerTab('tab-dashboard')" id="nav-dashboard">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-chart-pie nav-icon"></i>
                            <span>Dashboard</span>
                        </span>
                    </a>
                </li>

                <!-- Products (Collapsible Tree) -->
                <li class="sidebar-item">
                    <a class="sidebar-link sidebar-tree-toggle open" onclick="toggleSubmenu('submenu-products', this)" id="nav-products-parent">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-box-open nav-icon"></i>
                            <span>Products</span>
                        </span>
                        <i class="fa-solid fa-chevron-right chevron-icon"></i>
                    </a>
                    <ul class="sidebar-submenu show" id="submenu-products">
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-all-products')" id="subnav-all-products">
                                <span class="submenu-tree-symbol">├──</span> All Products
                            </a>
                        </li>
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-add-product')" id="subnav-add-product">
                                <span class="submenu-tree-symbol">├──</span> Add Product
                            </a>
                        </li>
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-categories')" id="subnav-categories">
                                <span class="submenu-tree-symbol">├──</span> Categories
                            </a>
                        </li>
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-stock')" id="subnav-stock">
                                <span class="submenu-tree-symbol">└──</span> Stock
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Orders (Collapsible Tree) -->
                <li class="sidebar-item">
                    <a class="sidebar-link sidebar-tree-toggle open" onclick="toggleSubmenu('submenu-orders', this)" id="nav-orders-parent">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-receipt nav-icon"></i>
                            <span>Orders</span>
                        </span>
                        <i class="fa-solid fa-chevron-right chevron-icon"></i>
                    </a>
                    <ul class="sidebar-submenu show" id="submenu-orders">
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-all-orders')" id="subnav-all-orders">
                                <span class="submenu-tree-symbol">├──</span> All Orders
                            </a>
                        </li>
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-new-orders')" id="subnav-new-orders">
                                <span class="submenu-tree-symbol">├──</span> New Orders
                            </a>
                        </li>
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-processing')" id="subnav-processing">
                                <span class="submenu-tree-symbol">├──</span> Processing
                            </a>
                        </li>
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-shipped')" id="subnav-shipped">
                                <span class="submenu-tree-symbol">├──</span> Shipped
                            </a>
                        </li>
                        <li>
                            <a class="submenu-link" onclick="switchSellerTab('tab-delivered')" id="subnav-delivered">
                                <span class="submenu-tree-symbol">└──</span> Delivered
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Returns -->
                <li class="sidebar-item">
                    <a class="sidebar-link" onclick="switchSellerTab('tab-returns')" id="nav-returns">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-rotate-left nav-icon text-warning"></i>
                            <span>Returns</span>
                        </span>
                        <span class="sidebar-badge bg-warning text-dark">@Model.PendingReturns</span>
                    </a>
                </li>

                <!-- Reviews -->
                <li class="sidebar-item">
                    <a class="sidebar-link" onclick="switchSellerTab('tab-reviews')" id="nav-reviews">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-star nav-icon text-warning"></i>
                            <span>Reviews</span>
                        </span>
                        <span class="sidebar-badge bg-dark border border-secondary text-light">4.9 ★</span>
                    </a>
                </li>

                <!-- Sales & Earnings -->
                <li class="sidebar-item">
                    <a class="sidebar-link" onclick="switchSellerTab('tab-earnings')" id="nav-earnings">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-wallet nav-icon text-success"></i>
                            <span>Sales & Earnings</span>
                        </span>
                    </a>
                </li>

                <!-- Coupons -->
                <li class="sidebar-item">
                    <a class="sidebar-link" onclick="switchSellerTab('tab-coupons')" id="nav-coupons">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-ticket nav-icon text-info"></i>
                            <span>Coupons</span>
                        </span>
                    </a>
                </li>

                <div class="sidebar-divider"></div>

                <!-- Shop Profile -->
                <li class="sidebar-item">
                    <a class="sidebar-link" onclick="switchSellerTab('tab-profile')" id="nav-profile">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-id-card nav-icon"></i>
                            <span>Shop Profile</span>
                        </span>
                    </a>
                </li>

                <!-- Notifications -->
                <li class="sidebar-item">
                    <a class="sidebar-link" onclick="switchSellerTab('tab-notifications')" id="nav-notifications">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-bell nav-icon"></i>
                            <span>Notifications</span>
                        </span>
                        <span class="sidebar-badge bg-primary text-white">3</span>
                    </a>
                </li>

                <!-- Settings -->
                <li class="sidebar-item">
                    <a class="sidebar-link" onclick="switchSellerTab('tab-settings')" id="nav-settings">
                        <span class="sidebar-link-content">
                            <i class="fa-solid fa-gear nav-icon"></i>
                            <span>Settings</span>
                        </span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- ====================================================
             MAIN CONTENT PANELS
             ========================================= -->
        <main class="seller-main-content">
            
            <!-- 1. TAB: DASHBOARD (Overview with 6 key metrics & Recent Orders) -->
            <!-- 1. TAB: DASHBOARD (Default Active) -->
            @await Html.PartialAsync("~/Views/Vendor/Partials/_DashboardTab.cshtml", Model)

            <!-- 2. TAB: ALL PRODUCTS -->
            <div class="tab-panel" id="tab-all-products" data-loaded="false" style="display: none;"></div>

            <!-- 3. TAB: ADD PRODUCT -->
            <div class="tab-panel" id="tab-add-product" data-loaded="false" style="display: none;"></div>

            <!-- 4. TAB: CATEGORIES -->
            <div class="tab-panel" id="tab-categories" data-loaded="false" style="display: none;"></div>

            <!-- 5. TAB: STOCK -->
