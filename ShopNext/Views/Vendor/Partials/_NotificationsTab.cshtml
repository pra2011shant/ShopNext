@model ShopNext.Models.SellerDashboardViewModel
            <div class="tab-panel" id="tab-notifications">
                <div class="glass-panel">
                    <div class="panel-header-flex">
                        <div>
                            <h3><i class="fa-solid fa-bell text-warning"></i> Store Notifications</h3>
                            <span class="text-muted small">Live system alerts and customer dispatch notices</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-3">
                        <div class="p-3 rounded-4" style="background: rgba(15, 23, 42, 0.5); border: 1px solid var(--glass-border);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-warning"><i class="fa-solid fa-box-archive me-1"></i> New Order Received</strong>
                                <span class="text-muted small">10 mins ago</span>
                            </div>
                            <p class="text-light small mb-0">Customer Pooja Sharma has placed order #ORD1045 for ₹38,999.00.</p>
                        </div>
                        <div class="p-3 rounded-4" style="background: rgba(15, 23, 42, 0.5); border: 1px solid var(--glass-border);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-info"><i class="fa-solid fa-circle-check me-1"></i> Weekly Settlement Released</strong>
                                <span class="text-muted small">Yesterday</span>
                            </div>
                            <p class="text-light small mb-0">₹45,200 has been transferred directly to your registered bank account.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 17. TAB: SETTINGS -->