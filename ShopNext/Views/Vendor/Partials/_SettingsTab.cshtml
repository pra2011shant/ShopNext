@model ShopNext.Models.SellerDashboardViewModel
            <div class="tab-panel" id="tab-settings">
                <div class="glass-panel" style="max-width: 750px;">
                    <div class="panel-header-flex">
                        <div>
                            <h3><i class="fa-solid fa-gear text-primary"></i> Store Settings</h3>
                            <span class="text-muted small">Preferences, store timings, and auto-dispatch rules</span>
                        </div>
                    </div>
                    <div class="p-3 rounded-4 mb-3" style="background: rgba(15, 23, 42, 0.5); border: 1px solid var(--glass-border);">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-white d-block">Store Open for Orders</strong>
                                <span class="text-muted small">Temporarily close store when out of inventory</span>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" checked style="width: 48px; height: 24px;">
                            </div>
                        </div>
                    </div>
                    <div class="p-3 rounded-4 mb-3" style="background: rgba(15, 23, 42, 0.5); border: 1px solid var(--glass-border);">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-white d-block">Instant SMS Order Alerts</strong>
                                <span class="text-muted small">Receive automated SMS when customer orders</span>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" checked style="width: 48px; height: 24px;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
