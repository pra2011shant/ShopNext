@model ShopNext.Models.SellerDashboardViewModel
            <div class="tab-panel" id="tab-stock">
                <div class="glass-panel">
                    <!-- Panel Header -->
                    <div class="panel-header-flex mb-4">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary px-2 py-1 rounded-pill small">Feature 23</span>
                                <h3 class="mb-0 text-white"><i class="fa-solid fa-boxes-stacked text-warning me-2"></i> 23. Inventory</h3>
                            </div>
                            <span class="text-muted small">Real-time inventory levels, stock status, and low-inventory threshold triggers.</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-light btn-sm px-3 py-2 rounded-pill" onclick="switchSellerTab('tab-add-product')">
                                <i class="fa-solid fa-plus me-1"></i> Add Product
                            </button>
                        </div>
                    </div>

                    <!-- 23. Specification Alert Banner -->
                    <div class="alert alert-warning d-flex align-items-center p-3 rounded-4 mb-4 border border-warning" style="background: rgba(245, 158, 11, 0.12);">
                        <i class="fa-solid fa-triangle-exclamation fs-2 text-warning me-3 flex-shrink-0"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <strong class="text-warning" style="font-size: 1.05rem;">
                                    <i class="fa-solid fa-bell me-1"></i> Rule: Stock 5 se kam &rarr; ⚠ Low Stock
                                </strong>
                                <span class="badge bg-warning text-dark px-2 py-0.5 rounded-pill small fw-bold">Active Threshold</span>
                            </div>
                            <div class="text-white-50 small">
                                Jab kisi product ka stock <strong>5 se kam</strong> (1 se 4) bachta hai, to system use <strong>⚠ Low Stock</strong> alert ke sath highlight karta hai. 
                                Stock <strong>0</strong> hone par <strong>Out of Stock</strong> aur <strong>5 ya usse zyada</strong> hone par <strong>Available</strong> dikhta hai.
                            </div>
                        </div>
                    </div>

                    <!-- Inventory Summary 4 Metric Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-4 h-100" style="background: rgba(15, 23, 42, 0.85); border: 1px solid var(--glass-border);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small fw-bold">Total Tracked</span>
                                    <i class="fa-solid fa-box text-primary"></i>
                                </div>
                                <div class="fs-4 fw-bold text-white" id="invCountTotal">@(Model.Products?.Count ?? 0)</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Catalog items</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-4 h-100" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-success small fw-bold">Available (Stock &ge; 5)</span>
                                    <i class="fa-solid fa-circle-check text-success"></i>
                                </div>
                                <div class="fs-4 fw-bold text-success" id="invCountAvail">@Model.AvailableStock</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Sufficient inventory</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-4 h-100" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.4);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-warning small fw-bold">⚠ Low Stock (&lt; 5)</span>
                                    <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                                </div>
                                <div class="fs-4 fw-bold text-warning" id="invCountLow">@Model.LowStock</div>
                                <div class="text-warning small" style="font-size: 0.75rem;">Requires restock</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-4 h-100" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-danger small fw-bold">Out of Stock (0)</span>
                                    <i class="fa-solid fa-circle-xmark text-danger"></i>
                                </div>
                                <div class="fs-4 fw-bold text-danger" id="invCountOut">@Model.OutOfStock</div>
                                <div class="text-danger small" style="font-size: 0.75rem;">Sales disabled</div>
                            </div>
                        </div>
                    </div>

                    <!-- Filter & Search Controls -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-dark px-3 py-1.5 rounded-pill border border-secondary active" id="filterBtnAll" onclick="filterInvTable('all', this)">
                                All Products
                            </button>
                            <button type="button" class="btn btn-sm btn-dark px-3 py-1.5 rounded-pill border border-secondary" id="filterBtnAvail" onclick="filterInvTable('available', this)">
                                <i class="fa-solid fa-circle-check text-success me-1"></i> Available
                            </button>
                            <button type="button" class="btn btn-sm btn-dark px-3 py-1.5 rounded-pill border border-warning text-warning" id="filterBtnLow" onclick="filterInvTable('low', this)">
                                <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> ⚠ Low Stock (&lt; 5)
                            </button>
                            <button type="button" class="btn btn-sm btn-dark px-3 py-1.5 rounded-pill border border-danger text-danger" id="filterBtnOut" onclick="filterInvTable('out', this)">
                                <i class="fa-solid fa-circle-xmark text-danger me-1"></i> Out of Stock (0)
                            </button>
                        </div>
                        <div style="min-width: 260px;">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <input type="text" id="invSearchInput" class="form-control bg-dark border-secondary text-white" placeholder="Search product name or SKU..." onkeyup="searchInvTable()" />
                            </div>
                        </div>
                    </div>

                    <!-- 23. INVENTORY TABLE (Product | Stock | Status) -->
                    <div class="table-responsive rounded-4 border border-secondary border-opacity-25">
                        <table class="table custom-table mb-0" id="inventoryMasterTable">
                            <thead>
                                <tr>
                                    <th style="min-width: 250px;"><i class="fa-solid fa-box text-primary me-1"></i> Product</th>
                                    <th style="min-width: 140px;" class="text-center"><i class="fa-solid fa-cubes text-info me-1"></i> Stock</th>
                                    <th style="min-width: 160px;" class="text-center"><i class="fa-solid fa-signal text-warning me-1"></i> Status</th>
                                    <th style="min-width: 160px;" class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Products != null && Model.Products.Any())
                                {
                                    foreach (var p in Model.Products)
                                    {
                                        int curStock = p.Stock;
                                        string statusBadgeClass;
                                        string statusLabel;
                                        string statusIcon;
                                        string rowFilterType;

                                        if (curStock <= 0)
                                        {
                                            statusBadgeClass = "bg-danger bg-opacity-25 text-danger border border-danger";
                                            statusLabel = "Out of Stock";
                                            statusIcon = "fa-circle-xmark";
                                            rowFilterType = "out";
                                        }
                                        else if (curStock < 5)
                                        {
                                            statusBadgeClass = "bg-warning bg-opacity-25 text-warning border border-warning";
                                            statusLabel = "⚠ Low Stock";
                                            statusIcon = "fa-triangle-exclamation";
                                            rowFilterType = "low";
                                        }
                                        else
                                        {
                                            statusBadgeClass = "bg-success bg-opacity-25 text-success border border-success";
                                            statusLabel = "Available";
                                            statusIcon = "fa-circle-check";
                                            rowFilterType = "available";
                                        }

                                        <tr class="inv-row" data-filter="@rowFilterType" id="invRow_@p.Id">
                                            <!-- Column 1: Product -->
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@p.ImageUrl" alt="@p.ProductName" style="width: 46px; height: 46px; border-radius: 10px; object-fit: cover; background: #0f172a; border: 1px solid var(--glass-border);" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100&auto=format&fit=crop&q=60';" />
                                                    <div>
                                                        <strong class="text-white inv-prod-title">@p.ProductName</strong>
                                                        <div class="text-muted small d-flex align-items-center gap-2">
                                                            <span>Category: @(string.IsNullOrEmpty(p.Category) ? "General" : p.Category)</span>
                                                            &bull;
                                                            <span class="inv-prod-sku">SKU: @(string.IsNullOrEmpty(p.Sku) ? $"PRD-{p.Id}" : p.Sku)</span>
                                                            @if (p.HasVariants)
                                                            {
                                                                <span class="badge bg-info bg-opacity-25 text-info border border-info rounded-pill" style="font-size: 0.65rem;">Variants</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Column 2: Stock -->
                                            <td class="text-center align-middle">
                                                <div class="d-inline-flex align-items-center gap-1">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="stepStockValue(@p.Id, -1)" title="Decrease Stock">-</button>
                                                    <input type="number" min="0" class="form-control form-control-sm text-center fw-bold inv-stock-input" id="stockInput_@p.Id" value="@curStock" style="width: 70px; background: rgba(15,23,42,0.8); color: white; border: 1px solid var(--glass-border);" onchange="onStockInputChange(@p.Id)" />
                                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="stepStockValue(@p.Id, 1)" title="Increase Stock">+</button>
                                                </div>
                                                <div class="text-muted small mt-1" id="stockUnitsLabel_@p.Id">@curStock units</div>
                                            </td>

                                            <!-- Column 3: Status (Available / ⚠ Low Stock / Out of Stock) -->
                                            <td class="text-center align-middle">
                                                <span class="badge @statusBadgeClass px-3 py-2 rounded-pill fw-bold inv-status-badge" id="statusBadge_@p.Id">
                                                    <i class="fa-solid @statusIcon me-1"></i> @statusLabel
                                                </span>
                                            </td>

                                            <!-- Action: Update Stock -->
                                            <td class="text-end align-middle">
                                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" id="saveStockBtn_@p.Id" onclick="submitStockUpdate(@p.Id)">
                                                    <i class="fa-solid fa-floppy-disk me-1"></i> Update Stock
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="py-3">
                                                <i class="fa-solid fa-cubes-stacked fs-1 text-warning mb-3"></i>
                                                <h5 class="text-white fw-bold">No Inventory Records Found</h5>
                                                <p class="text-muted small mb-3">Add items to your catalog to track live stock thresholds and low inventory alerts.</p>
                                                <button type="button" class="btn btn-warning text-dark btn-sm px-4 py-2 rounded-pill fw-bold" onclick="switchSellerTab('tab-add-product')">
                                                    <i class="fa-solid fa-plus-circle me-1"></i> Add First Item
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 6. TAB: ALL ORDERS (Orders ├── All Orders) -->