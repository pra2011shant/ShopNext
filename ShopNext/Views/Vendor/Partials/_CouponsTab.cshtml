@model ShopNext.Models.SellerDashboardViewModel
            <div class="tab-panel" id="tab-coupons">
                <div class="glass-panel">
                    <div class="panel-header-flex">
                        <div>
                            <h3><i class="fa-solid fa-ticket text-info"></i> Store Coupons & Discounts</h3>
                            <span class="text-muted small">Create customer promotional vouchers</span>
                        </div>
                        <button type="button" class="btn btn-outline-info btn-sm px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-plus me-1"></i> New Coupon
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded-4" style="background: rgba(15, 23, 42, 0.5); border: 1px dashed rgba(99, 102, 241, 0.5);">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary px-3 py-1 fs-6">FLAT50</span>
                                    <span class="text-success small fw-bold">Active</span>
                                </div>
                                <p class="text-white mb-1 fw-semibold">Flat ₹50 OFF on orders above ₹499</p>
                                <span class="text-muted small">Applicable for all store categories</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-4" style="background: rgba(15, 23, 42, 0.5); border: 1px dashed rgba(16, 185, 129, 0.5);">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-success px-3 py-1 fs-6">SUPER10</span>
                                    <span class="text-success small fw-bold">Active</span>
                                </div>
                                <p class="text-white mb-1 fw-semibold">10% Instant Discount on orders above ₹1,000</p>
                                <span class="text-muted small">Max discount ₹150</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 15. TAB: SHOP PROFILE -->