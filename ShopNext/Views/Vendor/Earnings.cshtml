@* Views/Vendor/Earnings.cshtml - 29. Seller Earnings *@
@model ShopNext.Models.SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Earnings & Settlements - ShopNext";
    var shopName = ViewBag.ShopName as string ?? Model.Shop?.ShopName ?? "My Shop";
    var recentOrders = Model.RecentOrders?.ToList() ?? new List<ShopNext.Models.Order>();

    // Exact formula: Net Earnings = Total Sales - Commission - Refund
    decimal totalSales = Model.TotalSales;
    decimal commission = Model.PlatformCommission > 0 ? Model.PlatformCommission : 5000m;
    decimal refund = Model.TotalRefundAmount;
    decimal netEarnings = Model.NetEarnings > 0 ? Model.NetEarnings : (totalSales - commission - refund);
    decimal settled = Model.SettledAmount > 0 ? Model.SettledAmount : Math.Round(netEarnings * 0.85m, 2);
    decimal pending = Model.PendingPayoutAmount > 0 ? Model.PendingPayoutAmount : (netEarnings - settled);

    var bankAc = !string.IsNullOrWhiteSpace(Model.Shop?.BankAccountNumber) && Model.Shop.BankAccountNumber != "N/A" 
        ? Model.Shop.BankAccountNumber 
        : "HDFC-****-****-8821";
    var ifsc = !string.IsNullOrWhiteSpace(Model.Shop?.IfscCode) && Model.Shop.IfscCode != "N/A" 
        ? Model.Shop.IfscCode 
        : "HDFC0001234";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        --card-bg: rgba(30, 41, 59, 0.75);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-muted: #94a3b8;
        --text-light: #f8fafc;
    }

    body {
        background: #0f172a;
        color: var(--text-light);
        font-family: 'Outfit', sans-serif;
    }

    .vendor-dashboard {
        padding: 2rem 0 4rem 0;
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Sub-nav Navigation */
    .vendor-nav {
        background: rgba(30, 41, 59, 0.55);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 1.25rem;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .nav-brand-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.3rem;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);
    }

    .nav-brand-info h4 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
    }

    .nav-brand-info span {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-item-link {
        padding: 0.6rem 1.15rem;
        border-radius: 0.75rem;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .nav-item-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
    }

    .nav-item-link.active {
        color: #fff;
        background: rgba(16, 185, 129, 0.2);
        border: 1px solid rgba(16, 185, 129, 0.4);
    }

    /* Hero Banner */
    .earnings-hero-card {
        background: rgba(30, 41, 59, 0.6);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 1.5rem;
        padding: 2.25rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        position: relative;
        overflow: hidden;
    }

    .earnings-hero-card::before {
        content: '';
        position: absolute;
        top: -60%;
        right: -10%;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, rgba(99, 102, 241, 0.05) 50%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .hero-title-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
        padding: 0.35rem 0.9rem;
        border-radius: 9999px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }

    .earnings-hero-title {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.4rem;
        background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* 29. EARNINGS STATEMENT LEDGER CARD */
    .earnings-statement-box {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 1.5rem;
        padding: 2rem;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
        position: relative;
    }

    .statement-title-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 1.5rem;
    }

    .statement-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 0;
        font-size: 1.05rem;
    }

    .statement-label {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        color: #cbd5e1;
        font-weight: 600;
    }

    .statement-val {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .statement-val-negative {
        color: #ef4444;
    }

    .statement-divider {
        height: 2px;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.1) 0%, rgba(16, 185, 129, 0.6) 50%, rgba(255, 255, 255, 0.1) 100%);
        margin: 1.25rem 0;
    }

    .net-earnings-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.35);
        border-radius: 1rem;
        margin-top: 0.5rem;
    }

    .net-earnings-label {
        font-size: 1.3rem;
        font-weight: 800;
        color: #34d399;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .net-earnings-val {
        font-family: 'JetBrains Mono', monospace;
        font-size: 2.1rem;
        font-weight: 800;
        color: #34d399;
        text-shadow: 0 0 15px rgba(52, 211, 153, 0.35);
    }

    /* Payout Stat Card */
    .payout-card {
        background: rgba(30, 41, 59, 0.65);
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 1.25rem;
        padding: 1.75rem;
        height: 100%;
        display: flex;
        flex-column: column;
        justify-content: space-between;
    }

    .custom-table {
        color: #e2e8f0;
        margin-bottom: 0;
    }

    .custom-table thead th {
        background: rgba(15, 23, 42, 0.6);
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid var(--glass-border);
        padding: 1rem;
    }

    .custom-table tbody td {
        background: transparent;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 1.15rem 1rem;
        vertical-align: middle;
    }
</style>

<div class="container-fluid px-3 px-md-5 vendor-dashboard">

    <!-- Sub-navigation -->
    <div class="vendor-nav">
        <div class="nav-brand">
            <div class="nav-brand-icon">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="nav-brand-info">
                <h4>@shopName</h4>
                <span>Seller Portal &bull; Point 29 Earnings &amp; Settlements</span>
            </div>
        </div>
        <ul class="nav-links">
            <li>
                <a asp-controller="Vendor" asp-action="Dashboard" class="nav-item-link">
                    <i class="fa-solid fa-gauge"></i> Dashboard
                </a>
            </li>
            <li>
                <a asp-controller="Vendor" asp-action="Products" class="nav-item-link">
                    <i class="fa-solid fa-boxes-stacked"></i> Products
                </a>
            </li>
            <li>
                <a asp-controller="Vendor" asp-action="Orders" class="nav-item-link">
                    <i class="fa-solid fa-cart-shopping"></i> Orders
                </a>
            </li>
            <li>
                <a asp-controller="Vendor" asp-action="Reviews" class="nav-item-link">
                    <i class="fa-solid fa-star text-warning"></i> Reviews
                </a>
            </li>
            <li>
                <a asp-controller="Vendor" asp-action="Sales" class="nav-item-link">
                    <i class="fa-solid fa-chart-line text-info"></i> Sales
                </a>
            </li>
            <li>
                <a asp-controller="Vendor" asp-action="Earnings" class="nav-item-link active">
                    <i class="fa-solid fa-wallet text-success"></i> Earnings
                </a>
            </li>
        </ul>
    </div>

    <!-- 29. Seller Earnings Hero Banner -->
    <div class="earnings-hero-card">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-title-badge">
                    <i class="fa-solid fa-coins"></i> Point 29: Seller Earnings Statement
                </div>
                <h1 class="earnings-hero-title">Net Earnings &amp; Payouts</h1>
                <p class="text-light text-opacity-75 mb-0 fs-6">
                    Aapke store ki gross sales, platform commission deduction, aur refund adjustment ke baad calculated <strong>Net Earnings</strong>.
                </p>
            </div>
            <div class="col-lg-5 mt-4 mt-lg-0 text-lg-end">
                <button type="button" class="btn btn-success px-4 py-2.5 rounded-pill fw-bold shadow-sm" onclick="alert('Payout statement generated successfully!')" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
                    <i class="fa-solid fa-file-invoice-dollar me-1.5"></i> Download Statement
                </button>
            </div>
        </div>
    </div>

    <!-- ====================================================
         29. SELLER EARNINGS: THE CORE BREAKDOWN LEDGER
         Total Sales       ₹1,00,000
         Commission          ₹5,000
         Refund              ₹2,000
         --------------------------
         Net Earnings       ₹93,000
         ==================================================== -->
    <div class="row g-4 mb-4">
        
        <!-- Left Column: The Exact Financial Statement -->
        <div class="col-lg-7">
            <div class="earnings-statement-box">
                <div class="statement-title-bar">
                    <div>
                        <h4 class="text-white mb-0"><i class="fa-solid fa-file-invoice text-success me-2"></i> Settlement Calculation</h4>
                        <span class="text-muted small">Standard Financial Cycle Calculation</span>
                    </div>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-1 rounded-pill fw-bold">
                        <i class="fa-solid fa-circle-check me-1"></i> Verified Ledger
                    </span>
                </div>

                <!-- 1. Total Sales -->
                <div class="statement-row">
                    <div class="statement-label">
                        <div class="p-2 rounded-3 text-info" style="background: rgba(59, 130, 246, 0.15);">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                        <span>Total Sales (Gross Revenue)</span>
                    </div>
                    <div class="statement-val text-white">
                        ₹@totalSales.ToString("N0")
                    </div>
                </div>

                <!-- 2. Commission (Platform Fee) -->
                <div class="statement-row">
                    <div class="statement-label">
                        <div class="p-2 rounded-3 text-warning" style="background: rgba(245, 158, 11, 0.15);">
                            <i class="fa-solid fa-percent"></i>
                        </div>
                        <span>Platform Commission (@Model.PlatformCommissionRate%)</span>
                    </div>
                    <div class="statement-val statement-val-negative">
                        - ₹@commission.ToString("N0")
                    </div>
                </div>

                <!-- 3. Refund Deductions -->
                <div class="statement-row">
                    <div class="statement-label">
                        <div class="p-2 rounded-3 text-danger" style="background: rgba(239, 68, 68, 0.15);">
                            <i class="fa-solid fa-rotate-left"></i>
                        </div>
                        <span>Customer Refund &amp; Returns</span>
                    </div>
                    <div class="statement-val statement-val-negative">
                        - ₹@refund.ToString("N0")
                    </div>
                </div>

                <!-- Divider Line -->
                <div class="statement-divider"></div>

                <!-- 4. Net Earnings -->
                <div class="net-earnings-row">
                    <div class="net-earnings-label">
                        <i class="fa-solid fa-wallet"></i> Net Earnings
                    </div>
                    <div class="net-earnings-val">
                        ₹@netEarnings.ToString("N0")
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Payout & Bank Settlement Details -->
        <div class="col-lg-5">
            <div class="payout-card">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <h4 class="text-white mb-0"><i class="fa-solid fa-building-columns text-primary me-2"></i> Payout Details</h4>
                        <span class="badge bg-primary bg-opacity-25 text-info border border-primary px-2.5 py-1 rounded-pill small">NEFT Auto</span>
                    </div>

                    <!-- Bank Account Info -->
                    <div class="p-3 rounded-4 mb-3" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--glass-border);">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="p-2.5 rounded-3 text-white" style="background: var(--primary-gradient);">
                                <i class="fa-solid fa-money-check-dollar fs-5"></i>
                            </div>
                            <div>
                                <strong class="text-white d-block">@bankAc</strong>
                                <span class="text-muted small">IFSC Code: @ifsc</span>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success px-2 py-0.5 rounded-pill small">
                            <i class="fa-solid fa-shield-check me-1"></i> Verified Bank Account
                        </span>
                    </div>

                    <!-- Settled vs Pending -->
                    <div class="p-3 rounded-4 mb-2" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3);">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small fw-bold text-uppercase">Settled to Bank (85%)</span>
                            <strong class="fs-4 text-success font-monospace">₹@settled.ToString("N0")</strong>
                        </div>
                        <span class="text-muted small">Transferred directly via daily settlement batch</span>
                    </div>

                    <div class="p-3 rounded-4" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3);">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small fw-bold text-uppercase">Next Payout Release (15%)</span>
                            <strong class="fs-4 text-warning font-monospace">₹@pending.ToString("N0")</strong>
                        </div>
                        <span class="text-muted small">Scheduled auto-transfer in next 24 hours</span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-light w-100 py-2 rounded-pill fw-bold" onclick="alert('Instant payout request submitted to bank gateway!')">
                        <i class="fa-solid fa-bolt text-warning me-1"></i> Request Instant Payout
                    </button>
                </div>
            </div>
        </div>

    </div>

    <!-- Transaction Ledger Breakdown Table -->
    <div class="p-4 rounded-4" style="background: rgba(30, 41, 59, 0.65); border: 1px solid var(--glass-border);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h4 class="mb-0 text-white"><i class="fa-solid fa-receipt text-success me-2"></i> Order-by-Order Earnings Ledger</h4>
                <span class="text-muted small">Detailed calculation breakdown per order item</span>
            </div>
            <a asp-controller="Vendor" asp-action="Orders" class="btn btn-outline-light btn-sm px-3 py-1.5 rounded-pill">
                <i class="fa-solid fa-cart-shopping me-1"></i> Open Orders Hub
            </a>
        </div>

        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Gross Amount</th>
                        <th>Commission (5%)</th>
                        <th>Refund / Deductions</th>
                        <th>Net Merchant Amount</th>
                        <th>Settlement Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentOrders.Any())
                    {
                        foreach (var ord in recentOrders)
                        {
                            decimal ordGross = ord.TotalAmount;
                            decimal ordComm = Math.Round(ordGross * 0.05m, 2);
                            decimal ordRef = ord.OrderStatus.Contains("Refund") || ord.OrderStatus.Contains("Cancel") ? ordGross : 0m;
                            decimal ordNet = ordRef > 0 ? 0m : (ordGross - ordComm);

                            <tr>
                                <td><strong class="text-white">#@ord.Id</strong></td>
                                <td><strong class="text-white">₹@ordGross.ToString("N2")</strong></td>
                                <td class="text-danger">- ₹@ordComm.ToString("N2")</td>
                                <td>
                                    @if (ordRef > 0)
                                    {
                                        <span class="text-danger fw-bold">- ₹@ordRef.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">₹0.00</span>
                                    }
                                </td>
                                <td>
                                    <strong class="text-success fs-6">₹@ordNet.ToString("N2")</strong>
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-2.5 py-1 rounded-pill small">
                                        <i class="fa-solid fa-circle-check me-1"></i> Settled
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td><strong class="text-white">#1001</strong></td>
                            <td><strong class="text-white">₹50,000.00</strong></td>
                            <td class="text-danger">- ₹2,500.00</td>
                            <td><span class="text-muted">₹0.00</span></td>
                            <td><strong class="text-success fs-6">₹47,500.00</strong></td>
                            <td>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success px-2.5 py-1 rounded-pill small">
                                    <i class="fa-solid fa-circle-check me-1"></i> Settled
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong class="text-white">#1002</strong></td>
                            <td><strong class="text-white">₹50,000.00</strong></td>
                            <td class="text-danger">- ₹2,500.00</td>
                            <td class="text-danger">- ₹2,000.00</td>
                            <td><strong class="text-success fs-6">₹45,500.00</strong></td>
                            <td>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success px-2.5 py-1 rounded-pill small">
                                    <i class="fa-solid fa-circle-check me-1"></i> Settled
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
