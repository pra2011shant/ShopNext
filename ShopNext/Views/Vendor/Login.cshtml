@* Views/Vendor/Login.cshtml *@
@{
    ViewData["Title"] = "Vendor Login - ShopNext";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        --card-bg: rgba(30, 41, 59, 0.75);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-muted: #64748b;
        --text-light: #1e293b;
        --error-color: #ef4444;
    }

    body {
        background: transparent;
        color: var(--text-light);
        font-family: 'Outfit', sans-serif;
    }

    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        animation: fadeIn 0.8s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .glass-login-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 3rem;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
    }

    .glass-login-card:hover {
        border-color: rgba(99, 102, 241, 0.3);
        box-shadow: 0 25px 55px rgba(99, 102, 241, 0.15);
    }

    .card-header-icon {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 3rem;
        display: block;
        margin: 0 auto 1.5rem;
        text-align: center;
    }

    .login-title {
        font-weight: 800;
        font-size: 2rem;
        text-align: center;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
    }

    .login-subtitle {
        color: var(--text-muted);
        text-align: center;
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    .form-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .form-control-custom {
        width: 100%;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 0.85rem 1rem 0.85rem 2.75rem;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #a855f7;
        box-shadow: 0 0 15px rgba(168, 85, 247, 0.2);
        background: rgba(15, 23, 42, 0.8);
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 2.5rem;
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    .btn-login {
        background: var(--primary-gradient);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.85rem;
        width: 100%;
        font-weight: 600;
        font-size: 1.05rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
        box-shadow: 0 8px 20px rgba(168, 85, 247, 0.3);
    }

    .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(168, 85, 247, 0.45);
    }

    .btn-login:active {
        transform: translateY(0);
    }

    .register-link-container {
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .register-link {
        color: #a5b4fc;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
    }

    .register-link:hover {
        color: #ec4899;
        text-decoration: underline;
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.25);
        color: #fca5a5;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div class="login-container">
    <div class="glass-login-card">
        <span class="card-header-icon"><i class="fa-solid fa-shop"></i></span>
        <h1 class="login-title" id="loginHeader">Dukaan Login</h1>
        <p class="login-subtitle">Enter your registered phone number to manage products and orders.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert-danger-custom" id="loginErrorMessage">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-controller="Vendor" asp-action="Login" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="phoneNumber" class="form-label">Phone Number</label>
                <i class="fa-solid fa-phone input-icon"></i>
                <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control-custom" placeholder="e.g. 9876543210" required />
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <i class="fa-solid fa-lock input-icon"></i>
                <input type="password" id="password" name="password" class="form-control-custom" placeholder="Enter password (if configured)" />
            </div>

            <button type="submit" class="btn-login" id="loginSubmitBtn">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Log In
            </button>
        </form>

        <div class="register-link-container">
            Nayi dukaan hai? 
            <a asp-controller="Vendor" asp-action="Register" class="register-link" id="registerRedirectLink">Apni Dukaan Register Karen</a>
        </div>
    </div>
</div>
