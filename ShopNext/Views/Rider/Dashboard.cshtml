@* Views/Rider/Dashboard.cshtml *@
@model IEnumerable<ShopNext.Models.Order>
@{
    ViewData["Title"] = "Rider Dashboard - ShopNext";
    var riderName = ViewBag.RiderName as string ?? "Rider";
    var riderId = ViewBag.RiderId as int? ?? 0;
    var currentLat = ViewBag.RiderLatitude as decimal? ?? 0;
    var currentLng = ViewBag.RiderLongitude as decimal? ?? 0;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        --card-bg: rgba(30, 41, 59, 0.75);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-muted: #64748b;
        --text-light: #1e293b;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --info-color: #3b82f6;
    }

    body {
        background: transparent;
        color: var(--text-light);
        font-family: 'Outfit', sans-serif;
    }

    .rider-dashboard {
        padding: 2rem 0;
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Sub-nav Styling */
    .rider-nav {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1rem 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .rider-brand {
        font-weight: 800;
        font-size: 1.4rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .v-logout {
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.2);
        background: rgba(239, 68, 68, 0.05);
        text-decoration: none;
        padding: 0.5rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .v-logout:hover {
        color: white;
        background: #ef4444;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
    }

    .dashboard-header {
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .dashboard-title {
        font-weight: 800;
        font-size: 2rem;
        letter-spacing: -0.02em;
        margin: 0;
    }

    /* GPS simulator card */
    .gps-simulator-box {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.25);
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .gps-coords-value {
        font-family: monospace;
        font-size: 1.1rem;
        font-weight: bold;
        color: #a5b4fc;
    }

    /* Order Card styling */
    .order-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .order-card:hover {
        border-color: rgba(99, 102, 241, 0.3);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
    }

    .order-id {
        font-weight: 800;
        font-size: 1.15rem;
        color: white;
    }

    .status-badge {
        padding: 0.35rem 0.85rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .status-Dispatched {
        background: rgba(99, 102, 241, 0.15);
        color: #818cf8;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .status-OutForDelivery {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .status-Completed {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .order-details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .order-details-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    .info-box {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid var(--glass-border);
        border-radius: 14px;
        padding: 1rem;
    }

    .info-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-weight: 600;
        font-size: 0.95rem;
        color: white;
        margin-bottom: 0.75rem;
    }

    .info-value:last-child {
        margin-bottom: 0;
    }

    .order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .btn-action {
        border-radius: 10px;
        padding: 0.6rem 1.5rem;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-start {
        background: var(--primary-gradient);
        color: white;
        box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
    }

    .btn-start:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(168, 85, 247, 0.45);
    }

    .btn-complete {
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .btn-complete:hover {
        background: var(--success-color);
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .sim-progress-box {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        width: 100%;
        display: none;
        margin-top: 1rem;
        animation: fadeIn 0.3s ease-out;
    }

    .progress-bar-container {
        height: 6px;
        background: #1e293b;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 0.5rem;
    }

    .progress-bar-fill {
        height: 100%;
        width: 0%;
        background: var(--primary-gradient);
        transition: width 0.4s ease;
    }

    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        background: var(--card-bg);
        border: 1px dashed var(--glass-border);
        border-radius: 24px;
    }

    .empty-icon {
        font-size: 4rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 1.5rem;
    }

    /* Toast Notification */
    .toast-container-custom {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1055;
    }

    .toast-custom {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        color: white;
        min-width: 300px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        display: none;
        animation: slideIn 0.3s ease-out;
    }

    @@keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>

<div class="container rider-dashboard">
    <!-- Rider Sub-Navbar -->
    <nav class="rider-nav">
        <div class="rider-brand">
            <i class="fa-solid fa-motorcycle"></i> Rider: @riderName
        </div>
        <a asp-controller="Rider" asp-action="Logout" class="v-logout">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
        </a>
    </nav>

    <!-- Header and Location Status -->
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">My Delivery Tasks</h2>
            <p class="text-muted mb-0">View assigned delivery trips and report your live coordinates.</p>
        </div>
    </div>

    <!-- Active Location Tracking Status Card -->
    <div class="gps-simulator-box">
        <div>
            <i class="fa-solid fa-satellite-dish text-primary me-2"></i> Live GPS Telemetry Status: 
            <span class="badge bg-success ms-2"><i class="fa-solid fa-circle-nodes"></i> Active Connection</span>
        </div>
        <div>
            Current GPS Coordinates: 
            <span class="gps-coords-value" id="currentGpsDisplay">@currentLat.ToString("F6"), @currentLng.ToString("F6")</span>
        </div>
    </div>

    <!-- Deliveries List -->
    <div id="deliveriesContainer">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid fa-motorcycle"></i></div>
                <h3>Koi delivery assigned nahi hai</h3>
                <p class="text-muted">Jab koi dukaan aapko order assign karegi, wo yahan dikhai dega.</p>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                // Calculate mock customer coordinates offset from shop coordinates (approx 2 km away)
                var shopLat = order.Shop?.Latitude ?? 28.6139m;
                var shopLng = order.Shop?.Longitude ?? 77.2090m;
                var custLat = shopLat + 0.015m;
                var custLng = shopLng + 0.015m;

                <div class="order-card" id="order-card-@order.Id">
                    <div class="order-header">
                        <span class="order-id">Delivery Request #@order.Id</span>
                        <span class="status-badge status-@order.OrderStatus" id="badge-@order.Id">
                            @if (order.OrderStatus == "Dispatched")
                            {
                                <i class="fa-solid fa-map-location-dot"></i> <span>Assigned</span>
                            }
                            else if (order.OrderStatus == "OutForDelivery")
                            {
                                <i class="fa-solid fa-motorcycle"></i> <span>Out For Delivery</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-check"></i> <span>Delivered</span>
                            }
                        </span>
                    </div>

                    <div class="order-details-grid">
                        <!-- Shop/Pickup Box -->
                        <div class="info-box" style="border-color: rgba(168, 85, 247, 0.2)">
                            <div class="info-label"><i class="fa-solid fa-store text-primary"></i> Pickup Store</div>
                            <div class="info-value">@(order.Shop?.ShopName ?? "Store")</div>
                            <div class="info-label">Address / Category</div>
                            <div class="info-value">@(order.Shop?.Category ?? "General") (Coords: @(order.Shop?.Latitude.ToString("F4") ?? "0.0000"), @(order.Shop?.Longitude.ToString("F4") ?? "0.0000"))</div>
                        </div>

                        <!-- Customer/Drop Box -->
                        <div class="info-box" style="border-color: rgba(99, 102, 241, 0.2)">
                            <div class="info-label"><i class="fa-solid fa-house text-primary"></i> Delivery Drop</div>
                            <div class="info-value">@(order.Customer?.Name ?? "Customer")</div>
                            <div class="info-label">Address</div>
                            <div class="info-value">@order.Remark</div>
                        </div>
                    </div>

                    <!-- Live Simulation Map Container -->
                    <div class="rider-map-card mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-white">
                                <i class="fa-solid fa-location-crosshairs text-primary me-1"></i> Live Route Navigation & Simulation
                            </span>
                            <span id="speed-tag-@order.Id" class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 px-2 py-1 small">
                                Ready to Dispatch
                            </span>
                        </div>
                        <div id="map-@order.Id" class="order-map-embed"></div>
                        <div class="sim-progress-wrapper" id="sim-bar-wrapper-@order.Id" style="display: none;">
                            <div class="progress-bar-fill" id="sim-bar-@order.Id"></div>
                        </div>
                    </div>

                    <!-- Footer / Action Buttons -->
                    <div class="order-footer">
                        <div>
                            Total Amount to Collect: <strong class="fs-5 text-success">₹@order.TotalAmount.ToString("F2")</strong>
                            @if (!string.IsNullOrEmpty(order.DeliveryOtp))
                            {
                                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-25 ms-2 small">
                                    <i class="fa-solid fa-key me-1"></i> OTP Protected
                                </span>
                            }
                        </div>
                        <div id="actions-@order.Id">
                            @if (order.OrderStatus == "Dispatched")
                            {
                                <button type="button" class="btn-action btn-start" 
                                        onclick="startDeliveryTrip(@order.Id, @shopLat, @shopLng, @custLat, @custLng)"
                                        id="btn-start-@order.Id">
                                    <i class="fa-solid fa-motorcycle"></i> Start Delivery Trip
                                </button>
                                <button type="button" class="btn-action btn-complete" 
                                        onclick="openDeliveryOtpModal(@order.Id, @order.TotalAmount, '@(order.Customer?.Name?.Replace("'", "\\'") ?? "Customer")', '@(order.DeliveryOtp ?? "")')"
                                        id="btn-complete-@order.Id" style="display: none;">
                                    <i class="fa-solid fa-key"></i> Enter OTP & Deliver
                                </button>
                            }
                            else if (order.OrderStatus == "OutForDelivery")
                            {
                                <button type="button" class="btn-action btn-complete" 
                                        onclick="openDeliveryOtpModal(@order.Id, @order.TotalAmount, '@(order.Customer?.Name?.Replace("'", "\\'") ?? "Customer")', '@(order.DeliveryOtp ?? "")')"
                                        id="btn-complete-@order.Id">
                                    <i class="fa-solid fa-key"></i> Enter OTP & Deliver
                                </button>
                                <script>
                                    // Resume simulation if refreshed during trip
                                    document.addEventListener("DOMContentLoaded", function() {
                                        startLocationSimulation(@order.Id, @shopLat, @shopLng, @custLat, @custLng);
                                    });
                                </script>
                            }
                            else
                            {
                                <span class="text-success small fw-bold">
                                    <i class="fa-solid fa-circle-check"></i> Delivered ✓ (OTP: @(string.IsNullOrEmpty(order.DeliveryOtp) ? "Verified" : order.DeliveryOtp))
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal: Customer Delivery OTP Verification -->
<div class="modal fade" id="deliveryOtpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-white" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(20px); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 24px; box-shadow: 0 25px 50px rgba(0,0,0,0.5);">
            <div class="modal-header border-secondary border-opacity-25 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary bg-opacity-25 p-2 text-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="fa-solid fa-key fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0">Delivery Handover OTP</h5>
                        <small class="text-muted">Point 41: Anti-Theft Handover Verification</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Order Summary Info -->
                <div class="p-3 mb-3 rounded-3" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Order ID:</span>
                        <strong class="text-primary font-monospace" id="modalOrderId">#ORD0</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Customer:</span>
                        <strong class="text-white" id="modalCustomerName">Customer</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Collect Amount:</span>
                        <strong class="text-success fs-6" id="modalTotalAmount">₹0.00</strong>
                    </div>
                </div>

                <!-- OTP Input Form -->
                <div class="text-center py-2">
                    <label class="form-label text-muted small fw-semibold mb-2">
                        Customer ke mobile / app par dikh raha 4-digit OTP enter karein:
                    </label>
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <input type="text" id="deliveryOtpInput" maxlength="4" placeholder="5824"
                               class="form-control text-center font-monospace fw-bold fs-2 text-warning bg-dark border-secondary"
                               style="max-width: 220px; letter-spacing: 10px; border-radius: 14px; padding: 0.6rem;" 
                               autocomplete="off" inputmode="numeric" />
                    </div>
                    <div id="otpValidationFeedback" class="small mb-3" style="display: none;"></div>
                </div>

                <!-- Handover Notes (Optional) -->
                <div class="mb-3">
                    <label class="form-label text-muted small">Delivery Remarks / Handover Notes (Optional):</label>
                    <input type="text" id="deliveryNotesInput" class="form-control form-control-sm bg-dark text-white border-secondary rounded-3" placeholder="e.g. Handed over to customer in person" />
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25 pt-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" id="btnSubmitOtp" onclick="submitDeliveryOtp()">
                    <i class="fa-solid fa-check me-1"></i> Verify OTP & Deliver
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div class="toast-container-custom">
    <div class="toast-custom p-3" id="riderToast">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-check text-success fs-4" id="toastIcon"></i>
            <div id="toastMessage" class="fw-semibold">Action completed successfully!</div>
        </div>
    </div>
</div>

<script>
    let activeIntervals = {};
    let currentOtpOrderId = 0;
    let otpModalInstance = null;

    function openDeliveryOtpModal(orderId, totalAmount, customerName, expectedOtp) {
        currentOtpOrderId = orderId;
        document.getElementById("modalOrderId").innerText = "#ORD" + orderId;
        document.getElementById("modalCustomerName").innerText = customerName || "Customer";
        document.getElementById("modalTotalAmount").innerText = "₹" + parseFloat(totalAmount).toFixed(2);
        
        const input = document.getElementById("deliveryOtpInput");
        input.value = "";
        document.getElementById("deliveryNotesInput").value = "";
        
        const feedback = document.getElementById("otpValidationFeedback");
        feedback.style.display = "none";
        feedback.innerHTML = "";

        const btn = document.getElementById("btnSubmitOtp");
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Verify OTP & Deliver';

        if (!otpModalInstance) {
            otpModalInstance = new bootstrap.Modal(document.getElementById('deliveryOtpModal'));
        }
        otpModalInstance.show();

        setTimeout(() => {
            input.focus();
        }, 500);
    }

    function submitDeliveryOtp() {
        const otp = document.getElementById("deliveryOtpInput").value.trim();
        const notes = document.getElementById("deliveryNotesInput").value.trim();
        const feedback = document.getElementById("otpValidationFeedback");
        const btn = document.getElementById("btnSubmitOtp");

        if (!otp || otp.length < 4) {
            feedback.className = "small text-danger fw-semibold";
            feedback.innerHTML = '<i class="fa-solid fa-circle-exclamation me-1"></i> Please enter a valid 4-digit OTP.';
            feedback.style.display = "block";
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Verifying...';

        $.ajax({
            url: '@Url.Action("VerifyDeliveryOtp", "Rider")',
            type: 'POST',
            data: { orderId: currentOtpOrderId, otp: otp, notes: notes },
            success: function(res) {
                if (res.success) {
                    // Show 5824 ✓ Order Delivered
                    feedback.className = "alert alert-success py-2 px-3 small fw-bold mb-0 text-success border border-success";
                    feedback.innerHTML = `<i class="fa-solid fa-circle-check fs-5 me-2"></i> ${otp} ✓ Order Delivered!`;
                    feedback.style.display = "block";

                    // Update dashboard card badge and actions
                    const badge = document.getElementById("badge-" + currentOtpOrderId);
                    if (badge) {
                        badge.className = "status-badge status-Completed";
                        badge.innerHTML = '<i class="fa-solid fa-circle-check"></i> <span>Delivered</span>';
                    }

                    const actions = document.getElementById("actions-" + currentOtpOrderId);
                    if (actions) {
                        actions.innerHTML = `<span class="text-success small fw-bold"><i class="fa-solid fa-circle-check"></i> Delivered ✓ (OTP: ${otp})</span>`;
                    }

                    // Clear simulation
                    if (activeIntervals[currentOtpOrderId]) {
                        clearInterval(activeIntervals[currentOtpOrderId]);
                    }

                    showToast(`Order #${currentOtpOrderId} delivered successfully! OTP: ${otp} ✓`);

                    setTimeout(() => {
                        if (otpModalInstance) otpModalInstance.hide();
                    }, 1200);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Verify OTP & Deliver';
                    feedback.className = "alert alert-danger py-2 px-3 small fw-semibold mb-0 text-danger border border-danger";
                    feedback.innerHTML = `<i class="fa-solid fa-triangle-exclamation me-1"></i> ${res.message || 'Invalid OTP. Please check with customer.'}`;
                    feedback.style.display = "block";
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Verify OTP & Deliver';
                feedback.className = "small text-danger fw-semibold";
                feedback.innerHTML = '<i class="fa-solid fa-wifi me-1"></i> Connection error while verifying OTP.';
                feedback.style.display = "block";
            }
        });
    }

    // Allow pressing Enter on OTP Input to submit
    document.getElementById("deliveryOtpInput")?.addEventListener("keyup", function(e) {
        if (e.key === "Enter") {
            submitDeliveryOtp();
        }
    });

    function startDeliveryTrip(orderId, shopLat, shopLng, custLat, custLng) {
        const btnStart = document.getElementById("btn-start-" + orderId);
        btnStart.disabled = true;
        btnStart.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Starting...';

        $.ajax({
            url: '@Url.Action("UpdateOrderStatus", "Rider")',
            type: 'POST',
            data: { orderId: orderId, status: 'OutForDelivery' },
            success: function(res) {
                if (res.success) {
                    showToast("Trip started! GPS coordinates are now streaming.");
                    
                    // Update badge
                    const badge = document.getElementById("badge-" + orderId);
                    if (badge) {
                        badge.className = "status-badge status-OutForDelivery";
                        badge.innerHTML = '<i class="fa-solid fa-truck-fast"></i> <span>Out for Delivery</span>';
                    }

                    // Switch buttons
                    btnStart.style.display = "none";
                    const btnComplete = document.getElementById("btn-complete-" + orderId);
                    if (btnComplete) btnComplete.style.display = "inline-block";

                    // Trigger Geolocation Simulation
                    startLocationSimulation(orderId, shopLat, shopLng, custLat, custLng);
                } else {
                    showToast("Failed to start trip.", true);
                    btnStart.disabled = false;
                    btnStart.innerHTML = '<i class="fa-solid fa-motorcycle"></i> Start Delivery Trip';
                }
            },
            error: function() {
                showToast("Connection error.", true);
                btnStart.disabled = false;
                btnStart.innerHTML = '<i class="fa-solid fa-motorcycle"></i> Start Delivery Trip';
            }
        });
    }

    function startLocationSimulation(orderId, shopLat, shopLng, custLat, custLng) {
        const simBox = document.getElementById("sim-box-" + orderId);
        const simStatus = document.getElementById("sim-status-" + orderId);
        const simStep = document.getElementById("sim-step-" + orderId);
        const simBar = document.getElementById("sim-bar-" + orderId);

        if (simBox) simBox.style.display = "block";

        const steps = 10;
        let step = 0;

        if (activeIntervals[orderId]) {
            clearInterval(activeIntervals[orderId]);
        }

        activeIntervals[orderId] = setInterval(() => {
            step++;
            if (step > steps) {
                clearInterval(activeIntervals[orderId]);
                if (simStatus) simStatus.innerHTML = '<span class="text-success fw-bold"><i class="fa-solid fa-location-dot"></i> Arrived at Customer! Ask for Delivery OTP</span>';
                if (simStep) simStep.innerText = `${steps} / ${steps} steps`;
                if (simBar) simBar.style.width = '100%';
                return;
            }

            const currentLat = shopLat + (custLat - shopLat) * (step / steps);
            const currentLng = shopLng + (custLng - shopLng) * (step / steps);

            if (simStatus) simStatus.innerText = `Riding bike... step ${step}`;
            if (simStep) simStep.innerText = `${step} / ${steps} steps`;
            if (simBar) simBar.style.width = `${(step / steps) * 100}%`;

            reportLocation(currentLat, currentLng);

        }, 4000);
    }

    function reportLocation(lat, lng) {
        const gpsDisplay = document.getElementById("currentGpsDisplay");
        if (gpsDisplay) gpsDisplay.innerText = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;

        $.ajax({
            url: '@Url.Action("UpdateLocation", "Rider")',
            type: 'POST',
            data: { latitude: lat, longitude: lng },
            success: function(res) {
                console.log("GPS Telemetry streaming: OK");
            },
            error: function(err) {
                console.warn("GPS Telemetry streaming failed: ", err);
            }
        });
    }

    function showToast(message, isError = false) {
        const toast = document.getElementById("riderToast");
        const toastMsg = document.getElementById("toastMessage");
        const toastIcon = document.getElementById("toastIcon");

        if (!toast || !toastMsg) return;

        toastMsg.innerText = message;
        if (isError) {
            toastIcon.className = "fa-solid fa-circle-xmark text-danger fs-4";
        } else {
            toastIcon.className = "fa-solid fa-circle-check text-success fs-4";
        }

        $(toast).fadeIn(300);
        setTimeout(() => {
            $(toast).fadeOut(300);
        }, 3500);
    }
</script>
