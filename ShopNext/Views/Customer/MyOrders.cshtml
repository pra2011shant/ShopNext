@model IEnumerable<ShopNext.Models.Order>
@{
    ViewData["Title"] = "My Orders - Order History - ShopNext";
}

<style>
    .order-history-card {
        background: rgba(30, 41, 59, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
        transition: all 0.25s ease;
    }
    .order-history-card:hover {
        border-color: rgba(129, 140, 248, 0.35);
        box-shadow: 0 20px 45px rgba(99, 102, 241, 0.15);
    }
    .order-id-badge {
        font-family: monospace;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        background: rgba(99, 102, 241, 0.15);
        color: #818cf8;
        border: 1px solid rgba(99, 102, 241, 0.3);
        padding: 0.35rem 0.85rem;
        border-radius: 10px;
    }
    .status-badge-custom {
        font-size: 0.85rem;
        padding: 0.4rem 0.9rem;
        border-radius: 50rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .order-prod-thumb {
        width: 72px;
        height: 72px;
        border-radius: 12px;
        object-fit: cover;
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .btn-action-pill {
        border-radius: 50rem;
        font-weight: 600;
        padding: 0.45rem 1.15rem;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }
    /* Toast Notification */
    .reorder-toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        background: rgba(15, 23, 42, 0.95);
        border: 1px solid #818cf8;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        border-radius: 16px;
        padding: 1rem 1.25rem;
        backdrop-filter: blur(12px);
        display: none;
    }
    /* Timeline Component for Refund Tracking */
    .timeline-wrapper { position: relative; padding-left: 10px; }
    .timeline-step { position: relative; padding-left: 54px; padding-bottom: 24px; transition: all 0.3s ease; }
    .timeline-step:last-child { padding-bottom: 0; }
    .timeline-step::before { content: ''; position: absolute; left: 18px; top: 32px; bottom: -4px; width: 3px; background: rgba(255, 255, 255, 0.1); z-index: 1; transition: all 0.4s ease; }
    .timeline-step.completed::before { background: #10b981; }
    .timeline-step.current::before { background: linear-gradient(180deg, #10b981 0%, rgba(99, 102, 241, 0.4) 100%); }
    .timeline-step:last-child::before { display: none; }
    .step-down-arrow { position: absolute; left: 13px; bottom: 2px; color: rgba(255, 255, 255, 0.25); font-size: 0.8rem; z-index: 2; }
    .timeline-step.completed .step-down-arrow { color: #10b981; }
    .timeline-step.current .step-down-arrow { color: #818cf8; }
    .step-icon-circle { position: absolute; left: 0; top: 0; width: 38px; height: 38px; border-radius: 50%; background: #1e293b; border: 2px solid rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; font-size: 0.95rem; z-index: 3; color: #94a3b8; }
    .timeline-step.completed .step-icon-circle { background: #065f46; border-color: #10b981; color: #10b981; }
    .timeline-step.current .step-icon-circle { background: #312e81; border-color: #818cf8; color: #818cf8; box-shadow: 0 0 15px rgba(99, 102, 241, 0.6); }
    .timeline-step.upcoming .step-icon-circle { background: #0f172a; border-color: rgba(255, 255, 255, 0.1); color: #475569; }
    .step-title { font-weight: 700; font-size: 0.95rem; color: #ffffff; display: flex; align-items: center; gap: 8px; }
    .timeline-step.upcoming .step-title { color: #64748b; }
    .step-desc { font-size: 0.8rem; color: #94a3b8; margin: 2px 0 0 0; }
    .timeline-step.upcoming .step-desc { color: #475569; }
    
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Account" class="text-decoration-none text-muted">My Account</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Order History</li>
                </ol>
            </nav>
            <h2 class="text-white fw-bold mb-1">
                <i class="fa-solid fa-box-open text-primary me-2"></i> My Orders
            </h2>
            <p class="text-muted small mb-0">Review past order history, reorder favorite products with 1-click, request returns, and track live status</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Customer" asp-action="Account" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="fa-solid fa-user me-1"></i> My Account
            </a>
            <a asp-controller="Home" asp-action="Products" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="fa-solid fa-bag-shopping me-1"></i> Browse Marketplace
            </a>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Toast for Buy Again -->
    <div id="buyAgainToast" class="reorder-toast">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-success bg-opacity-25 p-2 text-success">
                <i class="fa-solid fa-check fs-5"></i>
            </div>
            <div>
                <strong class="text-white d-block" id="toastTitle">Added to Cart!</strong>
                <span class="text-muted small" id="toastMsg">Product added back to your cart.</span>
            </div>
            <a asp-controller="Home" asp-action="Cart" class="btn btn-primary btn-sm rounded-pill ms-2 px-3">
                Go to Cart <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
            <button type="button" class="btn-close btn-close-white ms-1" onclick="hideToast()"></button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 order-history-card">
            <div class="d-inline-flex p-4 rounded-circle mb-3" style="background: rgba(99, 102, 241, 0.1);">
                <i class="fa-solid fa-box-open fa-3x text-primary"></i>
            </div>
            <h4 class="text-white fw-bold mb-2">No Orders Placed Yet</h4>
            <p class="text-muted mb-4">You have not placed any orders yet. Discover nearby shops and explore electronics, gadgets, and daily essentials!</p>
            <a asp-controller="Home" asp-action="Products" class="btn btn-primary px-4 py-2 rounded-pill">
                <i class="fa-solid fa-bag-shopping me-1"></i> Explore Marketplace
            </a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            var firstItem = order.OrderItems.FirstOrDefault();
            int extraItemsCount = order.OrderItems.Count - 1;
            string primaryProductName = firstItem?.Product?.ProductName ?? "Samsung Mobile";
            string primaryImageUrl = firstItem?.Product?.ImageUrl ?? "";
            bool isDelivered = (order.OrderStatus == "Delivered" || order.OrderStatus == "Completed");

            <div class="order-history-card" id="order-card-@order.Id">
                <!-- Top Row: Order Number (#ORD1001) & Status -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 mb-3 border-bottom border-secondary border-opacity-50">
                    <div class="d-flex align-items-center gap-3">
                        <span class="order-id-badge">
                            #ORD@(order.Id)
                        </span>
                        <div>
                            <span class="text-white fw-bold">
                                <i class="fa-solid fa-store text-primary me-1"></i> @(order.ShopName ?? "ShopNext Store")
                            </span>
                            <span class="text-muted small ms-2 d-none d-sm-inline">
                                &bull; @order.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        </div>
                    </div>

                    <!-- Status Badge -->
                    <div id="order-status-badge-container-@order.Id">
                        @if (isDelivered)
                        {
                            <span class="status-badge-custom bg-success bg-opacity-25 text-success border border-success border-opacity-50" id="badge-order-@order.Id">
                                <i class="fa-solid fa-circle-check"></i> Delivered
                            </span>
                        }
                        else if (order.OrderStatus == "OutForDelivery")
                        {
                            <span class="status-badge-custom bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50" id="badge-order-@order.Id">
                                <i class="fa-solid fa-motorcycle fa-bounce"></i> Out for Delivery
                            </span>
                        }
                        else if (order.OrderStatus == "Shipped" || order.OrderStatus == "Dispatched")
                        {
                            <span class="status-badge-custom bg-primary bg-opacity-25 text-info border border-info border-opacity-50" id="badge-order-@order.Id">
                                <i class="fa-solid fa-truck-fast"></i> @order.OrderStatus
                            </span>
                        }
                        else if (order.OrderStatus == "Packed")
                        {
                            <span class="status-badge-custom bg-info bg-opacity-25 text-info border border-info border-opacity-50" id="badge-order-@order.Id">
                                <i class="fa-solid fa-box"></i> Packed
                            </span>
                        }
                        else if (order.OrderStatus == "Processing")
                        {
                            <span class="status-badge-custom border border-purple border-opacity-50" id="badge-order-@order.Id" style="background: rgba(168,85,247,0.2); color: #c084fc; border-color: rgba(168,85,247,0.4);">
                                <i class="fa-solid fa-gears fa-spin"></i> Processing
                            </span>
                        }
                        else if (order.OrderStatus == "Accepted")
                        {
                            <span class="status-badge-custom bg-success bg-opacity-25 text-success border border-success border-opacity-50" id="badge-order-@order.Id">
                                <i class="fa-solid fa-circle-check"></i> Accepted
                            </span>
                        }
                        else if (order.OrderStatus == "ReturnRequested")
                        {
                            <span class="status-badge-custom bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50">
                                <i class="fa-solid fa-rotate-left"></i> Return Requested
                            </span>
                        }
                        else if (order.OrderStatus == "ReturnApproved")
                        {
                            <span class="status-badge-custom bg-info bg-opacity-25 text-info border border-info border-opacity-50">
                                <i class="fa-solid fa-thumbs-up"></i> Return Approved
                            </span>
                        }
                        else if (order.OrderStatus == "ProductPickup")
                        {
                            <span class="status-badge-custom bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50">
                                <i class="fa-solid fa-truck-ramp-box fa-bounce"></i> Product Pickup
                            </span>
                        }
                        else if (order.OrderStatus == "ProductReceived")
                        {
                            <span class="status-badge-custom bg-info bg-opacity-25 text-info border border-info border-opacity-50">
                                <i class="fa-solid fa-warehouse"></i> Product Received
                            </span>
                        }
                        else if (order.OrderStatus == "RefundInitiated")
                        {
                            <span class="status-badge-custom bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50">
                                <i class="fa-solid fa-money-bill-transfer fa-fade"></i> Refund Initiated
                            </span>
                        }
                        else if (order.OrderStatus == "RefundCompleted" || order.OrderStatus == "Returned")
                        {
                            <span class="status-badge-custom bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                <i class="fa-solid fa-circle-check"></i> Refund Completed
                            </span>
                        }
                        else if (order.OrderStatus == "Cancelled")
                        {
                            <span class="status-badge-custom bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50">
                                <i class="fa-solid fa-ban"></i> Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="status-badge-custom bg-info bg-opacity-25 text-info border border-info border-opacity-50">
                                <i class="fa-solid fa-clock"></i> @order.OrderStatus
                            </span>
                        }
                    </div>
                </div>

                <!-- Middle Row: Product & Price -->
                <div class="row align-items-center g-3 mb-3">
                    <div class="col-lg-8 col-md-7">
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(primaryImageUrl))
                            {
                                <img src="@primaryImageUrl" alt="@primaryProductName" class="order-prod-thumb" />
                            }
                            else
                            {
                                <div class="order-prod-thumb d-flex align-items-center justify-content-center text-muted">
                                    <i class="fa-solid fa-mobile-screen-button fa-2x text-primary opacity-75"></i>
                                </div>
                            }
                            <div>
                                <h5 class="text-white fw-bold mb-1">
                                    @primaryProductName
                                </h5>
                                @if (extraItemsCount > 0)
                                {
                                    <span class="badge bg-secondary bg-opacity-50 text-light small mb-1">
                                        + @extraItemsCount more item@(extraItemsCount > 1 ? "s" : "")
                                    </span>
                                }
                                <div class="text-muted small">
                                    Qty: @(firstItem?.Quantity ?? 1) &bull; Payment: <strong class="text-light">@order.PaymentMode</strong> (@order.PaymentStatus)
                                </div>
                                <div class="text-muted small mt-1">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i> @order.Remark
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Price Column -->
                    <div class="col-lg-4 col-md-5 text-md-end">
                        <span class="text-muted small d-block">Order Price</span>
                        <div class="fs-4 fw-bold text-white mb-1">
                            &#8377;@order.TotalAmount.ToString("N0")
                        </div>
                        <span class="text-muted small">
                            @(order.PaymentStatus == "Paid" ? "Online Payment (Paid)" : "Cash on Delivery")
                        </span>
                    </div>
                </div>

                <!-- Point 41: Customer Delivery OTP Banner -->
                @if (!isDelivered && order.OrderStatus != "Cancelled" && order.OrderStatus != "RefundCompleted")
                {
                    <div class="mb-3 p-3 rounded-4 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: rgba(99, 102, 241, 0.09); border: 1px dashed rgba(99, 102, 241, 0.45);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-25 p-2 text-primary d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; min-width: 42px;">
                                <i class="fa-solid fa-key fs-5"></i>
                            </div>
                            <div>
                                <div class="text-white small fw-bold">
                                    Your Delivery OTP: 
                                    <span class="badge bg-warning text-dark fs-6 font-monospace px-3 py-1 ms-1 shadow-sm">
                                        @(string.IsNullOrEmpty(order.DeliveryOtp) ? "5824" : order.DeliveryOtp)
                                    </span>
                                </div>
                                <small class="text-muted" style="font-size: 0.78rem;">Rider ko parcel deliver hone ke baad hi ye OTP share karein.</small>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill small">
                            <i class="fa-solid fa-shield-halved me-1"></i> OTP Handover Protected
                        </span>
                    </div>
                }
                else if (isDelivered)
                {
                    <div class="mb-3 p-2 px-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25);">
                        <span class="text-success small fw-semibold">
                            <i class="fa-solid fa-circle-check text-success me-1"></i> Delivered via OTP Handover Verification 
                            <span class="badge bg-dark text-success border border-success border-opacity-25 ms-1 font-monospace">
                                @(string.IsNullOrEmpty(order.DeliveryOtp) ? "Verified" : "OTP: " + order.DeliveryOtp) ✓
                            </span>
                        </span>
                        @if (order.DeliveredDate.HasValue)
                        {
                            <small class="text-muted"><i class="fa-solid fa-clock me-1"></i> Delivered on @order.DeliveredDate.Value.ToString("dd MMM yyyy, hh:mm tt")</small>
                        }
                    </div>
                }

                <!-- Bottom Row: Exact Action Buttons requested: -->
                <!-- [View Details]   [Need Help]   [Buy Again]   [Return] -->
                <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top border-secondary border-opacity-50 flex-wrap">
                    <!-- 1. [View Details] -->
                    <a asp-controller="Home" asp-action="OrderSuccess" asp-route-orderId="@order.Id" class="btn btn-outline-info btn-action-pill">
                        <i class="fa-solid fa-eye me-1"></i> View Details
                    </a>

                    <!-- Point 43: [Need Help] -->
                    <button type="button" class="btn btn-outline-danger btn-action-pill" onclick="openNeedHelpModal(@order.Id, '#ORD@order.Id', '@primaryProductName.Replace("'", "\\'")')">
                        <i class="fa-solid fa-headset me-1"></i> Need Help
                    </button>

                    <!-- 2. [Buy Again] (Delivered order me click karne par product cart me add ho jaye) -->
                    @{
                        var orderItemsJson = System.Text.Json.JsonSerializer.Serialize(order.OrderItems.Select(oi => new {
                            productId = oi.ProductId,
                            productName = oi.Product?.ProductName ?? primaryProductName,
                            price = oi.UnitPrice,
                            quantity = oi.Quantity,
                            imageUrl = oi.Product?.ImageUrl ?? primaryImageUrl
                        }));
                    }
                    <button type="button" class="btn btn-primary btn-action-pill" id="buyAgainBtn_@order.Id" onclick='handleBuyAgain(@order.Id, @order.ShopId, "@(order.ShopName?.Replace("\"", "\\\"") ?? "Shop")", "@primaryProductName.Replace("\"", "\\\"")", @(firstItem?.UnitPrice ?? order.TotalAmount), @(firstItem?.ProductId ?? 14), "@primaryImageUrl", this, @Html.Raw(orderItemsJson))'>
                        <i class="fa-solid fa-rotate-right me-1"></i> Buy Again
                    </button>

                    <!-- 3. Status-Specific Actions matching Cancel/Return Rules: -->
                    <!-- Placed (Pending)    → Cancel -->
                    <!-- Confirmed (Accepted)→ Cancel -->
                    <!-- Packed (Packed)     → Cancel -->
                    <!-- Shipped (Dispatched/OutForDelivery) → Not allowed -->
                    <!-- Delivered (Delivered/Completed)     → Return -->
                    @if (isDelivered)
                    {
                        <!-- Delivered product: [Return Product] -->
                        <button type="button" class="btn btn-outline-warning btn-action-pill" onclick="openReturnModal(@order.Id, '#ORD@order.Id', '@primaryProductName.Replace("'", "\\'")')">
                            <i class="fa-solid fa-rotate-left me-1"></i> Return Product
                        </button>

                        <button type="button" class="btn btn-outline-light btn-action-pill" onclick="openReviewModal(@order.Id, @order.ShopId, @(firstItem?.ProductId ?? 0), '@(order.ShopName?.Replace("'", "\\'") ?? "Shop")')">
                            <i class="fa-solid fa-star text-warning me-1"></i> Rate & Review
                        </button>
                    }
                    else if (order.OrderStatus == "Pending" || order.OrderStatus == "Accepted" || order.OrderStatus == "Packed")
                    {
                        <!-- Placed, Confirmed, Packed → Cancel allowed -->
                        <button type="button" class="btn btn-outline-danger btn-action-pill" onclick="openCancelModal(@order.Id, '#ORD@order.Id', '@order.OrderStatus')">
                            <i class="fa-solid fa-ban me-1"></i> Cancel Order
                        </button>
                    }
                    else if (order.OrderStatus == "Dispatched" || order.OrderStatus == "OutForDelivery")
                    {
                        <!-- Shipped → Not allowed to Cancel -->
                        <span class="badge bg-secondary bg-opacity-25 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill small" title="Order has been shipped and is with delivery partner. Cancellation is not allowed.">
                            <i class="fa-solid fa-truck-fast me-1"></i> Shipped (Cancellation Locked)
                        </span>

                        <button type="button" class="btn btn-success btn-action-pill ms-1" onclick="confirmOrderReceived(@order.Id)">
                            <i class="fa-solid fa-circle-check me-1"></i> Confirm Received
                        </button>
                    }

                    @if (order.OrderStatus == "ReturnRequested" || order.OrderStatus == "ReturnApproved" || order.OrderStatus == "ProductPickup" || order.OrderStatus == "ProductReceived" || order.OrderStatus == "RefundInitiated" || order.OrderStatus == "RefundCompleted" || order.OrderStatus == "Returned")
                    {
                        <button type="button" class="btn btn-outline-warning btn-action-pill ms-1" onclick="openRefundTrackerModal(@order.Id, '#ORD@order.Id', '@order.OrderStatus', @order.TotalAmount, '@order.PaymentMode', '@(order.ReturnReason?.Replace("'", "\\'") ?? "Customer Return")')">
                            <i class="fa-solid fa-money-bill-wave me-1"></i> Track Refund
                        </button>
                    }

                    @if (order.OrderStatus == "ReturnRequested" && !string.IsNullOrEmpty(order.ReturnReason))
                    {
                        <span class="text-warning small ms-2"><i class="fa-solid fa-info-circle me-1"></i> Return Under Review: @order.ReturnReason</span>
                    }

                    @if (order.OrderStatus == "Cancelled" && !string.IsNullOrEmpty(order.CancelReason))
                    {
                        <span class="text-danger small ms-2"><i class="fa-solid fa-ban me-1"></i> Cancelled: @order.CancelReason</span>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Modal: Return Order -->
<div class="modal fade" id="returnModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary" style="border-radius: 20px;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-warning">
                    <i class="fa-solid fa-rotate-left me-2"></i> Return Order <span id="returnOrderBadge" class="badge bg-secondary"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="returnOrderId" />
                <div class="mb-3 p-3 bg-black bg-opacity-25 rounded-3 border border-secondary">
                    <span class="text-muted small d-block">Returning Item:</span>
                    <strong class="text-white fs-6" id="returnProductName">Product</strong>
                </div>

                <label class="form-label small fw-semibold">Select Return Reason *</label>
                <select id="returnReasonSelect" class="form-select bg-dark text-white border-secondary mb-3">
                    <option value="Damaged">Damaged</option>
                    <option value="Wrong Product">Wrong Product</option>
                    <option value="Defective">Defective</option>
                    <option value="Missing Item">Missing Item</option>
                    <option value="Not as Described">Not as Described</option>
                </select>

                <label class="form-label small fw-semibold">Additional Comments (Optional):</label>
                <textarea id="returnReasonText" class="form-control bg-dark text-white border-secondary" placeholder="Provide any details to help our support team process your return faster..." rows="3"></textarea>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold" onclick="submitReturnOrder()">
                    <i class="fa-solid fa-check me-1"></i> Submit Return
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Cancel Order with 5 Exact Reasons -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary" style="border-radius: 20px;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-danger">
