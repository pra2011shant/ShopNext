<script>
    let currentRefundModalOrderId = null;
    let refundModalInstance = null;

    function openRefundTrackerModal(orderId, orderPill, status, amount, method, reason) {
        currentRefundModalOrderId = orderId;
        document.getElementById("refundModalOrderPill").innerText = orderPill;
        document.getElementById("refundModalAmount").innerText = "₹" + Number(amount).toLocaleString('en-IN');
        document.getElementById("refundModalMethod").innerText = method || "UPI / Source Account";
        document.getElementById("refundModalReason").innerText = reason || "Customer Return";

        updateModalStepperUI(status);

        if (!refundModalInstance) {
            refundModalInstance = new bootstrap.Modal(document.getElementById('refundTrackerModal'));
        }
        refundModalInstance.show();
    }

    function updateModalStepperUI(status) {
        let stage = 0;
        if (status === "ReturnRequested") stage = 0;
        else if (status === "ReturnApproved") stage = 1;
        else if (status === "ProductPickup") stage = 2;
        else if (status === "ProductReceived") stage = 3;
        else if (status === "RefundInitiated") stage = 4;
        else if (status === "RefundCompleted" || status === "Returned") stage = 5;

        for (let i = 1; i <= 5; i++) {
            const stepEl = document.getElementById("refModalStep" + i);
            if (!stepEl) continue;
            const iconCircle = stepEl.querySelector(".step-icon-circle");
            const badge = stepEl.querySelector(".step-badge");

            stepEl.classList.remove("completed", "current", "upcoming");

            if (stage > i) {
                stepEl.classList.add("completed");
                iconCircle.innerHTML = '<i class="fa-solid fa-check"></i>';
                if (badge) {
                    badge.className = "badge bg-success bg-opacity-25 text-success small py-0 px-2 fw-semibold step-badge";
                    badge.innerText = "✓ Done";
                }
            } else if (stage === i) {
                stepEl.classList.add("current");
                iconCircle.innerHTML = '<i class="fa-solid fa-circle-dot"></i>';
                if (badge) {
                    badge.className = "badge bg-warning bg-opacity-25 text-warning small py-0 px-2 fw-semibold step-badge animate__animated animate__pulse animate__infinite";
                    badge.innerText = "● In Progress";
                }
            } else {
                stepEl.classList.add("upcoming");
                iconCircle.innerHTML = '<i class="fa-regular fa-circle"></i>';
                if (badge) {
                    badge.className = "badge small py-0 px-2 fw-semibold step-badge d-none";
                    badge.innerText = "";
                }
            }
        }
    }

    async function advanceModalRefund(nextStatus) {
        if (!currentRefundModalOrderId) return;
        const form = new FormData();
        form.append("orderId", currentRefundModalOrderId);
        form.append("nextStatus", nextStatus);

        try {
            const resp = await fetch('/Customer/UpdateRefundStatus', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                body: form
            });
            const data = await resp.json();
            if (data.success) {
                updateModalStepperUI(nextStatus);
                setTimeout(() => window.location.reload(), 900);
            } else {
                alert(data.message || "Failed to update refund stage.");
            }
        } catch (e) {
            alert("Error: " + e.message);
        }
    }
    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    // ==========================================
    // 1. BUY AGAIN (Reorder to Cart)
    // ==========================================
    function handleBuyAgain(orderId, shopId, shopName, productName, price, productId, imageUrl, btnElement, itemsJson) {
        let cart = JSON.parse(localStorage.getItem("shop_cart")) || { shopId: null, shopName: null, items: [] };

        if (cart.shopId && cart.shopId !== shopId && cart.items.length > 0) {
            const ok = confirm(`Your cart already contains items from "${cart.shopName}". Clear cart to add from "${shopName}"?`);
            if (!ok) return;
            cart = { shopId: shopId, shopName: shopName, items: [] };
        }

        cart.shopId = shopId;
        cart.shopName = shopName;

        let addedNames = [];

        if (itemsJson && Array.isArray(itemsJson) && itemsJson.length > 0) {
            itemsJson.forEach(item => {
                const existing = cart.items.find(i => i.productId === item.productId);
                if (existing) {
                    existing.quantity += (item.quantity || 1);
                } else {
                    cart.items.push({
                        productId: item.productId,
                        productName: item.productName,
                        price: item.price,
                        quantity: item.quantity || 1,
                        imageUrl: item.imageUrl || ''
                    });
                }
                addedNames.push(item.productName);
            });
        } else {
            const existing = cart.items.find(i => i.productId === productId);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.items.push({
                    productId: productId,
                    productName: productName,
                    price: price,
                    quantity: 1,
                    imageUrl: imageUrl || ''
                });
            }
            addedNames.push(productName);
        }

        localStorage.setItem("shop_cart", JSON.stringify(cart));

        // Sync layout header badge
        let totalQty = 0;
        cart.items.forEach(i => totalQty += i.quantity);
        if (window.updateLayoutCartBadge) {
            window.updateLayoutCartBadge(totalQty);
        }

        // Button tactile feedback
        if (btnElement) {
            const originalHtml = btnElement.innerHTML;
            btnElement.classList.remove('btn-primary');
            btnElement.classList.add('btn-success');
            btnElement.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Added to Cart!';
            btnElement.disabled = true;

            setTimeout(() => {
                btnElement.classList.remove('btn-success');
                btnElement.classList.add('btn-primary');
                btnElement.innerHTML = originalHtml;
                btnElement.disabled = false;
            }, 2500);
        }

        // Show toast
        showBuyAgainToast(addedNames[0] || productName, `#ORD${orderId}`);
    }

    function showBuyAgainToast(productName, orderIdText) {
        const toast = document.getElementById("buyAgainToast");
        document.getElementById("toastTitle").innerText = `Added ${productName} to Cart!`;
        document.getElementById("toastMsg").innerText = `Reordered from ${orderIdText}. Ready to checkout.`;
        toast.style.display = "block";

        setTimeout(() => {
            hideToast();
        }, 5000);
    }

    function hideToast() {
        const toast = document.getElementById("buyAgainToast");
        if (toast) toast.style.display = "none";
    }

    // ==========================================
    // 2. RETURN ORDER
    // ==========================================
    function openReturnModal(orderId, orderBadge, productName) {
        document.getElementById("returnOrderId").value = orderId;
        document.getElementById("returnOrderBadge").innerText = orderBadge;
        document.getElementById("returnProductName").innerText = productName;
        new bootstrap.Modal(document.getElementById('returnModal')).show();
    }

    async function submitReturnOrder() {
        const orderId = document.getElementById("returnOrderId").value;
        const sel = document.getElementById("returnReasonSelect").value;
        const comments = document.getElementById("returnReasonText").value.trim();
        const reason = comments ? `${sel} - ${comments}` : sel;

        const form = new FormData();
        form.append("orderId", orderId);
        form.append("returnReason", reason);

        try {
            const resp = await fetch('/Customer/ReturnOrder', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                body: form
            });
            const data = await resp.json();
            alert(data.message);
            if (data.success) location.reload();
        } catch (e) {
            alert("Error: " + e.message);
        }
    }

    // ==========================================
    // 3. CANCEL ORDER
    // ==========================================
    function openCancelModal(orderId, orderBadge) {
        document.getElementById("cancelOrderId").value = orderId;
        document.getElementById("cancelOrderBadge").innerText = orderBadge;
        new bootstrap.Modal(document.getElementById('cancelModal')).show();
    }

    async function submitCancelOrder() {
        const orderId = document.getElementById("cancelOrderId").value;
        const sel = document.getElementById("cancelReasonSelect").value;
        const comments = document.getElementById("cancelReasonText").value.trim();
        const reason = comments ? `${sel} - ${comments}` : sel;

        const form = new FormData();
        form.append("orderId", orderId);
        form.append("cancelReason", reason);

        try {
            const resp = await fetch('/Customer/CancelOrder', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                body: form
            });
            const data = await resp.json();
            alert(data.message);
            if (data.success) location.reload();
        } catch (e) {
            alert("Error: " + e.message);
        }
    }

    // ==========================================
    // 4. CONFIRM RECEIVED
    // ==========================================
    async function confirmOrderReceived(orderId) {
        if (!confirm("Confirm that you have received this order?")) return;
        const form = new FormData();
        form.append("orderId", orderId);

        try {
            const resp = await fetch('/Customer/ConfirmReceived', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                body: form
            });
            const data = await resp.json();
            alert(data.message);
            if (data.success) location.reload();
        } catch (e) {
            alert("Error: " + e.message);
        }
    }

    // ==========================================
    // 5. REVIEW & RATING
    // ==========================================
    function openReviewModal(orderId, shopId, productId, shopName) {
        document.getElementById("revOrderId").value = orderId;
        document.getElementById("revShopId").value = shopId;
        document.getElementById("revProductId").value = productId || '';
        document.getElementById("revShopName").innerText = shopName;
        new bootstrap.Modal(document.getElementById('reviewModal')).show();
    }

    document.querySelectorAll('.star-btn').forEach(star => {
        star.addEventListener('click', function() {
            const val = parseInt(this.getAttribute('data-val'));
            document.getElementById("revRatingVal").value = val;
            document.querySelectorAll('.star-btn').forEach(s => {
                const sVal = parseInt(s.getAttribute('data-val'));
                if (sVal <= val) {
                    s.classList.remove('fa-regular');
                    s.classList.add('fa-solid');
                } else {
                    s.classList.remove('fa-solid');
                    s.classList.add('fa-regular');
                }
            });
        });
    });

    async function submitReview() {
        const form = new FormData();
        form.append("orderId", document.getElementById("revOrderId").value);
        form.append("shopId", document.getElementById("revShopId").value);
        const prodId = document.getElementById("revProductId").value;
        if (prodId) form.append("productId", prodId);
        form.append("rating", document.getElementById("revRatingVal").value);
        form.append("comment", document.getElementById("revComment").value.trim());

        try {
            const resp = await fetch('/Customer/SubmitReview', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                body: form
            });
            const data = await resp.json();
            alert(data.message);
            if (data.success) location.reload();
        } catch (e) {
            alert("Error: " + e.message);
        }
    }

    // ==========================================
    // 25. AUTOMATIC ORDER STATUS SYNC FOR CUSTOMER
    // ==========================================
    const activeOrderIds = [
        @foreach (var o in Model.Where(x => x.OrderStatus != "Completed" && x.OrderStatus != "Delivered" && x.OrderStatus != "Cancelled" && x.OrderStatus != "RefundCompleted"))
        {
            <text>@o.Id, </text>
        }
    ];

    function pollActiveOrdersStatus() {
        if (!activeOrderIds || activeOrderIds.length === 0) return;

        activeOrderIds.forEach(orderId => {
            $.ajax({
                url: '/Home/GetOrderRiderLocation',
                type: 'GET',
                data: { orderId: orderId },
                success: function (res) {
                    if (res.success && res.orderStatus) {
                        const container = document.getElementById("order-status-badge-container-" + orderId);
                        if (!container) return;

                        let badgeHtml = '';
                        const st = res.orderStatus;
                        if (st === "Accepted") {
                            badgeHtml = '<span class="status-badge-custom bg-success bg-opacity-25 text-success border border-success border-opacity-50"><i class="fa-solid fa-circle-check"></i> Accepted</span>';
                        } else if (st === "Processing") {
                            badgeHtml = '<span class="status-badge-custom border border-purple border-opacity-50" style="background: rgba(168,85,247,0.2); color: #c084fc; border-color: rgba(168,85,247,0.4);"><i class="fa-solid fa-gears fa-spin"></i> Processing</span>';
                        } else if (st === "Packed") {
                            badgeHtml = '<span class="status-badge-custom bg-info bg-opacity-25 text-info border border-info border-opacity-50"><i class="fa-solid fa-box"></i> Packed</span>';
                        } else if (st === "Shipped" || st === "Dispatched") {
                            badgeHtml = `<span class="status-badge-custom bg-primary bg-opacity-25 text-info border border-info border-opacity-50"><i class="fa-solid fa-truck-fast"></i> ${st}</span>`;
                        } else if (st === "OutForDelivery") {
                            badgeHtml = '<span class="status-badge-custom bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50"><i class="fa-solid fa-motorcycle fa-bounce"></i> Out for Delivery</span>';
                        } else if (st === "Completed" || st === "Delivered") {
                            badgeHtml = '<span class="status-badge-custom bg-success bg-opacity-25 text-success border border-success border-opacity-50"><i class="fa-solid fa-circle-check"></i> Delivered</span>';
                        }

                        if (badgeHtml && container.innerHTML.trim() !== badgeHtml.trim()) {
                            container.innerHTML = badgeHtml;
                        }
                    }
                }
            });
        });
    }

    if (activeOrderIds.length > 0) {
        setInterval(pollActiveOrdersStatus, 4000);
    }

    // ==========================================
    // POINT 44: NEED HELP / CUSTOMER COMPLAINT AGAINST RIDER
    // ==========================================
    let lastCreatedTicketId = 0;
    let lastCreatedOrderId = 0;

    function openNeedHelpModal(orderId, orderPill, productName) {
        lastCreatedOrderId = orderId;
        document.getElementById("helpOrderId").value = orderId;
        document.getElementById("helpOrderPill").innerText = orderPill;
        document.getElementById("helpProductName").innerText = productName || "Order Items";
        const firstRadio = document.querySelector('input[name="custDeliveryIssue"][value="Wrong Product"]') || document.querySelector('input[name="custDeliveryIssue"]');
        if (firstRadio) firstRadio.checked = true;
        document.getElementById("helpDescription").value = "";
        document.getElementById("helpAttachmentUrl").value = "";

        new bootstrap.Modal(document.getElementById('needHelpModal')).show();
    }

    function submitNeedHelpComplaint() {
        const orderId = document.getElementById("helpOrderId").value;
        lastCreatedOrderId = orderId;
        const selectedRadio = document.querySelector('input[name="custDeliveryIssue"]:checked');
        const issue = selectedRadio ? selectedRadio.value : "Delivery Issue";
        const desc = document.getElementById("helpDescription").value.trim();
        const attachment = document.getElementById("helpAttachmentUrl").value.trim();

        if (!issue) {
            alert("Please select a delivery issue category.");
            return;
        }

        if (!desc) {
            alert("Please provide your statement / description of the issue.");
            return;
        }

        const btn = document.getElementById("btnSubmitComplaint");
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Logging ticket...';

        $.ajax({
            url: '/Customer/RaiseComplaint',
            type: 'POST',
            data: {
                orderId: orderId,
                issue: issue,
                reasonCategory: issue,
                description: desc,
                attachmentUrl: attachment
            },
            success: function (res) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1.5"></i> Submit Complaint';

                bootstrap.Modal.getInstance(document.getElementById('needHelpModal'))?.hide();

                if (res.success) {
                    lastCreatedTicketId = res.ticketId;
                    document.getElementById("confirmTicketNumber").innerText = res.ticketNumber || `T${res.ticketId}`;
                    new bootstrap.Modal(document.getElementById('complaintConfirmationModal')).show();
                } else {
                    alert(res.message || "Failed to submit complaint.");
                }
            },
            error: function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1.5"></i> Submit Complaint';
                alert("Connection error while submitting complaint. Please try again.");
            }
        });
    }

    function viewCreatedTicket() {
        bootstrap.Modal.getInstance(document.getElementById('complaintConfirmationModal'))?.hide();
        openCustomerSupportTicketModal(lastCreatedOrderId, lastCreatedTicketId);
    }

    // Point 78: Customer Support Ticket Modal & Two-Way Conversation Desk
    function openCustomerSupportTicketModal(orderId, ticketId) {
        document.getElementById("suppTicketLoader").style.display = "block";
        document.getElementById("suppTicketMessageContainer").style.display = "none";
        document.getElementById("suppTicketReplyInput").value = "";

        const modal = new bootstrap.Modal(document.getElementById('customerSupportTicketModal'));
        modal.show();

        $.ajax({
            url: '/Customer/GetTicketThreadDetails',
            type: 'GET',
            data: { orderId: orderId, ticketId: ticketId },
            success: function(res) {
                document.getElementById("suppTicketLoader").style.display = "none";
                if (res.success) {
                    document.getElementById("suppTicketMessageContainer").style.display = "flex";
                    document.getElementById("suppCurrentTicketId").value = res.ticketId;
                    document.getElementById("suppTicketNumberTitle").innerText = `Ticket #${res.ticketNumber}`;
                    document.getElementById("suppTicketOrderTitle").innerText = `Order #${res.orderNumber}`;
                    document.getElementById("suppTicketIssueTitle").innerText = `Issue: ${res.issue}`;
                    document.getElementById("suppTicketCreatedDate").innerText = res.createdDate;

                    const badge = document.getElementById("suppTicketStatusBadge");
                    badge.innerText = `Status: ${res.status}`;
                    if (res.status === 'Open') {
                        badge.className = "badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-0.5 rounded-pill font-monospace small";
                    } else if (res.status === 'Resolved' || res.status === 'Closed') {
                        badge.className = "badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-0.5 rounded-pill font-monospace small";
                    } else {
                        badge.className = "badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-0.5 rounded-pill font-monospace small";
                    }

                    renderTicketThreadMessages(res.messages || []);
                } else {
                    alert(res.message || "Failed to load support ticket.");
                    modal.hide();
                }
            },
            error: function() {
                document.getElementById("suppTicketLoader").style.display = "none";
                alert("Connection error fetching ticket thread.");
                modal.hide();
            }
        });
    }

    function renderTicketThreadMessages(messages) {
        const container = document.getElementById("suppTicketMessageContainer");
        container.innerHTML = "";

        if (!messages || messages.length === 0) {
            container.innerHTML = '<div class="text-secondary text-center py-3 small">No conversation messages logged yet.</div>';
            return;
        }

        messages.forEach(m => {
            const isAdmin = m.senderRole === "Admin" || m.senderRole === "Support" || m.senderRole === "SupportAgent";
            const bubble = document.createElement("div");
            bubble.className = `d-flex gap-2.5 align-items-start ${isAdmin ? 'ps-3' : 'pe-3'}`;
            
            if (isAdmin) {
                bubble.innerHTML = `
                    <div class="rounded-circle bg-success bg-opacity-20 text-success p-2 d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <div class="p-3 rounded-4 bg-black bg-opacity-40 border border-success border-opacity-40 flex-grow-1 shadow-sm" style="border-left: 3px solid #22c55e;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-1.5">
                                <strong class="text-success small">${m.senderName || 'Admin Reply'}</strong>
                                <span class="badge bg-success bg-opacity-20 text-success px-1.5 py-0.2 rounded-pill" style="font-size: 10px;"><i class="fa-solid fa-circle-check me-0.5"></i> Support Desk</span>
                            </div>
                            <small class="text-secondary font-monospace" style="font-size: 11px;">${m.sentAt || ''}</small>
                        </div>
                        <p class="text-light small mb-0" style="white-space: pre-wrap;">${m.message || ''}</p>
                    </div>
                `;
            } else {
                bubble.innerHTML = `
                    <div class="rounded-circle bg-primary bg-opacity-20 text-primary p-2 d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="p-3 rounded-4 bg-black bg-opacity-40 border border-primary border-opacity-40 flex-grow-1 shadow-sm" style="border-left: 3px solid #38bdf8;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-info small">${m.senderName || 'Customer Message'}</strong>
                            <small class="text-secondary font-monospace" style="font-size: 11px;">${m.sentAt || ''}</small>
                        </div>
                        <p class="text-light small mb-0" style="white-space: pre-wrap;">${m.message || ''}</p>
                        ${m.attachmentUrl ? `<div class="mt-2"><a href="${m.attachmentUrl}" target="_blank" class="btn btn-outline-info btn-sm py-0.5 px-2 rounded-pill" style="font-size: 11px;"><i class="fa-solid fa-paperclip me-1"></i> View Attachment</a></div>` : ''}
                    </div>
                `;
            }
            container.appendChild(bubble);
        });

        const chatBody = document.getElementById("suppTicketChatBody");
        setTimeout(() => { chatBody.scrollTop = chatBody.scrollHeight; }, 100);
    }

    function submitTicketReply() {
        const ticketId = document.getElementById("suppCurrentTicketId").value;
        const msg = document.getElementById("suppTicketReplyInput").value.trim();

        if (!msg) {
            alert("Please write your reply message first.");
            return;
        }

        const btn = document.getElementById("btnSubmitTicketReply");
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

        $.ajax({
            url: '/Customer/PostTicketReply',
            type: 'POST',
            data: {
                ticketId: ticketId,
                message: msg
            },
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> <span>Reply</span>';
                if (res.success) {
                    document.getElementById("suppTicketReplyInput").value = "";
                    renderTicketThreadMessages(res.messages || []);
                } else {
                    alert(res.message || "Failed to post reply.");
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> <span>Reply</span>';
                alert("Connection error submitting reply.");
            }
        });
    }

    // Point 63: Rider Return Pickup Issue Functions
    function openReportPickupIssueModal() {
        const orderId = document.getElementById("helpOrderId")?.value || 
                        document.querySelector("#returnModal #returnOrderId")?.value || 
                        window.currentActiveTrackerOrderId || 1001;

        document.getElementById("pickupIssueOrderId").value = orderId;
        document.getElementById("pickupIssueReturnBadge").innerText = "#R" + orderId;

        // Hide refund tracker modal and show pickup issue modal
        bootstrap.Modal.getInstance(document.getElementById('refundTrackerModal'))?.hide();
        new bootstrap.Modal(document.getElementById('reportPickupIssueModal')).show();
    }

    function submitReportPickupIssue() {
        const orderId = document.getElementById("pickupIssueOrderId").value || 1001;
        const selectedRadio = document.querySelector('input[name="pickupReasonOption"]:checked');
        const reason = selectedRadio ? selectedRadio.value : "Rider didn't arrive";
        const notes = document.getElementById("pickupIssueNotes").value.trim();

        const btn = document.getElementById("btnSubmitPickupIssue");
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Submitting...';

        const fullDescription = "Return Pickup Failure Reported: " + reason + (notes ? (" | Notes: " + notes) : "");

        $.ajax({
            url: '/Customer/RaiseComplaint',
            type: 'POST',
            data: {
                orderId: orderId,
                issue: "Rider Issue",
                reasonCategory: "Return Pickup Issue - " + reason,
                description: fullDescription
            },
            success: function (res) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1.5"></i> Submit Pickup Dispute';

                bootstrap.Modal.getInstance(document.getElementById('reportPickupIssueModal'))?.hide();

                if (res.success) {
                    document.getElementById("confirmTicketNumber").innerText = res.ticketNumber || "TKT-PICKUP-DISPUTE";
                    new bootstrap.Modal(document.getElementById('complaintConfirmationModal')).show();
                } else {
                    alert(res.message || "Failed to submit pickup dispute.");
                }
            },
            error: function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1.5"></i> Submit Pickup Dispute';
                alert("Connection error while submitting pickup dispute. Please try again.");
            }
        });
    }
</script>
