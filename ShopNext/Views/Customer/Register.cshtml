@{
    ViewData["Title"] = "Customer Registration - ShopNext";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    .auth-card {
        background: rgba(30, 41, 59, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
        transition: all 0.3s ease;
    }
    .auth-card:hover {
        border-color: rgba(129, 140, 248, 0.4);
        box-shadow: 0 25px 60px rgba(99, 102, 241, 0.2);
    }
    .gradient-text {
        background: linear-gradient(135deg, #818cf8 0%, #c084fc 50%, #f472b6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .input-group-custom {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .input-group-custom:focus-within {
        border-color: #818cf8;
        box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.25);
    }
    .input-group-custom input {
        background: transparent;
        border: none;
        color: #f8fafc;
        padding: 0.75rem 1rem;
    }
    .input-group-custom input:focus {
        background: transparent;
        color: #f8fafc;
        box-shadow: none;
    }
    .input-group-custom .input-group-text {
        background: transparent;
        border: none;
        color: #94a3b8;
    }
    .btn-gradient {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        padding: 0.85rem;
        transition: all 0.3s ease;
    }
    .btn-gradient:hover {
        background: linear-gradient(135deg, #4f46e5 0%, #9333ea 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.4);
        color: white;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(99, 102, 241, 0.15);">
                        <i class="fa-solid fa-user-plus fa-2x text-primary"></i>
                    </div>
                    <h2 class="fw-bold text-white">Create Customer Account</h2>
                    <p class="text-muted small">Join ShopNext for instant hyperlocal shopping & fast delivery</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <form asp-controller="Customer" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label text-light small fw-semibold">Full Name *</label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Rahul Sharma" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light small fw-semibold">Phone Number (10 Digits) *</label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                            <input type="tel" name="phoneNumber" class="form-control" placeholder="e.g. 9876543210" pattern="[6-9][0-9]{9}" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light small fw-semibold">Email Address (Optional)</label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                            <input type="email" name="email" class="form-control" placeholder="name@example.com" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small fw-semibold">Password *</label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input type="password" name="password" id="regPassword" class="form-control" placeholder="Min 6 characters" minlength="6" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-light small fw-semibold">Confirm Password *</label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text"><i class="fa-solid fa-shield-halved"></i></span>
                                <input type="password" name="confirmPassword" id="regConfirmPassword" class="form-control" placeholder="Re-enter password" minlength="6" required />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 mb-3">
                        <i class="fa-solid fa-user-check me-2"></i> Register & Start Shopping
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Already have an account?</span>
                        <a asp-controller="Customer" asp-action="Login" class="text-primary text-decoration-none fw-semibold ms-1">Login here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
