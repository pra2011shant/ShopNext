@{
    ViewData["Title"] = "Customer Login - ShopNext";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    .auth-card {
        background: rgba(30, 41, 59, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
        transition: all 0.3s ease;
    }
    .auth-card:hover {
        border-color: rgba(129, 140, 248, 0.4);
        box-shadow: 0 25px 60px rgba(99, 102, 241, 0.2);
    }
    .input-group-custom {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .input-group-custom:focus-within {
        border-color: #818cf8;
        box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.25);
    }
    .input-group-custom input {
        background: transparent;
        border: none;
        color: #f8fafc;
        padding: 0.75rem 1rem;
    }
    .input-group-custom input:focus {
        background: transparent;
        color: #f8fafc;
        box-shadow: none;
    }
    .input-group-custom .input-group-text {
        background: transparent;
        border: none;
        color: #94a3b8;
    }
    .btn-gradient {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        padding: 0.85rem;
        transition: all 0.3s ease;
    }
    .btn-gradient:hover {
        background: linear-gradient(135deg, #4f46e5 0%, #9333ea 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.4);
        color: white;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(99, 102, 241, 0.15);">
                        <i class="fa-solid fa-right-to-bracket fa-2x text-primary"></i>
                    </div>
                    <h2 class="fw-bold text-white">Customer Login</h2>
                    <p class="text-muted small">Welcome back! Access your cart, orders & addresses</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <form asp-controller="Customer" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="mb-3">
                        <label class="form-label text-light small fw-semibold">Phone Number or Email</label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                            <input type="text" name="loginIdentifier" class="form-control" placeholder="e.g. 9999988888 or rahul@example.com" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light small fw-semibold">Password</label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" name="password" id="loginPassword" class="form-control" placeholder="Enter password" required />
                            <button class="btn btn-link text-muted pe-3" type="button" onclick="togglePasswordVisibility()">
                                <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 mb-3">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Login to ShopNext
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">New to ShopNext?</span>
                        <a asp-controller="Customer" asp-action="Register" class="text-primary text-decoration-none fw-semibold ms-1">Create an account</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility() {
        const pass = document.getElementById('loginPassword');
        const icon = document.getElementById('togglePasswordIcon');
        if (pass.type === 'password') {
            pass.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            pass.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>
