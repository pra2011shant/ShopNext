@model ShopNext.Models.Order
@{
    Layout = null;
    var tax = ViewBag.TaxBreakdown as ShopNext.Models.TaxBreakdownDto ?? new ShopNext.Models.TaxBreakdownDto();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tax Invoice - #ORD@Model.Id - ShopNext</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 13px;
        }
        .invoice-card {
            max-width: 850px;
            margin: 30px auto;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 35px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }
        .invoice-header-logo {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
        }
        .invoice-header-logo span {
            color: #f59e0b;
        }
        .table-invoice th {
            background-color: #f1f5f9;
            color: #475569;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        @@media print {
            body { background: #fff; }
            .invoice-card { border: none; box-shadow: none; margin: 0; padding: 0; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Print / Action Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3 no-print max-w-850 mx-auto" style="max-width: 850px; margin-top: 20px;">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Orders
            </a>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-dark btn-sm rounded-pill px-4 shadow-sm">
                    <i class="fa-solid fa-print me-1.5"></i> Print / Download PDF
                </button>
            </div>
        </div>

        <!-- Printable Invoice Sheet -->
        <div class="invoice-card">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
                <div>
                    <div class="invoice-header-logo mb-1">Shop<span>Next</span></div>
                    <div class="text-secondary small">India's Premier Multi-Vendor Hyperlocal Network</div>
                    <div class="text-secondary small">GSTIN: <strong>10AAAAA0000A1Z5</strong> &bull; CIN: U72900BR2026PTC012345</div>
                </div>
                <div class="text-end">
                    <div class="badge bg-dark text-white px-3 py-1.5 rounded-pill fs-6 mb-2">ORIGINAL TAX INVOICE</div>
                    <div class="fw-bold fs-5 text-dark font-monospace">#ORD@Model.Id</div>
                    <div class="text-secondary small">Invoice Date: @Model.CreatedDate.ToString("dd MMM yyyy")</div>
                    <div class="text-secondary small">Place of Supply: Bihar (10)</div>
                </div>
            </div>

            <!-- Seller & Buyer Columns -->
            <div class="row g-4 mb-4 pb-3 border-bottom">
                <div class="col-6">
                    <h6 class="fw-bold text-uppercase small text-secondary mb-2">Sold By (Merchant):</h6>
                    <div class="fw-bold fs-6">@(Model.Shop?.ShopName ?? "Verified Partner Store")</div>
                    <div class="text-secondary small">Owner: @(Model.Shop?.OwnerName ?? "Merchant")</div>
                    <div class="text-secondary small">@(Model.Shop?.Address ?? "Boring Road, Patna, Bihar")</div>
                    <div class="text-secondary small">GSTIN: <strong>@(tax.ShopGstin)</strong></div>
                </div>
                <div class="col-6 text-end">
                    <h6 class="fw-bold text-uppercase small text-secondary mb-2">Billed &amp; Shipped To:</h6>
                    <div class="fw-bold fs-6">@(Model.Customer?.Name ?? "Customer")</div>
                    <div class="text-secondary small">Phone: @(Model.Customer?.PhoneNumber ?? "N/A")</div>
                    <div class="text-secondary small">Email: @(Model.Customer?.Email ?? "N/A")</div>
                    <div class="text-secondary small">Delivery: Patna, Bihar - 800001</div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-invoice align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 45%;">Item Description</th>
                            <th style="width: 15%; text-align: center;">HSN Code</th>
                            <th style="width: 10%; text-align: center;">Qty</th>
                            <th style="width: 12%; text-align: right;">Unit Price</th>
                            <th style="width: 13%; text-align: right;">Total (INR)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderItems != null && Model.OrderItems.Any())
                        {
                            int idx = 1;
                            foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td class="text-center font-monospace">@(idx++)</td>
                                    <td>
                                        <div class="fw-bold">@(item.Product?.ProductName ?? "Item")</div>
                                        <small class="text-secondary">Category: @(item.Product?.Category ?? "General")</small>
                                    </td>
                                    <td class="text-center font-monospace text-secondary">@tax.HsnCode</td>
                                    <td class="text-center font-monospace">@item.Quantity</td>
                                    <td class="text-end font-monospace">₹@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-end font-monospace fw-bold">₹@item.TotalPrice.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-center font-monospace">1</td>
                                <td>
                                    <div class="fw-bold">Order Items Package</div>
                                    <small class="text-secondary">Standard Retail Fulfillment</small>
                                </td>
                                <td class="text-center font-monospace text-secondary">@tax.HsnCode</td>
                                <td class="text-center font-monospace">1</td>
                                <td class="text-end font-monospace">₹@Model.TotalAmount.ToString("N2")</td>
                                <td class="text-end font-monospace fw-bold">₹@Model.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Calculation & Tax Summary -->
            <div class="row g-4 mb-4">
                <div class="col-6">
                    <div class="p-3 rounded-3 bg-light border">
                        <h6 class="fw-bold small text-secondary text-uppercase mb-2">Payment &amp; Logistics Details</h6>
                        <div class="small mb-1"><strong>Payment Mode:</strong> @(Model.PaymentMode ?? "Online Prepaid")</div>
                        <div class="small mb-1"><strong>Payment Status:</strong> <span class="badge bg-success">@(Model.PaymentStatus ?? "Paid")</span></div>
                        <div class="small mb-1"><strong>Transaction ID:</strong> <span class="font-monospace">TXN-@(Model.Id.ToString().PadLeft(8, '0'))</span></div>
                        <div class="small"><strong>Order Status:</strong> @Model.OrderStatus</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary">Taxable Subtotal:</td>
                                    <td class="text-end font-monospace fw-semibold">₹@tax.SubTotal.ToString("N2")</td>
                                </tr>
                                @if (tax.IsInterstate)
                                {
                                    <tr>
                                        <td class="text-secondary">Integrated GST (IGST @@ @tax.GstRatePercent%):</td>
                                        <td class="text-end font-monospace">₹@tax.IgstAmount.ToString("N2")</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td class="text-secondary">Central GST (CGST @@ @(tax.GstRatePercent / 2)%):</td>
                                        <td class="text-end font-monospace">₹@tax.CgstAmount.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary">State GST (SGST @@ @(tax.GstRatePercent / 2)%):</td>
                                        <td class="text-end font-monospace">₹@tax.SgstAmount.ToString("N2")</td>
                                    </tr>
                                }
                                <tr class="border-top">
                                    <td class="fw-bold fs-6">Grand Total:</td>
                                    <td class="text-end font-monospace fw-bold fs-5 text-dark">₹@Model.TotalAmount.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Footer & Signatures -->
            <div class="border-top pt-3 text-secondary small d-flex justify-content-between align-items-center">
                <div>
                    <div>This is a computer-generated tax invoice and requires no physical signature.</div>
                    <div>Authorized by ShopNext Hyperlocal E-Commerce Platform.</div>
                </div>
                <div class="text-end font-monospace" style="font-size: 11px;">
                    DIGITAL-HASH-VERIFIED-2026
                </div>
            </div>
        </div>
    </div>
</body>
</html>
