@* Views/Home/ShopCatalog.cshtml *@
@model IEnumerable<ShopNext.Models.Product>
@{
    var shop = ViewBag.Shop as ShopNext.Models.Shop;
    ViewData["Title"] = $"{shop?.ShopName} Catalog - ShopNext";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        --card-bg: rgba(30, 41, 59, 0.75);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-muted: #64748b;
        --text-light: #1e293b;
        --success-color: #10b981;
        --danger-color: #ef4444;
    }

    body {
        background: transparent;
        color: var(--text-light);
        font-family: 'Outfit', sans-serif;
    }

    .catalog-container {
        padding: 2rem 0;
        animation: fadeIn 0.6s ease-out;
        position: relative;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .shop-header-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 2rem;
        margin-bottom: 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .shop-info-title {
        font-weight: 800;
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
        color: white;
    }

    .shop-info-cat {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid rgba(99, 102, 241, 0.3);
        display: inline-block;
    }

    .shop-info-contact {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-back-home {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-muted);
        border: 1px solid var(--glass-border);
        padding: 0.6rem 1.25rem;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-back-home:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    /* Product Grid */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 5rem;
    }

    .product-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .product-card:hover {
        transform: translateY(-5px);
        border-color: rgba(99, 102, 241, 0.3);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
    }

    .product-image-container {
        height: 180px;
        overflow: hidden;
        background: #0f172a;
        position: relative;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.05);
    }

    .stock-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 0.3rem 0.6rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(239, 68, 68, 0.4);
        background: rgba(239, 68, 68, 0.25);
        color: #f87171;
    }

    .product-details {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 0.5rem;
    }

    .product-name {
        font-weight: 600;
        font-size: 1.1rem;
        color: white;
        margin: 0;
    }

    .product-price {
        font-size: 1.25rem;
        font-weight: 800;
        color: #a5b4fc;
    }

    .btn-add-cart {
        background: var(--primary-gradient);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.6rem;
        width: 100%;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: auto;
    }

    .btn-add-cart:hover {
        box-shadow: 0 6px 15px rgba(168, 85, 247, 0.35);
        transform: translateY(-1px);
    }

    .btn-add-cart:disabled {
        background: rgba(255, 255, 255, 0.05) !important;
        color: var(--text-muted) !important;
        border: 1px solid var(--glass-border) !important;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
    }

    /* Floating Cart Summary Bar */
    .floating-cart-bar {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%) translateY(150px);
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(168, 85, 247, 0.35);
        border-radius: 20px;
        padding: 0.85rem 1.5rem;
        width: 90%;
        max-width: 600px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.1);
        z-index: 1000;
    }

    .floating-cart-bar.show {
        transform: translateX(-50%) translateY(0);
    }

    .cart-summary-text {
        font-weight: 500;
        font-size: 1.05rem;
    }

    .cart-summary-text span {
        font-weight: 800;
        color: #a5b4fc;
    }

    .btn-view-cart {
        background: var(--primary-gradient);
        color: white;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.5rem 1.25rem;
        border-radius: 10px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-view-cart:hover {
        box-shadow: 0 5px 15px rgba(168, 85, 247, 0.4);
        transform: translateY(-2px);
    }

    .empty-catalog {
        text-align: center;
        padding: 5rem 2rem;
        background: var(--card-bg);
        border: 1px dashed var(--glass-border);
        border-radius: 24px;
        grid-column: 1 / -1;
    }

    /* Modal for clearing cart */
    .modal-content-glass {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        color: var(--text-light);
    }
</style>

<div class="container catalog-container">
    <!-- Back button -->
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn-back-home" id="btnBackHome">
            <i class="fa-solid fa-arrow-left"></i> Home / Shop List
        </a>
    </div>

    <!-- Shop Details Header (Point 30: Seller Shop Profile) -->
    <div class="shop-header-card p-4 rounded-4" style="background: linear-gradient(135deg, rgba(15,23,42,0.95) 0%, rgba(30,27,75,0.9) 100%); border: 1px solid rgba(255,255,255,0.1);">
        <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="shop-info-cat">@shop?.Category</span>
                <span class="badge bg-warning bg-opacity-25 text-warning fw-bold px-2.5 py-1 rounded-pill border border-warning border-opacity-50">
                    ⭐ @(ViewBag.AverageRating != null ? ViewBag.AverageRating.ToString("0.0") : "4.5") Rating
                </span>
                <span class="badge bg-success bg-opacity-25 text-success px-2.5 py-1 rounded-pill border border-success border-opacity-50">
                    <i class="fa-solid fa-circle-check"></i> Approved Partner
                </span>
            </div>
            
            <h1 class="shop-info-title mb-1">@shop?.ShopName</h1>
            
            <div class="d-flex align-items-center gap-3 text-secondary small flex-wrap">
                <span><i class="fa-solid fa-location-dot text-danger me-1"></i> Location: <strong class="text-white">@(ViewBag.Location ?? "Patna")</strong></span>
                <span><i class="fa-solid fa-boxes-stacked text-info me-1"></i> Total Products: <strong class="text-white">@(ViewBag.TotalProducts ?? 120)</strong></span>
                <span><i class="fa-solid fa-bag-shopping text-success me-1"></i> Total Orders: <strong class="text-success">@(ViewBag.TotalOrders ?? 500)</strong></span>
                @if (!string.IsNullOrEmpty(shop?.PhoneNumber))
                {
                    <span><i class="fa-solid fa-phone text-light me-1"></i> Contact: <strong class="text-light">@shop?.PhoneNumber</strong></span>
                }
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center mt-3 mt-md-0">
            <a asp-action="ShopProfile" asp-route-id="@shop?.Id" class="btn btn-primary px-4 py-2 fw-bold rounded-3 shadow">
                <i class="fa-solid fa-store me-1"></i> [View Shop Profile]
            </a>
        </div>
    </div>

    <!-- Products Catalog Grid -->
    <h2 class="mb-4" style="font-weight: 700;">Products Available</h2>
    <div class="products-grid">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-catalog" id="emptyCatalogPanel">
                <div class="fs-1 text-muted mb-3"><i class="fa-solid fa-box-open"></i></div>
                <h3>Samaan khatam hai</h3>
                <p class="text-muted">Is dukan par abhi koi product list nahi kiya gaya hai.</p>
            </div>
        }
        else
        {
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        @if (product.StockStatus != "InStock")
                        {
                            <span class="stock-badge"><i class="fa-solid fa-triangle-exclamation"></i> Out of Stock</span>
                        }
                        <!-- ♡ Add to Wishlist button -->
                        <button type="button" class="btn btn-dark btn-sm rounded-circle position-absolute top-0 end-0 m-2 d-flex align-items-center justify-content-center shadow" style="width: 34px; height: 34px; background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(255,255,255,0.25); z-index: 2;" onclick="toggleWishlistShop(@product.Id, this)" title="Add to Wishlist">
                            <i class="fa-regular fa-heart text-danger fs-6"></i>
                        </button>
                        <img src="@product.ImageUrl" alt="@product.ProductName" class="product-img" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=60';" />
                    </div>
                    <div class="product-details">
                        <a asp-action="ProductDetails" asp-route-id="@product.Id" class="text-decoration-none text-white">
                            <h4 class="product-name text-truncate" title="@product.ProductName">@product.ProductName</h4>
                        </a>
                        <div class="product-price">₹@product.Price.ToString("F2")</div>
                        
                        <div class="d-flex gap-2">
                            <a asp-action="ProductDetails" asp-route-id="@product.Id" class="btn btn-outline-light btn-sm px-2 py-2" title="Details">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <button type="button" class="btn-add-cart flex-grow-1" 
                                    onclick="addProductToCart(@product.Id, '@Html.Raw(product.ProductName)', @product.Price)"
                                    @(product.StockStatus != "InStock" ? "disabled" : "")
                                    id="btn-add-@product.Id">
                                <i class="fa-solid fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Floating Cart Summary Bar -->
    <div class="floating-cart-bar" id="floatingCartSummary">
        <div class="cart-summary-text">
            <i class="fa-solid fa-basket-shopping me-1"></i> Cart: <span id="cartItemCount">0</span> items (₹<span id="cartTotalPrice">0.00</span>)
        </div>
        <a asp-controller="Home" asp-action="Cart" class="btn-view-cart">
            Go to Cart <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</div>

<!-- Clear Cart Confirmation Modal -->
<div class="modal fade" id="clearCartModal" tabindex="-1" aria-labelledby="clearCartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-warning" id="clearCartModalLabel"><i class="fa-solid fa-triangle-exclamation me-2"></i> Cart me Dusri Shop ka Samaan Hai!</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Aapki cart me pehle se dusri dukaan ka samaan hai. Ek baar me sirf ek hi dukaan se order kiya ja sakta hai.
                <br /><br />
                Kya aap purani cart ko <strong>khali (clear)</strong> karke is dukaan ka samaan add karna chahte hain?
            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 10px;">Nahi, Back</button>
                <button type="button" class="btn btn-danger" onclick="confirmClearAndAdd()" style="border-radius: 10px;">Haan, Clear & Add</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Variables for pending addition in case of shop mismatch
    let pendingItem = null;

    document.addEventListener("DOMContentLoaded", function () {
        updateFloatingCartBar();
    });

    function addProductToCart(productId, productName, price) {
        let cart = JSON.parse(localStorage.getItem("shop_cart"));
        const currentShopId = @shop?.Id;
        const currentShopName = '@Html.Raw(shop?.ShopName)';

        if (cart && cart.shopId !== currentShopId && cart.items.length > 0) {
            // Mismatch shop! Show modal
            pendingItem = { productId, productName, price, shopId: currentShopId, shopName: currentShopName };
            const modal = new bootstrap.Modal(document.getElementById('clearCartModal'));
            modal.show();
            return;
        }

        // Cart is empty or same shop
        if (!cart) {
            cart = {
                shopId: currentShopId,
                shopName: currentShopName,
                items: []
            };
        }

        // Add or update item
        const existingItem = cart.items.find(i => i.productId === productId);
        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            cart.items.push({
                productId: productId,
                productName: productName,
                price: price,
                quantity: 1
            });
        }

        localStorage.setItem("shop_cart", JSON.stringify(cart));
        updateFloatingCartBar();
        
        // Dynamic feedback - change button momentarily
        const btn = document.getElementById("btn-add-" + productId);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-circle-check text-success"></i> Added!';
        btn.style.background = 'rgba(16, 185, 129, 0.2)';
        setTimeout(() => {
            btn.innerHTML = originalHtml;
            btn.style.background = '';
        }, 1200);
    }

    function confirmClearAndAdd() {
        if (pendingItem) {
            const cart = {
                shopId: pendingItem.shopId,
                shopName: pendingItem.shopName,
                items: [{
                    productId: pendingItem.productId,
                    productName: pendingItem.productName,
                    price: pendingItem.price,
                    quantity: 1
                }]
            };
            localStorage.setItem("shop_cart", JSON.stringify(cart));
            updateFloatingCartBar();

            // Hide modal
            const modalEl = document.getElementById('clearCartModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            modal.hide();
            
            pendingItem = null;
        }
    }

    function updateFloatingCartBar() {
        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        const bar = document.getElementById("floatingCartSummary");
        const countSpan = document.getElementById("cartItemCount");
        const priceSpan = document.getElementById("cartTotalPrice");

        if (cart && cart.items.length > 0) {
            let totalQty = 0;
            let totalPrice = 0.0;
            
            cart.items.forEach(item => {
                totalQty += item.quantity;
                totalPrice += item.price * item.quantity;
            });

            countSpan.innerText = totalQty;
            priceSpan.innerText = totalPrice.toFixed(2);
            bar.classList.add("show");

            // Update layout layout navigation badge if function exists
            if (window.updateLayoutCartBadge) {
                window.updateLayoutCartBadge(totalQty);
            }
        } else {
            bar.classList.remove("show");
            if (window.updateLayoutCartBadge) {
                window.updateLayoutCartBadge(0);
            }
        }
    }

    async function toggleWishlistShop(productId, btn) {
        const form = new FormData();
        form.append("productId", productId);

        try {
            const resp = await fetch('/Customer/ToggleWishlist', {
                method: 'POST',
                body: form
            });
            const data = await resp.json();
            if (data.success) {
                const icon = btn.querySelector('i');
                if (data.isAdded) {
                    icon.classList.remove('fa-regular');
                    icon.classList.add('fa-solid');
                    btn.title = "In Wishlist";
                } else {
                    icon.classList.remove('fa-solid');
                    icon.classList.add('fa-regular');
                    btn.title = "Add to Wishlist";
                }
                showWishlistToast(data.message);
            } else {
                alert(data.message || "Please login to manage wishlist.");
                if (data.message && data.message.includes("login")) {
                    window.location.href = '/Customer/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                }
            }
        } catch (e) {
            console.error(e);
        }
    }

    function showWishlistToast(msg) {
        let toast = document.getElementById("catalogWishlistToast");
        if (!toast) {
            toast = document.createElement("div");
            toast.id = "catalogWishlistToast";
            toast.style.position = "fixed";
            toast.style.bottom = "24px";
            toast.style.right = "24px";
            toast.style.zIndex = "9999";
            toast.style.background = "linear-gradient(135deg, #ef4444, #ec4899)";
            toast.style.color = "white";
            toast.style.padding = "12px 20px";
            toast.style.borderRadius = "12px";
            toast.style.boxShadow = "0 10px 25px rgba(0,0,0,0.4)";
            toast.style.fontWeight = "600";
            toast.style.transition = "all 0.3s ease";
            document.body.appendChild(toast);
        }
        toast.innerHTML = `<i class="fa-solid fa-heart me-2"></i> ${msg}`;
        toast.style.opacity = "1";
        toast.style.transform = "translateY(0)";
        setTimeout(() => {
            toast.style.opacity = "0";
            toast.style.transform = "translateY(10px)";
        }, 2500);
    }
</script>
