@{
    ViewData["Title"] = "Privacy Policy - ShopNext";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .privacy-hero {
        background: linear-gradient(135deg, rgba(30, 27, 75, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%), url('https://images.unsplash.com/photo-1557683316-973673baf926?w=1600') center/cover;
        border-radius: 24px;
        padding: 4rem 2rem;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }
    .privacy-card {
        background: rgba(30, 41, 59, 0.65);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 2.2rem;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }
    .privacy-card:hover {
        border-color: rgba(99, 102, 241, 0.35);
        transform: translateY(-2px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    }
    .gradient-badge {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: white;
        padding: 0.35rem 0.9rem;
        border-radius: 50rem;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .section-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    .highlight-box {
        background: rgba(15, 23, 42, 0.7);
        border-left: 4px solid #6366f1;
        padding: 1.2rem;
        border-radius: 0 12px 12px 0;
        margin: 1.2rem 0;
    }
    .security-badge-card {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 16px;
        padding: 1.5rem;
    }
</style>

<div class="container py-5 font-outfit">
    <!-- Hero Banner -->
    <div class="privacy-hero text-center text-white mb-5">
        <span class="gradient-badge mb-3">
            <i class="fa-solid fa-shield-halved"></i> ShopNext Trust & Safety Center
        </span>
        <h1 class="display-4 fw-bold mb-3">Privacy Policy</h1>
        <p class="lead text-light opacity-75 max-w-700 mx-auto" style="max-width: 720px;">
            Aapki personal information aur privacy humare liye sarvopari hai. Ye document simple aur clear language me batata hai ki hum aapka data kaise collect, use aur protect karte hain.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4 text-muted small">
            <span><i class="fa-solid fa-calendar-check me-1 text-primary"></i> Last Updated: 06 September 2026</span>
            <span>&bull;</span>
            <span><i class="fa-solid fa-lock me-1 text-success"></i> 100% Zero Data Selling Guarantee</span>
        </div>
    </div>

    <!-- Security & PCI-DSS Highlight Card (Payment Card Protection) -->
    <div class="security-badge-card mb-5">
        <div class="d-flex align-items-start gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-success text-white flex-shrink-0" style="width: 44px; height: 44px;">
                <i class="fa-solid fa-credit-card fs-5"></i>
            </div>
            <div>
                <h5 class="fw-bold text-success mb-1">💳 Important Notice on Payment & Card Details</h5>
                <p class="text-light opacity-90 small mb-0">
                    <strong>ShopNext apne server ya database me complete Credit/Debit Card numbers ya CVV bilkul store NAHI karta.</strong> Sabhi card aur online payments RBI-authorized, PCI-DSS Level 1 certified payment gateways (UPI, NetBanking, Card Gateways) dwara end-to-end tokenized & encrypted standard par securely process hoti hain.
                </p>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-12">

            <!-- 1. Data We Collect -->
            <div class="privacy-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="section-icon bg-primary bg-opacity-20 text-primary">
                        <i class="fa-solid fa-database"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">1. Hum Kaunsa Data Collect Karte Hain</h4>
                        <small class="text-muted">Transparency on what information is gathered</small>
                    </div>
                </div>
                <p class="text-light opacity-90">ShopNext par seamless hyperlocal shopping aur fast doorstep delivery provide karne ke liye nimnlikhit data collect kiya jata hai:</p>
                
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-60 border border-secondary border-opacity-30 h-100">
                            <h6 class="fw-bold text-info"><i class="fa-solid fa-user me-2"></i> Account Information</h6>
                            <ul class="text-muted small ps-3 mb-0">
                                <li>Aapka Full Name aur Mobile Number</li>
                                <li>Email Address (Account communication aur invoices ke liye)</li>
                                <li>Cryptographically Salted & Hashed Password (encrypted format me)</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-60 border border-secondary border-opacity-30 h-100">
                            <h6 class="fw-bold text-warning"><i class="fa-solid fa-location-dot me-2"></i> Delivery Information</h6>
                            <ul class="text-muted small ps-3 mb-0">
                                <li>Doorstep Delivery Addresses (Street, Flat, Landmark)</li>
                                <li>City, State, aur Pincode</li>
                                <li>Optional Delivery Notes/Instructions (e.g. Leave with security)</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-60 border border-secondary border-opacity-30 h-100">
                            <h6 class="fw-bold text-success"><i class="fa-solid fa-receipt me-2"></i> Order & Payment Information</h6>
                            <ul class="text-muted small ps-3 mb-0">
                                <li>Purchased Products, Quantity, aur Total Amount</li>
                                <li>Selected Payment Mode (COD, UPI, NetBanking)</li>
                                <li>Gateway Transaction Reference IDs (UTR/ARN for refund tracking)</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-60 border border-secondary border-opacity-30 h-100">
                            <h6 class="fw-bold text-danger"><i class="fa-solid fa-headset me-2"></i> Support & Dispute Telemetry</h6>
                            <ul class="text-muted small ps-3 mb-0">
                                <li>Support Tickets, Grievances, aur Chat communication</li>
                                <li>Customer uploaded unboxing video & photo evidence for returns</li>
                                <li>Doorstep Delivery Handover OTP verification timestamps</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Purpose of Data -->
            <div class="privacy-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="section-icon bg-info bg-opacity-20 text-info">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">2. Data Ka Purpose (Use Kaise Hota Hai)</h4>
                        <small class="text-muted">How your information empowers the platform</small>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-25 h-100">
                            <strong class="text-white d-block mb-1"><i class="fa-solid fa-truck-fast text-primary me-1.5"></i> Order Fulfillment</strong>
                            <p class="text-muted small mb-0">Riders ko aapka address dikhane aur accurate doorstep delivery time calculate karne ke liye.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-25 h-100">
                            <strong class="text-white d-block mb-1"><i class="fa-solid fa-money-bill-transfer text-success me-1.5"></i> Instant Refunds</strong>
                            <p class="text-muted small mb-0">Return approve hone par UPI/Bank account me automated refund settle karne ke liye.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-25 h-100">
                            <strong class="text-white d-block mb-1"><i class="fa-solid fa-shield-virus text-danger me-1.5"></i> Fraud & Risk Prevention</strong>
                            <p class="text-muted small mb-0">Bot attacks, fake orders, coupon brute-forcing, aur counterfeit returns se platform ko safe rakhne ke liye.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Data Sharing Policies -->
            <div class="privacy-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="section-icon bg-warning bg-opacity-20 text-warning">
                        <i class="fa-solid fa-share-nodes"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">3. Data Sharing Kab Hoti Hai?</h4>
                        <small class="text-muted">Strict controls on third-party access</small>
                    </div>
                </div>
                <p class="text-light opacity-90">Hum aapka data sirf unhi parties ke saath share karte hain jo order deliver karne ke liye mandatory hain:</p>
                <div class="highlight-box">
                    <ul class="text-light opacity-90 small ps-3 mb-0">
                        <li><strong>🛵 Delivery Partners / Riders:</strong> Sirf aapka Delivery Name, Address, Phone number aur Landmark (delivery coordinate karne ke liye).</li>
                        <li><strong>🏪 Merchant Store:</strong> Item details aur packing invoice create karne ke liye.</li>
                        <li><strong>💳 Payment Gateways (Razorpay/PayTM/NPCI):</strong> Tokenized checkout aur automated refund settlement ke liye.</li>
                        <li><strong>❌ 100% Zero 3rd-Party Selling:</strong> Hum aapka personal data kisi bhi advertising agency, marketing agency ya data broker ko kabhie sell ya rent nahi karte.</li>
                    </ul>
                </div>
            </div>

            <!-- 4. Data Security Standard -->
            <div class="privacy-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="section-icon bg-success bg-opacity-20 text-success">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">4. Data Security Standards</h4>
                        <small class="text-muted">Bank-grade encryption & access control</small>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-30">
                            <i class="fa-solid fa-key fs-4 text-warning"></i>
                            <div>
                                <strong class="text-white d-block small">End-to-End TLS 1.3 & AES-256</strong>
                                <span class="text-muted small">Data transmission aur storage dono high-level encryption se protected hain.</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-30">
                            <i class="fa-solid fa-user-shield fs-4 text-primary"></i>
                            <div>
                                <strong class="text-white d-block small">Role-Based Access Control (RBAC)</strong>
                                <span class="text-muted small">Sirf authorized personnel audit logs ke according customer support ticket access kar sakte hain.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Customer Rights & Account Deletion -->
            <div class="privacy-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="section-icon bg-danger bg-opacity-20 text-danger">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">5. Customer Rights & Account/Data Deletion Process</h4>
                        <small class="text-muted">Your rights as a consumer</small>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-30 h-100">
                            <strong class="text-white d-block mb-1"><i class="fa-solid fa-download text-info me-1.5"></i> Right to Access</strong>
                            <p class="text-muted small mb-0">Aap apne account section me kabhi bhi apni complete order history aur saved data dekh/export kar sakte hain.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-30 h-100">
                            <strong class="text-white d-block mb-1"><i class="fa-solid fa-pen-to-square text-warning me-1.5"></i> Right to Rectify</strong>
                            <p class="text-muted small mb-0">Aap apne address, phone number ya profile credentials ko kabhi bhi update/edit kar sakte hain.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-30 h-100">
                            <strong class="text-white d-block mb-1"><i class="fa-solid fa-trash-can text-danger me-1.5"></i> Account Deletion Process</strong>
                            <p class="text-muted small mb-0">Account delete karne ke liye `Profile -> Delete Account` select karein ya `privacy@shopnext.com` par email karein. Aapka personal data 48 ghante me permanently erase kar diya jata hai.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. Grievance Officer & Contact Information -->
            <div class="privacy-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="section-icon bg-info bg-opacity-20 text-info">
                        <i class="fa-solid fa-address-book"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">6. Grievance Redressal & Contact Information</h4>
                        <small class="text-muted">Dedicated nodal officer for privacy & data concerns</small>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-30">
                            <span class="text-muted small d-block">Grievance & Data Protection Officer:</span>
                            <strong class="text-white fs-6">Pooja Sharma (Lead Compliance Officer)</strong>
                            <div class="mt-2 text-muted small">
                                <div><i class="fa-solid fa-envelope me-2 text-primary"></i> Email: <strong>privacy@shopnext.com</strong></div>
                                <div><i class="fa-solid fa-phone me-2 text-success"></i> Phone: <strong>+91 98765 43210 (Mon-Sat, 9AM-6PM)</strong></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-30">
                            <span class="text-muted small d-block">Registered Corporate Office:</span>
                            <strong class="text-white fs-6">ShopNext Internet Technologies Pvt. Ltd.</strong>
                            <div class="mt-2 text-muted small">
                                <div><i class="fa-solid fa-building me-2 text-warning"></i> Tech Hub, Fraser Road, Patna, Bihar - 800001</div>
                                <div><i class="fa-solid fa-globe me-2 text-info"></i> Official Website: <strong>https://shopnext.in</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
