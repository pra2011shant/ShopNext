    async function saveAndUseNewAddress() {
        const type = document.getElementById("newAddrType").value;
        const recipient = document.getElementById("newAddrRecipient").value.trim();
        const phone = document.getElementById("newAddrPhone").value.trim();
        const line = document.getElementById("newAddrLine").value.trim();
        const city = document.getElementById("newAddrCity").value.trim() || "New Delhi";
        const pincode = document.getElementById("newAddrPincode").value.trim();
        const isDefault = document.getElementById("newAddrIsDefault").checked;

        if (!recipient || !phone || !line || !pincode) {
            alert("Please fill in recipient name, phone, address line, and pincode.");
            return;
        }

        const newAddr = {
            addressType: type,
            recipientName: recipient,
            phoneNumber: phone,
            addressLine: line,
            city: city,
            state: "Delhi",
            pincode: pincode,
            isDefault: isDefault
        };

        try {
            // Save to backend if customer logged in
            const resp = await fetch('/Customer/SaveAddress', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newAddr)
            });
            const data = await resp.json();
            if (data.id) newAddr.id = data.id;
        } catch (e) {
            console.error(e);
        }

        savedAddressesCache.unshift(newAddr);
        selectedAddressIndex = 0;
        renderAddressCards();
        toggleNewAddressForm();

        showCartAlert(`New <strong>${type}</strong> address saved and selected for delivery!`, 'success');
    }

