@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Simple & Fast Checkout - ShopNext";
    bool isCustLoggedIn = Context.Request.Cookies.TryGetValue("CustomerId", out string? cIdStr) && !string.IsNullOrEmpty(cIdStr);
    string custName = isCustLoggedIn && Context.Request.Cookies.TryGetValue("CustomerName", out string? cName) ? cName : "";
    string custPhone = isCustLoggedIn && Context.Request.Cookies.TryGetValue("CustomerPhone", out string? cPhone) ? cPhone : "";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        --card-bg: rgba(30, 41, 59, 0.75);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-muted: #94a3b8;
        --text-light: #f8fafc;
    }

    body {
        font-family: 'Outfit', sans-serif;
    }

    .checkout-wrapper {
        padding: 2rem 0 4rem;
        animation: fadeIn 0.4s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 1.75rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    /* 5-Step Visual Stepper */
    .checkout-stepper-container {
        position: relative;
        margin-bottom: 2.5rem;
    }

    .checkout-stepper {
        display: flex;
        justify-content: space-between;
        position: relative;
        z-index: 2;
    }

    .stepper-bg-bar {
        position: absolute;
        top: 22px;
        left: 8%;
        right: 8%;
        height: 3px;
        background: rgba(255, 255, 255, 0.1);
        z-index: 1;
    }

    .stepper-progress-bar {
        position: absolute;
        top: 22px;
        left: 8%;
        height: 3px;
        background: linear-gradient(90deg, #6366f1, #a855f7);
        z-index: 1;
        transition: width 0.35s ease;
        width: 0%;
    }

    .step-item {
        position: relative;
        text-align: center;
        flex: 1;
        cursor: pointer;
    }

    .step-badge {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #0f172a;
        border: 2px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 8px;
        color: var(--text-muted);
        font-weight: 700;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .step-item.active .step-badge {
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border-color: #c084fc;
        color: white;
        box-shadow: 0 0 20px rgba(168, 85, 247, 0.6);
        transform: scale(1.08);
    }

    .step-item.completed .step-badge {
        background: #10b981;
        border-color: #10b981;
        color: white;
    }

    .step-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        transition: color 0.3s;
    }

    .step-item.active .step-label {
        color: #ffffff;
        font-weight: 700;
    }

    .step-item.completed .step-label {
        color: #10b981;
    }

    /* Step Panels */
    .step-panel {
        display: none;
        animation: fadeIn 0.35s ease-out;
    }

    .step-panel.active {
        display: block;
    }

    /* Cart Table Styles */
    .smart-cart-table {
        margin-bottom: 0;
    }

    .smart-cart-table th {
        background: transparent;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.85rem 0.5rem;
    }

    .smart-cart-table td {
        background: transparent;
        color: white;
        padding: 1rem 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        vertical-align: middle;
    }

    .cart-item-img {
        width: 58px;
        height: 58px;
        border-radius: 12px;
        object-fit: cover;
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .qty-controls {
        display: inline-flex;
        align-items: center;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        padding: 3px 6px;
        gap: 6px;
    }

    .qty-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: all 0.2s;
    }

    .qty-btn:hover {
        background: rgba(255, 255, 255, 0.15);
        color: white;
    }

    .qty-value {
        font-weight: 600;
        min-width: 24px;
        text-align: center;
        color: white;
    }

    .btn-action-link {
        background: transparent;
        border: none;
        padding: 0;
        font-size: 0.8rem;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    /* Address Choice Cards */
    .address-choice-card {
        background: rgba(15, 23, 42, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 1rem 1.25rem;
        cursor: pointer;
        transition: all 0.25s ease;
        margin-bottom: 0.85rem;
    }

    .address-choice-card:hover {
        border-color: rgba(129, 140, 248, 0.4);
        background: rgba(15, 23, 42, 0.85);
    }

    .address-choice-card.selected {
        border-color: #818cf8;
        background: rgba(99, 102, 241, 0.14);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
    }

    .address-type-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 0.45rem 1.1rem;
        transition: all 0.2s;
    }

    /* Option Cards for Delivery and Payment */
    .delivery-opt-card, .payment-option-card {
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 1.1rem 1.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-bottom: 0.85rem;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .delivery-opt-card:hover, .payment-option-card:hover {
        border-color: rgba(129, 140, 248, 0.4);
        background: rgba(15, 23, 42, 0.8);
    }

    .delivery-opt-card.selected, .payment-option-card.selected {
        border-color: #818cf8;
        background: rgba(99, 102, 241, 0.15);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.15);
    }

    .btn-step-next {
        background: var(--primary-gradient);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.85rem 1.75rem;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 6px 16px rgba(168, 85, 247, 0.3);
    }

    .btn-step-next:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(168, 85, 247, 0.45);
        color: white;
    }

    .btn-place-final {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        border: none;
        border-radius: 14px;
        padding: 1.1rem;
        width: 100%;
        font-weight: 800;
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-place-final:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(16, 185, 129, 0.55);
        color: white;
    }

    .btn-place-final:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
    }

    .sticky-summary-card {
        position: sticky;
        top: 90px;
    }

    .instruction-chip {
        cursor: pointer;
        padding: 0.4rem 0.85rem;
        border-radius: 50rem;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(15, 23, 42, 0.6);
        color: #cbd5e1;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

    .instruction-chip:hover, .instruction-chip.selected {
        border-color: #818cf8;
        background: rgba(99, 102, 241, 0.2);
        color: white;
    }
</style>

<div class="container checkout-wrapper">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-white fw-bold mb-1">
                <i class="fa-solid fa-bag-shopping text-primary me-2"></i> Simple & Fast Checkout
            </h2>
            <p class="text-muted small mb-0">Order seamlessly from Cart to Placement without unnecessary pages</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-info btn-sm" id="btnStockCheck" onclick="checkStockAndSyncPrices(true)">
                <i class="fa-solid fa-rotate me-1" id="syncSpinIcon"></i> Stock & Price Check
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="clearCart()">
                <i class="fa-solid fa-trash me-1"></i> Clear Cart
            </button>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="cartAlertContainer"></div>

    <!-- 5-Step Visual Stepper Bar -->
    <div class="checkout-stepper-container" id="stepperContainer" style="display: none;">
        <div class="stepper-bg-bar"></div>
        <div class="stepper-progress-bar" id="stepperProgressBar"></div>
        <div class="checkout-stepper">
            <!-- Step 1: Cart -->
            <div class="step-item active" id="stepNode1" onclick="goToStep(1)">
                <div class="step-badge"><i class="fa-solid fa-cart-shopping"></i></div>
                <div class="step-label">1. Cart</div>
            </div>
            <!-- Step 2: Address -->
            <div class="step-item" id="stepNode2" onclick="goToStep(2)">
                <div class="step-badge"><i class="fa-solid fa-location-dot"></i></div>
                <div class="step-label">2. Address</div>
            </div>
            <!-- Step 3: Delivery -->
            <div class="step-item" id="stepNode3" onclick="goToStep(3)">
                <div class="step-badge"><i class="fa-solid fa-truck-fast"></i></div>
                <div class="step-label">3. Delivery</div>
            </div>
            <!-- Step 4: Payment -->
            <div class="step-item" id="stepNode4" onclick="goToStep(4)">
                <div class="step-badge"><i class="fa-solid fa-credit-card"></i></div>
                <div class="step-label">4. Payment</div>
            </div>
            <!-- Step 5: Place Order -->
            <div class="step-item" id="stepNode5" onclick="goToStep(5)">
                <div class="step-badge"><i class="fa-solid fa-circle-check"></i></div>
                <div class="step-label">5. Place Order</div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div id="checkoutMainArea" style="display: none;">
        <div class="row g-4">
            <!-- Left Side: Active Step View -->
            <div class="col-lg-7">

                <!-- ============================================== -->
                <!-- STEP 1: CART (Items, Qty, Discounts, Coupons) -->
                <!-- ============================================== -->
                <div class="step-panel active" id="panelStep1">
                    <div class="glass-card mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <h5 class="text-white fw-bold mb-0">
                                <i class="fa-solid fa-basket-shopping me-2 text-primary"></i>1. Review Cart Items
                            </h5>
                            <span id="orderingFromBadge" class="badge bg-purple bg-opacity-25 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill"></span>
                        </div>

                        <!-- Desktop Table -->
                        <div class="table-responsive d-none d-md-block">
                            <table class="table smart-cart-table">
                                <thead>
                                    <tr>
                                        <th style="width: 38%;">Product</th>
                                        <th style="width: 16%;">Price</th>
                                        <th style="width: 18%;">Quantity</th>
                                        <th style="width: 12%;">Discount</th>
                                        <th style="width: 16%; text-align: right;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody id="cartTableBody">
                                    <!-- Populated via JS -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card List -->
                        <div id="cartMobileList" class="d-md-none">
                            <!-- Mobile Cards -->
                        </div>
                    </div>

                    <!-- Coupon Code Card -->
                    <div class="glass-card mb-4">
                        <h6 class="text-white fw-bold mb-3"><i class="fa-solid fa-ticket text-warning me-2"></i> Apply Coupon / Promo Code</h6>
                        <div class="input-group mb-2">
                            <input type="text" id="couponInput" class="form-control bg-dark text-white border-secondary text-uppercase" placeholder="Enter coupon (e.g. WELCOME50, SUPER20)" />
                            <button class="btn btn-primary px-3" type="button" onclick="applyCouponManual()">
                                <i class="fa-solid fa-check me-1"></i> Apply
                            </button>
                        </div>
                        <div id="couponMessage" class="small mb-2" style="display: none;"></div>
                        
                        <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                            <span class="text-muted small">Available:</span>
                            <button type="button" class="btn btn-sm btn-outline-info py-1 px-2 rounded-pill" onclick="quickApplyCoupon('WELCOME50')">
                                🎟️ WELCOME50 (Flat ₹50 OFF)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2 rounded-pill" onclick="quickApplyCoupon('SUPER20')">
                                🎟️ SUPER20 (20% OFF)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 rounded-pill" onclick="quickApplyCoupon('FREESHIP')">
                                🎟️ FREESHIP (Free Delivery)
                            </button>
                        </div>
                    </div>

                    <!-- Step 1 Navigation -->
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Products" class="btn btn-outline-light btn-sm">
                            <i class="fa-solid fa-arrow-left me-1"></i> Add More Items
                        </a>
                        <button class="btn-step-next" onclick="goToStep(2)">
                            Proceed to Address <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </div>

                    <!-- Saved for Later Sub-section -->
                    <div id="savedForLaterCard" class="glass-card mt-4" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-white fw-bold mb-0">
                                <i class="fa-solid fa-bookmark text-warning me-2"></i> Saved for Later (<span id="savedCount">0</span>)
                            </h6>
                            <button class="btn btn-link text-muted btn-sm p-0 text-decoration-none" onclick="clearSavedForLater()">Clear</button>
                        </div>
                        <div id="savedForLaterList"></div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- STEP 2: ADDRESS (Multiple Delivery Addresses)  -->
                <!-- ============================================== -->
                <div class="step-panel" id="panelStep2">
                    <div class="glass-card mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <div>
                                <h5 class="text-white fw-bold mb-0">
                                    <i class="fa-solid fa-location-dot me-2 text-primary"></i>2. Select Address
                                </h5>
                                <p class="text-muted small mb-0">Choose Home, Office, or Other delivery location</p>
                            </div>
                            <button class="btn btn-primary btn-sm" onclick="toggleNewAddressForm()">
                                <i class="fa-solid fa-plus me-1"></i> Add New Address
                            </button>
                        </div>

                        <!-- Address Radio Cards (○ Home, ○ Office, ○ Other) -->
                        <div id="addressSelectionList" class="mb-3">
                            <!-- Populated dynamically via JS -->
                        </div>

                        <!-- Inline Add New Address Box -->
                        <div id="newAddressCard" class="p-3 bg-dark rounded-3 border border-secondary mb-3" style="display: none; background: rgba(15, 23, 42, 0.95) !important;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-white fw-bold mb-0">
                                    <i class="fa-solid fa-plus-circle text-primary me-2"></i>New Delivery Address
                                </h6>
                                <button type="button" class="btn-close btn-close-white small" onclick="toggleNewAddressForm()"></button>
                            </div>

                            <!-- Live GPS & Map Pin Picker Banner -->
                            <div class="mb-3 p-3 rounded-3 border border-primary border-opacity-40" style="background: rgba(37, 99, 235, 0.12);">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                    <div>
                                        <strong class="text-white small d-block"><i class="fa-solid fa-location-crosshairs text-info me-1"></i> Live Mobile GPS & Interactive Map</strong>
                                        <span class="small" style="color: #cbd5e1; font-size: 0.8rem;">Apna exact live GPS address auto-fetch karein ya map par pin select karein</span>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm fw-bold px-3 shadow-sm" onclick="detectGPSLocation()">
                                        <i class="fa-solid fa-crosshairs me-1"></i> Detect My Live GPS
                                    </button>
                                </div>

                                <!-- Interactive Map Container -->
                                <div id="mapWrapper" style="display: none;" class="mt-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small text-white fw-semibold"><i class="fa-solid fa-map-pin text-danger me-1"></i> Tap map or drag pin to your exact building:</span>
                                        <span id="gpsStatusBadge" class="badge bg-success bg-opacity-25 text-success small">GPS Ready</span>
                                    </div>
                                    <div id="deliveryMap" style="height: 220px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.2); z-index: 1;"></div>
                                    <small class="d-block mt-1" style="color: #94a3b8; font-size: 0.78rem;">
                                        <i class="fa-solid fa-circle-info text-info me-1"></i> Map pin move karne par Road, Colony, City aur Pincode automatically fill ho jayenge.
                                    </small>
                                </div>
                            </div>

                            <!-- Address Type Selection (Home, Office, Other) -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" style="color: #cbd5e1 !important;">Address Type:</label>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-success address-type-btn active" id="btnTypeHome" onclick="selectNewAddressType('Home')">
                                        <i class="fa-solid fa-house me-1"></i> Home
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-info address-type-btn" id="btnTypeOffice" onclick="selectNewAddressType('Office')">
                                        <i class="fa-solid fa-building me-1"></i> Office
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-warning address-type-btn" id="btnTypeOther" onclick="selectNewAddressType('Other')">
                                        <i class="fa-solid fa-location-dot me-1"></i> Other
                                    </button>
                                </div>
                                <input type="hidden" id="newAddrType" value="Home" />
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small" style="color: #cbd5e1 !important;">Recipient Name *</label>
                                    <input type="text" id="newAddrRecipient" class="form-control bg-dark text-white border-secondary form-control-sm" placeholder="e.g. Rahul Sharma" value="@custName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small" style="color: #cbd5e1 !important;">Phone Number *</label>
                                    <input type="tel" id="newAddrPhone" class="form-control bg-dark text-white border-secondary form-control-sm" placeholder="e.g. 9876543210" pattern="[6-9][0-9]{9}" value="@custPhone" required />
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small" style="color: #cbd5e1 !important;">Street Address / House / Flat / Area *</label>
                                <textarea id="newAddrLine" class="form-control bg-dark text-white border-secondary form-control-sm" rows="2" placeholder="House/Flat No., Road, Landmark" required></textarea>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small" style="color: #cbd5e1 !important;">City</label>
                                    <input type="text" id="newAddrCity" class="form-control bg-dark text-white border-secondary form-control-sm" value="New Delhi" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small" style="color: #cbd5e1 !important;">Pincode *</label>
                                    <input type="text" id="newAddrPincode" class="form-control bg-dark text-white border-secondary form-control-sm" placeholder="e.g. 110001" required />
                                </div>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="newAddrIsDefault" checked />
                                <label class="form-check-label small" for="newAddrIsDefault" style="color: #cbd5e1 !important;">
                                    Set as default address
                                </label>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm" onclick="toggleNewAddressForm()">Cancel</button>
                                <button type="button" class="btn btn-primary btn-sm px-3" onclick="saveAndUseNewAddress()">
                                    <i class="fa-solid fa-check me-1"></i> Save & Deliver Here
                                </button>
                            </div>
                        </div>

                        <!-- Hidden fields holding chosen address info for downstream steps -->
                        <input type="hidden" id="custName" value="@custName" />
                        <input type="hidden" id="custPhone" value="@custPhone" />
                        <input type="hidden" id="deliveryAddr" value="" />
                        <input type="hidden" id="selectedAddressType" value="Home" />
                    </div>

                    <!-- Step 2 Navigation -->
                    <div class="d-flex justify-content-between align-items-center">
                        <button class="btn btn-outline-light" onclick="goToStep(1)">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to Cart
                        </button>
                        <button class="btn-step-next" onclick="validateAndGoToStep(3)">
                            Proceed to Delivery <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- STEP 3: DELIVERY OPTIONS (Standard vs Express) -->
                <!-- ============================================== -->
                <div class="step-panel" id="panelStep3">
                    <div class="glass-card mb-4">
