    function renderAddressCards() {
        const listDiv = document.getElementById("addressSelectionList");
        listDiv.innerHTML = "";

        savedAddressesCache.forEach((addr, idx) => {
            const isSelected = (idx === selectedAddressIndex);
            if (isSelected) {
                applyAddressToForm(addr);
            }

            let typeIcon = "fa-solid fa-house text-success";
            let badgeClass = "bg-success bg-opacity-25 text-success";

            if (addr.addressType === "Office") {
                typeIcon = "fa-solid fa-building text-info";
                badgeClass = "bg-info bg-opacity-25 text-info";
            } else if (addr.addressType === "Other") {
                typeIcon = "fa-solid fa-location-dot text-warning";
                badgeClass = "bg-warning bg-opacity-25 text-warning";
            }

            const card = document.createElement("div");
            card.className = `address-choice-card ${isSelected ? 'selected' : ''}`;
            card.id = `addrChoiceCard_${idx}`;
            card.onclick = () => selectAddressOption(idx);

            card.innerHTML = `
                <div class="d-flex align-items-start gap-3">
                    <input type="radio" name="addressRadioGroup" id="addrRadio_${idx}" value="${idx}" class="form-check-input mt-1" ${isSelected ? 'checked' : ''} />
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge ${badgeClass} px-2 py-1">
                                <i class="${typeIcon} me-1"></i> ${addr.addressType}
                            </span>
                            ${addr.isDefault ? `<span class="badge bg-primary bg-opacity-25 text-primary small">Default</span>` : ''}
                        </div>
                        <strong class="text-white d-block mb-1">
                            ${addr.recipientName} &bull; <span class="text-muted small">${addr.phoneNumber}</span>
                        </strong>
                        <p class="text-light opacity-75 small mb-0">
                            ${addr.addressLine}, ${addr.city}, ${addr.state || 'Delhi'} - ${addr.pincode}
                            ${addr.landmark ? `<span class="text-muted">(Near ${addr.landmark})</span>` : ''}
                        </p>
                    </div>
                </div>
            `;
            listDiv.appendChild(card);
        });
    }

    function selectAddressOption(idx) {
        selectedAddressIndex = idx;
        const addr = savedAddressesCache[idx];
        if (!addr) return;

        document.querySelectorAll('.address-choice-card').forEach(c => c.classList.remove('selected'));
        const activeCard = document.getElementById(`addrChoiceCard_${idx}`);
        if (activeCard) activeCard.classList.add('selected');

        const radio = document.getElementById(`addrRadio_${idx}`);
        if (radio) radio.checked = true;

        applyAddressToForm(addr);
    }

    function applyAddressToForm(addr) {
        document.getElementById("custName").value = addr.recipientName || "";
        document.getElementById("custPhone").value = addr.phoneNumber || "";
        let formatted = `${addr.addressLine}, ${addr.city}, ${addr.state || 'Delhi'} - ${addr.pincode}`;
        if (addr.landmark) formatted += ` (Landmark: ${addr.landmark})`;
        document.getElementById("deliveryAddr").value = formatted;
        document.getElementById("selectedAddressType").value = addr.addressType || "Home";
    }

    function detectGPSLocation() {
        const badge = document.getElementById("gpsStatusBadge");
        if (!navigator.geolocation) {
            alert("Geolocation is not supported by your browser/device.");
            return;
        }

        if (badge) {
            badge.className = "badge bg-warning bg-opacity-25 text-warning small";
            badge.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Detecting GPS Location...';
        }

        navigator.geolocation.getCurrentPosition(
            function (pos) {
                const lat = pos.coords.latitude;
                const lon = pos.coords.longitude;
                initOrShowDeliveryMap(lat, lon, 16);
                reverseGeocodeCoordinates(lat, lon);
            },
            function (err) {
                console.warn("GPS error / permission denied:", err);
                if (badge) {
                    badge.className = "badge bg-danger bg-opacity-25 text-danger small";
                    badge.innerText = "Location Permission Denied";
                }
                alert("Mobile GPS access denied or timed out. Map opened for manual pin selection.");
                initOrShowDeliveryMap(28.6139, 77.2090, 13);
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    function initOrShowDeliveryMap(lat, lon, zoomLevel = 16) {
        const mapWrapper = document.getElementById("mapWrapper");
        if (mapWrapper) mapWrapper.style.display = "block";

        if (!deliveryMap) {
            deliveryMap = L.map('deliveryMap').setView([lat, lon], zoomLevel);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(deliveryMap);

            deliveryMarker = L.marker([lat, lon], { draggable: true }).addTo(deliveryMap);

            deliveryMarker.on('dragend', function (e) {
                const pos = e.target.getLatLng();
                reverseGeocodeCoordinates(pos.lat, pos.lng);
            });

            deliveryMap.on('click', function (e) {
                deliveryMarker.setLatLng(e.latlng);
                reverseGeocodeCoordinates(e.latlng.lat, e.latlng.lng);
            });
        } else {
            deliveryMap.setView([lat, lon], zoomLevel);
            if (deliveryMarker) deliveryMarker.setLatLng([lat, lon]);
        }

        setTimeout(() => {
            if (deliveryMap) deliveryMap.invalidateSize();
        }, 300);
    }

    async function reverseGeocodeCoordinates(lat, lon) {
        const badge = document.getElementById("gpsStatusBadge");
        if (badge) {
            badge.className = "badge bg-info bg-opacity-25 text-info small";
            badge.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Resolving Address...';
        }

        try {
            const resp = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&addressdetails=1`);
            if (!resp.ok) throw new Error("Geocoding failed");
            const data = await resp.json();

            if (data && data.address) {
                const addr = data.address;
                const building = addr.building || addr.house_number || addr.amenity || "";
                const road = addr.road || addr.street || addr.neighbourhood || addr.suburb || "";
                const area = addr.suburb || addr.residential || addr.city_district || "";
                const city = addr.city || addr.town || addr.village || addr.county || "New Delhi";
                const pincode = addr.postcode || "";

                let addressLine = [building, road, area].filter(Boolean).join(", ");
                if (!addressLine) {
                    const parts = (data.display_name || "").split(",");
                    addressLine = parts.slice(0, 3).join(",").trim();
                }

                if (addressLine) document.getElementById("newAddrLine").value = addressLine;
                if (city) document.getElementById("newAddrCity").value = city;
                if (pincode) document.getElementById("newAddrPincode").value = pincode;

                if (deliveryMarker) {
                    deliveryMarker.bindPopup(`<b>Delivery Point</b><br>${addressLine || 'Selected Location'}`).openPopup();
                }

                if (badge) {
                    badge.className = "badge bg-success bg-opacity-25 text-success small";
                    badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Address Auto-Filled!';
                }
            }
        } catch (e) {
            console.error("Reverse geocode error:", e);
            if (badge) {
                badge.className = "badge bg-warning bg-opacity-25 text-warning small";
                badge.innerText = "Pin Selected";
            }
        }
    }

    function toggleNewAddressForm() {
        const box = document.getElementById("newAddressCard");
        const isHidden = box.style.display === "none";
        box.style.display = isHidden ? "block" : "none";
        if (isHidden) {
            document.getElementById("newAddrRecipient").focus();
            setTimeout(() => {
