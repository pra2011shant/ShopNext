    // ==========================================
    // CART RENDERING
    // ==========================================

    function renderCart() {
        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        const mainArea = document.getElementById("checkoutMainArea");
        const stepper = document.getElementById("stepperContainer");
        const emptyView = document.getElementById("emptyCartView");

        if (!cart || !cart.items || cart.items.length === 0) {
            mainArea.style.display = "none";
            stepper.style.display = "none";
            emptyView.style.display = "block";
            if (window.updateLayoutCartBadge) window.updateLayoutCartBadge(0);
            return;
        }

        emptyView.style.display = "none";
        mainArea.style.display = "block";
        stepper.style.display = "block";

        document.getElementById("orderingFromBadge").innerHTML = `<i class="fa-solid fa-store me-1"></i> ${cart.shopName}`;

        const tbody = document.getElementById("cartTableBody");
        const mobileDiv = document.getElementById("cartMobileList");
        const sideItemsDiv = document.getElementById("summaryItemsList");

        tbody.innerHTML = "";
        mobileDiv.innerHTML = "";
        sideItemsDiv.innerHTML = "";

        let subtotal = 0.0;
        let totalQty = 0;
        hasOutOfStockItems = false;

        cart.items.forEach(item => {
            subtotal += item.price * item.quantity;
            totalQty += item.quantity;
        });

        // Discount logic
        let discount = 0;
        if (appliedCoupon) {
            if (subtotal >= (appliedCoupon.minSubtotal || 0)) {
                if (appliedCoupon.discountType === 'Flat') {
                    discount = appliedCoupon.discountValue;
                } else if (appliedCoupon.discountType === 'Percent') {
                    discount = (subtotal * appliedCoupon.discountValue) / 100;
                }
                if (discount > subtotal) discount = subtotal;
                appliedCoupon.discountAmount = discount;
            } else {
                appliedCoupon = null;
            }
        }

        const couponRatio = subtotal > 0 ? (discount / subtotal) : 0;

        cart.items.forEach(item => {
            const lineRaw = item.price * item.quantity;
            const lineDiscount = lineRaw * couponRatio;
            const lineFinal = lineRaw - lineDiscount;
            const isOutOfStock = item.stockStatus === 'OutOfStock';
            if (isOutOfStock) hasOutOfStockItems = true;

            const fallbackImg = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=60";
            const imgUrl = item.imageUrl || fallbackImg;

            // Desktop Row
            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td>
                    <div class="d-flex align-items-center gap-3">
                        <img src="${imgUrl}" alt="${item.productName}" class="cart-item-img" onerror="this.src='${fallbackImg}'" />
                        <div>
                            <a href="/Home/ProductDetails/${item.productId}" class="text-white text-decoration-none fw-bold d-block text-truncate" style="max-width: 180px;">
                                ${item.productName}
                            </a>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge ${isOutOfStock ? 'bg-danger' : 'bg-success'} bg-opacity-25 ${isOutOfStock ? 'text-danger' : 'text-success'}" style="font-size: 0.7rem;">
                                    ${isOutOfStock ? 'Out of Stock' : 'In Stock'}
                                </span>
                                ${item.priceUpdated ? `<span class="badge bg-info bg-opacity-25 text-info" style="font-size: 0.7rem;">Price Updated</span>` : ''}
                            </div>
                            <div class="d-flex gap-3 mt-1">
                                <button type="button" class="btn-action-link text-warning" onclick="saveForLater(${item.productId})">
                                    <i class="fa-regular fa-bookmark me-1"></i>Save for later
                                </button>
                                <button type="button" class="btn-action-link text-danger" onclick="removeCartItem(${item.productId})">
                                    <i class="fa-regular fa-trash-can me-1"></i>Remove
                                </button>
                            </div>
                        </div>
                    </div>
                </td>
                <td><div class="fw-semibold">&#8377;${item.price.toFixed(2)}</div></td>
                <td>
                    <div class="qty-controls">
                        <button type="button" class="qty-btn" onclick="updateQty(${item.productId}, -1)"><i class="fa-solid fa-minus"></i></button>
                        <span class="qty-value">${item.quantity}</span>
                        <button type="button" class="qty-btn" onclick="updateQty(${item.productId}, 1)"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </td>
                <td>${lineDiscount > 0 ? `<span class="text-success small fw-semibold">-&#8377;${lineDiscount.toFixed(2)}</span>` : `<span class="text-muted small">&#8212;</span>`}</td>
                <td style="text-align: right;"><strong class="text-white">&#8377;${lineFinal.toFixed(2)}</strong></td>
            `;
            tbody.appendChild(tr);

            // Mobile Card
            const mob = document.createElement("div");
            mob.className = "p-3 bg-dark rounded-3 border border-secondary mb-3";
            mob.innerHTML = `
                <div class="d-flex gap-3 mb-2">
                    <img src="${imgUrl}" alt="${item.productName}" class="cart-item-img" onerror="this.src='${fallbackImg}'" />
                    <div class="flex-grow-1">
                        <strong class="text-white d-block text-truncate">${item.productName}</strong>
                        <div class="text-muted small">&#8377;${item.price.toFixed(2)} each</div>
                        <span class="badge ${isOutOfStock ? 'bg-danger' : 'bg-success'} bg-opacity-25 ${isOutOfStock ? 'text-danger' : 'text-success'} mt-1" style="font-size: 0.7rem;">
                            ${isOutOfStock ? 'Out of Stock' : 'In Stock'}
                        </span>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary">
                    <div class="qty-controls">
                        <button type="button" class="qty-btn" onclick="updateQty(${item.productId}, -1)"><i class="fa-solid fa-minus"></i></button>
                        <span class="qty-value">${item.quantity}</span>
                        <button type="button" class="qty-btn" onclick="updateQty(${item.productId}, 1)"><i class="fa-solid fa-plus"></i></button>
                    </div>
                    <div class="text-white fw-bold">&#8377;${lineFinal.toFixed(2)}</div>
                </div>
                <div class="d-flex justify-content-end gap-3 mt-2 pt-2 border-top border-secondary">
                    <button type="button" class="btn-action-link text-warning" onclick="saveForLater(${item.productId})">Save for later</button>
                    <button type="button" class="btn-action-link text-danger" onclick="removeCartItem(${item.productId})">Remove</button>
                </div>
            `;
            mobileDiv.appendChild(mob);

            // Right Summary Line
            const sideItem = document.createElement("div");
            sideItem.className = "d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-secondary border-opacity-25 small text-white";
            sideItem.innerHTML = `
                <span class="text-truncate fw-medium text-white" style="max-width: 190px;" title="${item.productName}">${item.quantity}x ${item.productName}</span>
                <span class="fw-bold text-white">&#8377;${(item.price * item.quantity).toFixed(2)}</span>
            `;
            sideItemsDiv.appendChild(sideItem);
        });

        // Totals Calculation (Subtotal - Discount + DeliveryFee)
        const fee = parseFloat(document.getElementById("selectedDeliveryFee").value) || currentDeliveryFee || 0;
        const grandTotal = Math.max(0, subtotal - discount + fee);

        document.getElementById("sideSubtotal").innerText = subtotal.toFixed(2);
        document.getElementById("sideGrandTotal").innerText = grandTotal.toFixed(2);
        document.getElementById("btnFinalPriceDisplay").innerText = grandTotal.toFixed(2);

        // Coupon display
        const sideCouponRow = document.getElementById("sideCouponRow");
        if (discount > 0 && appliedCoupon) {
            sideCouponRow.style.display = "flex";
            document.getElementById("sideCouponCode").innerText = appliedCoupon.code;
            document.getElementById("sideCouponDiscount").innerText = discount.toFixed(2);
        } else {
            sideCouponRow.style.display = "none";
        }

        if (window.updateLayoutCartBadge) {
            window.updateLayoutCartBadge(totalQty);
        }
    }

    function updateQty(productId, delta) {
        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        if (!cart) return;

        const item = cart.items.find(i => i.productId === productId);
        if (item) {
            item.quantity += delta;
            if (item.quantity <= 0) {
                if (confirm(`Remove "${item.productName}" from cart?`)) {
                    cart.items = cart.items.filter(i => i.productId !== productId);
                } else {
                    item.quantity = 1;
                }
            }
            localStorage.setItem("shop_cart", JSON.stringify(cart));
            renderCart();
        }
    }

    function removeCartItem(productId) {
        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        if (!cart) return;

        cart.items = cart.items.filter(i => i.productId !== productId);
        localStorage.setItem("shop_cart", JSON.stringify(cart));
        renderCart();
    }

    function clearCart() {
        if (!confirm("Are you sure you want to clear your cart?")) return;
        localStorage.removeItem("shop_cart");
        appliedCoupon = null;
        renderCart();
    }

    // ==========================================
    // SAVE FOR LATER
    // ==========================================

    function saveForLater(productId) {
        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        if (!cart) return;

        const idx = cart.items.findIndex(i => i.productId === productId);
        if (idx === -1) return;

        const [item] = cart.items.splice(idx, 1);
        localStorage.setItem("shop_cart", JSON.stringify(cart));

        let saved = JSON.parse(localStorage.getItem("shop_saved_for_later")) || [];
        saved = saved.filter(s => s.productId !== productId);
        saved.unshift({
            productId: item.productId,
            productName: item.productName,
            price: item.price,
            shopId: cart.shopId,
            shopName: cart.shopName,
            imageUrl: item.imageUrl || "",
            stockStatus: item.stockStatus || "InStock"
        });
        localStorage.setItem("shop_saved_for_later", JSON.stringify(saved));

        renderCart();
        renderSavedForLater();
        showCartAlert(`"${item.productName}" moved to <strong>Saved for Later</strong>.`, 'warning');
    }

    function renderSavedForLater() {
        const saved = JSON.parse(localStorage.getItem("shop_saved_for_later")) || [];
        const card = document.getElementById("savedForLaterCard");
        const list = document.getElementById("savedForLaterList");
        const count = document.getElementById("savedCount");

        if (!saved || saved.length === 0) {
            card.style.display = "none";
            list.innerHTML = "";
            return;
        }

        card.style.display = "block";
        count.innerText = saved.length;
        list.innerHTML = "";

        saved.forEach(item => {
            const fallbackImg = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=60";
            const imgUrl = item.imageUrl || fallbackImg;

            const div = document.createElement("div");
            div.className = "d-flex justify-content-between align-items-center p-2 bg-dark rounded-3 border border-secondary mb-2";
            div.innerHTML = `
                <div class="d-flex align-items-center gap-2">
                    <img src="${imgUrl}" alt="${item.productName}" class="cart-item-img" style="width: 44px; height: 44px;" onerror="this.src='${fallbackImg}'" />
                    <div>
                        <strong class="text-white small d-block text-truncate" style="max-width: 180px;">${item.productName}</strong>
                        <span class="text-success small fw-bold">&#8377;${item.price.toFixed(2)}</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm py-1 px-2" onclick="moveToCart(${item.productId})">
                        <i class="fa-solid fa-cart-arrow-down me-1"></i> Move to Cart
                    </button>
                    <button class="btn btn-outline-danger btn-sm py-1 px-2" onclick="removeSaved(${item.productId})">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            `;
            list.appendChild(div);
        });
    }

    function moveToCart(productId) {
        let saved = JSON.parse(localStorage.getItem("shop_saved_for_later")) || [];
        const item = saved.find(s => s.productId === productId);
        if (!item) return;

        let cart = JSON.parse(localStorage.getItem("shop_cart")) || { shopId: null, shopName: null, items: [] };

        if (cart.shopId && cart.shopId !== item.shopId && cart.items.length > 0) {
            const ok = confirm(`Your cart contains items from "${cart.shopName}". Clear current cart to add items from "${item.shopName}"?`);
            if (!ok) return;
            cart = { shopId: item.shopId, shopName: item.shopName, items: [] };
        }

        cart.shopId = item.shopId;
        cart.shopName = item.shopName;

        const existing = cart.items.find(i => i.productId === productId);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.items.push({
                productId: item.productId,
                productName: item.productName,
                price: item.price,
                imageUrl: item.imageUrl,
                quantity: 1,
                stockStatus: item.stockStatus
            });
        }

        saved = saved.filter(s => s.productId !== productId);
        localStorage.setItem("shop_saved_for_later", JSON.stringify(saved));
        localStorage.setItem("shop_cart", JSON.stringify(cart));

        renderCart();
        renderSavedForLater();
        showCartAlert(`"${item.productName}" added to <strong>Cart</strong>!`, 'success');
    }

    function removeSaved(productId) {
        let saved = JSON.parse(localStorage.getItem("shop_saved_for_later")) || [];
        saved = saved.filter(s => s.productId !== productId);
        localStorage.setItem("shop_saved_for_later", JSON.stringify(saved));
        renderSavedForLater();
    }

    function clearSavedForLater() {
        if (!confirm("Clear all saved items?")) return;
        localStorage.removeItem("shop_saved_for_later");
        renderSavedForLater();
    }

    // ==========================================
    // COUPON VALIDATION
    // ==========================================

    function quickApplyCoupon(code) {
        document.getElementById("couponInput").value = code;
        applyCouponManual();
    }

    async function applyCouponManual() {
        const code = document.getElementById("couponInput").value.trim();
        const msg = document.getElementById("couponMessage");

        if (!code) {
            msg.className = "text-danger small mb-2";
            msg.innerText = "Please enter coupon code.";
            msg.style.display = "block";
            return;
        }

        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        if (!cart || !cart.items || cart.items.length === 0) return;

        let subtotal = 0;
        cart.items.forEach(i => subtotal += i.price * i.quantity);

        try {
            const resp = await fetch('/Home/ValidateCoupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code, subtotal: subtotal })
            });
            const data = await resp.json();

            if (data.success) {
                appliedCoupon = {
                    code: data.code,
                    discountType: data.discountType,
                    discountValue: data.discountValue,
                    discountAmount: data.discountAmount,
                    minSubtotal: subtotal
                };
                msg.className = "text-success small mb-2";
                msg.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i> ${data.message}`;
                msg.style.display = "block";
                renderCart();
            } else {
                appliedCoupon = null;
                msg.className = "text-danger small mb-2";
                msg.innerHTML = `<i class="fa-solid fa-circle-xmark me-1"></i> ${data.message}`;
                msg.style.display = "block";
                renderCart();
            }
        } catch (e) {
            console.error(e);
        }
    }

    // ==========================================
    // STOCK & PRICE CHECK
    // ==========================================

    async function checkStockAndSyncPrices(isManualTrigger = false) {
        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        if (!cart || !cart.items || cart.items.length === 0) return;

        const spinIcon = document.getElementById("syncSpinIcon");
        if (spinIcon) spinIcon.classList.add("fa-spin");

        const checkPayload = cart.items.map(item => ({
            productId: item.productId,
            clientPrice: item.price,
            quantity: item.quantity
        }));

        try {
            const resp = await fetch('/Home/CheckStockAndPrices', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(checkPayload)
            });
            const data = await resp.json();

            if (data.success && data.items) {
                let anyPriceUpdated = false;

                data.items.forEach(srvItem => {
                    const localItem = cart.items.find(i => i.productId === srvItem.productId);
                    if (localItem) {
                        if (localItem.price !== srvItem.currentPrice) {
                            localItem.price = srvItem.currentPrice;
                            localItem.priceUpdated = true;
                            anyPriceUpdated = true;
                        }
                        localItem.stockStatus = srvItem.stockStatus;
                        if (srvItem.imageUrl && !localItem.imageUrl) localItem.imageUrl = srvItem.imageUrl;
                    }
                });

                localStorage.setItem("shop_cart", JSON.stringify(cart));
                renderCart();

                if (anyPriceUpdated) {
                    showCartAlert("<strong>Price Alert:</strong> Some prices have updated to latest store prices.", 'info');
                }

                if (data.hasStockIssue) {
                    showCartAlert("<strong>Stock Alert:</strong> Some items are out of stock. Please remove or save for later.", 'danger');
                } else if (isManualTrigger && !anyPriceUpdated) {
                    showCartAlert("<i class='fa-solid fa-circle-check me-1'></i> All items in stock with verified prices!", 'success');
                }
            }
        } catch (e) {
            console.error(e);
        } finally {
            if (spinIcon) spinIcon.classList.remove("fa-spin");
        }
    }

    function showCartAlert(htmlMessage, type = 'info') {
        const container = document.getElementById("cartAlertContainer");
        if (!container) return;

        const alertDiv = document.createElement("div");
        alertDiv.className = `alert alert-${type} alert-dismissible fade show mb-3`;
        alertDiv.innerHTML = `${htmlMessage}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        container.appendChild(alertDiv);

        setTimeout(() => {
            alertDiv.classList.remove("show");
            setTimeout(() => alertDiv.remove(), 250);
        }, 5000);
    }

    // ==========================================
    // FINAL ORDER SUBMISSION
    // ==========================================

    function submitFinalOrder() {
        const cart = JSON.parse(localStorage.getItem("shop_cart"));
        if (!cart || !cart.items || cart.items.length === 0) return;

        if (hasOutOfStockItems) {
            alert("Some items in your cart are out of stock. Please remove them or save for later.");
            goToStep(1);
            return;
        }

        const mode = document.getElementById("selectedPaymentMode").value;

        if (mode === 'UPI') {
            const upi = document.getElementById("upiIdInput").value.trim();
            if (!upi) {
                alert("Please enter a valid UPI ID (e.g. rahul@okhdfcbank).");
                goToStep(4);
                return;
            }
        } else if (mode === 'CARD') {
            const card = document.getElementById("cardNum").value.trim();
            if (!card || card.length < 12) {
                alert("Please enter a valid card number.");
                goToStep(4);
                return;
            }
        }

        const btn = document.getElementById("btnPlaceOrderFinal");
        const errDiv = document.getElementById("checkoutError");
        const errMsg = document.getElementById("checkoutErrorMessage");

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Placing Your Order...';
        errDiv.style.display = "none";

        const checkoutData = {
            customerName: document.getElementById("custName").value.trim(),
            phoneNumber: document.getElementById("custPhone").value.trim(),
            deliveryAddress: document.getElementById("deliveryAddr").value.trim(),
            deliveryInstructions: document.getElementById("deliveryInstructionsInput").value.trim(),
            deliverySpeed: document.getElementById("selectedDeliverySpeed").value,
            deliveryFee: parseFloat(document.getElementById("selectedDeliveryFee").value) || 0,
            shopId: cart.shopId,
            paymentMode: mode,
            couponCode: appliedCoupon ? appliedCoupon.code : null,
            discountAmount: appliedCoupon ? appliedCoupon.discountAmount : 0,
            items: cart.items.map(item => ({
                productId: item.productId,
                quantity: item.quantity
            }))
        };

        $.ajax({
            url: '@Url.Action("Checkout", "Home")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(checkoutData),
            success: function(res) {
                if (res.success) {
                    localStorage.removeItem("shop_cart");
                    if (window.updateLayoutCartBadge) window.updateLayoutCartBadge(0);
                    window.location.href = '@Url.Action("OrderSuccess", "Home")?orderId=' + res.orderId;
                } else {
                    errMsg.innerText = res.message;
                    errDiv.style.display = "block";
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-rocket me-2"></i> Try Again';
                }
            },
            error: function(err) {
                console.error(err);
                errMsg.innerText = "Connection error. Please try again later.";
                errDiv.style.display = "block";
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-rocket me-2"></i> Place Order Now';
            }
        });
    }
</script>
