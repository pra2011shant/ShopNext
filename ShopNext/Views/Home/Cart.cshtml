                        addressLine: "Flat 402, Royal Palms Apartments, Sector 14",
                        city: "New Delhi",
                        state: "Delhi",
                        pincode: "110001",
                        landmark: "Near Metro Gate 2",
                        isDefault: true
                    },
                    {
                        id: 102,
                        addressType: "Office",
                        recipientName: "@(string.IsNullOrEmpty(custName) ? "Rahul Sharma" : custName)",
                        phoneNumber: "@(string.IsNullOrEmpty(custPhone) ? "9999988888" : custPhone)",
                        addressLine: "Floor 5, Tech Park Tower A, Cyber City",
