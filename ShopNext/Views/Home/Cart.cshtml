                        </div>
                        <div class="d-flex justify-content-between small mb-2" id="sideCouponRow" style="display: none; color: #34d399 !important;">
                            <span class="fw-semibold">Discount (<span id="sideCouponCode"></span>):</span>
                            <span class="fw-bold">-&#8377;<span id="sideCouponDiscount">0.00</span></span>
                        </div>
                        <div class="d-flex justify-content-between small mb-2" style="color: #cbd5e1 !important;">
                            <span class="fw-semibold">Delivery Fee (<span id="sideDeliveryType">Standard</span>):</span>
                            <span id="sideDeliveryFeeBadge" class="fw-bold text-success"><span class="badge bg-success bg-opacity-25 text-success">FREE</span></span>
                        </div>
                        <div class="d-flex justify-content-between small mb-3" style="color: #cbd5e1 !important;">
                            <span class="fw-semibold">Taxes & Packaging:</span>
                            <span class="text-white fw-bold">&#8377;0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-50">
                            <span class="fs-5 fw-bold text-white">Total Payable:</span>
                            <span class="fs-4 fw-extrabold" style="color: #34d399 !important;">&#8377;<span id="sideGrandTotal">0.00</span></span>
                        </div>
                    </div>

                    <div class="mt-3 p-2.5 rounded-3 border border-secondary border-opacity-30 text-center small" style="background: rgba(0, 0, 0, 0.4) !important; color: #cbd5e1 !important;">
                        <i class="fa-solid fa-shield-halved text-success me-1"></i> 100% Safe & Secure Hyperlocal Checkout
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Empty Cart View -->
    <div id="emptyCartView" class="glass-card text-center py-5" style="display: none;">
        <div class="fs-1 text-muted mb-3"><i class="fa-solid fa-cart-shopping fa-3x opacity-50"></i></div>
        <h3 class="text-white fw-bold mb-2">Aapki Cart Khali Hai!</h3>
        <p class="text-muted mb-4">Cart me koi item nahi hai. Marketplace se fresh items browse karein.</p>
        <a asp-action="Products" class="btn btn-primary px-4 py-2" style="border-radius: 12px; font-weight: 600;">
            <i class="fa-solid fa-bag-shopping me-2"></i> Browse Products
        </a>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    let currentStep = 1;
    let savedAddressesCache = [];
    let selectedAddressIndex = 0;
    let appliedCoupon = null;
    let hasOutOfStockItems = false;
    let currentDeliveryFee = 0;
    let deliveryMap = null;
    let deliveryMarker = null;

    document.addEventListener("DOMContentLoaded", function () {
        renderCart();
        renderSavedForLater();
        loadSavedAddresses();

        setTimeout(() => {
            checkStockAndSyncPrices(false);
        }, 300);
    });

    // ==========================================
    // STEPPER NAVIGATION LOGIC
    // ==========================================

    function goToStep(stepNumber) {
        if (stepNumber > 1) {
            const cart = JSON.parse(localStorage.getItem("shop_cart"));
            if (!cart || !cart.items || cart.items.length === 0) {
                alert("Your cart is empty!");
                return;
            }
            if (hasOutOfStockItems && stepNumber > 1) {
                alert("Please remove or save out-of-stock items before proceeding.");
                return;
            }
        }

        if (stepNumber >= 3) {
            const name = document.getElementById("custName").value.trim();
            const phone = document.getElementById("custPhone").value.trim();
            const addr = document.getElementById("deliveryAddr").value.trim();
            if (!name || !phone || !addr) {
                alert("Please select or enter your delivery address first.");
                goToStep(2);
                return;
            }
        }

        currentStep = stepNumber;

        // Update Panels
        for (let i = 1; i <= 5; i++) {
            const panel = document.getElementById(`panelStep${i}`);
            if (panel) {
                panel.classList.toggle("active", i === stepNumber);
            }

            const node = document.getElementById(`stepNode${i}`);
            if (node) {
                if (i < stepNumber) {
                    node.className = "step-item completed";
                    node.querySelector(".step-badge").innerHTML = '<i class="fa-solid fa-check"></i>';
                } else if (i === stepNumber) {
                    node.className = "step-item active";
                    node.querySelector(".step-badge").innerHTML = `<i class="${getStepIcon(i)}"></i>`;
                } else {
                    node.className = "step-item";
                    node.querySelector(".step-badge").innerHTML = `<i class="${getStepIcon(i)}"></i>`;
                }
            }
        }

        // Stepper Progress Bar
        const progressPercentage = ((stepNumber - 1) / 4) * 84;
        document.getElementById("stepperProgressBar").style.width = `${progressPercentage}%`;

        window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    function getStepIcon(step) {
        switch(step) {
            case 1: return "fa-solid fa-cart-shopping";
            case 2: return "fa-solid fa-location-dot";
            case 3: return "fa-solid fa-truck-fast";
            case 4: return "fa-solid fa-credit-card";
            case 5: return "fa-solid fa-circle-check";
            default: return "fa-solid fa-circle";
        }
    }

    function validateAndGoToStep(targetStep) {
        if (targetStep === 3) {
            const name = document.getElementById("custName").value.trim();
            const phone = document.getElementById("custPhone").value.trim();
            const addr = document.getElementById("deliveryAddr").value.trim();

            if (!name || !phone || !addr) {
                alert("Please select an address or add a new delivery address.");
                return;
            }
        }
        goToStep(targetStep);
    }

    function prepareStep5SummaryAndProceed() {
        document.getElementById("sumRecipientName").innerText = document.getElementById("custName").value.trim();
        document.getElementById("sumPhone").innerText = document.getElementById("custPhone").value.trim();
        document.getElementById("sumAddress").innerText = document.getElementById("deliveryAddr").value.trim();

        const speed = document.getElementById("selectedDeliverySpeed").value;
        const time = document.getElementById("selectedDeliveryTime").value;
        const fee = parseFloat(document.getElementById("selectedDeliveryFee").value) || 0;
        document.getElementById("sumDeliverySpeed").innerText = `${speed} Delivery (${fee === 0 ? 'Free' : '₹99.00'} | ${time})`;

        const instruction = document.getElementById("deliveryInstructionsInput").value.trim();
        document.getElementById("sumInstructions").innerText = instruction ? `Note: ${instruction}` : "Note: No special instructions";

        const mode = document.getElementById("selectedPaymentMode").value;
        const modeNames = {
            'COD': 'Cash on Delivery (COD)',
            'UPI': 'Instant UPI / QR Code Scanner',
            'CARD': 'Credit / Debit Card',
            'NETBANKING': 'Net Banking'
        };
        document.getElementById("sumPaymentMode").innerText = modeNames[mode] || mode;

        goToStep(5);
    }

    // ==========================================
    // DELIVERY OPTIONS (Standard vs Express)
    // ==========================================

    function selectDeliveryOption(speed, fee, timeline) {
        document.getElementById("selectedDeliverySpeed").value = speed;
        document.getElementById("selectedDeliveryFee").value = fee;
        document.getElementById("selectedDeliveryTime").value = timeline;
        currentDeliveryFee = fee;

        document.getElementById("optDeliveryStandard").classList.toggle("selected", speed === 'Standard');
        document.getElementById("optDeliveryExpress").classList.toggle("selected", speed === 'Express');
        document.getElementById("radioStandard").checked = (speed === 'Standard');
        document.getElementById("radioExpress").checked = (speed === 'Express');

        // Update side fee badge
        const sideFeeBadge = document.getElementById("sideDeliveryFeeBadge");
        const sideType = document.getElementById("sideDeliveryType");
        sideType.innerText = speed;

        if (fee === 0) {
            sideFeeBadge.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success">FREE</span>';
        } else {
            sideFeeBadge.innerHTML = `<span class="badge bg-warning bg-opacity-25 text-warning fw-bold">&#8377;${fee.toFixed(2)}</span>`;
        }

        renderCart();
    }

    function toggleInstruction(chip, text) {
        const inp = document.getElementById("deliveryInstructionsInput");
        chip.classList.toggle("selected");
        if (chip.classList.contains("selected")) {
            inp.value = inp.value ? `${inp.value}, ${text}` : text;
        } else {
            inp.value = inp.value.replace(text, '').replace(', ,', ',').trim();
        }
    }

    // ==========================================
    // MULTIPLE DELIVERY ADDRESSES (Home, Office, Other)
    // ==========================================

    async function loadSavedAddresses() {
        const listDiv = document.getElementById("addressSelectionList");
        if (!listDiv) return;

        try {
            const resp = await fetch('/Customer/GetAddresses');
            const data = await resp.json();

            if (data.success && data.addresses && data.addresses.length > 0) {
                savedAddressesCache = data.addresses;
            } else {
                // Fallback default options matching Home, Office, Other
                savedAddressesCache = [
                    {
                        id: 101,
                        addressType: "Home",
                        recipientName: "@(string.IsNullOrEmpty(custName) ? "Rahul Sharma" : custName)",
