        document.getElementById("newAddrType").value = type;
        document.querySelectorAll('.address-type-btn').forEach(b => b.classList.remove('active'));
        if (type === 'Home') document.getElementById("btnTypeHome").classList.add('active');
        if (type === 'Office') document.getElementById("btnTypeOffice").classList.add('active');
