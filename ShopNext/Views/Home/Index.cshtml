@* Views/Home/Index.cshtml *@
@{
    ViewData["Title"] = "Find Shops Near You - ShopNext";
    var sortedShops = ViewBag.SortedShops as List<ShopNext.Controllers.ShopWithDistanceDto> ?? new List<ShopNext.Controllers.ShopWithDistanceDto>();
    var todaysDeals = ViewBag.TodaysDeals as List<ShopNext.Models.Offer> ?? new List<ShopNext.Models.Offer>();
    var userLat = ViewBag.Latitude as decimal?;
    var userLng = ViewBag.Longitude as decimal?;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    .landing-container {
        padding: 1.5rem 0;
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .hero-banner {
        background: linear-gradient(135deg, #0f172a 0%, #312e81 50%, #4338ca 100%);
        border-radius: 24px;
        padding: 3.5rem 2rem;
        margin-bottom: 2.5rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.15);
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 70%);
        transform: rotate(30deg);
        pointer-events: none;
    }

    .hero-title {
        font-weight: 800;
        font-size: 2.75rem;
        margin-bottom: 0.75rem;
        letter-spacing: -0.03em;
        color: #ffffff;
    }

    .hero-subtitle {
        font-size: 1.15rem;
        font-weight: 300;
        opacity: 0.9;
        margin-bottom: 2rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        color: #e2e8f0;
    }

    .btn-gps {
        background: #ffffff;
        color: #4338ca;
        border: none;
        border-radius: 12px;
        padding: 0.85rem 1.85rem;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .btn-gps:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        background: #f8fafc;
        color: #3730a3;
    }

    .gps-status {
        font-size: 0.85rem;
        margin-top: 0.75rem;
        color: #cbd5e1;
    }

    /* Search Bar Styles */
    .search-section {
        max-width: 680px;
        margin: 1.5rem auto 2.5rem;
    }

    .glass-search-box {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 0.35rem 0.85rem 0.35rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: var(--shadow-sm);
        transition: all 0.25s ease;
    }

    .glass-search-box:focus-within {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
    }

    .search-icon {
        color: var(--primary-color);
        font-size: 1.1rem;
    }

    .search-input {
        border: none;
        background: transparent;
        color: var(--text-main);
        font-size: 1rem;
        padding: 0.75rem 0;
        width: 100%;
        font-weight: 500;
    }

    .search-input:focus {
        outline: none;
    }
    
    .search-input::placeholder {
        color: #94a3b8;
        font-weight: 400;
    }

    .btn-search-gps {
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.25);
        border-radius: 10px;
        padding: 0.45rem 0.85rem;
        font-weight: 700;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .btn-search-gps:hover {
        background: #2563eb;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        transform: translateY(-1px);
    }

    .btn-search-map {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 10px;
        padding: 0.45rem 0.75rem;
        font-weight: 700;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .btn-search-map:hover {
        background: #f59e0b;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        transform: translateY(-1px);
    }

    .location-detect-highlight {
        animation: pulseLocationBox 1.2s ease-in-out 2;
    }

    @@keyframes pulseLocationBox {
        0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.5); }
        50% { box-shadow: 0 0 0 8px rgba(37, 99, 235, 0.25); border-color: #2563eb; }
        100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.5); }
    }

    /* Point 41: Today's Deals Section Styles */
    .deals-section {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 27, 75, 0.8) 100%);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 24px;
        padding: 2rem;
        margin-bottom: 2.5rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(16px);
    }

    .deals-header-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .deal-timer-badge {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.35);
        padding: 0.45rem 1.1rem;
        border-radius: 50px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.92rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.15);
    }

    .deals-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.25rem;
    }

    .deal-card {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 1.25rem;
        position: relative;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px);
        overflow: hidden;
    }

    .deal-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(239, 68, 68, 0.25);
        border-color: rgba(239, 68, 68, 0.5);
    }

    .deal-badge-discount {
        position: absolute;
        top: 12px;
        left: 12px;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #ffffff;
        font-weight: 800;
        font-size: 0.75rem;
        padding: 0.3rem 0.65rem;
        border-radius: 8px;
        z-index: 2;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 10px rgba(220, 38, 38, 0.35);
    }

    .deal-tagline-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(6px);
        color: #fbbf24;
        font-weight: 700;
        font-size: 0.68rem;
        padding: 0.25rem 0.55rem;
        border-radius: 6px;
        border: 1px solid rgba(251, 191, 36, 0.3);
        z-index: 2;
    }

    .deal-image-wrap {
        width: 100%;
        height: 180px;
        border-radius: 14px;
        overflow: hidden;
        background: #0f172a;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .deal-image-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .deal-card:hover .deal-image-wrap img {
        transform: scale(1.06);
    }

    .deal-title {
        font-weight: 700;
        font-size: 1.05rem;
        color: #ffffff;
        margin-bottom: 0.25rem;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .deal-shop-badge {
        font-size: 0.78rem;
        color: #94a3b8;
        margin-bottom: 0.75rem;
    }

    .deal-price-row {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .deal-selling-price {
        font-size: 1.35rem;
        font-weight: 800;
        color: #10b981;
        font-family: 'JetBrains Mono', monospace;
    }

    .deal-mrp {
        font-size: 0.9rem;
        color: #94a3b8;
        text-decoration: line-through;
        font-family: 'JetBrains Mono', monospace;
    }

    .deal-savings {
        font-size: 0.75rem;
        color: #ef4444;
        font-weight: 700;
    }

    .btn-deal-order {
        background: linear-gradient(135deg, #ef4444 0%, #f59e0b 100%);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1rem;
        width: 100%;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s ease;
        margin-top: auto;
        display: block;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
    }

    .btn-deal-order:hover {
        opacity: 0.92;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(239, 68, 68, 0.35);
    }

    /* Shops Grid */
    .shops-title-section {
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1rem;
    }

    .shops-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .shop-card {
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px);
        color: #ffffff;
    }

    .shop-card:hover {
        transform: translateY(-4px);
        border-color: rgba(99, 102, 241, 0.5);
        box-shadow: 0 15px 35px rgba(99, 102, 241, 0.15);
    }

    .shop-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: white;
        margin-bottom: 1.25rem;
    }

    .shop-name {
        font-weight: 700;
        font-size: 1.25rem;
        margin-bottom: 0.25rem;
        color: #ffffff;
    }

    .shop-category {
        font-size: 0.8rem;
        background: rgba(79, 70, 229, 0.08);
        color: #4f46e5;
        padding: 0.25rem 0.65rem;
        border-radius: 50px;
        border: 1px solid rgba(79, 70, 229, 0.2);
        display: inline-block;
        margin-bottom: 0.85rem;
        align-self: flex-start;
        font-weight: 600;
    }

    .shop-distance {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .shop-distance-value {
        color: #10b981;
        font-weight: 700;
    }

    .btn-browse {
        background: #f8fafc;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.65rem 1rem;
        width: 100%;
        font-weight: 600;
        font-size: 0.92rem;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s ease;
        margin-top: auto;
        display: block;
    }

    .shop-card:hover .btn-browse {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    .empty-shops {
        text-align: center;
        padding: 3.5rem 2rem;
        background: #ffffff;
        border: 1px dashed var(--border-color);
        border-radius: 18px;
        grid-column: 1 / -1;
    }
</style>

<div class="container landing-container">
    <!-- Hero Section with Geolocation Trigger -->
    <div class="hero-banner">
        <h1 class="hero-title">ShopNext Delivery</h1>
        <p class="hero-subtitle">Apne aas-paas ki approved dukaanein dhoondhein aur ghar baithe samaan mangwayein.</p>
        <div class="d-flex flex-wrap justify-content-center gap-3 align-items-center">
            <button type="button" class="btn-gps" onclick="detectAndFillLocation(true)" id="gpsLocateBtn">
                <i class="fa-solid fa-location-crosshairs text-primary"></i> Find Shops Near Me
            </button>
            <button type="button" class="btn btn-outline-light rounded-pill px-4 py-3 fw-bold d-inline-flex align-items-center gap-2 shadow" style="font-size: 1rem; border-width: 2px;" onclick="openMapPickerModal()" id="heroOpenMapBtn">
                <i class="fa-solid fa-map-location-dot text-warning"></i> Pick on Map
            </button>
            <a asp-controller="Vendor" asp-action="Register" class="btn btn-warning fw-bold px-4 py-3 rounded-pill d-inline-flex align-items-center gap-2 shadow" style="font-size: 1rem;" id="heroBecomeSellerBtn">
                <i class="fa-solid fa-store"></i> Become a Seller
            </a>
        </div>
        <div id="gpsStatus" class="gps-status">
            @if (userLat.HasValue && userLng.HasValue)
            {
                <span class="text-white"><i class="fa-solid fa-circle-check text-success me-1"></i> Showing shops near: @userLat.Value.ToString("F4"), @userLng.Value.ToString("F4")</span>
            }
            else
            {
                <span>Allow location access to sort shops by distance from you.</span>
            }
        </div>
    </div>

    <!-- Search Bar Section with Location Pin & GPS Fill Button -->
    <div class="search-section">
        <div class="glass-search-box" id="glassSearchBox">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" id="shopSearchInput" class="search-input" placeholder="Search shops by name, category, or area..." onkeyup="filterShops()" value="@ViewBag.SearchQuery" />
            <button type="button" class="btn-search-gps" onclick="detectAndFillLocation(false)" title="Detect Current GPS Location & Auto-Fill Search" id="btnSearchGps">
                <i class="fa-solid fa-location-crosshairs"></i>
                <span class="d-none d-sm-inline">Auto Fill GPS</span>
            </button>
            <button type="button" class="btn-search-map" onclick="openMapPickerModal()" title="Pinpoint Location on Map" id="btnSearchMap">
                <i class="fa-solid fa-map-pin"></i>
            </button>
        </div>
    </div>

    <!-- Point 41: 🔥 Today's Deals Section -->
    @if (todaysDeals.Any())
    {
        <div class="deals-section">
            <div class="deals-header-wrap">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2.5 py-1 rounded-pill small fw-bold">
                            <i class="fa-solid fa-fire me-1 text-danger"></i> FLASH DEALS
                        </span>
                        <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill small">
                            Limited Time Offers
                        </span>
                    </div>
                    <h2 class="fw-bold mb-0 text-white" style="font-size: 1.85rem;">
                        <span style="color: #ef4444;">🔥 Today's</span> Deals
                    </h2>
                    <p class="text-secondary small mb-0">Exclusive promotional discounts across verified local merchant catalogs.</p>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="deal-timer-badge">
                        <i class="fa-solid fa-stopwatch text-warning me-1"></i>
                        <span class="text-secondary small me-1">Ends in:</span>
                        <span id="dealCountdownText" class="text-warning">08h : 35m : 22s</span>
                    </div>
                </div>
            </div>

            <!-- Deals Product Grid -->
            <div class="deals-grid">
                @foreach (var deal in todaysDeals)
                {
                    <div class="deal-card">
                        <!-- Discount Badge -->
                        <div class="deal-badge-discount">
                            @(deal.DiscountType == "Percentage" ? $"{deal.Discount:N0}% OFF" : $"₹{deal.Discount:N0} OFF")
                        </div>

                        <!-- Tagline Badge -->
                        @if (!string.IsNullOrWhiteSpace(deal.Tagline))
                        {
                            <div class="deal-tagline-badge">
                                @deal.Tagline
                            </div>
                        }

                        <!-- Product Thumbnail -->
                        <div class="deal-image-wrap">
                            <img src="@(!string.IsNullOrWhiteSpace(deal.Product?.ImageUrl) ? deal.Product.ImageUrl : (deal.BannerUrl ?? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500"))" 
                                 alt="@deal.Title" 
                                 onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500';" />
                        </div>

                        <!-- Product Title -->
                        <div class="deal-title" title="@(deal.Product?.ProductName ?? deal.Title)">
                            @(deal.Product?.ProductName ?? deal.Title)
                        </div>

                        <!-- Store / Category info -->
                        <div class="deal-shop-badge">
                            <i class="fa-solid fa-store text-warning me-1"></i> @(deal.Product?.Shop?.ShopName ?? "Verified Partner") <span class="mx-1 opacity-50">•</span> <span class="badge bg-secondary bg-opacity-25 text-light">@(deal.Product?.Category ?? "Special")</span>
                        </div>

                        <!-- Price Row -->
                        <div class="deal-price-row">
                            <span class="deal-selling-price">₹@deal.SellingPrice.ToString("N0")</span>
                            <span class="deal-mrp">₹@deal.Mrp.ToString("N0")</span>
                            @if (deal.Mrp > deal.SellingPrice)
                            {
                                <span class="deal-savings">Save ₹@((deal.Mrp - deal.SellingPrice).ToString("N0"))</span>
                            }
                        </div>

                        <!-- Action Button -->
                        <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@deal.ProductId" class="btn-deal-order mt-auto">
                            <i class="fa-solid fa-bolt me-1"></i> Grab Deal
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Shops Catalog Title -->
    <div class="shops-title-section d-flex justify-content-between align-items-center">
        <div>
            <h2 class="m-0" style="font-weight: 700;">Approved Store Catalog</h2>
            <p class="text-muted mb-0">Browse and order items from verified shops in your neighbourhood.</p>
        </div>
        @if (userLat.HasValue)
        {
            <span class="badge bg-secondary p-2"><i class="fa-solid fa-sort-amount-down me-1"></i> Distance: Nearest First</span>
        }
    </div>

    <!-- Shops Listing Grid -->
    <div class="shops-grid" id="shopsGrid">
        @if (!sortedShops.Any())
        {
            <div class="empty-shops" id="emptyShopsPanel">
                <div class="fs-1 text-muted mb-3"><i class="fa-solid fa-store-slash"></i></div>
                <h3>Dukaan nahi mili</h3>
                <p class="text-muted">Database me koi approved dukan register nahi mili. Pehle Vendor Panel me dukan banayein.</p>
            </div>
        }
        else
        {
            @foreach (var item in sortedShops)
            {
                <div class="shop-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="shop-icon-wrapper">
                            @if (item.Shop.Category?.Contains("Grocery") == true)
                            {
                                <i class="fa-solid fa-basket-shopping"></i>
                            }
                            else if (item.Shop.Category?.Contains("Dairy") == true)
                            {
                                <i class="fa-solid fa-cheese"></i>
                            }
                            else if (item.Shop.Category?.Contains("Electronics") == true)
                            {
                                <i class="fa-solid fa-laptop"></i>
                            }
                            else if (item.Shop.Category?.Contains("Pharmacy") == true)
                            {
                                <i class="fa-solid fa-prescription-bottle-medical"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-store"></i>
                            }
                        </div>
                        <div class="badge bg-warning bg-opacity-25 text-warning fw-bold px-2.5 py-1.5 rounded-pill border border-warning border-opacity-50">
                            ⭐ @item.Rating.ToString("0.0") Rating
                        </div>
                    </div>

                    <h3 class="shop-name">@item.Shop.ShopName</h3>
                    <span class="shop-category">@item.Shop.Category</span>
                    
                    <!-- Point 30: Total Products: 120, Total Orders: 500 -->
                    <div class="p-2 rounded-3 my-2 border border-secondary border-opacity-25 d-flex justify-content-around text-center" style="background: rgba(15, 23, 42, 0.5);">
                        <div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Total Products</div>
                            <strong class="text-white" style="font-family: monospace;">@item.TotalProducts</strong>
                        </div>
                        <div class="border-end border-secondary border-opacity-25"></div>
                        <div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Total Orders</div>
                            <strong class="text-success" style="font-family: monospace;">@item.TotalOrders</strong>
                        </div>
                    </div>

                    <!-- Point 30: Location: Patna -->
                    <div class="shop-distance mb-3">
                        <i class="fa-solid fa-location-dot text-danger"></i>
                        <span>Location: <strong class="text-white">@item.Location</strong></span>
                        @if (item.Distance >= 0)
                        {
                            <span class="ms-auto text-success small fw-bold">(@item.Distance.ToString("F1") km)</span>
                        }
                    </div>

                    <!-- Point 30: [View Shop] -->
                    <div class="mt-auto d-flex gap-2">
                        <a href="@Url.Action("ShopProfile", "Home", new { id = item.Shop.Id })" class="btn btn-primary flex-grow-1 fw-bold rounded-3 py-2 shadow-sm d-flex align-items-center justify-content-center gap-1">
                            <i class="fa-solid fa-store"></i> [View Shop]
                        </a>
                        <a href="@Url.Action("ShopCatalog", "Home", new { shopId = item.Shop.Id })" class="btn btn-outline-light rounded-3 px-2.5 py-2" title="Browse Catalog">
                            <i class="fa-solid fa-bag-shopping"></i>
                        </a>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Phase 2: Become a Seller / Dukandaar Onboarding Banner -->
    <div class="seller-cta-banner mt-5 p-4 p-md-5 rounded-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%); border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
        <div class="row align-items-center g-4">
            <div class="col-lg-8 text-white">
                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3">
                    <i class="fa-solid fa-store me-1"></i> PHASE 2 &bull; LOCAL DUKANDAAR
                </span>
                <h2 class="fw-bold fs-2 text-white mb-2">Apni Dukaan Ko Banayein Online Superstore</h2>
                <p class="text-light opacity-75 fs-6 mb-3">
                    Kya aap dukandaar hain? ShopNext par apni dukaan register karein, hazaron local customers se direct orders paayein, aur hyperlocal delivery rider network ka faayda uthayein.
                </p>
                <div class="d-flex flex-wrap gap-3 text-light small opacity-90">
                    <div><i class="fa-solid fa-circle-check text-success me-1"></i> 2-Minute Quick Setup</div>
                    <div><i class="fa-solid fa-circle-check text-success me-1"></i> Automatic Rider Delivery</div>
                    <div><i class="fa-solid fa-circle-check text-success me-1"></i> Direct Bank Payouts</div>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end text-center">
                <a asp-controller="Vendor" asp-action="Register" class="btn btn-warning btn-lg px-4 py-3 fw-bold rounded-pill shadow-lg d-inline-flex align-items-center gap-2" id="homeBecomeSellerCta">
                    <i class="fa-solid fa-store fa-lg text-dark"></i> Become a Seller
                </a>
                <div class="text-white-50 small mt-2">Free registration &bull; Instant approval</div>
            </div>
        </div>
    </div>
</div>

<!-- Point 25 & Live Location: Interactive Map Location Picker Modal -->
<div class="modal fade" id="mapLocationModal" tabindex="-1" aria-labelledby="mapLocationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: rgba(15, 23, 42, 0.98); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.6); color: #ffffff;">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="mapLocationModalLabel">
                    <i class="fa-solid fa-map-location-dot text-warning"></i> Select Location on Interactive Map
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <span class="small text-muted"><i class="fa-solid fa-arrows-up-down-left-right me-1 text-info"></i> Drag pin or click anywhere on map to select location:</span>
                    <button type="button" class="btn btn-outline-info btn-sm rounded-pill fw-bold" onclick="locateUserOnMap()">
                        <i class="fa-solid fa-crosshairs me-1"></i> Detect Live GPS
                    </button>
                </div>
                
                <div id="indexPickerMap" style="height: 350px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.15); z-index: 1;"></div>
                
                <!-- Live Geocoded Address Preview -->
                <div class="mt-3 p-3 rounded-3" style="background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(59, 130, 246, 0.3);">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fa-solid fa-location-dot text-danger fs-5"></i>
                        <span class="fw-bold text-white small text-uppercase">Selected Location Address:</span>
                    </div>
                    <div id="modalSelectedAddress" class="fw-semibold text-warning" style="font-size: 0.95rem;">Detecting address...</div>
                    <div id="modalSelectedCoords" class="text-secondary small mt-1 font-monospace">Lat: --, Lng: --</div>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 pt-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow" onclick="applySelectedMapLocation()">
                    <i class="fa-solid fa-check me-1"></i> Use This Location & Auto-Fill Search
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let pickerMap = null;
    let pickerMarker = null;
    let currentSelectedLat = @(userLat.HasValue ? userLat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "28.6139");
    let currentSelectedLng = @(userLng.HasValue ? userLng.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "77.2090");
    let currentSelectedAddress = "Connaught Place, New Delhi";

    // Reverse Geocoding Helper
    async function reverseGeocodeCoords(lat, lng) {
        try {
            // First try Nominatim OpenStreetMap Reverse Geocode
            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`, {
                headers: { 'Accept': 'application/json' }
            });
            if (response.ok) {
                const data = await response.json();
                if (data && data.address) {
                    const addr = data.address;
                    const parts = [];
                    if (addr.suburb || addr.neighbourhood || addr.residential || addr.road) {
                        parts.push(addr.suburb || addr.neighbourhood || addr.residential || addr.road);
                    }
                    if (addr.city || addr.town || addr.village || addr.county) {
                        parts.push(addr.city || addr.town || addr.village || addr.county);
                    }
                    if (addr.state) {
                        parts.push(addr.state);
                    }
                    if (addr.postcode) {
                        parts.push(addr.postcode);
                    }
                    if (parts.length > 0) {
                        return parts.join(', ');
                    }
                    if (data.display_name) {
                        return data.display_name.split(',').slice(0, 3).join(', ');
                    }
                }
            }
        } catch (e) {
            console.warn("Primary geocoding failed, trying secondary fallback...", e);
        }

        try {
            // Secondary fallback via BigDataCloud Reverse Geocoding
            const bdcRes = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lng}&localityLanguage=en`);
            if (bdcRes.ok) {
                const bdcData = await bdcRes.json();
                const parts = [];
                if (bdcData.locality) parts.push(bdcData.locality);
                if (bdcData.city) parts.push(bdcData.city);
                if (bdcData.principalSubdivision) parts.push(bdcData.principalSubdivision);
                if (parts.length > 0) {
                    return parts.join(', ');
                }
            }
        } catch (err) {
            console.warn("Secondary geocoding fallback failed", err);
        }

        return `Location (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
    }

    // Live GPS Detection & Auto-Fill in Search Box
    async function detectAndFillLocation(reloadUrl = false) {
        const searchBox = document.getElementById("glassSearchBox");
        const searchInput = document.getElementById("shopSearchInput");
        const status = document.getElementById("gpsStatus");
        const heroBtn = document.getElementById("gpsLocateBtn");
        const searchGpsBtn = document.getElementById("btnSearchGps");

        if (!navigator.geolocation) {
            Swal.fire({
                icon: 'error',
                title: 'GPS Unsupported',
                text: 'Geolocation is not supported by your browser.',
                background: '#0f172a',
                color: '#ffffff'
            });
            return;
        }

        if (heroBtn) heroBtn.innerHTML = "<i class='fa-solid fa-spinner fa-spin me-1'></i> Getting GPS...";
        if (searchGpsBtn) searchGpsBtn.innerHTML = "<i class='fa-solid fa-spinner fa-spin'></i>";
        if (status) status.innerText = "Accessing browser live GPS coordinates...";

        navigator.geolocation.getCurrentPosition(
            async (position) => {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                currentSelectedLat = lat;
                currentSelectedLng = lng;

                if (status) status.innerText = "Resolving street & area address...";

                const address = await reverseGeocodeCoords(lat, lng);
                currentSelectedAddress = address;

                // Fill directly into the search input field
                if (searchInput) {
                    searchInput.value = address;
                }

                // Add visual glowing ripple feedback
                if (searchBox) {
                    searchBox.classList.remove("location-detect-highlight");
                    void searchBox.offsetWidth; // trigger reflow
                    searchBox.classList.add("location-detect-highlight");
                }

                if (heroBtn) heroBtn.innerHTML = "<i class='fa-solid fa-location-crosshairs text-primary me-1'></i> Find Shops Near Me";
                if (searchGpsBtn) searchGpsBtn.innerHTML = "<i class='fa-solid fa-location-crosshairs'></i> <span class='d-none d-sm-inline'>Auto Fill GPS</span>";
                if (status) status.innerHTML = `<span class='text-white'><i class='fa-solid fa-circle-check text-success me-1'></i> Live GPS Location: <strong>${address}</strong></span>`;

                Swal.fire({
                    icon: 'success',
                    title: '📍 Location Detected & Filled!',
                    html: `
                        <div class="text-start">
                            <p class="mb-2 text-white">Aapki live GPS location detect karke search box me auto-fill kar di gayi hai:</p>
                            <div class="p-2 rounded bg-dark border border-primary text-warning fw-bold small mb-2">
                                <i class="fa-solid fa-location-dot me-1 text-danger"></i> ${address}
                            </div>
                            <div class="text-secondary small font-monospace">GPS Coordinates: ${lat.toFixed(5)}, ${lng.toFixed(5)}</div>
                        </div>
                    `,
                    background: '#0f172a',
                    color: '#ffffff',
                    confirmButtonColor: '#3b82f6',
                    confirmButtonText: reloadUrl ? 'Filter Nearby Shops' : 'OK'
                }).then(() => {
                    if (reloadUrl) {
                        window.location.href = `/?lat=${lat}&lng=${lng}`;
                    } else {
                        filterShops();
                    }
                });
            },
            async (error) => {
                console.warn("GPS Access Error:", error);
                if (heroBtn) heroBtn.innerHTML = "<i class='fa-solid fa-location-crosshairs text-primary me-1'></i> Find Shops Near Me";
                if (searchGpsBtn) searchGpsBtn.innerHTML = "<i class='fa-solid fa-location-crosshairs'></i> <span class='d-none d-sm-inline'>Auto Fill GPS</span>";

                // Graceful fallback with standard Delhi coordinates
                const fallbackAddress = "Connaught Place, New Delhi";
                if (searchInput) searchInput.value = fallbackAddress;
                if (status) status.innerHTML = `<span class='text-warning'><i class='fa-solid fa-circle-exclamation me-1'></i> GPS permission not granted. Filled default area: ${fallbackAddress}</span>`;
                
                Swal.fire({
                    icon: 'info',
                    title: 'Default Location Applied',
                    html: `<p class="text-white small">GPS permission allow nahi hui. Standard location <strong>"${fallbackAddress}"</strong> search box me fill kar di gayi hai.</p>`,
                    background: '#0f172a',
                    color: '#ffffff',
                    confirmButtonColor: '#3b82f6'
                });
                filterShops();
            },
            { timeout: 8000, enableHighAccuracy: true }
        );
    }

    // Interactive Map Modal Initialization
    function openMapPickerModal() {
        const modalEl = document.getElementById('mapLocationModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        modalEl.addEventListener('shown.bs.modal', function () {
            initLeafletPickerMap();
        }, { once: true });
    }

    function initLeafletPickerMap() {
        if (pickerMap) {
            pickerMap.invalidateSize();
            return;
        }

        pickerMap = L.map('indexPickerMap').setView([currentSelectedLat, currentSelectedLng], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(pickerMap);

        const customIcon = L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34],
            shadowSize: [41, 41]
        });

        pickerMarker = L.marker([currentSelectedLat, currentSelectedLng], {
            draggable: true,
            icon: customIcon
        }).addTo(pickerMap);

        pickerMarker.bindPopup("<b>📍 Drag me</b> to your exact delivery location").openPopup();

        // Marker Drag Event
        pickerMarker.on('dragend', async function (e) {
            const pos = e.target.getLatLng();
            updateModalLocationData(pos.lat, pos.lng);
        });

        // Map Click Event
        pickerMap.on('click', async function (e) {
            pickerMarker.setLatLng(e.latlng);
            updateModalLocationData(e.latlng.lat, e.latlng.lng);
        });

        updateModalLocationData(currentSelectedLat, currentSelectedLng);
    }

    async function updateModalLocationData(lat, lng) {
        currentSelectedLat = lat;
        currentSelectedLng = lng;
        
        const addrDiv = document.getElementById("modalSelectedAddress");
        const coordsDiv = document.getElementById("modalSelectedCoords");
        
        if (addrDiv) addrDiv.innerText = "Resolving street & area name...";
        if (coordsDiv) coordsDiv.innerText = `Lat: ${lat.toFixed(5)}, Lng: ${lng.toFixed(5)}`;

        const address = await reverseGeocodeCoords(lat, lng);
        currentSelectedAddress = address;

        if (addrDiv) addrDiv.innerText = address;
    }

    function locateUserOnMap() {
        if (!navigator.geolocation) {
            alert("Geolocation is not supported by your browser.");
            return;
        }

        navigator.geolocation.getCurrentPosition(
            (pos) => {
                const lat = pos.coords.latitude;
                const lng = pos.coords.longitude;
                if (pickerMap && pickerMarker) {
                    pickerMap.flyTo([lat, lng], 16);
                    pickerMarker.setLatLng([lat, lng]);
                    updateModalLocationData(lat, lng);
                }
            },
            () => {
                alert("Could not access live GPS location.");
            },
            { timeout: 6000, enableHighAccuracy: true }
        );
    }

    function applySelectedMapLocation() {
        const searchInput = document.getElementById("shopSearchInput");
        const searchBox = document.getElementById("glassSearchBox");
        const status = document.getElementById("gpsStatus");

        if (searchInput && currentSelectedAddress) {
            searchInput.value = currentSelectedAddress;
        }

        if (searchBox) {
            searchBox.classList.remove("location-detect-highlight");
            void searchBox.offsetWidth;
            searchBox.classList.add("location-detect-highlight");
        }

        if (status) {
            status.innerHTML = `<span class='text-white'><i class='fa-solid fa-map-pin text-danger me-1'></i> Selected Location: <strong>${currentSelectedAddress}</strong></span>`;
        }

        const modalEl = document.getElementById('mapLocationModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();

        filterShops();

        Swal.fire({
            icon: 'success',
            title: '📍 Location Applied!',
            text: `Selected location "${currentSelectedAddress}" has been auto-filled into search!`,
            background: '#0f172a',
            color: '#ffffff',
            confirmButtonColor: '#3b82f6',
            timer: 2000
        });
    }

    function filterShops() {
        const input = document.getElementById("shopSearchInput");
        const filter = input.value.toLowerCase().trim();
        const grid = document.getElementById("shopsGrid");
        if (!grid) return;
        const cards = grid.getElementsByClassName("shop-card");
        let visibleCount = 0;

        for (let i = 0; i < cards.length; i++) {
            const card = cards[i];
            const name = card.querySelector(".shop-name")?.innerText?.toLowerCase() || "";
            const category = card.querySelector(".shop-category")?.innerText?.toLowerCase() || "";
            const distance = card.querySelector(".shop-distance")?.innerText?.toLowerCase() || "";

            if (filter === "" || name.includes(filter) || category.includes(filter) || distance.includes(filter)) {
                card.style.display = "";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        }

        // Handle empty search results state
        let emptyPanel = document.getElementById("emptySearchResultPanel");
        if (visibleCount === 0 && cards.length > 0) {
            if (!emptyPanel) {
                const emptyHtml = `
                    <div class="empty-shops" id="emptySearchResultPanel" style="grid-column: 1 / -1; text-align: center; padding: 4rem 2rem;">
                        <div class="fs-1 text-muted mb-3"><i class="fa-solid fa-magnifying-glass-minus"></i></div>
                        <h3>Koi dukaan nahi mili</h3>
                        <p class="text-muted">Aapki search query ke liye koi matching approved dukaan nahi mili.</p>
                    </div>
                `;
                grid.insertAdjacentHTML('beforeend', emptyHtml);
            }
        } else {
            if (emptyPanel) {
                emptyPanel.remove();
            }
        }
    }

    // Point 41: Live Deal Countdown Timer (Today's Deals)
    function startDealCountdown() {
        const timerEl = document.getElementById("dealCountdownText");
        if (!timerEl) return;

        const now = new Date();
        const endOfDay = new Date();
        endOfDay.setHours(23, 59, 59, 999);

        function updateTimer() {
            const currentTime = new Date();
            const diff = endOfDay - currentTime;

            if (diff <= 0) {
                timerEl.innerText = "00h : 00m : 00s";
                return;
            }

            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24).toString().padStart(2, '0');
            const minutes = Math.floor((diff / (1000 * 60)) % 60).toString().padStart(2, '0');
            const seconds = Math.floor((diff / 1000) % 60).toString().padStart(2, '0');

            timerEl.innerText = `${hours}h : ${minutes}m : ${seconds}s`;
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    }

    document.addEventListener("DOMContentLoaded", function() {
        startDealCountdown();
    });
</script>

