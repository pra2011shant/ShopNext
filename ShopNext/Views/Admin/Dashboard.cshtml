    function filterCampaignsTable(filter, btn) {
        document.querySelectorAll('.camp-filter-btn').forEach(b => {
            b.classList.remove('active', 'btn-danger', 'btn-warning', 'btn-secondary', 'text-white');
            b.classList.add('btn-dark');
        });
        if (btn) {
            btn.classList.add('active', 'btn-danger', 'text-white');
            btn.classList.remove('btn-dark');
        }

        const rows = document.querySelectorAll('#campaignsMainTable tbody tr.camp-row');
        rows.forEach(row => {
            const status = (row.getAttribute('data-status') || '').toLowerCase();
            const stage = (row.getAttribute('data-stage') || '').toLowerCase();

            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'live') {
                if (status === 'live' && (stage.includes('live') || stage.includes('now'))) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            } else if (filter === 'upcoming') {
                if (stage.includes('upcoming')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            } else if (filter === 'paused') {
                if (status === 'paused' || stage.includes('paused') || stage.includes('draft')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    }

    function searchCampaignsTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#campaignsMainTable tbody tr.camp-row');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (!q || text.includes(q)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

