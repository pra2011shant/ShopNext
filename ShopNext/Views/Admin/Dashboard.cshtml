                        actions.innerHTML = `
                            <button type="button" class="btn btn-outline-success btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="approveSellerParticipation(${id}, '${prodName}')" title="Grant Admin Approval">
                                <i class="fa-solid fa-check me-1"></i> Approve
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 rounded-3" onclick="openEditSellerDealModal(${id}, '${prodName}', 40000, 32999, 50)" title="Edit Pricing & Stock">
                                <i class="fa-solid fa-sliders"></i>
                            </button>`;
                    }
                    refreshParticipationCounters();
                } else {
                    showToast(res ? res.message : "Error rejecting participation.", true);
                }
            },
            error: function() {
                showToast("Connection error rejecting participation.", true);
            }
        });
    }

    function openEditSellerDealModal(id, prodName, regPrice, salePrice, stock) {
        document.getElementById("modalEditSellerPartId").value = id;
        document.getElementById("modalEditSellerProdName").innerText = prodName;
        document.getElementById("modalEditSellerRegPrice").value = regPrice || 0;
        document.getElementById("modalEditSellerSalePrice").value = salePrice || regPrice || 0;
        document.getElementById("modalEditSellerStock").value = stock || 50;
        document.getElementById("modalEditSellerParticipatingCheck").checked = true;
        document.getElementById("modalEditSellerNotes").value = "Approved for Mega Sale featured spotlight.";

        new bootstrap.Modal(document.getElementById('editSellerDealModal')).show();
    }

    function submitEditSellerDeal() {
        const id = parseInt(document.getElementById("modalEditSellerPartId").value) || 0;
        const salePrice = parseFloat(document.getElementById("modalEditSellerSalePrice").value) || 0;
        const stock = parseInt(document.getElementById("modalEditSellerStock").value) || 0;
        const isPart = document.getElementById("modalEditSellerParticipatingCheck").checked;
        const notes = document.getElementById("modalEditSellerNotes").value;
        const btn = document.getElementById("btnSubmitEditSellerDeal");

        if (salePrice <= 0) {
            showToast("Please enter a valid sale price (> 0).", true);
            return;
        }

        if (btn) btn.disabled = true;

        $.ajax({
            url: '@Url.Action("ToggleSellerSaleParticipation", "Admin")',
            type: 'POST',
            data: {
                id: id,
                isParticipating: isPart,
                salePrice: salePrice,
                allocatedStock: stock,
                notes: notes
            },
            success: function(res) {
                if (btn) btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('editSellerDealModal'))?.hide();
                if (res && res.success) {
                    showToast(res.message);
                    setTimeout(() => { location.reload(); }, 600);
                } else {
                    showToast(res ? res.message : "Error saving deal.", true);
                }
            },
            error: function() {
                if (btn) btn.disabled = false;
                showToast("Connection error saving deal.", true);
            }
        });
    }

    function onOptInProductSelect(selectEl) {
        const opt = selectEl.options[selectEl.selectedIndex];
        if (opt) {
            const price = parseFloat(opt.getAttribute("data-price")) || 1000;
            document.getElementById("modalOptInRegPrice").value = price;
            document.getElementById("modalOptInSalePrice").value = Math.round(price * 0.8);
        }
    }

    function openOptInDemoModal() {
        new bootstrap.Modal(document.getElementById('sellerOptInDemoModal')).show();
    }

    function submitOptInDemo() {
        const sel = document.getElementById("modalOptInProductSelect");
        const prodId = parseInt(sel.value) || 1;
        const opt = sel.options[sel.selectedIndex];
        const prodName = opt ? opt.getAttribute("data-name") : "Product";
        const salePrice = parseFloat(document.getElementById("modalOptInSalePrice").value) || 0;
        const stock = parseInt(document.getElementById("modalOptInStock").value) || 20;

        bootstrap.Modal.getInstance(document.getElementById('sellerOptInDemoModal'))?.hide();
        showToast(`☑ Product '${prodName}' submitted for Mega Sale! (Pending Admin Review)`);
        setTimeout(() => { location.reload(); }, 600);
    }

    function filterSellerParticipation(filter, btnEl) {
        document.querySelectorAll('.seller-part-filter-btn').forEach(b => {
            b.classList.remove('btn-warning', 'text-dark', 'fw-bold');
            b.classList.add('btn-outline-secondary', 'text-light');
        });
        if (btnEl) {
            btnEl.classList.remove('btn-outline-secondary', 'text-light');
            btnEl.classList.add('btn-warning', 'text-dark', 'fw-bold');
        }

        const rows = document.querySelectorAll('.seller-part-row');
        rows.forEach(r => {
            const status = r.getAttribute('data-status');
            const isPart = r.getAttribute('data-participating') === 'true';

            if (filter === 'all') {
                r.style.display = '';
            } else if (filter === 'pending') {
                r.style.display = (status === 'pending') ? '' : 'none';
            } else if (filter === 'approved') {
                r.style.display = (status === 'approved') ? '' : 'none';
            } else if (filter === 'optedout') {
                r.style.display = (status === 'optedout' || !isPart) ? '' : 'none';
            }
        });
    }

    function searchSellerParticipation(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.seller-part-row');
        rows.forEach(r => {
            const name = (r.getAttribute('data-name') || '').toLowerCase();
            const shop = (r.getAttribute('data-shop') || '').toLowerCase();
            const text = r.innerText.toLowerCase();
            if (!q || name.includes(q) || shop.includes(q) || text.includes(q)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function refreshParticipationCounters() {
        const rows = document.querySelectorAll('.seller-part-row');
        let total = rows.length;
        let approved = 0;
        let pending = 0;
        let optedOut = 0;

        rows.forEach(r => {
            const s = r.getAttribute('data-status');
            const isP = r.getAttribute('data-participating') === 'true';
            if (s === 'approved') approved++;
            else if (s === 'pending') pending++;
            else if (s === 'optedout' || !isP) optedOut++;
        });

        const cTotal = document.getElementById("countPartTotal");
        const cApp = document.getElementById("countPartApproved");
        const cPend = document.getElementById("countPartPending");
        const cOpt = document.getElementById("countPartOptedOut");

        if (cTotal) cTotal.innerText = total;
        if (cApp) cApp.innerText = approved;
        if (cPend) cPend.innerText = pending;
        if (cOpt) cOpt.innerText = optedOut;
    }

    function refreshSellerParticipations() {
        $.ajax({
            url: '@Url.Action("GetSellerSaleParticipations", "Admin")',
            type: 'GET',
            success: function(res) {
                showToast("Seller participation list refreshed! 🏪");
                refreshParticipationCounters();
            },
            error: function() {
                showToast("Connection error refreshing participations.", true);
            }
        });
    }

    // ==========================================
    // POINT 56: SALE ANALYTICS & POST-CAMPAIGN INTELLIGENCE
    // ==========================================
    function openSaleAnalyticsModal(campaignId = 1) {
        // Set selector value
        const sel = document.getElementById("modalAnalyticsCampaignSelect");
        if (sel) sel.value = campaignId;

        // Fetch data & show modal
        switchSaleAnalyticsCampaign(campaignId, false);
        const modalEl = document.getElementById('saleAnalyticsModal');
        if (modalEl) {
            new bootstrap.Modal(modalEl).show();
        }
    }

    function switchSaleAnalyticsCampaign(campaignId, showToastAlert = true) {
        campaignId = parseInt(campaignId) || 1;

        // Sync dropdowns
        const inlineSel = document.getElementById("inlineReportCampSelector");
        const modalSel = document.getElementById("modalAnalyticsCampaignSelect");
        if (inlineSel && inlineSel.value != campaignId) inlineSel.value = campaignId;
        if (modalSel && modalSel.value != campaignId) modalSel.value = campaignId;

        $.ajax({
            url: '@Url.Action("GetSaleAnalyticsReport", "Admin")',
            type: 'GET',
            data: { campaignId: campaignId },
            success: function(res) {
                if (res && res.success && res.data) {
                    renderSaleAnalyticsData(res.data);
                    if (showToastAlert) {
                        showToast(res.message || "📊 Loaded campaign report!");
                    }
                } else {
                    showToast(res ? res.message : "Error fetching sale analytics.", true);
                }
            },
            error: function() {
                showToast("Connection error retrieving sale analytics report.", true);
            }
        });
    }

    function renderSaleAnalyticsData(d) {
        if (!d) return;

        // 1. INLINE CARD METRICS (PANEL-CAMPAIGNS)
        const inlineTitle = document.getElementById("inlineReportCampName");
        const inlineStatus = document.getElementById("inlineReportCampStatus");
        const inlineRange = document.getElementById("inlineReportDateRange");
        const inOrders = document.getElementById("inlineReportTotalOrders");
        const inSold = document.getElementById("inlineReportProductsSold");
        const inRev = document.getElementById("inlineReportRevenue");
        const inCat = document.getElementById("inlineReportTopCategory");
        const inProd = document.getElementById("inlineReportTopProduct");
        const inSeller = document.getElementById("inlineReportTopSeller");
        const inRet = document.getElementById("inlineReportReturns");
        const inCanc = document.getElementById("inlineReportCancellations");
        const inRate = document.getElementById("inlineReportFulfillmentRate");

        if (inlineTitle) inlineTitle.innerText = "📊 " + (d.campaignName || "Mega Sale Report");
        if (inlineStatus) inlineStatus.innerText = (d.campaignStatus || "CONCLUDED").toUpperCase() + " • RECONCILED";
        if (inlineRange) inlineRange.innerText = d.dateRange + " • Executive Post-Campaign Intelligence & Telemetry";
        if (inOrders) inOrders.innerText = (d.totalOrders || 0).toLocaleString();
        if (inSold) inSold.innerText = (d.productsSold || 0).toLocaleString();
        if (inRev) inRev.innerText = d.revenueFormatted || ("₹" + (d.revenue || 0).toLocaleString());
        if (inCat) inCat.innerText = d.topCategory || "Electronics";
        if (inProd) inProd.innerText = d.topProduct || "Samsung Mobile";
        if (inSeller) inSeller.innerText = d.topSeller || "ABC Electronics";
        if (inRet) inRet.innerText = (d.returnsCount || 0).toLocaleString();
        if (inCanc) inCanc.innerText = (d.cancellationsCount || 0).toLocaleString();
        if (inRate) inRate.innerText = (d.fulfillmentSuccessRate || 91.8).toFixed(1) + "% (" + (d.deliveredOrders || 0).toLocaleString() + " orders)";

        // 2. MODAL HEADER & HERO KPIS
        const mTitle = document.getElementById("modalAnalyticsTitle");
        const mStatus = document.getElementById("modalAnalyticsStatusBadge");
        const mTagline = document.getElementById("modalAnalyticsTagline");
        const mOrders = document.getElementById("modalKpiTotalOrders");
        const mSold = document.getElementById("modalKpiProductsSold");
        const mRev = document.getElementById("modalKpiRevenue");
        const mComm = document.getElementById("modalKpiPlatformCommission");

        if (mTitle) mTitle.innerText = "📊 " + (d.campaignName || "Mega Sale Report");
        if (mStatus) mStatus.innerText = (d.campaignStatus || "Concluded & Reconciled");
        if (mTagline) mTagline.innerText = d.dateRange + " • Official Executive Performance Report";
        if (mOrders) mOrders.innerText = (d.totalOrders || 0).toLocaleString();
        if (mSold) mSold.innerText = (d.productsSold || 0).toLocaleString();
        if (mRev) mRev.innerText = d.revenueFormatted || ("₹" + (d.revenue || 0).toLocaleString());
        if (mComm) mComm.innerText = d.platformCommissionFormatted || "₹12.5 Lakh";

        // 3. TOP CHAMPIONS TRIO
        const mCatName = document.getElementById("modalTopCategoryName");
        const mCatRev = document.getElementById("modalTopCatRevenue");
        const mCatUnits = document.getElementById("modalTopCatUnits");
        const mCatBadge = document.getElementById("modalTopCatShareBadge");
        const mProdName = document.getElementById("modalTopProductName");
        const mProdRev = document.getElementById("modalTopProductRevenue");
        const mProdUnits = document.getElementById("modalTopProductUnits");
        const mSellerName = document.getElementById("modalTopSellerName");
        const mSellerOrders = document.getElementById("modalTopSellerOrders");
        const mSellerRev = document.getElementById("modalTopSellerRevenue");
        const mSellerRating = document.getElementById("modalTopSellerRating");

        if (mCatName) mCatName.innerText = d.topCategory || "Electronics";
        if (mCatRev) mCatRev.innerText = d.topCategoryGmvFormatted || "₹1.20 Crore";
        if (mCatUnits) mCatUnits.innerText = (d.topCategoryUnitsSold || 18500).toLocaleString() + " units";
        if (mCatBadge) mCatBadge.innerText = (d.topCategorySharePercentage || 48).toFixed(1) + "% of GMV";

        if (mProdName) mProdName.innerText = d.topProduct || "Samsung Mobile";
        if (mProdRev) mProdRev.innerText = d.topProductGmvFormatted || "₹4.09 Crore";
        if (mProdUnits) mProdUnits.innerText = (d.topProductUnitsSold || 12400).toLocaleString() + " units";

        if (mSellerName) mSellerName.innerText = d.topSeller || "ABC Electronics";
        if (mSellerOrders) mSellerOrders.innerText = (d.topSellerOrdersFulfilled || 8200).toLocaleString() + " orders";
        if (mSellerRev) mSellerRev.innerText = d.topSellerGmvFormatted || "₹82.00 Lakh";
        if (mSellerRating) mSellerRating.innerText = (d.topSellerRating || 4.9).toFixed(1) + " ★ Rating";

        // 4. RISK & TELEMETRY
        const mRet = document.getElementById("modalRiskReturns");
        const mRetRate = document.getElementById("modalRiskReturnRate");
        const mCanc = document.getElementById("modalRiskCancellations");
        const mCancRate = document.getElementById("modalRiskCancellationRate");
        const mDeliv = document.getElementById("modalRiskDelivered");
        const mDelivRate = document.getElementById("modalRiskFulfillmentRate");
        const mNetGmv = document.getElementById("modalRiskNetGmv");

        if (mRet) mRet.innerText = (d.returnsCount || 0).toLocaleString();
        if (mRetRate) mRetRate.innerText = (d.returnRate || 4.9).toFixed(1) + "% Return Rate (Healthy <7%)";
        if (mCanc) mCanc.innerText = (d.cancellationsCount || 0).toLocaleString();
        if (mCancRate) mCancRate.innerText = (d.cancellationRate || 3.3).toFixed(1) + "% Rate (Pre-dispatch)";
        if (mDeliv) mDeliv.innerText = (d.deliveredOrders || 0).toLocaleString();
        if (mDelivRate) mDelivRate.innerText = (d.fulfillmentSuccessRate || 91.8).toFixed(1) + "% Fulfillment Rate";
        if (mNetGmv) mNetGmv.innerText = d.netRevenueFormatted || "₹2.31 Cr";

        // 5. CATEGORY PROGRESS BARS
        const catContainer = document.getElementById("modalCategoryShareBars");
        if (catContainer && d.categoryShares && d.categoryShares.length > 0) {
            let catHtml = '';
            d.categoryShares.forEach(c => {
                catHtml += `
                    <div>
                        <div class="d-flex justify-content-between text-white small fw-bold mb-1">
                            <span><i class="fa-solid ${c.iconClass || 'fa-tag'} text-${c.badgeColor || 'warning'} me-1.5"></i> ${c.categoryName}</span>
                            <span class="font-monospace text-${c.badgeColor || 'warning'}">${c.revenueFormatted} (${c.sharePercentage.toFixed(1)}% Share • ${c.unitsSold.toLocaleString()} units)</span>
                        </div>
                        <div class="progress bg-dark" style="height: 10px; border-radius: 5px;">
                            <div class="progress-bar bg-${c.badgeColor || 'warning'}" role="progressbar" style="width: ${c.sharePercentage}%;" aria-valuenow="${c.sharePercentage}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                `;
            });
            catContainer.innerHTML = catHtml;
        }

        // 6. TOP 5 PRODUCTS TABLE
        const prodTableBody = document.getElementById("modalTopProductsTableBody");
        if (prodTableBody && d.topProductsList && d.topProductsList.length > 0) {
            let prodHtml = '';
            d.topProductsList.forEach((p, idx) => {
                const rankClass = idx === 0 ? "bg-warning text-dark" : "bg-secondary text-white";
                prodHtml += `
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge ${rankClass} fw-bold">#${idx + 1}</span>
                                <div>
                                    <div class="fw-bold text-white">${p.productName}</div>
                                    <small class="text-secondary">${p.categoryName}</small>
                                </div>
                            </div>
                        </td>
                        <td class="text-end font-monospace fw-bold text-info">${p.unitsSold.toLocaleString()}</td>
                        <td class="text-end font-monospace fw-bold text-success">${p.grossRevenueFormatted}</td>
                        <td class="text-end font-monospace text-danger">${p.returnsCount.toLocaleString()}</td>
                    </tr>
                `;
            });
            prodTableBody.innerHTML = prodHtml;
        }

        // 7. TOP 5 SELLERS TABLE
        const sellerTableBody = document.getElementById("modalTopSellersTableBody");
        if (sellerTableBody && d.topSellersList && d.topSellersList.length > 0) {
            let sHtml = '';
            d.topSellersList.forEach((s, idx) => {
                const rankClass = idx === 0 ? "bg-warning text-dark" : "bg-secondary text-white";
                sHtml += `
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge ${rankClass} fw-bold">#${idx + 1}</span>
                                <div>
                                    <div class="fw-bold text-white">${s.sellerName}</div>
                                    <small class="text-secondary">${s.category}</small>
                                </div>
                            </div>
                        </td>
                        <td class="text-end font-monospace fw-bold text-info">${s.ordersFulfilled.toLocaleString()}</td>
                        <td class="text-end font-monospace fw-bold text-success">${s.revenueGeneratedFormatted}</td>
                        <td class="text-end"><span class="badge bg-success bg-opacity-20 text-success">${s.rating.toFixed(1)} ★ • ${s.onTimeDispatchRate.toFixed(1)}%</span></td>
                    </tr>
                `;
            });
            sellerTableBody.innerHTML = sHtml;
        }
    }

    function exportSaleAnalyticsCsv(campaignId = 1) {
        campaignId = parseInt(campaignId) || 1;
        const exportUrl = '@Url.Action("ExportSaleAnalyticsReport", "Admin")?campaignId=' + campaignId + '&format=csv';
        showToast("📥 Exporting Sale Analytics Executive CSV Report...");
        window.location.href = exportUrl;
    }

    function printSaleAnalyticsReport() {
        window.print();
    }

    // ==========================================
    // TOAST NOTIFICATIONS
    // ==========================================
    function showToast(message, isError = false) {
        const toast = document.getElementById("adminToast");
        document.getElementById("toastMessage").innerText = message;
        document.getElementById("toastIcon").className = isError ? "fa-solid fa-circle-xmark text-danger fs-4" : "fa-solid fa-circle-check text-success fs-4";
        $(toast).fadeIn(300);
        setTimeout(() => { $(toast).fadeOut(300); }, 3500);
    }
</script>
