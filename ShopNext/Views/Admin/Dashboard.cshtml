            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    // Update table row telemetry live
                    const usedCountEl = document.getElementById(`coupon-used-${id}`);
                    const remCountEl = document.getElementById(`coupon-remaining-${id}`);
                    const progressEl = document.getElementById(`coupon-progress-${id}`);
