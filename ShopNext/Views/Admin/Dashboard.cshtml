                    if (cardUsedEl) cardUsedEl.innerText = Number(res.usedCount).toLocaleString();
                    if (cardRemEl) cardRemEl.innerText = Number(res.remaining).toLocaleString();
                    if (cardProgressEl) cardProgressEl.style.width = `${res.usagePercentage}%`;
                    if (cardPctEl) cardPctEl.innerText = `${res.usagePercentage.toFixed(1)}% claimed`;

                    if (res.isExhausted) {
                        if (rowEl) rowEl.setAttribute('data-exhausted', 'true');
