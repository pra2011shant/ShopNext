    // ==========================================
    // POINT 51: REAL-TIME TICKING COUNTDOWN & AUTO-LIFECYCLE ENGINE
    // ==========================================
    let heroTotalRemainingSeconds = 199500; // 2 days 8 hours 25 mins 00 secs
    let heroTimerInterval = null;

    function initScheduledSaleLiveCountdown() {
        if (heroTimerInterval) clearInterval(heroTimerInterval);

        heroTimerInterval = setInterval(() => {
            if (heroTotalRemainingSeconds > 0) {
                heroTotalRemainingSeconds--;

                const days = Math.floor(heroTotalRemainingSeconds / 86400);
                const hours = Math.floor((heroTotalRemainingSeconds % 86400) / 3600);
                const mins = Math.floor((heroTotalRemainingSeconds % 3600) / 60);
                const secs = heroTotalRemainingSeconds % 60;

                const dEl = document.getElementById('heroTimerDays');
                const hEl = document.getElementById('heroTimerHours');
                const mEl = document.getElementById('heroTimerMinutes');
                const sEl = document.getElementById('heroTimerSeconds');

                if (dEl) dEl.innerText = String(days).padStart(2, '0');
                if (hEl) hEl.innerText = String(hours).padStart(2, '0');
                if (mEl) mEl.innerText = String(mins).padStart(2, '0');
                if (sEl) sEl.innerText = String(secs).padStart(2, '0');
            } else {
                // Countdown reached 0 -> Auto Transition to ACTIVE
                const lbl = document.getElementById('heroCountdownLabel');
                const st = document.getElementById('heroAutoStatusText');
                if (lbl) lbl.innerHTML = '<i class="fa-solid fa-fire text-danger me-1"></i> SALE IS NOW LIVE!';
                if (st) st.innerHTML = '<i class="fa-solid fa-circle-check text-success me-1"></i> Campaign Status: ACTIVE (Live Now)';

                // Auto sync backend
                syncCampaignSchedulesManually(true);
                clearInterval(heroTimerInterval);
            }

            // Also decrement row-level timer badges
            document.querySelectorAll('.camp-row-timer').forEach(el => {
                let sec = parseInt(el.getAttribute('data-seconds'), 10) || 0;
                if (sec > 0) {
                    sec--;
                    el.setAttribute('data-seconds', sec);

                    const d = Math.floor(sec / 86400);
                    const h = Math.floor((sec % 86400) / 3600);
                    const m = Math.floor((sec % 3600) / 60);
                    const label = el.getAttribute('data-label') || 'Sale Starts In:';
                    el.innerHTML = `<i class="fa-regular fa-clock me-1"></i> ${label} ${String(d).padStart(2,'0')} Days ${String(h).padStart(2,'0')} Hours ${String(m).padStart(2,'0')} Minutes`;
                }
            });
        }, 1000);
    }

    function syncCampaignSchedulesManually(isSilent = false) {
        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("EvaluateCampaignSchedules", "Admin")',
            type: 'POST',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            success: function(res) {
                if (!isSilent) {
                    if (res && res.success) {
                        showToast(res.message);
                    } else {
                        showToast('Failed to sync schedules.', true);
                    }
                }
            },
            error: function() {
                if (!isSilent) showToast('Server communication error syncing schedules.', true);
            }
        });
    }

    // ==========================================
    // POINT 52: FLASH SALE ENGINE (Limited Stock & Live Countdown Tickers)
    // ==========================================
    let flashSaleTimerInterval = null;

    function initFlashSaleLiveCountdowns() {
        if (flashSaleTimerInterval) clearInterval(flashSaleTimerInterval);

        flashSaleTimerInterval = setInterval(() => {
            // 1. Tick showcase card timers
            document.querySelectorAll('.flash-timer-display').forEach(el => {
                let sec = parseInt(el.getAttribute('data-remaining-seconds'), 10);
                if (isNaN(sec)) return;

                if (sec > 0) {
                    sec--;
                    el.setAttribute('data-remaining-seconds', sec);

                    const hours = Math.floor(sec / 3600);
                    const mins = Math.floor((sec % 3600) / 60);
                    const secs = sec % 60;
                    el.innerText = `${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                } else if (sec === 0) {
                    el.setAttribute('data-remaining-seconds', -1);
                    el.innerHTML = '<span class="text-secondary"><i class="fa-solid fa-hourglass-end me-1"></i> EXPIRED</span>';
                }
            });

            // 2. Tick table timers
            document.querySelectorAll('.flash-table-timer').forEach(el => {
                let sec = parseInt(el.getAttribute('data-remaining-seconds'), 10);
                if (isNaN(sec)) return;

                if (sec > 0) {
                    sec--;
                    el.setAttribute('data-remaining-seconds', sec);

                    const hours = Math.floor(sec / 3600);
                    const mins = Math.floor((sec % 3600) / 60);
                    const secs = sec % 60;
                    el.innerHTML = `<i class="fa-regular fa-clock me-1"></i> ${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                }
            });
        }, 1000);
    }

    function calculateFlashDiscountPreview() {
        const orig = parseFloat(document.getElementById('modalFlashOrigPrice').value) || 0;
        const flash = parseFloat(document.getElementById('modalFlashPrice').value) || 0;
        const previewEl = document.getElementById('modalFlashDiscountPreview');

        if (orig > 0 && flash > 0 && orig >= flash) {
            const discAmt = orig - flash;
            const pct = Math.round((discAmt / orig) * 100);
            previewEl.innerHTML = `<small class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-3 py-1 rounded-pill font-monospace fw-bold">Discount: ${pct}% OFF (Save ₹${discAmt.toLocaleString('en-IN')})</small>`;
        } else if (flash > orig && orig > 0) {
            previewEl.innerHTML = `<small class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-3 py-1 rounded-pill font-monospace fw-bold">Warning: Flash price is higher than original price</small>`;
        }
    }

