    function submitEditOffer() {
        const id = document.getElementById("editOfferId").value;
        const productId = document.getElementById("editOfferProductId").value;
        const title = document.getElementById("editOfferTitle").value.trim();
        const mrp = parseFloat(document.getElementById("editOfferMrp").value) || 0;
        const sellingPrice = parseFloat(document.getElementById("editOfferPrice").value) || 0;
        const discountPct = parseFloat(document.getElementById("editOfferDiscountVal").value) || 0;
        const startDate = document.getElementById("editOfferStart").value;
        const endDate = document.getElementById("editOfferEnd").value;
        const status = document.getElementById("editOfferStatus").value;
        const desc = document.getElementById("editOfferDesc").value.trim();

        if (!productId) {
            showToast("Please select a target product.", true);
            return;
        }

        const btn = document.getElementById("btnSubmitEditOffer");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("EditOffer", "Admin")',
            type: 'POST',
            data: {
                id: id,
                productId: productId,
                title: title,
                mrp: mrp,
                sellingPrice: sellingPrice,
                discountPercentage: discountPct,
                startDate: startDate,
                endDate: endDate,
                status: status,
                description: desc
            },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('editOfferModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    setTimeout(() => { location.reload(); }, 800);
                } else {
                    showToast(res.message || "Error updating offer.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error updating offer deal.", true);
            }
        });
    }

