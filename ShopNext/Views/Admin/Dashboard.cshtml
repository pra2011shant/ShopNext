    function filterFlashSaleTable(filter, btn) {
        document.querySelectorAll('.flash-filter-btn').forEach(b => {
            b.classList.remove('active', 'btn-warning', 'text-dark');
            b.classList.add('btn-dark');
        });
        if (btn) {
            btn.classList.add('active', 'btn-warning', 'text-dark');
            btn.classList.remove('btn-dark');
        }

        const rows = document.querySelectorAll('#flashSalesMainTable tbody tr.flash-table-row');
        rows.forEach(row => {
            const status = (row.getAttribute('data-status') || '').toLowerCase();
            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'live') {
                row.style.display = (status === 'live') ? '' : 'none';
            } else if (filter === 'soldout') {
                row.style.display = (status === 'soldout') ? '' : 'none';
            } else if (filter === 'paused') {
                row.style.display = (status === 'paused') ? '' : 'none';
            }
        });
    }

    function searchFlashSaleTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#flashSalesMainTable tbody tr.flash-table-row');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = (!q || text.includes(q)) ? '' : 'none';
        });
    }

