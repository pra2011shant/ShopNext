                                        <th>Merchant / Shop</th>
                                        <th>Gross Amount</th>
                                        <th>Rate</th>
                                        <th>Commission Earned</th>
                                        <th>Net Seller Payout</th>
                                        <th>Payout Status</th>
                                        <th>Settlement Date</th>
                                    </tr>
                                </thead>
                                <tbody id="commissionReportTableBody">
                                    @foreach (var cm in Model.Reports.CommissionReports)
                                    {
                                        <tr>
                                            <td class="fw-bold text-info">@cm.CommissionId</td>
                                            <td class="text-light">@cm.OrderNumber</td>
                                            <td class="text-secondary small">@cm.OrderDate</td>
                                            <td class="fw-semibold text-white">@cm.ShopName</td>
                                            <td class="fw-bold text-white">₹@cm.GrossAmount.ToString("N2")</td>
                                            <td><span class="badge bg-secondary bg-opacity-40 text-light">@cm.CommissionRate%</span></td>
                                            <td class="fw-bold text-success">₹@cm.CommissionAmount.ToString("N2")</td>
                                            <td class="fw-bold text-info">₹@cm.NetSellerPayout.ToString("N2")</td>
                                            <td><span class="badge bg-success bg-opacity-25 text-success">@cm.PayoutStatus</span></td>
                                            <td class="text-secondary small">@cm.SettlementDate</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 16. TAB: NOTIFICATIONS (Point 44: Real-Time Platform System Notifications) -->
        <div class="tab-panel-container" id="panel-notifications">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-bell text-warning me-2"></i> Platform System Notifications</h3>
                        <p class="text-secondary small mb-0">System alerts for Admin (New Sellers, New Complaints, New Returns), Sellers (New Orders, Return Requests, Product Status), and Customers (Order &amp; Refund updates).</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="adminNotifCountBadge">
                            @Model.NotificationsList.Count Notifications
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2.5">
                    @foreach (var n in Model.NotificationsList)
                    {
                        <div class="p-3 rounded-4 border border-secondary border-opacity-25 d-flex justify-content-between align-items-center flex-wrap gap-3 transition-all" style="background: rgba(15, 23, 42, 0.65);" id="notif-item-@n.Id">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center p-2.5" style="width: 44px; height: 44px; background: rgba(234, 179, 8, 0.15); color: #eab308;">
                                    @if (n.Type == "Seller")
                                    {
                                        <i class="fa-solid fa-store fs-5"></i>
                                    }
                                    else if (n.Type == "Complaint")
                                    {
                                        <i class="fa-solid fa-headset fs-5 text-danger"></i>
                                    }
                                    else if (n.Type == "Return")
                                    {
                                        <i class="fa-solid fa-rotate-left fs-5 text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-bell fs-5 text-info"></i>
                                    }
                                </div>
                                <div>
                                    <div class="fw-bold text-white fs-6">
                                        @n.Title
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-30 px-2 py-0.5 rounded-pill ms-2 small">New</span>
                                        }
                                    </div>
                                    <div class="text-secondary small">@n.Message</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="text-secondary small font-monospace"><i class="fa-regular fa-clock me-1"></i> @n.Time</span>
                                @if (!string.IsNullOrEmpty(n.LinkUrl))
                                {
                                    <a href="@n.LinkUrl" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                                        <i class="fa-solid fa-arrow-right me-1"></i> View
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 17. TAB: SETTINGS -->
        <div class="tab-panel-container" id="panel-settings">
            <div class="glass-card">
                <h3 class="section-title">
                    <span><i class="fa-solid fa-sliders text-secondary me-2"></i> Platform Commission & Operational Settings</span>
                    <span class="badge bg-secondary">System Config</span>
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.6);">
                            <label class="form-label text-secondary small fw-bold">Platform Standard Commission (%)</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" value="5.0" />
                            <small class="text-muted">Standard rate applied across merchant sales.</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.6);">
                            <label class="form-label text-secondary small fw-bold">Hyperlocal Delivery Radius (KM)</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" value="10" />
                            <small class="text-muted">Default coverage zone for store matching.</small>
                        </div>
                    </div>
                </div>
                <div class="mt-4 text-end">
                    <button class="btn btn-primary px-4 py-2 rounded-pill fw-bold" onclick="showToast('Platform settings saved successfully!')">Save Configuration</button>
                </div>
            </div>
        </div>
    </main>
</div>

