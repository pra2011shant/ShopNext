    // POINT 45: REPORTS & ANALYTICS JAVASCRIPT ENGINE
    // ==========================================
    let currentReportType = 'Sales';
    let currentReportDateFilter = '30Days';
    let currentReportStartDate = '@Model.Reports.StartDate';
    let currentReportEndDate = '@Model.Reports.EndDate';

    function switchReportModule(reportType) {
        currentReportType = reportType;

        // Update nav tabs
        document.querySelectorAll('.report-nav-tab').forEach(tab => {
            if (tab.getAttribute('data-report') === reportType) {
                tab.className = 'btn btn-sm btn-info text-dark fw-bold rounded-pill px-3 py-1.5 report-nav-tab active';
            } else {
                tab.className = 'btn btn-sm btn-outline-light rounded-pill px-3 py-1.5 report-nav-tab';
            }
        });

        // Toggle panel display
        document.querySelectorAll('.report-content-panel').forEach(p => p.style.display = 'none');
        const activePanel = document.getElementById('report-view-' + reportType);
        if (activePanel) {
            activePanel.style.display = 'block';
        }
    }

    function setReportDateFilter(filter) {
        currentReportDateFilter = filter;

        // Update button styles
        document.querySelectorAll('.report-date-btn').forEach(btn => {
            if (btn.getAttribute('data-filter') === filter) {
                btn.className = 'btn btn-sm btn-info text-dark fw-bold rounded-pill px-3 report-date-btn active';
            } else {
                btn.className = 'btn btn-sm btn-outline-light rounded-pill px-3 report-date-btn';
            }
        });

        const customBox = document.getElementById('customDateRangeBox');
        if (filter === 'Custom') {
            if (customBox) customBox.style.display = 'block';
        } else {
            if (customBox) customBox.style.display = 'none';
            fetchAndRenderReportData();
        }
    }

    function applyCustomReportDateRange() {
        const start = document.getElementById('reportCustomStartDate').value;
        const end = document.getElementById('reportCustomEndDate').value;

        if (!start || !end) {
            showToast('Please select both Start Date and End Date.', true);
            return;
        }

        currentReportStartDate = start;
        currentReportEndDate = end;
        fetchAndRenderReportData();
    }

    function fetchAndRenderReportData() {
        showToast('Refreshing ' + currentReportType + ' analytics for ' + currentReportDateFilter + '...');

        $.ajax({
            url: '@Url.Action("GetFilteredReportData", "Admin")',
            type: 'GET',
            data: {
                reportType: currentReportType,
                dateFilter: currentReportDateFilter,
                startDate: currentReportStartDate,
                endDate: currentReportEndDate
            },
            success: function(res) {
                if (res.success) {
                    // Update Summary KPIs
                    document.getElementById('kpiReportGrossSales').innerText = '₹' + Number(res.summary.totalGrossSales).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    document.getElementById('kpiReportTotalOrders').innerText = res.summary.totalOrdersCount;
                    document.getElementById('kpiReportCommission').innerText = '₹' + Number(res.summary.totalCommissionEarned).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    document.getElementById('kpiReportAov').innerText = '₹' + Number(res.summary.averageOrderValue).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                    // Re-render Active Table
                    renderReportTable(res);
                } else {
                    showToast(res.message || 'Error fetching report data.', true);
                }
            },
            error: function() {
                showToast('Server error fetching report dataset.', true);
            }
        });
    }

