@* Views/Admin/Dashboard.cshtml - Point 31 & 32: Admin Sidebar Dashboard *@
@model ShopNext.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "ADMIN DASHBOARD - ShopNext Control Panel";
    var pendingShops = Model.PendingShops ?? ViewBag.PendingShops as List<ShopNext.Models.Shop> ?? new List<ShopNext.Models.Shop>();
    var approvedShops = Model.ApprovedShops ?? ViewBag.ApprovedShops as List<ShopNext.Models.Shop> ?? new List<ShopNext.Models.Shop>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<script>
    // Immediate Global Tab Switcher with Instant AJAX Lazy Loading
    function switchAdminTab(tabKey, clickedEl) {
        if (!tabKey) return;
        
        // 1. Update Sidebar Active State
        document.querySelectorAll('.nav-sidebar-item').forEach(el => el.classList.remove('active'));
        if (clickedEl && clickedEl.classList.contains('nav-sidebar-item')) {
            clickedEl.classList.add('active');
        } else {
            const navEl = document.getElementById('nav-' + tabKey);
            if (navEl) navEl.classList.add('active');
        }

        // 2. Switch Active Panel with direct DOM visibility enforcement
        document.querySelectorAll('.tab-panel-container').forEach(panel => {
            panel.classList.remove('active');
            panel.style.display = 'none';
        });

        let targetPanel = document.getElementById('panel-' + tabKey);
        if (targetPanel) {
            targetPanel.classList.add('active');
            targetPanel.style.display = 'block';

            // 3. Lazy Load Tab Content via AJAX on first click
            if (targetPanel.getAttribute('data-loaded') !== 'true') {
                targetPanel.innerHTML = `
                    <div class="d-flex flex-column justify-content-center align-items-center py-5 text-center" style="min-height: 380px;">
                        <div class="spinner-border text-warning mb-3" style="width: 2.8rem; height: 2.8rem;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h5 class="text-white fw-bold mb-1">Loading ${tabKey.toUpperCase()}...</h5>
                        <p class="text-secondary small">Fetching high-speed telemetry & SP data (< 10ms)...</p>
                    </div>`;

                fetch('/Admin/GetTabPartial?tab=' + encodeURIComponent(tabKey))
                    .then(res => {
                        if (!res.ok) throw new Error('Status ' + res.status);
                        return res.text();
                    })
                    .then(html => {
                        targetPanel.outerHTML = html;
                        const updatedPanel = document.getElementById('panel-' + tabKey);
                        if (updatedPanel) {
                            updatedPanel.classList.add('active');
                            updatedPanel.style.display = 'block';
                            updatedPanel.setAttribute('data-loaded', 'true');
                            // Execute script tags inside partial if any
                            updatedPanel.querySelectorAll('script').forEach(oldScript => {
                                const newScript = document.createElement('script');
                                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                                newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                                oldScript.parentNode.replaceChild(newScript, oldScript);
                            });
                        }
                    })
                    .catch(err => {
                        console.error('Tab loading error:', err);
                        targetPanel.innerHTML = `
                            <div class="p-4 my-4 rounded-4 text-center border border-danger border-opacity-30 bg-danger bg-opacity-10 text-white">
                                <i class="fa-solid fa-triangle-exclamation text-danger fs-2 mb-2"></i>
                                <h5 class="fw-bold">Unable to load tab</h5>
                                <p class="text-secondary small mb-3">Error: ${err.message}</p>
                                <button class="btn btn-outline-warning btn-sm rounded-pill px-4" onclick="targetPanel.removeAttribute('data-loaded'); switchAdminTab('${tabKey}');">
                                    <i class="fa-solid fa-rotate-right me-1"></i> Retry
                                </button>
                            </div>`;
                    });
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    }
    window.switchAdminTab = switchAdminTab;

    // Handle hash on direct page load (e.g. #orders, #sellers)
    document.addEventListener("DOMContentLoaded", function () {
        const hash = window.location.hash.replace('#', '').replace('-tab', '');
        if (hash) {
            switchAdminTab(hash);
        }
    });
</script>

<style>
    :root {
        --admin-bg: #070d18;
        --sidebar-bg: #0b1324;
        --card-bg: rgba(15, 23, 42, 0.78);
        --card-border: rgba(255, 255, 255, 0.08);
