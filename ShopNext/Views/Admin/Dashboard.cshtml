    let currentEvidenceData = null;

    function openReturnEvidenceModal(orderId) {
        document.getElementById("evidTargetOrderId").value = orderId;
        document.getElementById("returnEvidenceLoader").style.display = "block";
        document.getElementById("returnEvidenceContent").style.display = "none";
        document.getElementById("evidUploadCollapse").style.display = "none";
        document.getElementById("evidResolutionNotesInput").value = "";

        const modal = new bootstrap.Modal(document.getElementById('returnEvidenceModal'));
        modal.show();

        $.ajax({
            url: '@Url.Action("GetReturnEvidenceDetails", "Admin")',
            type: 'GET',
            data: { orderId: orderId },
            success: function(res) {
                document.getElementById("returnEvidenceLoader").style.display = "none";
                if (res.success && res.order) {
                    currentEvidenceData = res.order;
                    const o = res.order;
                    document.getElementById("returnEvidenceContent").style.display = "block";

                    // Header & Summary
                    document.getElementById("mEvidOrderTitle").innerText = `Return Dispute & Photo Evidence Desk ${o.orderNumber}`;
                    document.getElementById("mEvidCustName").innerText = o.customerName;
                    document.getElementById("mEvidShopName").innerText = o.shopName;
                    document.getElementById("mEvidSku").innerText = `SKU: ${o.sku}`;
                    document.getElementById("mEvidCustomerReason").innerText = `"${o.returnReason}"`;
                    document.getElementById("mEvidRefundAmount").innerText = `₹${Number(o.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;

                    // Render Outbound & Inbound Galleries
                    renderEvidenceStage(o.outboundEvidence, o.inboundEvidence);
                } else {
                    showToast(res.message || "Failed to load evidence telemetry.", true);
                }
            },
            error: function() {
                document.getElementById("returnEvidenceLoader").style.display = "none";
                showToast("Connection error fetching return evidence photos.", true);
            }
        });
    }

    function renderEvidenceStage(outboundList, inboundList) {
        // Outbound
        document.getElementById("outboundEvidCount").innerText = `${outboundList.length} Photos`;
        const outStrip = document.getElementById("evidOutboundThumbStrip");
        outStrip.innerHTML = "";
        if (outboundList.length > 0) {
            const first = outboundList[0];
            selectOutboundEvidence(first.photoUrl, first.title, first.uploadedBy || first.role, first.date, first.description, first.type);

            outboundList.forEach((ev, idx) => {
                const thumb = document.createElement("div");
                thumb.className = `rounded-2 overflow-hidden border ${idx === 0 ? 'border-info border-2' : 'border-secondary border-opacity-40'} cursor-pointer flex-shrink-0`;
                thumb.style = "width: 58px; height: 58px; cursor: pointer; background: #070d18;";
                thumb.innerHTML = `<img src="${ev.photoUrl}" class="w-100 h-100 object-fit-cover" title="${ev.title}" alt="${ev.title}" onerror="this.src='https://images.unsplash.com/photo-1610945415295-d9bbf067e59c?w=100'" />`;
                thumb.onclick = function() {
                    Array.from(outStrip.children).forEach(c => c.className = "rounded-2 overflow-hidden border border-secondary border-opacity-40 cursor-pointer flex-shrink-0");
                    thumb.className = "rounded-2 overflow-hidden border border-info border-2 cursor-pointer flex-shrink-0";
                    selectOutboundEvidence(ev.photoUrl, ev.title, ev.uploadedBy || ev.role, ev.date, ev.description, ev.type);
                };
                outStrip.appendChild(thumb);
            });
        }

        // Inbound
        document.getElementById("inboundEvidCount").innerText = `${inboundList.length} Photos`;
        const inStrip = document.getElementById("evidInboundThumbStrip");
        inStrip.innerHTML = "";
        if (inboundList.length > 0) {
            const first = inboundList[0];
            selectInboundEvidence(first.photoUrl, first.title, first.uploadedBy || first.role, first.date, first.description, first.type);

            inboundList.forEach((ev, idx) => {
                const thumb = document.createElement("div");
                thumb.className = `rounded-2 overflow-hidden border ${idx === 0 ? 'border-danger border-2' : 'border-secondary border-opacity-40'} cursor-pointer flex-shrink-0`;
                thumb.style = "width: 58px; height: 58px; cursor: pointer; background: #070d18;";
                thumb.innerHTML = `<img src="${ev.photoUrl}" class="w-100 h-100 object-fit-cover" title="${ev.title}" alt="${ev.title}" onerror="this.src='https://images.unsplash.com/photo-1569429593410-b498b3fb3387?w=100'" />`;
                thumb.onclick = function() {
                    Array.from(inStrip.children).forEach(c => c.className = "rounded-2 overflow-hidden border border-secondary border-opacity-40 cursor-pointer flex-shrink-0");
                    thumb.className = "rounded-2 overflow-hidden border border-danger border-2 cursor-pointer flex-shrink-0";
                    selectInboundEvidence(ev.photoUrl, ev.title, ev.uploadedBy || ev.role, ev.date, ev.description, ev.type);
                };
                inStrip.appendChild(thumb);
            });
        }
    }

    function selectOutboundEvidence(url, title, uploader, date, desc, type) {
        document.getElementById("evidMainOutboundImg").src = url;
        document.getElementById("evidOutboundTitle").innerText = title;
        document.getElementById("evidOutboundUploader").innerText = `Uploaded by ${uploader}`;
        document.getElementById("evidOutboundDate").innerText = date;
        document.getElementById("evidOutboundDesc").innerText = desc || "Verified outbound photo.";
