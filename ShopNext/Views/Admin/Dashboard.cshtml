                    document.getElementById("returnModalContent").style.display = "block";
                    
                    document.getElementById("mReturnProdImg").src = d.productImage || 'https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=500';
                    document.getElementById("mReturnProdName").innerText = d.productName;
