    // Status Filter Handler for Products
    function filterProductTable(status, btn) {
        document.querySelectorAll('.product-filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.product-table-row');
        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            if (status === 'all' || rowStatus.toLowerCase() === status.toLowerCase()) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // [View] Product Approval Modal
    function viewProductApprovalModal(productId) {
        const modal = new bootstrap.Modal(document.getElementById('productDetailsApprovalModal'));
        document.getElementById("prodModalLoader").style.display = "block";
        document.getElementById("prodModalContent").style.display = "none";
        modal.show();

        $.ajax({
            url: '@Url.Action("GetProductApprovalDetails", "Admin")',
            type: 'GET',
            data: { id: productId },
            success: function(res) {
                document.getElementById("prodModalLoader").style.display = "none";
                if (res.success && res.product) {
                    const p = res.product;
                    document.getElementById("prodModalContent").style.display = "block";

                    // Basic details
                    document.getElementById("mProdName").innerText = p.productName;
                    document.getElementById("mProdCategory").innerText = p.category;
                    document.getElementById("mProdBrand").innerHTML = `<i class="fa-solid fa-copyright me-1"></i> ${p.brand}`;
                    document.getElementById("mProdImage").src = p.imageUrl || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100';

                    // Price & Stock
                    document.getElementById("mProdPrice").innerText = '₹' + p.price.toLocaleString('en-IN');
                    document.getElementById("mProdMrp").innerText = p.mrp ? ('₹' + p.mrp.toLocaleString('en-IN')) : 'N/A';
                    document.getElementById("mProdDiscount").innerText = p.discount ? (p.discount + '% OFF') : '0%';
                    document.getElementById("mProdStock").innerText = p.stock + ' units';
                    document.getElementById("mProdSku").innerText = p.sku || ('PRD-' + p.id);

                    // Seller Info
                    document.getElementById("mProdShopName").innerText = p.shopName;
                    document.getElementById("mProdSellerOwner").innerText = p.sellerOwner;
                    document.getElementById("mProdSellerMobile").innerText = p.sellerMobile;
                    document.getElementById("mProdSellerAddress").innerText = p.sellerCity;
                    document.getElementById("mProdCreatedDate").innerText = p.createdDate;
                    document.getElementById("mProdDescription").innerText = p.description || 'No description provided.';

                    // Approval Status Badge
                    const badge = document.getElementById("mProdApprovalBadge");
                    if (p.isApproved && p.approvalStatus === "Approved") {
                        badge.className = "badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-3 py-1 rounded-pill";
                        badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Approved & Live';
                    } else if (p.approvalStatus === "Rejected") {
                        badge.className = "badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-3 py-1 rounded-pill";
                        badge.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i> Rejected';
                    } else {
                        badge.className = "badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-3 py-1 rounded-pill";
                        badge.innerHTML = '<i class="fa-solid fa-clock me-1"></i> Pending Review';
                    }

                    // Rejection Reason Box
                    const rejBox = document.getElementById("mProdRejectionBox");
                    if (p.approvalStatus === "Rejected" && p.rejectionReason) {
                        rejBox.style.display = "block";
                        document.getElementById("mProdRejectionReason").innerText = p.rejectionReason;
                    } else {
                        rejBox.style.display = "none";
                    }

                    // Multi-Angle Image Gallery (Point 21)
                    const galleryContainer = document.getElementById("mProdGalleryContainer");
                    const galleryTray = document.getElementById("mProdGalleryTray");
                    galleryTray.innerHTML = '';
                    if (p.galleryImages && p.galleryImages.length > 0) {
                        p.galleryImages.forEach(img => {
                            const imgDiv = document.createElement('div');
                            imgDiv.className = 'rounded-3 overflow-hidden border border-secondary border-opacity-25 p-1 bg-dark';
                            imgDiv.style.width = '64px';
                            imgDiv.style.height = '64px';
                            imgDiv.innerHTML = `<img src="${img}" class="w-100 h-100 object-fit-cover rounded-2" title="Product Photo Angle" />`;
                            galleryTray.appendChild(imgDiv);
                        });
                        galleryContainer.style.display = 'block';
                    } else {
                        galleryContainer.style.display = 'none';
                    }

                    // Variants Table (Point 22)
                    const varContainer = document.getElementById("mProdVariantsContainer");
                    const varBody = document.getElementById("mProdVariantsBody");
                    varBody.innerHTML = '';
                    if (p.variants && p.variants.length > 0) {
                        p.variants.forEach(v => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td class="fw-bold text-white">${v.size || '-'}</td>
                                <td><span class="badge bg-secondary bg-opacity-30 text-light">${v.color || '-'}</span></td>
                                <td class="font-monospace text-info fw-bold">₹${v.price ? v.price.toLocaleString('en-IN') : p.price.toLocaleString('en-IN')}</td>
                                <td class="font-monospace text-success">${v.stock} units</td>
                                <td class="font-monospace text-secondary">${v.sku || '-'}</td>
                            `;
                            varBody.appendChild(tr);
                        });
                        varContainer.style.display = 'block';
                    } else {
                        varContainer.style.display = 'none';
                    }

                    // Modal action buttons setup
                    const btnApprove = document.getElementById("mBtnApproveProd");
                    const btnReject = document.getElementById("mBtnRejectProd");
                    
                    btnApprove.onclick = function() {
                        bootstrap.Modal.getInstance(document.getElementById('productDetailsApprovalModal'))?.hide();
                        approveProduct(p.id);
                    };

                    btnReject.onclick = function() {
                        bootstrap.Modal.getInstance(document.getElementById('productDetailsApprovalModal'))?.hide();
                        openRejectProductModal(p.id, p.productName);
                    };

                    if (p.isApproved && p.approvalStatus === "Approved") {
                        btnApprove.style.display = "none";
                        btnReject.style.display = "inline-block";
                    } else if (p.approvalStatus === "Rejected") {
                        btnApprove.style.display = "inline-block";
                        btnReject.style.display = "none";
                    } else {
                        btnApprove.style.display = "inline-block";
                        btnReject.style.display = "inline-block";
                    }
                } else {
                    showToast(res.message || "Failed to load product specifications.", true);
                }
            },
            error: function() {
                document.getElementById("prodModalLoader").style.display = "none";
                showToast("Connection error fetching product review data.", true);
            }
        });
    }

    // [Approve] Product Handler
    function approveProduct(productId) {
        $.ajax({
            url: '@Url.Action("ApproveProduct", "Admin")',
            type: 'POST',
            data: { id: productId },
            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    updateProductRowStatus(productId, "Approved");
                } else {
                    showToast(res.message || "Error approving product.", true);
                }
            },
            error: function() {
                showToast("Connection error approving product.", true);
            }
        });
    }

    // [Reject] Product Modal Open
    function openRejectProductModal(productId, productName) {
        document.getElementById("rejectTargetProdId").value = productId;
        document.getElementById("rejectProdNameDisplay").innerText = productName;
        document.getElementById("rejectProdReasonInput").value = "";
        new bootstrap.Modal(document.getElementById('rejectProductModal')).show();
    }

    function setRejectReason(reasonText) {
        document.getElementById("rejectProdReasonInput").value = reasonText;
    }

    // Confirm Reject Product Handler
    function confirmRejectProduct() {
        const productId = document.getElementById("rejectTargetProdId").value;
        const reason = document.getElementById("rejectProdReasonInput").value.trim();
        const btn = document.getElementById("btnConfirmRejectProd");

        if (!reason) {
            alert("Please specify a reason for rejecting the product submission.");
            return;
        }

        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("RejectProduct", "Admin")',
            type: 'POST',
            data: { id: productId, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('rejectProductModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    updateProductRowStatus(productId, "Rejected", reason);
                } else {
                    showToast(res.message || "Error rejecting product.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error rejecting product.", true);
            }
        });
    }

    // DOM UI updates after approval or rejection
    function updateProductRowStatus(productId, newStatus, reason = '') {
        const row = document.getElementById("product-row-" + productId);
        if (row) {
            row.setAttribute("data-status", newStatus);
        }

        const statusCell = document.getElementById("product-status-cell-" + productId);
        const actionCell = document.getElementById("product-action-cell-" + productId);
        const prodName = document.getElementById("prod-name-" + productId)?.innerText || "Product";

        if (statusCell) {
            if (newStatus === "Approved") {
                statusCell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Approved &amp; Live</span>';
            } else if (newStatus === "Rejected") {
                statusCell.innerHTML = `<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill" title="${reason}"><i class="fa-solid fa-circle-xmark me-1"></i> Rejected</span>`;
            } else {
                statusCell.innerHTML = '<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-clock me-1"></i> Pending Review</span>';
            }
        }

        if (actionCell) {
            let actionsHtml = `<button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewProductApprovalModal(${productId})" title="View Product Specifications"><i class="fa-solid fa-eye me-1"></i> View</button> `;
            if (newStatus === "Pending" || newStatus === "Rejected") {
                actionsHtml += `<button type="button" class="btn btn-outline-success btn-sm px-2 py-1 rounded-3 fw-bold" onclick="approveProduct(${productId})" title="Approve Product"><i class="fa-solid fa-check me-1"></i> Approve</button> `;
            }
            if (newStatus === "Pending" || newStatus === "Approved") {
                actionsHtml += `<button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openRejectProductModal(${productId}, '${prodName.replace(/'/g, "\\'")}')" title="Reject Product"><i class="fa-solid fa-xmark me-1"></i> Reject</button>`;
            }
            actionCell.innerHTML = actionsHtml;
        }

        // Recalculate counter badges
        recalculateProductApprovalBadges();
    }

    function recalculateProductApprovalBadges() {
        const allRows = document.querySelectorAll('.product-table-row');
        let pending = 0;
        let approved = 0;
        let rejected = 0;

        allRows.forEach(r => {
            const st = r.getAttribute('data-status');
            if (st === 'Approved') approved++;
            else if (st === 'Rejected') rejected++;
            else pending++;
        });

        const countPending = document.getElementById("count-pending-prod");
        if (countPending) countPending.innerText = pending;

        const countApproved = document.getElementById("count-approved-prod");
        if (countApproved) countApproved.innerText = approved;

        const countRejected = document.getElementById("count-rejected-prod");
        if (countRejected) countRejected.innerText = rejected;

        const pendingHeaderBadge = document.getElementById("productPendingHeaderBadge");
        if (pendingHeaderBadge) pendingHeaderBadge.innerHTML = `<i class="fa-solid fa-clock me-1"></i> ${pending} Pending Review`;
    }

    // ==========================================
    // POINT 38: ADMIN ORDER MANAGEMENT
    // ==========================================
    let currentOrderDateFilter = 'all';

    function setDateOrderFilter(dateCat, btn) {
        currentOrderDateFilter = dateCat;
        document.querySelectorAll('.order-date-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        filterAdminOrders();
    }

    function filterAdminOrders() {
        const statusVal = (document.getElementById("orderFilterStatus")?.value || 'all').toLowerCase();
        const sellerVal = (document.getElementById("orderFilterSeller")?.value || 'all').toLowerCase();
        const searchVal = (document.getElementById("orderFilterSearch")?.value || '').trim().toLowerCase();

        const rows = document.querySelectorAll('.order-table-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const rowDate = (row.getAttribute('data-date') || '').toLowerCase();
            const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();
            const rowSeller = (row.getAttribute('data-seller') || '').toLowerCase();
            const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();

            let matchDate = (currentOrderDateFilter === 'all') || (rowDate === currentOrderDateFilter.toLowerCase());
            let matchStatus = (statusVal === 'all') || (rowStatus === statusVal);
            let matchSeller = (sellerVal === 'all') || (rowSeller === sellerVal);
            let matchSearch = !searchVal || rowSearch.includes(searchVal);

            if (matchDate && matchStatus && matchSeller && matchSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const badge = document.getElementById("ordersTotalBadge");
        if (badge) {
            badge.innerText = `${visibleCount} Orders Shown`;
        }
    }

