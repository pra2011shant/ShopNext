                    document.getElementById('modalClusCombinedOrders').innerText = c.totalCombinedOrders;
                    document.getElementById('modalClusCombinedSpent').innerText = '₹' + Number(c.totalCombinedSpent).toLocaleString('en-IN') + ' gross';
                    document.getElementById('modalClusConfidence').innerText = c.matchConfidence;
                    document.getElementById('modalClusPrimaryFactor').innerText = c.primaryMatchFactor;
                    document.getElementById('modalClusStatusDisplay').innerText = c.clusterStatus;

                    // Alert Badge styling
                    const alertBadge = document.getElementById('modalClusAlertBadge');
                    if (c.alertBadge.includes('Possible Multiple Accounts')) {
