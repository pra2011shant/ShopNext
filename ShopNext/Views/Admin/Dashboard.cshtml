    let flashSaleTimerInterval = null;

    function initFlashSaleLiveCountdowns() {
        if (flashSaleTimerInterval) clearInterval(flashSaleTimerInterval);

        flashSaleTimerInterval = setInterval(() => {
            // 1. Tick showcase card timers
            document.querySelectorAll('.flash-timer-display').forEach(el => {
                let sec = parseInt(el.getAttribute('data-remaining-seconds'), 10);
                if (isNaN(sec)) return;

                if (sec > 0) {
                    sec--;
                    el.setAttribute('data-remaining-seconds', sec);

                    const hours = Math.floor(sec / 3600);
                    const mins = Math.floor((sec % 3600) / 60);
                    const secs = sec % 60;
                    el.innerText = `${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                } else if (sec === 0) {
                    el.setAttribute('data-remaining-seconds', -1);
                    el.innerHTML = '<span class="text-secondary"><i class="fa-solid fa-hourglass-end me-1"></i> EXPIRED</span>';
                }
            });

            // 2. Tick table timers
            document.querySelectorAll('.flash-table-timer').forEach(el => {
                let sec = parseInt(el.getAttribute('data-remaining-seconds'), 10);
                if (isNaN(sec)) return;

                if (sec > 0) {
                    sec--;
                    el.setAttribute('data-remaining-seconds', sec);

                    const hours = Math.floor(sec / 3600);
                    const mins = Math.floor((sec % 3600) / 60);
                    const secs = sec % 60;
                    el.innerHTML = `<i class="fa-regular fa-clock me-1"></i> ${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                }
            });
        }, 1000);
    }

    function calculateFlashDiscountPreview() {
        const orig = parseFloat(document.getElementById('modalFlashOrigPrice').value) || 0;
        const flash = parseFloat(document.getElementById('modalFlashPrice').value) || 0;
        const previewEl = document.getElementById('modalFlashDiscountPreview');

        if (orig > 0 && flash > 0 && orig >= flash) {
            const discAmt = orig - flash;
            const pct = Math.round((discAmt / orig) * 100);
            previewEl.innerHTML = `<small class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-3 py-1 rounded-pill font-monospace fw-bold">Discount: ${pct}% OFF (Save ₹${discAmt.toLocaleString('en-IN')})</small>`;
        } else if (flash > orig && orig > 0) {
            previewEl.innerHTML = `<small class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-3 py-1 rounded-pill font-monospace fw-bold">Warning: Flash price is higher than original price</small>`;
        }
    }

