        --accent-violet: #8b5cf6;
        --accent-amber: #f59e0b;
        --accent-emerald: #10b981;
        --accent-rose: #f43f5e;
        --accent-cyan: #06b6d4;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
    }

    body {
        background-color: var(--admin-bg);
        color: var(--text-primary);
