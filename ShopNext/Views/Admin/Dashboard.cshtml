    function runConcurrencySimulation() {
        const prodName = document.getElementById("simProductName").value;
        const initialStock = parseInt(document.getElementById("simInitialStock").value) || 10;
        const concurrentUsers = parseInt(document.getElementById("simConcurrentUsers").value) || 100;
        const btn = document.getElementById("btnRunSim");

        if (initialStock <= 0 || concurrentUsers <= 0) {
            showToast("Please enter positive values for Stock and Concurrent Users.", true);
            return;
        }

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Running 100 Parallel Threads...';
        }

        $.ajax({
            url: '@Url.Action("SimulateConcurrentSaleRush", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                productName: prodName,
                initialStock: initialStock,
                concurrentUsers: concurrentUsers,
                productId: 1
            }),
            success: function(res) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-play me-1"></i> Launch Multi-Threaded Stress Test';
                }

                if (res.success && res.data) {
                    const data = res.data;
                    showToast(res.message);

                    // Update Top KPI counters
                    const kpiTotal = document.getElementById("kpiTotalEvaluations");
                    const kpiPrevented = document.getElementById("kpiOversellPrevented");
                    if (kpiTotal) kpiTotal.innerText = Number(data.totalRequests).toLocaleString();
                    if (kpiPrevented) kpiPrevented.innerText = Number(data.outOfStockRejectedCount).toLocaleString();

                    // Update Outcome Summary Badges
                    const subTitle = document.getElementById("simSubTitleDisplay");
                    if (subTitle) subTitle.innerText = `Simulation ID: ${data.simulationId} | Thread-Safe Execution (${data.totalElapsedMs}ms)`;
                    
                    const fUnits = document.getElementById("simFulfilledUnitsText");
                    if (fUnits) fUnits.innerText = `${data.totalUnitsSold} Units`;
                    
                    const bUnits = document.getElementById("simBlockedText");
                    if (bUnits) bUnits.innerText = `${data.outOfStockRejectedCount} Users`;
                    
                    const lText = document.getElementById("simLatencyText");
                    if (lText) lText.innerText = `${data.totalElapsedMs}ms`;

                    const fulfilledPct = data.totalRequests > 0 ? (data.fulfilledOrdersCount / data.totalRequests) * 100 : 0;
                    const blockedPct = Math.max(0, 100 - fulfilledPct);
                    const fBar = document.getElementById("simFulfilledBar");
                    const bBar = document.getElementById("simBlockedBar");
                    if (fBar) fBar.style.width = `${fulfilledPct}%`;
                    if (bBar) bBar.style.width = `${blockedPct}%`;

                    const tuBadge = document.getElementById("simTotalUsersBadge");
                    if (tuBadge) tuBadge.innerText = data.totalRequests;
                    
                    const foBadge = document.getElementById("simFulfilledOrdersBadge");
                    if (foBadge) foBadge.innerText = data.fulfilledOrdersCount;
                    
                    const roBadge = document.getElementById("simRejectedOrdersBadge");
                    if (roBadge) roBadge.innerText = data.outOfStockRejectedCount;
                    
                    const fsBadge = document.getElementById("simFinalStockBadge");
                    if (fsBadge) fsBadge.innerText = data.finalStock;

                    const countAll = document.getElementById("countLogAll");
                    if (countAll) countAll.innerText = data.logs.length;
                    
                    const countSuccess = document.getElementById("countLogSuccess");
                    if (countSuccess) countSuccess.innerText = data.fulfilledOrdersCount;
                    
                    const countRej = document.getElementById("countLogRejected");
                    if (countRej) countRej.innerText = data.outOfStockRejectedCount;

                    // Render Logs Table
                    const tbody = document.getElementById("simLogsTableBody");
                    if (tbody && data.logs && data.logs.length) {
                        let html = '';
                        data.logs.forEach(log => {
                            const isSuccess = log.isSuccess;
                            const statusBadge = isSuccess
                                ? '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> SUCCESS (Reserved)</span>'
                                : '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> OUT OF STOCK (Blocked)</span>';
                            
                            const orderClass = isSuccess ? 'text-success' : 'text-light';
                            const stockAfterClass = log.stockAfter === 0 ? 'text-danger fw-bold' : 'text-success fw-bold';
                            const qtyBadge = isSuccess
                                ? `<span class="badge bg-success bg-opacity-25 text-success border border-success px-2.5 py-1">${log.quantityRequested} units</span>`
                                : `<span class="badge bg-secondary bg-opacity-25 text-secondary px-2.5 py-1">${log.quantityRequested} units</span>`;

                            html += `
                            <tr class="inv-log-row" data-status="${isSuccess ? 'success' : 'rejected'}" data-order="${log.orderId}" data-cust="${log.customerName}">
                                <td class="font-monospace text-secondary">#${log.step}</td>
                                <td class="fw-bold font-monospace ${orderClass}">${log.orderId}</td>
                                <td class="text-white">${log.customerName}</td>
                                <td class="font-monospace fw-bold text-center">${qtyBadge}</td>
                                <td class="font-monospace">
                                    <span class="text-warning fw-bold">${log.stockBefore}</span>
                                    <i class="fa-solid fa-arrow-right text-secondary mx-1 small"></i>
                                    <span class="${stockAfterClass}">${log.stockAfter}</span>
                                </td>
                                <td>${statusBadge}</td>
                                <td class="font-monospace text-info small">${log.threadId}</td>
                                <td class="font-monospace text-secondary small">${log.timestampFormatted}</td>
                                <td class="text-secondary small font-monospace">${log.remark}</td>
                            </tr>`;
                        });
                        tbody.innerHTML = html;
                    }
                } else {
                    showToast(res.message || "Error running concurrency test.", true);
                }
            },
            error: function() {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-play me-1"></i> Launch Multi-Threaded Stress Test';
                }
                showToast("Connection error executing concurrency stress test.", true);
            }
        });
    }

