    function filterReportTableRows(input, tableBodyId) {
        const filter = input.value.toLowerCase();
        const rows = document.querySelectorAll('#' + tableBodyId + ' tr');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    }

    // ==========================================
    // POINT 47: ADDRESS RISK MANAGEMENT (Telemetry & Non-Punitive Investigation)
    // ==========================================

    function filterAddressRiskTable(filter, btn) {
        document.querySelectorAll('.address-filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.address-risk-row');
        rows.forEach(row => {
            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'high-activity') {
                row.style.display = row.classList.contains('high-activity') ? '' : 'none';
            } else if (filter === 'high-return') {
                row.style.display = row.classList.contains('high-return') ? '' : 'none';
            } else if (filter === 'under-investigation') {
                row.style.display = row.classList.contains('under-investigation') ? '' : 'none';
            } else if (filter === 'clean') {
                row.style.display = row.classList.contains('clean') ? '' : 'none';
            }
        });
    }

    function searchAddressRiskTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.address-risk-row');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const addrKey = (row.getAttribute('data-address-key') || '').toLowerCase();
            const locality = (row.getAttribute('data-locality') || '').toLowerCase();
            const pin = (row.getAttribute('data-pincode') || '').toLowerCase();

            if (!q || text.includes(q) || addrKey.includes(q) || locality.includes(q) || pin.includes(q)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function setPresetAddressNote(noteText) {
        const textarea = document.getElementById('modalAddrAdminNotes');
        if (textarea) textarea.value = noteText;
    }

    function openAddressRiskModal(addressKey) {
        if (!addressKey) return;

        // Reset display
        document.getElementById('modalAddrKeyHidden').value = addressKey;
        document.getElementById('modalAddrKeyDisplay').innerText = addressKey;
        document.getElementById('modalAddrFullDisplay').innerText = 'Loading address telemetry...';
        document.getElementById('modalAddrCustomersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-secondary"><i class="fa-solid fa-spinner fa-spin me-2"></i> Fetching linked customers...</td></tr>';
        document.getElementById('modalAddrOrdersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-secondary"><i class="fa-solid fa-spinner fa-spin me-2"></i> Fetching recent orders...</td></tr>';

        // Default tab
        const firstTab = new bootstrap.Tab(document.getElementById('tab-addr-customers-btn'));
        firstTab.show();

        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('addressRiskModal'));
        modal.show();

        // Fetch details via AJAX
        $.ajax({
            url: '@Url.Action("GetAddressRiskDetails", "Admin")',
            type: 'GET',
            data: { addressKey: addressKey },
            success: function(res) {
                if (res && res.success && res.data) {
                    const d = res.data;
                    document.getElementById('modalAddrKeyDisplay').innerText = d.addressKey;
                    document.getElementById('modalAddrFullDisplay').innerText = d.formattedAddress;
                    document.getElementById('modalAddrTotalOrders').innerText = d.totalOrders;
                    document.getElementById('modalAddrTotalAmount').innerText = '₹' + Number(d.totalAmount).toLocaleString('en-IN') + ' gross';
                    document.getElementById('modalAddrReturnedOrders').innerText = d.returnedOrders;
                    document.getElementById('modalAddrReturnRate').innerText = d.returnRate + '% Return Rate';
                    document.getElementById('modalAddrCancelledOrders').innerText = d.cancelledOrders;
                    document.getElementById('modalAddrCancelRate').innerText = d.cancellationRate + '% Cancel Rate';
                    document.getElementById('modalAddrCustomerCount').innerText = d.distinctCustomersCount;
                    document.getElementById('modalAddrCustCountBadge').innerText = d.distinctCustomersCount;

                    // Alert Badge styling
                    const badgeEl = document.getElementById('modalAddrAlertBadge');
                    if (d.alertBadge === '⚠ High Activity' || d.riskLevel === 'High Risk') {
                        badgeEl.className = 'badge bg-danger text-white px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> ' + d.alertBadge;
                    } else if (d.alertBadge === 'High Return Rate') {
                        badgeEl.className = 'badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-rotate-left me-1"></i> High Return Rate';
                    } else if (d.alertBadge === 'Multi-Account Cluster') {
                        badgeEl.className = 'badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-people-arrows me-1"></i> Multi-Account Cluster';
                    } else {
                        badgeEl.className = 'badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Normal Activity';
                    }

                    // Form controls
                    document.getElementById('modalAddrStatusSelect').value = d.investigationStatus || 'Under Investigation';
                    document.getElementById('modalAddrRequireOtpCheck').checked = d.requireManualOtpVerification;
                    document.getElementById('modalAddrAdminNotes').value = d.adminNotes || '';

                    // Linked customers table
                    let custHtml = '';
                    if (d.linkedCustomers && d.linkedCustomers.length > 0) {
                        d.linkedCustomers.forEach(c => {
                            let restrictionBadge = `<span class="badge bg-success bg-opacity-20 text-success">Normal</span>`;
                            if (c.restrictionLevel === 'Account Blocked') {
                                restrictionBadge = `<span class="badge bg-danger text-white">Blocked</span>`;
                            } else if (c.restrictionLevel === 'Account Suspended') {
                                restrictionBadge = `<span class="badge bg-secondary">Suspended</span>`;
                            } else if (c.restrictionLevel === 'COD Restricted') {
                                restrictionBadge = `<span class="badge bg-warning bg-opacity-25 text-warning">COD Restricted</span>`;
                            } else if (c.restrictionLevel === 'Return Restricted') {
                                restrictionBadge = `<span class="badge bg-warning bg-opacity-25 text-warning">Return Restricted</span>`;
                            } else if (c.restrictionLevel === 'Warning') {
                                restrictionBadge = `<span class="badge bg-warning bg-opacity-25 text-warning">Warning</span>`;
                            }

                            custHtml += `<tr>
                                <td>
                                    <div class="fw-bold text-white">${c.customerName}</div>
                                    <div class="text-secondary small">ID: #${c.customerId}</div>
                                </td>
                                <td>
                                    <div class="text-light small">${c.email}</div>
                                    <div class="font-monospace text-secondary small">${c.phone}</div>
                                </td>
                                <td class="fw-bold font-monospace text-center">${c.ordersCount}</td>
                                <td class="fw-bold font-monospace text-danger text-center">${c.returnsCount}</td>
                                <td>${restrictionBadge}</td>
                                <td><span class="badge bg-success bg-opacity-15 text-success">Active</span></td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn btn-outline-info btn-sm rounded-pill py-0.5 px-2.5 small" 
                                            onclick="openCustomerRestrictionModal(${c.customerId}, '${c.customerName}')">
                                        <i class="fa-solid fa-user-shield me-1"></i> View Profile
                                    </button>
                                </td>
                            </tr>`;
                        });
                    } else {
                        custHtml = '<tr><td colspan="7" class="text-center py-3 text-secondary">No customer accounts currently linked to this cluster.</td></tr>';
                    }
                    document.getElementById('modalAddrCustomersTableBody').innerHTML = custHtml;

                    // Recent orders table
                    let ordHtml = '';
                    if (d.recentOrders && d.recentOrders.length > 0) {
                        d.recentOrders.forEach(o => {
                            let statusBadge = `<span class="badge bg-success bg-opacity-20 text-success">${o.status}</span>`;
                            if (o.status === 'Returned') statusBadge = `<span class="badge bg-danger bg-opacity-20 text-danger">Returned</span>`;
                            else if (o.status === 'Cancelled') statusBadge = `<span class="badge bg-warning bg-opacity-20 text-warning">Cancelled</span>`;

                            const reason = o.returnReason || o.cancelReason || '<span class="text-secondary">—</span>';

                            ordHtml += `<tr>
                                <td class="fw-bold font-monospace text-info">#ORD${o.orderId}</td>
                                <td class="text-white">${o.customerName}</td>
                                <td class="fw-bold font-monospace text-white">₹${Number(o.amount).toLocaleString('en-IN')}</td>
                                <td><span class="badge bg-secondary bg-opacity-40 text-light">${o.paymentMode}</span></td>
                                <td>${statusBadge}</td>
                                <td class="small text-light text-opacity-90" style="max-width: 240px;">${reason}</td>
                                <td class="text-secondary small font-monospace">${o.orderDate}</td>
                            </tr>`;
                        });
                    } else {
                        ordHtml = '<tr><td colspan="7" class="text-center py-3 text-secondary">No recent orders recorded for this address.</td></tr>';
                    }
                    document.getElementById('modalAddrOrdersTableBody').innerHTML = ordHtml;
                } else {
                    showToast(res ? res.message : 'Could not fetch address details.', true);
                }
            },
            error: function() {
                showToast('Failed to fetch address risk telemetry.', true);
            }
        });
    }

    function submitUpdateAddressInvestigation() {
        const addressKey = document.getElementById('modalAddrKeyHidden').value;
        const status = document.getElementById('modalAddrStatusSelect').value;
        const notes = document.getElementById('modalAddrAdminNotes').value;
        const requireManualOtp = document.getElementById('modalAddrRequireOtpCheck').checked;

        if (!addressKey) return;

        const btn = document.getElementById('btnSaveAddressInvestigation');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("UpdateAddressInvestigation", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            data: JSON.stringify({
                AddressKey: addressKey,
                InvestigationStatus: status,
                AdminNotes: notes,
                RequireManualOtpVerification: requireManualOtp
            }),
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;

                if (res && res.success) {
                    showToast(res.message || 'Address investigation status saved successfully.');

                    // Update live table row
                    const safeKey = addressKey.replace(/[^a-zA-Z0-9]/g, '_');
                    const statusContainer = document.getElementById('status-badge-container-' + safeKey);
                    if (statusContainer) {
                        let newBadge = '';
                        if (status === 'Under Investigation') {
                            newBadge = '<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-40 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation</span>';
                        } else if (status === 'Flagged for Review') {
                            newBadge = '<span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-flag me-1"></i> Flagged for Review</span>';
                        } else if (status === 'Verified / Clean') {
                            newBadge = '<span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-circle-check me-1"></i> Verified / Clean</span>';
                        } else {
                            newBadge = '<span class="badge bg-secondary bg-opacity-40 text-light border border-secondary border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-eye me-1"></i> Monitoring</span>';
                        }
                        statusContainer.innerHTML = newBadge;
                    }

                    const otpIndicator = document.getElementById('manual-verify-indicator-' + safeKey);
                    if (otpIndicator) {
                        if (requireManualOtp) otpIndicator.classList.remove('d-none');
                        else otpIndicator.classList.add('d-none');
                    }

                    const row = document.getElementById('address-row-' + safeKey);
                    if (row) {
                        row.setAttribute('data-status', status);
                        if (status === 'Under Investigation') row.classList.add('under-investigation');
                        else row.classList.remove('under-investigation');
                        if (status === 'Verified / Clean') row.classList.add('clean');
                        else row.classList.remove('clean');
                    }

                    // Hide modal
                    const modalEl = document.getElementById('addressRiskModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                } else {
                    showToast(res ? res.message : 'Error updating investigation status.', true);
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                showToast('Server communication error.', true);
            }
        });
    }

