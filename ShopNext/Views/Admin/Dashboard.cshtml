    function selectInboundEvidence(url, title, uploader, date, desc, type) {
        document.getElementById("evidMainInboundImg").src = url;
        document.getElementById("evidInboundTitle").innerText = title;
        document.getElementById("evidInboundUploader").innerText = `Uploaded by ${uploader}`;
        document.getElementById("evidInboundDate").innerText = date;
        document.getElementById("evidInboundDesc").innerText = desc || "Reported inbound condition photo.";
