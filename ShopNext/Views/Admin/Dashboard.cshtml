        border-right: 1px solid var(--card-border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: all 0.3s ease;
        position: sticky;
        top: 70px;
        height: calc(100vh - 70px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,0.1) transparent;
        z-index: 1040;
    }

    .admin-sidebar::-webkit-scrollbar {
        width: 5px;
    }

    .admin-sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
    }

    .admin-content-area {
        flex-grow: 1;
        padding: 1.75rem 2rem 3.5rem;
        overflow-x: hidden;
    }

    .sidebar-header {
        padding: 1.5rem 1.25rem 1rem;
        border-bottom: 1px solid var(--card-border);
    }

    .sidebar-group-title {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #64748b;
        font-weight: 700;
        padding: 1rem 1.25rem 0.35rem;
    }

    .nav-sidebar-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 1.25rem;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 600;
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
        cursor: pointer;
    }

    .nav-sidebar-item:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.04);
        border-left-color: rgba(99, 102, 241, 0.5);
    }

    .nav-sidebar-item.active {
        color: #ffffff;
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.15) 0%, transparent 100%);
        border-left-color: var(--accent-indigo);
    }

    .nav-sidebar-item i {
        width: 22px;
        font-size: 1rem;
        margin-right: 10px;
    }

    /* Modern Glassmorphic Sidebar Badges & Color Contrast */
    .sidebar-badge {
        font-size: 0.72rem;
        padding: 0.25rem 0.65rem;
        border-radius: 50px;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        letter-spacing: 0.02em;
    }

    /* High Contrast & Glassmorphic Opacity Overrides for Dark Portal */
    [class*="bg-opacity-"], .bg-opacity-10, .bg-opacity-15, .bg-opacity-20, .bg-opacity-25, .bg-opacity-30 {
        --bs-bg-opacity: 1 !important;
    }

    .bg-warning[class*="bg-opacity"], .bg-warning.bg-opacity-10, .bg-warning.bg-opacity-15, .bg-warning.bg-opacity-20, .bg-warning.bg-opacity-25 {
        background-color: rgba(245, 158, 11, 0.16) !important;
        color: #fbbf24 !important;
    }
    .bg-primary[class*="bg-opacity"], .bg-primary.bg-opacity-10, .bg-primary.bg-opacity-15, .bg-primary.bg-opacity-20, .bg-primary.bg-opacity-25 {
        background-color: rgba(99, 102, 241, 0.16) !important;
        color: #818cf8 !important;
    }
    .bg-danger[class*="bg-opacity"], .bg-danger.bg-opacity-10, .bg-danger.bg-opacity-15, .bg-danger.bg-opacity-20, .bg-danger.bg-opacity-25 {
        background-color: rgba(244, 63, 94, 0.16) !important;
        color: #fb7185 !important;
    }
    .bg-success[class*="bg-opacity"], .bg-success.bg-opacity-10, .bg-success.bg-opacity-15, .bg-success.bg-opacity-20, .bg-success.bg-opacity-25 {
        background-color: rgba(16, 185, 129, 0.16) !important;
        color: #34d399 !important;
    }
    .bg-info[class*="bg-opacity"], .bg-info.bg-opacity-10, .bg-info.bg-opacity-15, .bg-info.bg-opacity-20, .bg-info.bg-opacity-25 {
        background-color: rgba(6, 182, 212, 0.16) !important;
        color: #22d3ee !important;
    }
    .bg-secondary[class*="bg-opacity"], .bg-secondary.bg-opacity-10, .bg-secondary.bg-opacity-15, .bg-secondary.bg-opacity-20, .bg-secondary.bg-opacity-30 {
        background-color: rgba(148, 163, 184, 0.15) !important;
        color: #cbd5e1 !important;
    }
    .bg-cyan[class*="bg-opacity"], .bg-cyan.bg-opacity-10, .bg-cyan.bg-opacity-15, .bg-cyan.bg-opacity-20 {
        background-color: rgba(6, 182, 212, 0.16) !important;
        color: #22d3ee !important;
    }

    /* Icon chips */
    .sidebar-header .p-2.rounded-3,
    .kpi-icon-wrap,
    .p-3.rounded-3[class*="bg-"],
    .p-2.rounded-3[class*="bg-"] {
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
    }

    .border-opacity-30 { border-color: rgba(255, 255, 255, 0.2) !important; }
    .border-opacity-40 { border-color: rgba(255, 255, 255, 0.3) !important; }

    /* Admin Hero Header */
    .admin-header-card {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 27, 75, 0.9) 50%, rgba(49, 46, 129, 0.85) 100%);
        border: 1px solid var(--card-border);
        border-radius: 22px;
        padding: 1.75rem 2rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(16px);
        position: relative;
        overflow: hidden;
    }

    .admin-title {
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin-bottom: 0.2rem;
        text-transform: uppercase;
    }

    /* Top 4 Core Metrics Grid (Point 31) */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .kpi-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 1.25rem 1.4rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(12px);
        transition: transform 0.25s ease, border-color 0.25s ease;
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        border-color: rgba(99, 102, 241, 0.4);
    }

    .kpi-icon-wrap {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .kpi-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
        font-weight: 600;
        margin-bottom: 0.15rem;
    }

    .kpi-value {
        font-size: 1.65rem;
        font-weight: 800;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        line-height: 1.1;
    }

    /* Featured Today's Sales Banner */
    .sales-highlight-card {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(6, 182, 212, 0.12) 100%),
                    rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(16, 185, 129, 0.35);
        border-radius: 22px;
        padding: 1.5rem 1.85rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 12px 30px rgba(16, 185, 129, 0.1);
        backdrop-filter: blur(12px);
    }

    .sales-highlight-val {
        font-size: 2.2rem;
        font-weight: 800;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: -0.02em;
    }

    /* 3 Pending Attention Cards (Point 31) */
    .pending-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .pending-card {
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 1.25rem 1.4rem;
        backdrop-filter: blur(12px);
        transition: transform 0.25s ease, border-color 0.25s ease;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pending-count-badge {
        font-size: 1.4rem;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        padding: 0.35rem 0.8rem;
        border-radius: 12px;
    }

    .glass-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px);
    }

    .section-title {
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 1.25rem;
        color: white;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tab-panel-container {
        display: none;
        animation: fadeIn 0.4s ease-out;
    }

    .tab-panel-container.active {
        display: block;
    }

    .approved-table td {
        padding: 0.85rem 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
