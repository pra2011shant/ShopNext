    // POINT 47: ADDRESS RISK MANAGEMENT (Telemetry & Non-Punitive Investigation)
    // ==========================================

    function filterAddressRiskTable(filter, btn) {
        document.querySelectorAll('.address-filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.address-risk-row');
        rows.forEach(row => {
            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'high-activity') {
                row.style.display = row.classList.contains('high-activity') ? '' : 'none';
            } else if (filter === 'high-return') {
                row.style.display = row.classList.contains('high-return') ? '' : 'none';
            } else if (filter === 'under-investigation') {
                row.style.display = row.classList.contains('under-investigation') ? '' : 'none';
            } else if (filter === 'clean') {
                row.style.display = row.classList.contains('clean') ? '' : 'none';
            }
        });
    }

    function searchAddressRiskTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.address-risk-row');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const addrKey = (row.getAttribute('data-address-key') || '').toLowerCase();
            const locality = (row.getAttribute('data-locality') || '').toLowerCase();
            const pin = (row.getAttribute('data-pincode') || '').toLowerCase();

            if (!q || text.includes(q) || addrKey.includes(q) || locality.includes(q) || pin.includes(q)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function setPresetAddressNote(noteText) {
        const textarea = document.getElementById('modalAddrAdminNotes');
        if (textarea) textarea.value = noteText;
    }

    function openAddressRiskModal(addressKey) {
        if (!addressKey) return;

        // Reset display
        document.getElementById('modalAddrKeyHidden').value = addressKey;
        document.getElementById('modalAddrKeyDisplay').innerText = addressKey;
        document.getElementById('modalAddrFullDisplay').innerText = 'Loading address telemetry...';
        document.getElementById('modalAddrCustomersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-secondary"><i class="fa-solid fa-spinner fa-spin me-2"></i> Fetching linked customers...</td></tr>';
        document.getElementById('modalAddrOrdersTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-secondary"><i class="fa-solid fa-spinner fa-spin me-2"></i> Fetching recent orders...</td></tr>';

        // Default tab
        const firstTab = new bootstrap.Tab(document.getElementById('tab-addr-customers-btn'));
        firstTab.show();

        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('addressRiskModal'));
        modal.show();

        // Fetch details via AJAX
        $.ajax({
            url: '@Url.Action("GetAddressRiskDetails", "Admin")',
            type: 'GET',
            data: { addressKey: addressKey },
            success: function(res) {
                if (res && res.success && res.data) {
                    const d = res.data;
                    document.getElementById('modalAddrKeyDisplay').innerText = d.addressKey;
                    document.getElementById('modalAddrFullDisplay').innerText = d.formattedAddress;
                    document.getElementById('modalAddrTotalOrders').innerText = d.totalOrders;
                    document.getElementById('modalAddrTotalAmount').innerText = '₹' + Number(d.totalAmount).toLocaleString('en-IN') + ' gross';
                    document.getElementById('modalAddrReturnedOrders').innerText = d.returnedOrders;
                    document.getElementById('modalAddrReturnRate').innerText = d.returnRate + '% Return Rate';
                    document.getElementById('modalAddrCancelledOrders').innerText = d.cancelledOrders;
                    document.getElementById('modalAddrCancelRate').innerText = d.cancellationRate + '% Cancel Rate';
                    document.getElementById('modalAddrCustomerCount').innerText = d.distinctCustomersCount;
                    document.getElementById('modalAddrCustCountBadge').innerText = d.distinctCustomersCount;

                    // Alert Badge styling
                    const badgeEl = document.getElementById('modalAddrAlertBadge');
                    if (d.alertBadge === '⚠ High Activity' || d.riskLevel === 'High Risk') {
                        badgeEl.className = 'badge bg-danger text-white px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> ' + d.alertBadge;
                    } else if (d.alertBadge === 'High Return Rate') {
                        badgeEl.className = 'badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-rotate-left me-1"></i> High Return Rate';
                    } else if (d.alertBadge === 'Multi-Account Cluster') {
                        badgeEl.className = 'badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-people-arrows me-1"></i> Multi-Account Cluster';
                    } else {
                        badgeEl.className = 'badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill fw-bold';
                        badgeEl.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Normal Activity';
                    }

                    // Form controls
                    document.getElementById('modalAddrStatusSelect').value = d.investigationStatus || 'Under Investigation';
