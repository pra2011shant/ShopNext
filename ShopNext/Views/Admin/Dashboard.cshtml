        $.ajax({
            url: '@Url.Action("GetCustomerCodDetails", "Admin")',
            type: 'GET',
            data: { customerId: customerId },
            success: function(res) {
                if (res && res.success && res.data) {
                    const data = res.data;
                    document.getElementById('modalCodCustomerName').innerText = data.customerName || 'Customer';
                    document.getElementById('modalCodCustomerContact').innerHTML = (data.customerEmail || 'No email') + ' &bull; ' + (data.customerPhone || 'No phone') + ' &bull; Registered Customer';

                    // Alert Badge
                    const alertBadgeEl = document.getElementById('modalCodAlertBadge');
                    if (data.alertBadge) {
                        alertBadgeEl.innerText = data.alertBadge;
                        alertBadgeEl.className = 'badge bg-danger text-white px-2.5 py-1 rounded-pill fw-bold';
                        alertBadgeEl.classList.remove('d-none');
                    } else {
                        alertBadgeEl.classList.add('d-none');
                    }

                    // Risk Badge
                    const riskBadgeEl = document.getElementById('modalCodRiskBadge');
                    riskBadgeEl.innerText = 'COD Risk: ' + data.codRiskLevel;
                    if (data.codRiskLevel === 'High') {
                        riskBadgeEl.className = 'badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill';
                    } else if (data.codRiskLevel === 'Medium') {
                        riskBadgeEl.className = 'badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill';
                    } else {
                        riskBadgeEl.className = 'badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill';
                    }

                    // KPIs
                    document.getElementById('modalCodTotalOrders').innerText = data.totalCodOrders;
                    document.getElementById('modalCodDelivered').innerText = data.deliveredCodOrders;
                    document.getElementById('modalCodRejected').innerText = data.rejectedCodOrders;
                    document.getElementById('modalCodRejectionRate').innerText = data.codRejectionRate.toFixed(1) + '%';
                    
                    const successPct = data.totalCodOrders > 0 ? ((data.deliveredCodOrders / data.totalCodOrders) * 100).toFixed(1) : '100.0';
                    document.getElementById('modalCodSuccessRate').innerText = successPct + '% Success Rate';
                    document.getElementById('modalCodHistoryTabCount').innerText = data.totalCodOrders;

                    // Policy Form
                    const policySelect = document.getElementById('modalCodPolicyStatusSelect');
                    if (data.policyEnforcement) {
                        policySelect.value = data.policyEnforcement;
                        if (!policySelect.value) {
                            policySelect.selectedIndex = data.isCodDisabled ? 0 : 1;
                        }
                    } else {
                        policySelect.selectedIndex = data.isCodDisabled ? 0 : 1;
                    }

                    document.getElementById('modalCodDisableCheck').checked = data.isCodDisabled;
                    document.getElementById('modalCodAdminReason').value = data.adminReason || '';

                    // Order History Table
                    let historyHtml = '';
                    if (data.orderHistory && data.orderHistory.length > 0) {
                        data.orderHistory.forEach(order => {
                            const isDelivered = order.isDelivered || order.orderStatus === 'Delivered';
                            const outcomeBadge = isDelivered 
                                ? '<span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2 py-0.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Delivered</span>' 
                                : '<span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2 py-0.5 rounded-pill"><i class="fa-solid fa-ban me-1"></i> Doorstep Refusal</span>';

                            historyHtml += `
                                <tr class="border-bottom border-secondary border-opacity-10">
                                    <td class="font-monospace text-warning fw-semibold">#${order.orderId}</td>
                                    <td class="text-secondary small">${order.orderDateFormatted || order.orderDate}</td>
                                    <td class="text-light fw-bold">₹${Number(order.totalAmount).toLocaleString('en-IN')}</td>
                                    <td><span class="badge bg-dark border border-secondary text-light">${order.orderStatus}</span></td>
                                    <td>${outcomeBadge}</td>
                                    <td class="small ${order.rejectionReason && !isDelivered ? 'text-danger fw-semibold' : 'text-secondary'}">${order.rejectionReason || '—'}</td>
                                </tr>
                            `;
                        });
                    } else {
                        historyHtml = '<tr><td colspan="6" class="text-center py-4 text-secondary">No COD order telemetry found for this customer.</td></tr>';
                    }
                    document.getElementById('modalCodHistoryTableBody').innerHTML = historyHtml;

                    // Show Modal
                    const modalEl = document.getElementById('codAbuseModal');
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();
                } else {
                    showToast(res ? res.message : 'Could not fetch COD analytics.', true);
                }
            },
            error: function() {
                showToast('Server communication error fetching COD data.', true);
            }
        });
    }

    function submitUpdateCodPolicy(quickAction) {
        const customerId = parseInt(document.getElementById('modalCodCustomerIdHidden').value, 10);
        if (!customerId) return;

        let policyStatus = document.getElementById('modalCodPolicyStatusSelect').value;
        let isCodDisabled = document.getElementById('modalCodDisableCheck').checked;
        let adminReason = document.getElementById('modalCodAdminReason').value;

        if (quickAction === 'restrict') {
            policyStatus = 'Prepaid-Only (COD Restricted)';
            isCodDisabled = true;
            if (!adminReason) {
                adminReason = 'Enforced prepaid-only ordering due to excessive COD doorstep failures. Account active for online payments.';
            }
        } else if (quickAction === 'restore') {
            policyStatus = 'Normal (All Payment Modes Active)';
            isCodDisabled = false;
            if (!adminReason) {
                adminReason = 'Customer COD payment privileges restored after verification.';
            }
        } else if (quickAction === 'warning') {
            policyStatus = 'High Risk Warning';
            isCodDisabled = false;
            if (!adminReason) {
                adminReason = 'Warning issued for elevated COD refusal rate. Monitored for future orders.';
            }
        }

        const btn = document.getElementById('btnSaveCodPolicy');
        const origText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving Policy...';

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("UpdateCustomerCodPolicy", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            data: JSON.stringify({
                CustomerId: customerId,
                PolicyEnforcement: policyStatus,
                IsCodDisabled: isCodDisabled,
                AdminReason: adminReason
            }),
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = origText;

                if (res && res.success) {
                    showToast(res.message || 'COD policy updated successfully.');

                    // Update live table row
                    const codStatusBadgeEl = document.getElementById('cod-status-badge-' + customerId);
                    if (codStatusBadgeEl) {
                        if (isCodDisabled || policyStatus.includes('Prepaid')) {
                            codStatusBadgeEl.innerHTML = '<span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2 py-0.5 rounded-pill"><i class="fa-solid fa-ban me-1"></i> Prepaid-Only</span>';
                        } else {
                            codStatusBadgeEl.innerHTML = '<span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2 py-0.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> COD Active</span>';
                        }
                    }

                    const policyDisplayEl = document.getElementById('cod-policy-display-' + customerId);
                    if (policyDisplayEl) {
                        policyDisplayEl.innerText = policyStatus;
                    }

                    const row = document.getElementById('cod-row-' + customerId);
                    if (row) {
                        row.setAttribute('data-status', isCodDisabled ? 'Restricted' : 'Normal');
                    }

                    // Hide modal
                    const modalEl = document.getElementById('codAbuseModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                } else {
                    showToast(res ? res.message : 'Error updating COD policy.', true);
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = origText;
                showToast('Server communication error updating COD policy.', true);
            }
        });
    }

