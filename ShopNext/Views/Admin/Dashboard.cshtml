        font-weight: 600;
    }

    .detail-row .value {
        color: #ffffff;
        font-weight: 600;
    }

    .toast-container-custom {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1055;
    }

    .toast-custom {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid var(--card-border);
        border-radius: 14px;
        color: white;
        min-width: 320px;
        display: none;
    }
</style>

