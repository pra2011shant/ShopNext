                if (res && res.success && res.data) {
                    const c = res.data;
                    document.getElementById('modalClusNameDisplay').innerText = c.clusterName;
                    document.getElementById('modalClusSignalDisplay').innerText = 'Primary Signal: ' + c.primaryMatchFactor + ' • ' + c.commonSignalValue;
                    document.getElementById('modalClusAccountCount').innerText = c.totalAccountsCount;
