    function searchMultiAccountTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.multi-account-row');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const id = (row.getAttribute('data-cluster-id') || '').toLowerCase();
            const name = (row.getAttribute('data-name') || '').toLowerCase();
            const signal = (row.getAttribute('data-signal') || '').toLowerCase();

            if (!q || text.includes(q) || id.includes(q) || name.includes(q) || signal.includes(q)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
