@* Views/Admin/Dashboard.cshtml - Point 31 & 32: Admin Sidebar Dashboard *@
@model ShopNext.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "ADMIN DASHBOARD - ShopNext Control Panel";
    var pendingShops = Model.PendingShops ?? ViewBag.PendingShops as List<ShopNext.Models.Shop> ?? new List<ShopNext.Models.Shop>();
    var approvedShops = Model.ApprovedShops ?? ViewBag.ApprovedShops as List<ShopNext.Models.Shop> ?? new List<ShopNext.Models.Shop>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --admin-bg: #070d18;
        --sidebar-bg: #0b1324;
        --card-bg: rgba(15, 23, 42, 0.78);
        --card-border: rgba(255, 255, 255, 0.08);
        --accent-indigo: #6366f1;
        --accent-violet: #8b5cf6;
        --accent-amber: #f59e0b;
        --accent-emerald: #10b981;
        --accent-rose: #f43f5e;
        --accent-cyan: #06b6d4;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
    }

    body {
        background-color: var(--admin-bg);
        color: var(--text-primary);
        font-family: 'Outfit', sans-serif;
    }

    /* Admin Sidebar Layout */
    .admin-layout-wrapper {
        display: flex;
        min-height: calc(100vh - 70px);
    }

    .admin-sidebar {
        width: 275px;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--card-border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: all 0.3s ease;
        position: sticky;
        top: 70px;
        height: calc(100vh - 70px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,0.1) transparent;
        z-index: 1040;
    }

    .admin-sidebar::-webkit-scrollbar {
        width: 5px;
    }

    .admin-sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
    }

    .admin-content-area {
        flex-grow: 1;
        padding: 1.75rem 2rem 3.5rem;
        overflow-x: hidden;
    }

    .sidebar-header {
        padding: 1.5rem 1.25rem 1rem;
        border-bottom: 1px solid var(--card-border);
    }

    .sidebar-group-title {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #64748b;
        font-weight: 700;
        padding: 1rem 1.25rem 0.35rem;
    }

    .nav-sidebar-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 1.25rem;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 600;
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
        cursor: pointer;
    }

    .nav-sidebar-item:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.04);
        border-left-color: rgba(99, 102, 241, 0.5);
    }

    .nav-sidebar-item.active {
        color: #ffffff;
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.15) 0%, transparent 100%);
        border-left-color: var(--accent-indigo);
    }

    .nav-sidebar-item i {
        width: 22px;
        font-size: 1rem;
        margin-right: 10px;
    }

    .sidebar-badge {
        font-size: 0.72rem;
        padding: 0.2rem 0.55rem;
        border-radius: 50px;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
    }

    /* Admin Hero Header */
    .admin-header-card {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 27, 75, 0.9) 50%, rgba(49, 46, 129, 0.85) 100%);
        border: 1px solid var(--card-border);
        border-radius: 22px;
        padding: 1.75rem 2rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(16px);
        position: relative;
        overflow: hidden;
    }

    .admin-title {
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin-bottom: 0.2rem;
        text-transform: uppercase;
    }

    /* Top 4 Core Metrics Grid (Point 31) */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .kpi-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 1.25rem 1.4rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(12px);
        transition: transform 0.25s ease, border-color 0.25s ease;
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        border-color: rgba(99, 102, 241, 0.4);
    }

    .kpi-icon-wrap {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .kpi-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
        font-weight: 600;
        margin-bottom: 0.15rem;
    }

    .kpi-value {
        font-size: 1.65rem;
        font-weight: 800;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        line-height: 1.1;
    }

    /* Featured Today's Sales Banner */
    .sales-highlight-card {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(6, 182, 212, 0.12) 100%),
                    rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(16, 185, 129, 0.35);
        border-radius: 22px;
        padding: 1.5rem 1.85rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 12px 30px rgba(16, 185, 129, 0.1);
        backdrop-filter: blur(12px);
    }

    .sales-highlight-val {
        font-size: 2.2rem;
        font-weight: 800;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: -0.02em;
    }

    /* 3 Pending Attention Cards (Point 31) */
    .pending-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .pending-card {
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 1.25rem 1.4rem;
        backdrop-filter: blur(12px);
        transition: transform 0.25s ease, border-color 0.25s ease;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pending-count-badge {
        font-size: 1.4rem;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        padding: 0.35rem 0.8rem;
        border-radius: 12px;
    }

    .glass-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px);
    }

    .section-title {
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 1.25rem;
        color: white;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tab-panel-container {
        display: none;
        animation: fadeIn 0.4s ease-out;
    }

    .tab-panel-container.active {
        display: block;
    }

    .approved-table td {
        padding: 0.85rem 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        font-size: 0.9rem;
        vertical-align: middle;
        color: #f1f5f9;
    }

    .approved-table th {
        font-size: 0.78rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 0.75rem;
        font-weight: 600;
    }

    .modal-content-glass {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid var(--card-border);
        border-radius: 24px;
        color: white;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        font-size: 0.88rem;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-row .label {
        color: var(--text-secondary);
        font-weight: 600;
    }

    .detail-row .value {
        color: #ffffff;
        font-weight: 600;
    }

    .toast-container-custom {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1055;
    }

    .toast-custom {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid var(--card-border);
        border-radius: 14px;
        color: white;
        min-width: 320px;
        display: none;
    }
</style>

<div class="admin-layout-wrapper">
    <!-- 32. ADMIN SIDEBAR DASHBOARD NAVIGATION (17 CORE SECTIONS) -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-header">
            <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-warning bg-opacity-15 text-warning fs-5">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <div class="text-white fw-bold fs-6">ShopNext Master</div>
                    <small class="text-success fw-bold" style="font-size: 0.72rem;"><i class="fa-solid fa-circle-dot me-1"></i> ADMIN PORTAL</small>
                </div>
            </div>
        </div>

        <!-- Group 1: OVERVIEW -->
        <div class="sidebar-group-title">Overview</div>
        <div class="nav-sidebar-item active" onclick="switchAdminTab('overview', this)">
            <span><i class="fa-solid fa-gauge-high text-info"></i> Dashboard</span>
            <span class="sidebar-badge bg-info bg-opacity-20 text-info">Live</span>
        </div>

        <!-- Group 2: USERS & MERCHANTS -->
        <div class="sidebar-group-title">Users & Merchants</div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('customers', this)" id="nav-customers">
            <span><i class="fa-solid fa-users text-primary"></i> Customers</span>
            <span class="sidebar-badge bg-primary bg-opacity-20 text-primary">10.5K</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('sellers', this)" id="nav-sellers">
            <span><i class="fa-solid fa-store text-warning"></i> Sellers</span>
            <span class="sidebar-badge bg-warning bg-opacity-20 text-warning">250</span>
        </div>

        <!-- Group 3: CATALOG & INVENTORY -->
        <div class="sidebar-group-title">Catalog & Inventory</div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('products', this)" id="nav-products">
            <span><i class="fa-solid fa-boxes-stacked text-cyan" style="color: #22d3ee;"></i> Products</span>
            <span class="sidebar-badge bg-cyan bg-opacity-20 text-info">15K</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('categories', this)" id="nav-categories">
            <span><i class="fa-solid fa-layer-group text-violet" style="color: #a78bfa;"></i> Categories</span>
            <span class="sidebar-badge bg-secondary bg-opacity-30 text-light">5</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('brands', this)" id="nav-brands">
            <span><i class="fa-solid fa-copyright text-pink" style="color: #f472b6;"></i> Brands</span>
            <span class="sidebar-badge bg-secondary bg-opacity-30 text-light" id="sidebarBrandBadge">@Model.BrandsList.Count</span>
        </div>

        <!-- Group 4: SALES & FINANCE -->
        <div class="sidebar-group-title">Sales & Finance</div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('orders', this)" id="nav-orders">
            <span><i class="fa-solid fa-bag-shopping text-emerald" style="color: #34d399;"></i> Orders</span>
            <span class="sidebar-badge bg-success bg-opacity-20 text-success" id="sidebarOrderBadge">@Model.OrdersList.Count</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('payments', this)" id="nav-payments">
            <span><i class="fa-solid fa-credit-card text-success"></i> Payments</span>
            <span class="sidebar-badge bg-success bg-opacity-20 text-success" id="sidebarPaymentBadge">@Model.PaymentsList.Count</span>
        </div>

        <!-- Group 5: POST-PURCHASE -->
        <div class="sidebar-group-title">Post-Purchase</div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('returns', this)" id="nav-returns">
            <span><i class="fa-solid fa-rotate-left text-danger"></i> Returns</span>
            <span class="sidebar-badge bg-danger bg-opacity-20 text-danger">8 New</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('refunds', this)" id="nav-refunds">
            <span><i class="fa-solid fa-money-bill-transfer text-amber" style="color: #fbbf24;"></i> Refunds</span>
            <span class="sidebar-badge bg-warning bg-opacity-20 text-warning">Direct UPI</span>
        </div>

        <!-- Group 6: MARKETING -->
        <div class="sidebar-group-title">Marketing & Deals</div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('coupons', this)" id="nav-coupons">
            <span><i class="fa-solid fa-ticket text-info"></i> Coupons</span>
            <span class="sidebar-badge bg-info bg-opacity-20 text-info" id="sidebarCouponBadge">@Model.CouponsList.Count</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('offers', this)" id="nav-offers">
            <span><i class="fa-solid fa-bullhorn text-warning"></i> Offers</span>
            <span class="sidebar-badge bg-warning bg-opacity-20 text-warning" id="sidebarOfferBadge">@Model.OffersList.Count</span>
        </div>

        <!-- Group 7: FEEDBACK & SUPPORT -->
        <div class="sidebar-group-title">Feedback & Support</div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('reviews', this)" id="nav-reviews">
            <span><i class="fa-solid fa-star text-warning"></i> Reviews</span>
            <span class="sidebar-badge bg-warning bg-opacity-20 text-warning" id="sidebarReviewBadge">@Model.ReviewsList.Count</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('complaints', this)" id="nav-complaints">
            <span><i class="fa-solid fa-headset text-danger"></i> Complaints</span>
            <span class="sidebar-badge bg-danger bg-opacity-20 text-danger">5 Open</span>
        </div>

        <!-- Group 8: SYSTEM -->
        <div class="sidebar-group-title">System Operations</div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('reports', this)" id="nav-reports">
            <span><i class="fa-solid fa-chart-line text-info"></i> Reports</span>
            <span class="sidebar-badge bg-secondary bg-opacity-30 text-light">PDF/CSV</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('notifications', this)" id="nav-notifications">
            <span><i class="fa-solid fa-bell text-warning"></i> Notifications</span>
            <span class="sidebar-badge bg-warning bg-opacity-20 text-warning">3</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('settings', this)" id="nav-settings">
            <span><i class="fa-solid fa-sliders text-secondary"></i> Settings</span>
        </div>
        <a asp-action="Logout" class="nav-sidebar-item text-danger mt-2 border-top border-secondary border-opacity-25 pt-3">
            <span><i class="fa-solid fa-right-from-bracket text-danger"></i> Logout</span>
        </a>
    </aside>

    <!-- Main Content Area with Tab Panels -->
    <main class="admin-content-area">
        @Html.AntiForgeryToken()
        <!-- 1. TAB: OVERVIEW (Point 31 Admin Dashboard) -->
        <div class="tab-panel-container active" id="panel-overview">
            <!-- Admin Hero Header -->
            <div class="admin-header-card">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                            <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-30 px-3 py-1 rounded-pill small fw-bold">
                                <i class="fa-solid fa-crown me-1"></i> PHASE 3 &bull; ADMIN CONTROL
                            </span>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-3 py-1 rounded-pill small">
                                <i class="fa-solid fa-circle-dot me-1"></i> System Operational
                            </span>
                        </div>
                        <h1 class="admin-title"><i class="fa-solid fa-shield-halved text-warning me-2"></i> ADMIN DASHBOARD</h1>
                        <p class="text-secondary small mb-0">Unified platform telemetry, seller approvals, real-time finances, and operations management.</p>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="DatabaseSetup" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 fw-semibold">
                            <i class="fa-solid fa-database me-1"></i> DB Console
                        </a>
                        <a asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Top 4 Core Platform Metrics -->
            <div class="kpi-grid">
                <div class="kpi-card" onclick="switchAdminTab('customers')" style="cursor: pointer;">
                    <div class="kpi-icon-wrap" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3);">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <div class="kpi-label">Customers</div>
                        <div class="kpi-value" id="kpiCustomers">@Model.TotalCustomers.ToString("N0")</div>
                    </div>
                </div>

                <div class="kpi-card" onclick="switchAdminTab('sellers')" style="cursor: pointer;">
                    <div class="kpi-icon-wrap" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                        <i class="fa-solid fa-store"></i>
                    </div>
                    <div>
                        <div class="kpi-label">Sellers</div>
                        <div class="kpi-value" id="kpiSellers">@Model.TotalSellers.ToString("N0")</div>
                    </div>
                </div>

                <div class="kpi-card" onclick="switchAdminTab('products')" style="cursor: pointer;">
                    <div class="kpi-icon-wrap" style="background: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3);">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>
                    <div>
                        <div class="kpi-label">Products</div>
                        <div class="kpi-value" id="kpiProducts">@Model.TotalProducts.ToString("N0")</div>
                    </div>
                </div>

                <div class="kpi-card" onclick="switchAdminTab('orders')" style="cursor: pointer;">
                    <div class="kpi-icon-wrap" style="background: rgba(139, 92, 246, 0.15); color: #a78bfa; border: 1px solid rgba(139, 92, 246, 0.3);">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                    <div>
                        <div class="kpi-label">Orders</div>
                        <div class="kpi-value" id="kpiOrders">@Model.TotalOrders.ToString("N0")</div>
                    </div>
                </div>
            </div>

            <!-- Featured Today's Sales Banner -->
            <div class="sales-highlight-card">
                <div class="row align-items-center g-3">
                    <div class="col-md-7">
                        <div class="text-secondary small fw-bold text-uppercase mb-1"><i class="fa-solid fa-bolt me-1 text-success"></i> Real-Time Daily GMV</div>
                        <div class="d-flex align-items-baseline gap-3 flex-wrap">
                            <span class="text-secondary fs-4 fw-bold">Today's Sales:</span>
                            <span class="sales-highlight-val text-emerald" style="color: #34d399;">₹@Model.TodaySales.ToString("N0")</span>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-40 px-2.5 py-1 rounded-pill small">
                                <i class="fa-solid fa-arrow-trend-up me-1"></i> +18.4% vs yesterday
                            </span>
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end">
                        <div class="d-inline-flex flex-column gap-1 text-start p-2.5 rounded-3" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--card-border);">
                            <small class="text-secondary">Platform 5% Commission: <strong class="text-warning font-monospace">₹22,500</strong></small>
                            <small class="text-secondary">Settled Merchant Payouts: <strong class="text-success font-monospace">₹4,27,500</strong></small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- The 3 Pending Attention Cards -->
            <div class="pending-grid">
                <div class="pending-card" onclick="switchAdminTab('sellers')" style="border-left: 4px solid #f59e0b; cursor: pointer;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fs-2 text-warning"><i class="fa-solid fa-user-clock"></i></div>
                        <div>
                            <div class="text-white fw-bold">Pending Seller Requests</div>
                            <small class="text-secondary">New merchant applications</small>
                        </div>
                    </div>
                    <div class="pending-count-badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-30">
                        @Model.PendingSellerRequests
                    </div>
                </div>

                <div class="pending-card" onclick="switchAdminTab('returns')" style="border-left: 4px solid #f43f5e; cursor: pointer;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fs-2 text-danger"><i class="fa-solid fa-rotate-left"></i></div>
                        <div>
                            <div class="text-white fw-bold">Pending Returns</div>
                            <small class="text-secondary">Doorstep returns to audit</small>
                        </div>
                    </div>
                    <div class="pending-count-badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-30">
                        @Model.PendingReturns
                    </div>
                </div>

                <div class="pending-card" onclick="switchAdminTab('complaints')" style="border-left: 4px solid #06b6d4; cursor: pointer;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fs-2 text-info"><i class="fa-solid fa-headset"></i></div>
                        <div>
                            <div class="text-white fw-bold">Pending Complaints</div>
                            <small class="text-secondary">Customer resolution desk</small>
                        </div>
                    </div>
                    <div class="pending-count-badge bg-info bg-opacity-15 text-info border border-info border-opacity-30">
                        @Model.PendingComplaints
                    </div>
                </div>
            </div>

            <!-- Seller Requests Panel & Active Directory -->
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="glass-card">
                        <h3 class="section-title">
                            <span><i class="fa-solid fa-users-gear text-warning me-2"></i> Pending Seller KYC</span>
                            <span class="badge bg-warning text-dark fs-6 rounded-pill" id="badgePendingCount">@pendingShops.Count</span>
                        </h3>

                        <div id="pendingShopsList">
                            @if (!pendingShops.Any())
                            {
                                <div class="p-4 rounded-4 text-center border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.4);">
                                    <div class="fs-1 text-success mb-2"><i class="fa-solid fa-circle-check"></i></div>
                                    <h6 class="text-white fw-bold">No Pending Requests</h6>
                                    <p class="text-secondary small mb-0">All merchant applications have been reviewed.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var shop in pendingShops)
                                {
                                    <div class="p-3 rounded-4 mb-3 border border-secondary border-opacity-25" id="pending-card-@shop.Id" style="background: rgba(15, 23, 42, 0.55);">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="text-white fw-bold fs-5 pending-shop-name">@shop.ShopName</div>
                                                <div class="text-secondary small"><i class="fa-solid fa-user me-1 text-primary"></i> @(string.IsNullOrWhiteSpace(shop.OwnerName) ? "Merchant" : shop.OwnerName) &bull; <i class="fa-solid fa-phone me-1 text-success"></i> @shop.PhoneNumber</div>
                                            </div>
                                            <span class="badge bg-warning bg-opacity-20 text-warning px-2.5 py-1 rounded-pill small pending-shop-cat">@shop.Category</span>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            <button type="button" class="btn btn-outline-info btn-sm flex-grow-1" onclick="viewSellerModal(@shop.Id)"><i class="fa-solid fa-eye me-1"></i> View</button>
                                            <button type="button" class="btn btn-success btn-sm flex-grow-1" onclick="approveSeller(@shop.Id)"><i class="fa-solid fa-check me-1"></i> Approve</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="openRejectSellerModal(@shop.Id, '@Html.Raw(shop.ShopName.Replace("'", "\\'"))')"><i class="fa-solid fa-xmark"></i></button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="glass-card">
                        <h3 class="section-title">
                            <span><i class="fa-solid fa-store text-success me-2"></i> Active Partner Stores</span>
                            <span class="badge bg-success fs-6 rounded-pill" id="badgeActiveCount">@approvedShops.Count</span>
                        </h3>
                        <div class="table-responsive">
                            <table class="table approved-table">
                                <thead>
                                    <tr>
                                        <th>Store & Owner</th>
                                        <th>Category</th>
                                        <th>Mobile</th>
                                        <th style="text-align: center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="approvedShopsTableBody">
                                    @foreach (var shop in approvedShops.Take(6))
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-white">@shop.ShopName</div>
                                                <div class="text-secondary small">@(string.IsNullOrEmpty(shop.City) ? "Patna" : shop.City)</div>
                                            </td>
                                            <td><span class="badge bg-secondary bg-opacity-30 text-light px-2 py-1">@shop.Category</span></td>
                                            <td class="font-monospace text-secondary small">@shop.PhoneNumber</td>
                                            <td style="text-align: center;">
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">Active</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. TAB: CUSTOMERS (Point 33: Customer Management) -->
        <div class="tab-panel-container" id="panel-customers">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-users text-primary me-2"></i> Customer Management</h3>
                        <p class="text-secondary small mb-0">Audit consumer profiles, order histories, and manage active / block permissions.</p>
                    </div>
                    <span class="badge bg-primary bg-opacity-25 text-primary px-3 py-2 rounded-pill font-monospace">@Model.TotalCustomers.ToString("N0") Customers</span>
                </div>
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Mobile</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Risk Assessment (Point 36)</th>
                                <th>Registration Date</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="customerTableBody">
                            @foreach (var cust in Model.CustomersList)
                            {
                                <tr id="cust-row-@cust.Id">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 rounded-circle bg-primary bg-opacity-15 text-primary">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            <div>
                                                <strong class="text-white cust-name" id="cust-name-@cust.Id">@cust.Name</strong>
                                                <div class="text-secondary small">Patna &bull; @cust.TotalOrders orders</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-light cust-email">@cust.Email</td>
                                    <td class="font-monospace text-secondary cust-mobile">@(string.IsNullOrWhiteSpace(cust.Mobile) ? cust.Phone : cust.Mobile)</td>
                                    <td style="text-align: center;" id="cust-status-cell-@cust.Id">
                                        @if (cust.RestrictionLevel == "Account Blocked" || cust.Status == "Blocked" || !cust.IsActive)
                                        {
                                            <span class="badge bg-danger text-white border border-danger px-2.5 py-1 rounded-pill"><i class="fa-solid fa-user-slash me-1"></i> Blocked</span>
                                        }
                                        else if (cust.RestrictionLevel == "Account Suspended" || cust.IsAccountSuspended)
                                        {
                                            <span class="badge bg-secondary bg-opacity-35 text-light border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-clock me-1"></i> Suspended</span>
                                        }
                                        else if (cust.RestrictionLevel == "Return Restricted" || cust.IsReturnDisabled)
                                        {
                                            <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill" style="color: #fb923c !important;"><i class="fa-solid fa-rotate-left me-1"></i> Return Restricted</span>
                                        }
                                        else if (cust.RestrictionLevel == "COD Restricted" || cust.IsCodDisabled)
                                        {
                                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> COD Restricted</span>
                                        }
                                        else if (cust.RestrictionLevel == "Warning")
                                        {
                                            <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Warning</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Normal</span>
                                        }
                                    </td>
                                    <td style="text-align: center;" id="cust-risk-cell-@cust.Id">
                                        @if (cust.RiskLevel == "High" || cust.RiskScore >= 70)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-pill shadow-sm" onclick="openCustomerRiskModal(@cust.Id)" title="High Fraud / Abuse Risk Detected - Click for Breakdown">
                                                <span class="spinner-grow spinner-grow-sm text-danger me-1" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                                                <span class="fw-bold">High 🔴</span>
                                                <span class="badge bg-danger ms-1">@cust.RiskScore/100</span>
                                            </button>
                                        }
                                        else if (cust.RiskLevel == "Medium" || cust.RiskScore >= 30)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning px-2.5 py-1 rounded-pill" onclick="openCustomerRiskModal(@cust.Id)" title="Medium Risk - Monitoring Recommended">
                                                <span class="fw-bold">Medium 🟡</span>
                                                <span class="badge bg-warning text-dark ms-1">@cust.RiskScore/100</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success px-2.5 py-1 rounded-pill" onclick="openCustomerRiskModal(@cust.Id)" title="Low Risk - Verified Safe Shopper">
                                                <span class="fw-bold">Low 🟢</span>
                                                <span class="badge bg-success ms-1">@cust.RiskScore/100</span>
                                            </button>
                                        }
                                        @if (cust.IsCodDisabled)
                                        {
                                            <div class="mt-1"><span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30" style="font-size: 0.68rem;"><i class="fa-solid fa-ban me-0.5"></i> COD Restricted</span></div>
                                        }
                                        @if (cust.IsReturnDisabled)
                                        {
                                            <div class="mt-1"><span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30" style="font-size: 0.68rem;"><i class="fa-solid fa-rotate-left me-0.5"></i> Return Blocked</span></div>
                                        }
                                    </td>
                                    <td class="text-secondary small font-monospace">@cust.RegistrationDate</td>
                                    <td style="text-align: center;" id="cust-action-cell-@cust.Id">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <!-- [Point 46: Manage Restrictions] -->
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="openCustomerRestrictionModal(@cust.Id)" id="btn-restrict-cust-@cust.Id" title="Point 46: Granular Customer Restriction Management (Normal, Warning, COD, Return, Suspended, Blocked)">
                                                <i class="fa-solid fa-user-gear me-1"></i> Restrict
                                            </button>

                                            <!-- [Risk Profile] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1 rounded-3" onclick="openCustomerRiskModal(@cust.Id)" id="btn-risk-cust-@cust.Id" title="Inspect Suspicious Activity &amp; Risk Engine Score">
                                                <i class="fa-solid fa-shield-halved me-1"></i> Risk
                                            </button>

                                            <!-- [View] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2.5 py-1 rounded-3" onclick="viewCustomerModal(@cust.Id)" id="btn-view-cust-@cust.Id" title="View Lifetime History &amp; Orders">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. TAB: SELLERS (Point 34: Seller Management) -->
        <div class="tab-panel-container" id="panel-sellers">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-store text-warning me-2"></i> Seller Management</h3>
                        <p class="text-secondary small mb-0">Review merchant onboarding, monitor shop performance, and manage approvals & restrictions.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group bg-dark p-1 rounded-3 border border-secondary border-opacity-25" role="group">
                            <button type="button" class="btn btn-sm btn-dark seller-filter-btn active" onclick="filterSellerTable('all', this)" id="btnFilterAll">All</button>
                            <button type="button" class="btn btn-sm btn-dark seller-filter-btn" onclick="filterSellerTable('Approved', this)" id="btnFilterApproved">
                                <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Approved</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-dark seller-filter-btn" onclick="filterSellerTable('Pending', this)" id="btnFilterPending">
                                <span class="text-warning"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-dark seller-filter-btn" onclick="filterSellerTable('Rejected', this)" id="btnFilterRejected">
                                <span class="text-danger"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-dark seller-filter-btn" onclick="filterSellerTable('Blocked', this)" id="btnFilterBlocked">
                                <span class="text-danger-emphasis" style="color: #f87171;"><i class="fa-solid fa-ban me-1"></i> Blocked</span>
                            </button>
                        </div>
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill font-monospace fw-bold">@Model.TotalSellers Sellers</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Shop Name</th>
                                <th>Owner</th>
                                <th>Email</th>
                                <th>Mobile</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="sellerTableBody">
                            @foreach (var seller in Model.SellersList)
                            {
                                <tr id="seller-row-@seller.Id" class="seller-table-row" data-status="@seller.Status">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 rounded-3 bg-warning bg-opacity-15 text-warning">
                                                <i class="fa-solid fa-shop"></i>
                                            </div>
                                            <div>
                                                <strong class="text-white seller-shop-name" id="seller-name-@seller.Id">@seller.ShopName</strong>
                                                <div class="text-secondary small">
                                                    <span class="badge bg-secondary bg-opacity-30 text-light me-1">@seller.Category</span>
                                                    <span>@seller.City &bull; @seller.TotalProducts items</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-light fw-semibold seller-owner-name">@seller.Owner</div>
                                        <small class="text-secondary">⭐ @seller.Rating.ToString("F1")</small>
                                    </td>
                                    <td class="text-secondary font-monospace small seller-email-val">@seller.Email</td>
                                    <td class="text-secondary font-monospace small seller-mobile-val">@seller.Mobile</td>
                                    <td style="text-align: center;" id="seller-status-cell-@seller.Id">
                                        @if (seller.Status == "Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Approved
                                            </span>
                                        }
                                        else if (seller.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-clock me-1"></i> Pending
                                            </span>
                                        }
                                        else if (seller.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-xmark me-1"></i> Rejected
                                            </span>
                                        }
                                        else if (seller.Status == "Blocked")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-ban me-1"></i> Blocked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-secondary px-2.5 py-1 rounded-pill">@seller.Status</span>
                                        }
                                    </td>
                                    <td style="text-align: center;" id="seller-action-cell-@seller.Id">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <!-- [View] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewSellerModal(@seller.Id)" title="View Details">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>

                                            @if (seller.Status == "Pending")
                                            {
                                                <!-- [Approve] -->
                                                <button type="button" class="btn btn-success btn-sm px-2 py-1 rounded-3 fw-bold" onclick="approveSeller(@seller.Id)" title="Approve Seller">
                                                    <i class="fa-solid fa-check me-1"></i> Approve
                                                </button>
                                                <!-- [Reject] -->
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openRejectSellerModal(@seller.Id, '@Html.Raw(seller.ShopName.Replace("'", "\\'"))')" title="Reject Application">
                                                    <i class="fa-solid fa-xmark me-1"></i> Reject
                                                </button>
                                            }
                                            else if (seller.Status == "Approved")
                                            {
                                                <!-- [Block] -->
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3 fw-bold" onclick="openBlockSellerModal(@seller.Id, '@Html.Raw(seller.ShopName.Replace("'", "\\'"))')" title="Block Seller">
                                                    <i class="fa-solid fa-ban me-1"></i> Block
                                                </button>
                                            }
                                            else if (seller.Status == "Blocked")
                                            {
                                                <!-- [Unblock] -->
                                                <button type="button" class="btn btn-outline-success btn-sm px-2 py-1 rounded-3 fw-bold" onclick="unblockSeller(@seller.Id)" title="Unblock Seller">
                                                    <i class="fa-solid fa-lock-open me-1"></i> Unblock
                                                </button>
                                            }
                                            else if (seller.Status == "Rejected")
                                            {
                                                <!-- [Approve] Re-approve -->
                                                <button type="button" class="btn btn-outline-success btn-sm px-2 py-1 rounded-3 fw-bold" onclick="approveSeller(@seller.Id)" title="Re-approve Seller">
                                                    <i class="fa-solid fa-check me-1"></i> Approve
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 4. TAB: PRODUCTS (Point 37: Product Approval & Moderation Queue) -->
        <div class="tab-panel-container" id="panel-products">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-boxes-stacked text-cyan me-2" style="color: #22d3ee;"></i> Product Management &amp; Approval Queue</h3>
                        <p class="text-secondary small mb-0">Multi-Vendor Lifecycle: Seller Adds &rarr; Admin Review &rarr; Approved &rarr; Visible to Customers.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="productPendingHeaderBadge">
                            <i class="fa-solid fa-clock me-1"></i> @Model.PendingProductApprovals Pending Review
                        </span>
                        <span class="badge bg-info bg-opacity-20 text-info px-3 py-2 rounded-pill font-monospace" id="productTotalHeaderBadge">
                            @Model.ProductsList.Count Total Products
                        </span>
                    </div>
                </div>

                <!-- Approval Filter Pills -->
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold product-filter-btn active" onclick="filterProductTable('all', this)">
                        All (<span id="count-all-prod">@Model.ProductsList.Count</span>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold product-filter-btn" onclick="filterProductTable('Pending', this)">
                        <i class="fa-solid fa-clock me-1"></i> Pending Review (<span id="count-pending-prod">@Model.ProductsList.Count(p => p.ApprovalStatus == "Pending" || !p.IsApproved)</span>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold product-filter-btn" onclick="filterProductTable('Approved', this)">
                        <i class="fa-solid fa-circle-check me-1"></i> Approved (<span id="count-approved-prod">@Model.ProductsList.Count(p => p.IsApproved && p.ApprovalStatus == "Approved")</span>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold product-filter-btn" onclick="filterProductTable('Rejected', this)">
                        <i class="fa-solid fa-circle-xmark me-1"></i> Rejected (<span id="count-rejected-prod">@Model.ProductsList.Count(p => p.ApprovalStatus == "Rejected")</span>)
                    </button>
                </div>

                <!-- Product Catalog Table -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Product Details &amp; SKU</th>
                                <th>Seller / Shop</th>
                                <th>Category &amp; Brand</th>
                                <th>Price &amp; Stock</th>
                                <th style="text-align: center;">Approval Status</th>
                                <th>Date Added</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productsTableBody">
                            @foreach (var prod in Model.ProductsList)
                            {
                                string approvalStatus = string.IsNullOrWhiteSpace(prod.ApprovalStatus) ? (prod.IsApproved ? "Approved" : "Pending") : prod.ApprovalStatus;
                                <tr class="product-table-row" id="product-row-@prod.Id" data-status="@approvalStatus">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@prod.ImageUrl" class="rounded-3" style="width: 48px; height: 48px; object-fit: cover; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1);" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100';" alt="@prod.ProductName" />
                                            <div>
                                                <div class="fw-bold text-white" id="prod-name-@prod.Id">@prod.ProductName</div>
                                                <div class="d-flex align-items-center gap-2 text-secondary small font-monospace">
                                                    <span>SKU: @prod.Sku</span>
                                                    @if (prod.HasVariants)
                                                    {
                                                        <span class="badge bg-indigo bg-opacity-20 text-indigo px-1.5 py-0.5 rounded" style="font-size: 0.7rem; color: #a5b4fc; background: rgba(99,102,241,0.2);">Variants</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <strong class="text-white">@prod.ShopName</strong>
                                        <div class="text-secondary small">ID: #SHP-@prod.ShopId.ToString("D3")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-30 text-light px-2 py-1">@prod.Category</span>
                                        <div class="text-light small mt-0.5"><i class="fa-solid fa-copyright text-pink me-1" style="font-size: 0.75rem;"></i> @prod.Brand</div>
                                    </td>
                                    <td>
                                        <div class="font-monospace text-info fw-bold">₹@prod.Price.ToString("N0")</div>
                                        @if (prod.Mrp.HasValue && prod.Mrp > prod.Price)
                                        {
                                            <div class="text-secondary small font-monospace text-decoration-line-through">₹@prod.Mrp.Value.ToString("N0")</div>
                                        }
                                        <small class="badge bg-success bg-opacity-20 text-success py-0.5 px-1.5 rounded">@prod.Stock in stock</small>
                                    </td>
                                    <td style="text-align: center;" id="product-status-cell-@prod.Id">
                                        @if (approvalStatus == "Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Approved &amp; Live
                                            </span>
                                        }
                                        else if (approvalStatus == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1.5 rounded-pill">
                                                <i class="fa-solid fa-clock me-1"></i> Pending Review
                                            </span>
                                        }
                                        else if (approvalStatus == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill" title="@prod.RejectionReason">
                                                <i class="fa-solid fa-circle-xmark me-1"></i> Rejected
                                            </span>
                                        }
                                    </td>
                                    <td class="text-secondary small">
                                        @prod.CreatedDate
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center" id="product-action-cell-@prod.Id">
                                            <!-- [View] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewProductApprovalModal(@prod.Id)" title="View Product Specifications">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>

                                            @if (approvalStatus == "Pending" || approvalStatus == "Rejected")
                                            {
                                                <!-- [Approve] -->
                                                <button type="button" class="btn btn-outline-success btn-sm px-2 py-1 rounded-3 fw-bold" onclick="approveProduct(@prod.Id)" title="Approve Product for Customer Catalog">
                                                    <i class="fa-solid fa-check me-1"></i> Approve
                                                </button>
                                            }

                                            @if (approvalStatus == "Pending" || approvalStatus == "Approved")
                                            {
                                                <!-- [Reject] -->
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openRejectProductModal(@prod.Id, '@Html.Raw(prod.ProductName.Replace("'", "\\'"))')" title="Reject Product">
                                                    <i class="fa-solid fa-xmark me-1"></i> Reject
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 5. TAB: CATEGORIES (Point 35: Category Management) -->
        <div class="tab-panel-container" id="panel-categories">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-layer-group text-primary me-2"></i> Category Management</h3>
                        <p class="text-secondary small mb-0">Manage platform product classifications, taxonomy icons, and store departments.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- [Add] Category Action -->
                        <button type="button" class="btn btn-primary btn-sm px-3.5 py-2 fw-bold rounded-3 shadow-sm" onclick="openAddCategoryModal()">
                            <i class="fa-solid fa-plus me-1.5"></i> Add Category
                        </button>
                        <span class="badge bg-primary bg-opacity-25 text-primary px-3 py-2 rounded-pill font-monospace" id="categoryTotalBadge">@Model.CategoriesList.Count Categories</span>
                    </div>
                </div>

                <!-- 5 Target Categories Grid & Table -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Description / Scope</th>
                                <th>Products</th>
                                <th>Total GMV</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="categoriesTableBody">
                            @foreach (var cat in Model.CategoriesList)
                            {
                                <tr id="category-row-@cat.Id">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="p-2.5 rounded-3 bg-primary bg-opacity-15 text-primary fs-5" id="cat-icon-wrap-@cat.Id">
                                                <i class="@cat.Icon" id="cat-icon-@cat.Id"></i>
                                            </div>
                                            <div>
                                                <strong class="text-white fs-6" id="cat-name-@cat.Id">@cat.Name</strong>
                                                <div class="text-secondary small font-monospace">ID: #CAT-@cat.Id.ToString("D3")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-secondary small" id="cat-desc-@cat.Id">@cat.Description</div>
                                    </td>
                                    <td>
                                        <span class="text-info fw-bold font-monospace">@cat.ProductCount.ToString("N0")</span>
                                        <small class="text-secondary">items</small>
                                    </td>
                                    <td>
                                        <span class="text-success fw-bold font-monospace">₹@cat.TotalSales.ToString("N0")</span>
                                    </td>
                                    <td style="text-align: center;" id="cat-status-cell-@cat.Id">
                                        @if (cat.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill">
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5">
                                            <!-- [Edit] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="openEditCategoryModal(@cat.Id)" title="Edit Category">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                            </button>
                                            <!-- [Delete] -->
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2.5 py-1 rounded-3" onclick="openDeleteCategoryModal(@cat.Id, '@Html.Raw(cat.Name.Replace("'", "\\'"))')" title="Delete Category">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 6. TAB: BRANDS (Point 36: Brand Management) -->
        <div class="tab-panel-container" id="panel-brands">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-copyright text-pink me-2" style="color: #f472b6;"></i> Brand Management</h3>
                        <p class="text-secondary small mb-0">Manage partner brands (Samsung, Apple, Nike, Adidas, HP, Dell, Lenovo), category associations, and quality ratings.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- [Add] Brand Action -->
                        <button type="button" class="btn btn-sm px-3.5 py-2 fw-bold rounded-3 shadow-sm text-white" style="background: linear-gradient(135deg, #ec4899, #db2777); border: none;" onclick="openAddBrandModal()">
                            <i class="fa-solid fa-plus me-1.5"></i> Add Brand
                        </button>
                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background: rgba(244, 114, 182, 0.2); color: #f472b6;" id="brandTotalBadge">@Model.BrandsList.Count Brands</span>
                    </div>
                </div>

                <!-- 7 Target Brands Table (Samsung, Apple, Nike, Adidas, HP, Dell, Lenovo) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Brand Details</th>
                                <th>Category</th>
                                <th>Description / Scope</th>
                                <th>Products</th>
                                <th>Rating</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="brandsTableBody">
                            @foreach (var b in Model.BrandsList)
                            {
                                <tr id="brand-row-@b.Id">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-3 overflow-hidden d-flex align-items-center justify-content-center p-1" style="width: 44px; height: 44px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);" id="brand-logo-wrap-@b.Id">
                                                <img src="@(string.IsNullOrWhiteSpace(b.LogoUrl) ? "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=100" : b.LogoUrl)" id="brand-img-@b.Id" class="img-fluid rounded-2" style="max-height: 100%; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=100';" alt="@b.Name" />
                                            </div>
                                            <div>
                                                <strong class="text-white fs-6" id="brand-name-@b.Id">@b.Name</strong>
                                                <div class="text-secondary small font-monospace">ID: #BRD-@b.Id.ToString("D3")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill" id="brand-cat-@b.Id">
                                            @b.Category
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-secondary small text-truncate" style="max-width: 260px;" id="brand-desc-@b.Id" title="@b.Description">
                                            @(string.IsNullOrWhiteSpace(b.Description) ? $"{b.Name} authorized brand collection" : b.Description)
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-info fw-bold font-monospace">@b.ProductCount.ToString("N0")</span>
                                        <small class="text-secondary">items</small>
                                    </td>
                                    <td>
                                        <span class="text-warning fw-bold font-monospace" id="brand-rating-@b.Id">⭐ @b.Rating.ToString("F1")</span>
                                    </td>
                                    <td style="text-align: center;" id="brand-status-cell-@b.Id">
                                        @if (b.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill">
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5">
                                            <!-- [View] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2.5 py-1 rounded-3" onclick="viewBrandModal(@b.Id)" title="View Brand Profile">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>
                                            <!-- [Edit] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="openEditBrandModal(@b.Id)" title="Edit Brand">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                            </button>
                                            <!-- [Delete] -->
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2.5 py-1 rounded-3" onclick="openDeleteBrandModal(@b.Id, '@Html.Raw(b.Name.Replace("'", "\\'"))')" title="Delete Brand">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 7. TAB: ORDERS (Point 38: Admin Order Management) -->
        <div class="tab-panel-container" id="panel-orders">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-bag-shopping text-emerald me-2" style="color: #34d399;"></i> Order Management &amp; Telemetry</h3>
                        <p class="text-secondary small mb-0">Track all marketplace orders across customers, sellers, payment modes, and delivery lifecycle.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-success bg-opacity-20 text-success px-3 py-2 rounded-pill font-monospace" id="orderTotalHeaderBadge">
                            <i class="fa-solid fa-bag-shopping me-1"></i> @Model.OrdersList.Count Total Orders
                        </span>
                        <span class="badge bg-info bg-opacity-20 text-info px-3 py-2 rounded-pill font-monospace">
                            ₹@Model.OrdersList.Sum(o => o.TotalAmount).ToString("N0") Volume
                        </span>
                    </div>
                </div>

                <!-- Point 38: Multi-Dimensional Filter Bar (Date, Status, Seller, Customer) -->
                <div class="p-3 rounded-4 mb-4 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.65);">
                    <div class="row g-3 align-items-center">
                        <!-- Date Filter Buttons (Today, Yesterday, This Month, All) -->
                        <div class="col-lg-4 col-md-12">
                            <label class="form-label text-secondary small fw-bold mb-1"><i class="fa-regular fa-calendar me-1 text-info"></i> Date Filter</label>
                            <div class="d-flex gap-1.5 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold order-date-btn active" onclick="setDateOrderFilter('all', this)" id="btnOrderDateAll">All Dates</button>
                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold order-date-btn" onclick="setDateOrderFilter('Today', this)">Today</button>
                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold order-date-btn" onclick="setDateOrderFilter('Yesterday', this)">Yesterday</button>
                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold order-date-btn" onclick="setDateOrderFilter('ThisMonth', this)">This Month</button>
                            </div>
                        </div>

                        <!-- Status Filter Dropdown -->
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label text-secondary small fw-bold mb-1"><i class="fa-solid fa-signal me-1 text-warning"></i> Status</label>
                            <select id="orderStatusFilter" class="form-select form-select-sm bg-dark text-white border-secondary" onchange="filterAdminOrders()">
                                <option value="all" selected>All Statuses</option>
                                <option value="Pending">Pending</option>
                                <option value="Accepted">Accepted</option>
                                <option value="Preparing">Preparing</option>
                                <option value="OutForDelivery">Out For Delivery</option>
                                <option value="Delivered">Delivered</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <!-- Seller Filter Dropdown -->
                        <div class="col-lg-3 col-md-4">
                            <label class="form-label text-secondary small fw-bold mb-1"><i class="fa-solid fa-store me-1 text-warning"></i> Seller / Shop</label>
                            <select id="orderSellerFilter" class="form-select form-select-sm bg-dark text-white border-secondary" onchange="filterAdminOrders()">
                                <option value="all" selected>All Sellers</option>
                                @foreach (var sellerName in Model.OrdersList.Select(o => o.ShopName).Distinct())
                                {
                                    <option value="@sellerName">@sellerName</option>
                                }
                            </select>
                        </div>

                        <!-- Customer Search Input -->
                        <div class="col-lg-3 col-md-4">
                            <label class="form-label text-secondary small fw-bold mb-1"><i class="fa-solid fa-user me-1 text-primary"></i> Customer Search</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-dark text-secondary border-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <input type="text" id="orderCustomerSearch" class="form-control bg-dark text-white border-secondary" placeholder="Name, Phone, or #ORD..." oninput="filterAdminOrders()" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Point 38: Orders Table (Order ID, Customer, Seller, Amount, Payment, Status, Date) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Seller</th>
                                <th>Amount</th>
                                <th>Payment</th>
                                <th style="text-align: center;">Status</th>
                                <th>Date</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody">
                            @foreach (var ord in Model.OrdersList)
                            {
                                <tr class="order-table-row" id="order-row-@ord.Id" data-date="@ord.DateFilterCategory" data-status="@ord.OrderStatus" data-seller="@ord.ShopName" data-customer="@ord.CustomerName @ord.CustomerMobile @ord.OrderNumber">
                                    <!-- Order ID -->
                                    <td>
                                        <div class="font-monospace text-info fw-bold" id="order-num-@ord.Id">@ord.OrderNumber</div>
                                        <small class="text-secondary">@ord.ItemCount item(s)</small>
                                    </td>

                                    <!-- Customer -->
                                    <td>
                                        <strong class="text-white">@ord.CustomerName</strong>
                                        <div class="text-secondary small font-monospace">@ord.CustomerMobile</div>
                                        <div class="text-muted small text-truncate" style="max-width: 180px;" title="@ord.DeliveryAddress">@ord.DeliveryAddress</div>
                                    </td>

                                    <!-- Seller -->
                                    <td>
                                        <strong class="text-white">@ord.ShopName</strong>
                                        <div class="text-secondary small">Owner: @ord.SellerOwner</div>
                                    </td>

                                    <!-- Amount -->
                                    <td>
                                        <div class="font-monospace text-success fw-bold">₹@ord.TotalAmount.ToString("N2")</div>
                                    </td>

                                    <!-- Payment -->
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-30 text-light px-2 py-0.5 mb-1 d-inline-block">@ord.PaymentMode</span>
                                        <div>
                                            @if (ord.PaymentStatus == "Paid" || ord.PaymentStatus == "Success")
                                            {
                                                <span class="badge bg-success bg-opacity-20 text-success py-0.5 px-1.5 rounded" id="order-pay-status-@ord.Id">Paid</span>
                                            }
                                            else if (ord.PaymentStatus == "Refunded")
                                            {
                                                <span class="badge bg-warning bg-opacity-20 text-warning py-0.5 px-1.5 rounded" id="order-pay-status-@ord.Id">Refunded</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-20 text-danger py-0.5 px-1.5 rounded" id="order-pay-status-@ord.Id">@ord.PaymentStatus</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Status -->
                                    <td style="text-align: center;" id="order-status-cell-@ord.Id">
                                        @if (ord.OrderStatus == "Delivered")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Delivered
                                            </span>
                                        }
                                        else if (ord.OrderStatus == "OutForDelivery")
                                        {
                                            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1.5 rounded-pill">
                                                <i class="fa-solid fa-truck-fast me-1"></i> Out for Delivery
                                            </span>
                                        }
                                        else if (ord.OrderStatus == "Preparing" || ord.OrderStatus == "Accepted")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1.5 rounded-pill">
                                                <i class="fa-solid fa-boxes-packing me-1"></i> @ord.OrderStatus
                                            </span>
                                        }
                                        else if (ord.OrderStatus == "Cancelled")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill">
                                                <i class="fa-solid fa-ban me-1"></i> Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light border border-secondary border-opacity-30 px-2.5 py-1.5 rounded-pill">
                                                <i class="fa-solid fa-clock me-1"></i> @ord.OrderStatus
                                            </span>
                                        }
                                    </td>

                                    <!-- Date -->
                                    <td class="text-secondary small font-monospace">
                                        @ord.FormattedDate
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <!-- [View] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewAdminOrderModal(@ord.Id)" title="View Order Details">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>
                                            <!-- [Update Status] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openUpdateOrderStatusModal(@ord.Id, '@ord.OrderStatus')" title="Change Order Status">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Status
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 8. TAB: PAYMENTS (Point 39: Payment Management) -->
        <div class="tab-panel-container" id="panel-payments">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-credit-card text-success me-2"></i> Payment Management &amp; Settlements</h3>
                        <p class="text-secondary small mb-0">Audit merchant payment transactions, 5% platform commission settlements, and gateway receipts.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-success bg-opacity-20 text-success px-3 py-2 rounded-pill font-monospace">
                            <i class="fa-solid fa-shield-halved me-1"></i> 5% Standard Platform Fee
                        </span>
                        <span class="badge bg-info bg-opacity-20 text-info px-3 py-2 rounded-pill font-monospace" id="paymentTotalBadge">
                            @Model.PaymentsList.Count Transactions
                        </span>
                    </div>
                </div>

                <!-- Point 39: Status Filter Pills (Pending, Success, Failed, Refunded, All) & Search -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold payment-filter-btn active" onclick="filterPaymentTable('all', this)">
                            All (<span id="count-pay-all">@Model.PaymentsList.Count</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold payment-filter-btn" onclick="filterPaymentTable('Success', this)">
                            <i class="fa-solid fa-circle-check me-1"></i> Success (<span id="count-pay-success">@Model.PaymentsList.Count(p => p.Status == "Success")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold payment-filter-btn" onclick="filterPaymentTable('Pending', this)">
                            <i class="fa-solid fa-clock me-1"></i> Pending (<span id="count-pay-pending">@Model.PaymentsList.Count(p => p.Status == "Pending")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold payment-filter-btn" onclick="filterPaymentTable('Failed', this)">
                            <i class="fa-solid fa-circle-xmark me-1"></i> Failed (<span id="count-pay-failed">@Model.PaymentsList.Count(p => p.Status == "Failed")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold payment-filter-btn" onclick="filterPaymentTable('Refunded', this)">
                            <i class="fa-solid fa-rotate-left me-1"></i> Refunded (<span id="count-pay-refunded">@Model.PaymentsList.Count(p => p.Status == "Refunded")</span>)
                        </button>
                    </div>
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text bg-dark text-secondary border-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="paymentSearchInput" class="form-control bg-dark text-white border-secondary" placeholder="Search Txn ID, Order ID..." oninput="searchPaymentTable()" />
                    </div>
                </div>

                <!-- Point 39: Payments Table (Payment ID, Order ID, Customer, Amount, Payment Method, Transaction ID, Status, Date) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Payment ID</th>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Amount &amp; Fee</th>
                                <th>Payment Method</th>
                                <th>Transaction ID</th>
                                <th style="text-align: center;">Status</th>
                                <th>Date</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="paymentsTableBody">
                            @foreach (var pay in Model.PaymentsList)
                            {
                                <tr class="payment-table-row" id="payment-row-@pay.RawOrderId" data-status="@pay.Status" data-search="@pay.PaymentId @pay.OrderId @pay.TransactionId @pay.CustomerName @pay.CustomerMobile">
                                    <!-- Payment ID -->
                                    <td class="font-monospace text-info fw-bold">@pay.PaymentId</td>

                                    <!-- Order ID -->
                                    <td class="font-monospace text-light fw-bold">@pay.OrderId</td>

                                    <!-- Customer -->
                                    <td>
                                        <strong class="text-white">@pay.CustomerName</strong>
                                        <div class="text-secondary small font-monospace">@pay.CustomerMobile</div>
                                    </td>

                                    <!-- Amount, 5% Commission, Net Payout -->
                                    <td>
                                        <div class="font-monospace text-white fw-bold">₹@pay.Amount.ToString("N2")</div>
                                        <small class="text-warning">5% Fee: ₹@pay.Commission.ToString("F2")</small>
                                    </td>

                                    <!-- Payment Method -->
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                            @pay.PaymentMethod
                                        </span>
                                    </td>

                                    <!-- Transaction ID -->
                                    <td class="font-monospace text-secondary small">@pay.TransactionId</td>

                                    <!-- Status -->
                                    <td style="text-align: center;" id="payment-status-cell-@pay.RawOrderId">
                                        @if (pay.Status == "Success")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Success
                                            </span>
                                        }
                                        else if (pay.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-clock me-1"></i> Pending
                                            </span>
                                        }
                                        else if (pay.Status == "Failed")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-xmark me-1"></i> Failed
                                            </span>
                                        }
                                        else if (pay.Status == "Refunded")
                                        {
                                            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-rotate-left me-1"></i> Refunded
                                            </span>
                                        }
                                    </td>

                                    <!-- Date -->
                                    <td class="text-secondary small font-monospace">@pay.Date</td>

                                    <!-- Actions -->
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewPaymentDetailsModal(@pay.RawOrderId)" title="View Transaction Audit">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>
                                            @if (pay.Status == "Success")
                                            {
                                                <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openRefundModal(@pay.RawOrderId, @pay.Amount)" title="Initiate Refund">
                                                    <i class="fa-solid fa-rotate-left me-1"></i> Refund
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 9. TAB: RETURNS (Point 34: Wrong Product Return & Product Swap Protection) -->
        <div class="tab-panel-container" id="panel-returns">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small fw-bold">
                                <i class="fa-solid fa-shield-halved me-1"></i> ANTI-FRAUD &bull; SWAP PROTECTION
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-rotate-left text-danger me-2"></i> Returns &amp; Product Verification Desk</h3>
                        <p class="text-secondary small mb-0">Audit serial numbers, verify original SKUs, and inspect returned items before refund release.</p>
                    </div>
                    <span class="badge bg-danger bg-opacity-20 text-danger px-3 py-2 rounded-pill font-monospace" id="returnsBadge">
                        @Model.ReturnsList.Count Returns Active
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Return &amp; Order ID</th>
                                <th>Customer &amp; Store</th>
                                <th>Product &amp; SKU</th>
                                <th>Reason</th>
                                <th>Refund Amount</th>
                                <th style="text-align: center;">Verification Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="returnsTableBody">
                            @foreach (var ret in Model.ReturnsList)
                            {
                                <tr id="return-row-@ret.RawOrderId">
                                    <td class="font-monospace text-danger fw-bold">
                                        <div>@ret.ReturnId</div>
                                        <small class="text-secondary">@ret.OrderId</small>
                                    </td>
                                    <td>
                                        <div class="text-white fw-bold">@ret.CustomerName</div>
                                        <small class="text-secondary"><i class="fa-solid fa-store text-warning me-1"></i> @ret.ShopName</small>
                                    </td>
                                    <td>
                                        <div class="text-light fw-semibold">@ret.ProductName</div>
                                        <div class="font-monospace text-secondary small">SKU: @ret.Sku</div>
                                    </td>
                                    <td class="text-warning small fst-italic">"@ret.Reason"</td>
                                    <td class="font-monospace text-success fw-bold">₹@ret.Amount.ToString("N2")</td>
                                    <td style="text-align: center;" id="return-status-cell-@ret.RawOrderId">
                                        @if (ret.Status == "Approved" || ret.Status == "Return_Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Approved
                                            </span>
                                        }
                                        else if (ret.Status == "Under_Verification")
                                        {
                                            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-magnifying-glass me-1"></i> Under Verification
                                            </span>
                                        }
                                        else if (ret.Status == "Product_Swapped_Fraud" || ret.Status == "Swapped_Product_Hold")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Swapped / Hold
                                            </span>
                                        }
                                        else if (ret.Status == "Rejected" || ret.Status == "Return_Rejected")
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light border border-secondary px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-xmark me-1"></i> Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-clock me-1"></i> Return Requested
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align: center;" id="return-action-cell-@ret.RawOrderId">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1.5 rounded-3 fw-bold" onclick="openReturnVerificationModal(@ret.RawOrderId)" title="Inspect & Verify Item">
                                                <i class="fa-solid fa-shield-halved me-1"></i> Verify
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm px-2.5 py-1.5 rounded-3 fw-bold" onclick="openReturnEvidenceModal(@ret.RawOrderId)" title="Side-by-Side Visual Photo Comparison">
                                                <i class="fa-solid fa-camera-rotate me-1"></i> Compare Evidence
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 10. TAB: REFUNDS -->
        <div class="tab-panel-container" id="panel-refunds">
            <div class="glass-card">
                <h3 class="section-title">
                    <span><i class="fa-solid fa-money-bill-transfer text-amber me-2"></i> Processed Refunds Ledger</span>
                    <span class="badge bg-success">Instant Gateway</span>
                </h3>
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Refund ID</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Gateway</th>
                                <th>Status</th>
                                <th>Processed Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var refd in Model.RefundsList)
                            {
                                <tr>
                                    <td class="font-monospace text-info fw-bold">@refd.RefundId</td>
                                    <td>@refd.CustomerName</td>
                                    <td class="font-monospace text-danger fw-bold">₹@refd.Amount.ToString("N0")</td>
                                    <td><span class="badge bg-secondary bg-opacity-30 text-light px-2 py-1">@refd.Gateway</span></td>
                                    <td><span class="badge bg-success bg-opacity-25 text-success px-2 py-1 rounded-pill">@refd.Status</span></td>
                                    <td class="text-secondary small">@refd.ProcessedDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 11. TAB: COUPONS (Point 40: Coupon Management) -->
        <div class="tab-panel-container" id="panel-coupons">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-ticket text-info me-2"></i> Coupon Management</h3>
                        <p class="text-secondary small mb-0">Create, configure, and monitor promotional discount coupons across marketing campaigns.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-info bg-opacity-20 text-info px-3 py-2 rounded-pill font-monospace" id="couponCountBadge">
                            @Model.CouponsList.Count Coupons Active
                        </span>
                        <button type="button" class="btn btn-info btn-sm px-3.5 py-2 fw-bold rounded-3 shadow-sm text-dark" onclick="openAddCouponModal()">
                            <i class="fa-solid fa-plus me-1.5"></i> Add Coupon
                        </button>
                    </div>
                </div>

                <!-- Point 40: Coupon Management Table (Coupon Code, Discount, Min Order, Max Discount, Start Date, End Date, Usage Limit, Status) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Coupon Code</th>
                                <th>Discount</th>
                                <th>Minimum Order</th>
                                <th>Maximum Discount</th>
                                <th>Validity Period</th>
                                <th>Usage Limit</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="couponsTableBody">
                            @foreach (var c in Model.CouponsList)
                            {
                                <tr id="coupon-row-@c.Id">
                                    <!-- Coupon Code -->
                                    <td>
                                        <span class="badge bg-primary bg-opacity-20 text-info px-3 py-1.5 rounded-pill font-monospace fw-bold fs-6 border border-primary border-opacity-30" id="coupon-code-@c.Id">
                                            @c.Code
                                        </span>
                                        <div class="text-secondary small mt-1" id="coupon-desc-@c.Id">@c.Description</div>
                                    </td>

                                    <!-- Discount -->
                                    <td>
                                        <strong class="text-success font-monospace fs-6" id="coupon-disc-@c.Id">@c.Discount</strong>
                                        <div class="text-secondary small">Type: @c.DiscountType</div>
                                    </td>

                                    <!-- Minimum Order -->
                                    <td>
                                        <div class="font-monospace text-white fw-bold" id="coupon-min-@c.Id">₹@c.MinOrder.ToString("N0")</div>
                                        <small class="text-muted">Threshold</small>
                                    </td>

                                    <!-- Maximum Discount -->
                                    <td>
                                        <div class="font-monospace text-info" id="coupon-max-@c.Id">@(c.MaxDiscount.HasValue ? $"₹{c.MaxDiscount.Value:N0}" : "Uncapped")</div>
                                    </td>

                                    <!-- Validity Period -->
                                    <td class="text-secondary small font-monospace" id="coupon-validity-@c.Id">
                                        <div><i class="fa-regular fa-calendar-check text-success me-1"></i> @c.StartDate</div>
                                        <div><i class="fa-regular fa-calendar-xmark text-danger me-1"></i> @c.EndDate</div>
                                    </td>

                                    <!-- Usage Limit -->
                                    <td>
                                        <div class="font-monospace text-white">@c.UsedCount / @c.UsageLimit</div>
                                        <div class="progress mt-1" style="height: 4px; background: rgba(255,255,255,0.1);">
                                            @{
                                                int pct = c.UsageLimit > 0 ? (int)((double)c.UsedCount / c.UsageLimit * 100) : 0;
                                            }
                                            <div class="progress-bar bg-info" style="width: @pct%;"></div>
                                        </div>
                                    </td>

                                    <!-- Status -->
                                    <td style="text-align: center;" id="coupon-status-cell-@c.Id">
                                        @if (c.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Active
                                            </span>
                                        }
                                        else if (c.Status == "Expired")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-clock me-1"></i> Expired
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <!-- [Edit] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openEditCouponModal(@c.Id)" title="Edit Coupon">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <!-- [Toggle Status] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="toggleCouponStatus(@c.Id)" title="Toggle Active Status">
                                                <i class="fa-solid fa-power-off"></i>
                                            </button>
                                            <!-- [Delete] -->
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openDeleteCouponModal(@c.Id, '@c.Code')" title="Delete Coupon">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 12. TAB: OFFERS (Point 41: Offers Management) -->
        <div class="tab-panel-container" id="panel-offers">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill small fw-bold">
                                <i class="fa-solid fa-fire me-1"></i> TODAY'S DEALS &bull; PROMOTIONS
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-bullhorn text-warning me-2"></i> Promotional Offers Management</h3>
                        <p class="text-secondary small mb-0">Manage special pricing, time-limited flash deals, and featured homepage discount banners.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="offersCountBadge">
                            @Model.OffersList.Count Offers Live
                        </span>
                        <button type="button" class="btn btn-warning btn-sm px-3.5 py-2 fw-bold rounded-3 shadow-sm text-dark" onclick="openAddOfferModal()">
                            <i class="fa-solid fa-plus me-1.5"></i> Add Offer
                        </button>
                    </div>
                </div>

                <!-- Point 41: Offers Management Table (Product, MRP, Selling Price, Discount, Start Date, End Date, Status, Actions) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>MRP</th>
                                <th>Selling Price</th>
                                <th>Discount</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="offersTableBody">
                            @if (!Model.OffersList.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-secondary">
                                        <i class="fa-solid fa-tags fs-3 mb-2 d-block opacity-50"></i>
                                        No promotional offers created yet. Click "Add Offer" to create your first flash deal.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var off in Model.OffersList)
                                {
                                    <tr id="offer-row-@off.Id">
                                        <!-- Product -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2.5">
                                                <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25" style="width: 44px; height: 44px; flex-shrink: 0; background: #0b1324;">
                                                    <img src="@off.ProductImage" class="w-100 h-100 object-fit-cover" id="offer-img-@off.Id" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100';" />
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-white" id="offer-title-@off.Id">@off.ProductName</div>
                                                    <div class="d-flex gap-1.5 align-items-center mt-0.5">
                                                        <span class="badge bg-secondary bg-opacity-30 text-light" style="font-size: 0.7rem;" id="offer-cat-@off.Id">@off.Category</span>
                                                        <small class="text-secondary font-monospace" style="font-size: 0.72rem;">@off.ShopName</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- MRP -->
                                        <td>
                                            <div class="font-monospace text-secondary text-decoration-line-through" id="offer-mrp-@off.Id">₹@off.Mrp.ToString("N0")</div>
                                        </td>

                                        <!-- Selling Price -->
                                        <td>
                                            <strong class="font-monospace text-success fs-6" id="offer-price-@off.Id">₹@off.SellingPrice.ToString("N0")</strong>
                                        </td>

                                        <!-- Discount -->
                                        <td>
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill font-monospace fw-bold" id="offer-disc-@off.Id">
                                                @off.DiscountFormatted
                                            </span>
                                        </td>

                                        <!-- Start Date -->
                                        <td>
                                            <div class="text-secondary small font-monospace" id="offer-start-@off.Id">
                                                <i class="fa-regular fa-calendar-check text-success me-1"></i> @off.StartDate
                                            </div>
                                        </td>

                                        <!-- End Date -->
                                        <td>
                                            <div class="text-secondary small font-monospace" id="offer-end-@off.Id">
                                                <i class="fa-regular fa-calendar-xmark text-danger me-1"></i> @off.EndDate
                                            </div>
                                        </td>

                                        <!-- Status -->
                                        <td style="text-align: center;" id="offer-status-cell-@off.Id">
                                            @if (off.Status == "Active")
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-circle-check me-1"></i> Active
                                                </span>
                                            }
                                            else if (off.Status == "Expired")
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-clock me-1"></i> Expired
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions -->
                                        <td style="text-align: center;">
                                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                                <!-- [Edit] -->
                                                <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openEditOfferModal(@off.Id)" title="Edit Offer">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <!-- [Toggle Status] -->
                                                <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="toggleOfferStatus(@off.Id)" title="Toggle Active/Inactive">
                                                    <i class="fa-solid fa-power-off"></i>
                                                </button>
                                                <!-- [Delete] -->
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openDeleteOfferModal(@off.Id, '@off.ProductName.Replace("'", "\\'")')" title="Delete Offer">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 13. TAB: REVIEWS (Point 42: Review Management) -->
        <div class="tab-panel-container" id="panel-reviews">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small fw-bold">
                                <i class="fa-solid fa-shield-halved me-1"></i> POLICY &bull; REVIEW MODERATION
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-star text-warning me-2"></i> Customer Review Moderation</h3>
                        <p class="text-secondary small mb-0">Audit product ratings and remove inappropriate, abusive, or fake reviews from customer visibility.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="reviewsCountBadge">
                            @Model.ReviewsList.Count Total Reviews
                        </span>
                    </div>
                </div>

                <!-- Review Status Filter Pills -->
                <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                    <span class="text-secondary small fw-bold text-uppercase me-1"><i class="fa-solid fa-filter me-1"></i> Filter:</span>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 active review-filter-btn" onclick="filterReviewTable('all', this)">All Reviews</button>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 review-filter-btn" onclick="filterReviewTable('visible', this)"><i class="fa-solid fa-eye me-1"></i> Visible</button>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 review-filter-btn" onclick="filterReviewTable('hidden', this)"><i class="fa-solid fa-eye-slash me-1"></i> Hidden / Flagged</button>
                </div>

                <!-- Point 42: Review Management Table (Product, Customer, Rating, Review, Date, Actions: [Hide], [Delete]) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Customer</th>
                                <th style="text-align: center;">Rating</th>
                                <th style="min-width: 250px;">Review Comment</th>
                                <th>Date</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="reviewsTableBody">
                            @if (!Model.ReviewsList.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-secondary">
                                        <i class="fa-solid fa-comment-slash fs-3 mb-2 d-block opacity-50"></i>
                                        No customer reviews recorded yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model.ReviewsList)
                                {
                                    <tr id="review-row-@r.Id" class="review-table-row" data-status="@(r.IsHidden ? "hidden" : "visible")">
                                        <!-- Product -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25" style="width: 40px; height: 40px; flex-shrink: 0; background: #0b1324;">
                                                    <img src="@r.ProductImage" class="w-100 h-100 object-fit-cover" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100';" />
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-white small" id="rev-pname-@r.Id">@r.ProductName</div>
                                                    <small class="text-secondary font-monospace" style="font-size: 0.72rem;">@r.ShopName</small>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Customer -->
                                        <td>
                                            <div class="text-white fw-bold small" id="rev-cname-@r.Id">@r.CustomerName</div>
                                            <small class="text-secondary font-monospace">@r.CustomerPhone</small>
                                        </td>

                                        <!-- Rating (1 to 5 Stars) -->
                                        <td style="text-align: center;">
                                            <div class="text-warning font-monospace fw-bold" style="font-size: 0.95rem;">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= r.Rating)
                                                    {
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-regular fa-star text-secondary opacity-50"></i>
                                                    }
                                                }
                                            </div>
                                            <small class="text-secondary font-monospace">@r.Rating.0 / 5.0</small>
                                        </td>

                                        <!-- Review Comment -->
                                        <td>
                                            <div class="text-light small fst-italic" id="rev-comment-@r.Id">
                                                "@r.Comment"
                                            </div>
                                            @if (r.IsHidden && !string.IsNullOrWhiteSpace(r.ModerationReason))
                                            {
                                                <div class="mt-1" id="rev-reason-badge-@r.Id">
                                                    <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30" style="font-size: 0.7rem;">
                                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Reason: @r.ModerationReason
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <!-- Date -->
                                        <td class="text-secondary small font-monospace">
                                            @r.Date
                                        </td>

                                        <!-- Status -->
                                        <td style="text-align: center;" id="review-status-cell-@r.Id">
                                            @if (r.IsHidden)
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-eye-slash me-1"></i> Hidden
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-eye me-1"></i> Visible
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions: [Hide] / [Unhide], [Delete] -->
                                        <td style="text-align: center;" id="review-action-cell-@r.Id">
                                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                                @if (r.IsHidden)
                                                {
                                                    <button type="button" class="btn btn-outline-success btn-sm px-2.5 py-1 rounded-3" onclick="unhideReview(@r.Id)" title="Make Review Visible to Customers">
                                                        <i class="fa-solid fa-eye me-1"></i> Unhide
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1 rounded-3" onclick="openHideReviewModal(@r.Id, '@r.CustomerName.Replace("'", "\\'")')" title="Hide Inappropriate Review">
                                                        <i class="fa-solid fa-eye-slash me-1"></i> Hide
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openDeleteReviewModal(@r.Id, '@r.CustomerName.Replace("'", "\\'")')" title="Permanently Delete Review">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 14. TAB: COMPLAINTS (Point 43: Customer Complaints & Support Desk) -->
        <div class="tab-panel-container" id="panel-complaints">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-headset text-danger me-2"></i> Complaint / Support Management</h3>
                        <p class="text-secondary small mb-0">Audit and resolve customer order complaints, defective items, delivery escalations, and refund requests.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background: rgba(239, 68, 68, 0.2); color: #f87171;" id="complaintTotalBadge">
                            @Model.ComplaintsList.Count Total Tickets
                        </span>
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="complaintOpenBadge">
                            @Model.ComplaintsList.Count(c => c.Status == "Open" || c.Status == "In Progress") Pending Action
                        </span>
                    </div>
                </div>

                <!-- Point 43: Filter Pills (All, Open, In Progress, Resolved, Closed) & Search -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold complaint-filter-btn active" onclick="filterComplaintTable('all', this)">
                            All (<span id="count-comp-all">@Model.ComplaintsList.Count</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Open', this)">
                            <i class="fa-solid fa-circle-exclamation me-1"></i> Open (<span id="count-comp-open">@Model.ComplaintsList.Count(c => c.Status == "Open")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Under Investigation', this)">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation (<span id="count-comp-investigation">@Model.ComplaintsList.Count(c => c.Status == "Under Investigation" || c.Status == "In Progress")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Resolved', this)">
                            <i class="fa-solid fa-circle-check me-1"></i> Resolved (<span id="count-comp-resolved">@Model.ComplaintsList.Count(c => c.Status == "Resolved")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Rejected', this)">
                            <i class="fa-solid fa-ban me-1"></i> Rejected (<span id="count-comp-rejected">@Model.ComplaintsList.Count(c => c.Status == "Rejected")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Closed', this)">
                            <i class="fa-solid fa-lock me-1"></i> Closed (<span id="count-comp-closed">@Model.ComplaintsList.Count(c => c.Status == "Closed")</span>)
                        </button>
                    </div>
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text bg-dark text-secondary border-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="complaintSearchInput" class="form-control bg-dark text-white border-secondary" placeholder="Search Ticket, Order, Customer..." oninput="searchComplaintTable()" />
                    </div>
                </div>

                <!-- Point 43 & 45: Complaints / Disputes Table (Ticket #, Order ID, Customer, Issue, Description, Attachment, Priority, Status, Date, Actions) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Dispute / Ticket</th>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Issue / Category</th>
                                <th>Description</th>
                                <th style="text-align: center;">Attachment</th>
                                <th>Priority</th>
                                <th style="text-align: center;">Status</th>
                                <th>Date</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="complaintsTableBody">
                            @foreach (var comp in Model.ComplaintsList)
                            {
                                <tr class="complaint-table-row" id="complaint-row-@comp.Id" data-status="@comp.Status" data-search="@comp.TicketId #D@(comp.Id) @comp.OrderNumber @comp.CustomerName @comp.CustomerMobile @comp.Issue @comp.Description">
                                    <!-- Ticket Number & Dispute Number -->
                                    <td>
                                        <div class="fw-bold text-danger font-monospace">#D@(comp.Id)</div>
                                        <small class="text-secondary font-monospace" style="font-size: 11px;">@comp.TicketId</small>
                                    </td>

                                    <!-- Order Number -->
                                    <td>
                                        <span class="font-monospace text-info fw-bold">@comp.OrderNumber</span>
                                    </td>

                                    <!-- Customer -->
                                    <td>
                                        <strong class="text-white">@comp.CustomerName</strong>
                                        <div class="text-secondary small font-monospace">@comp.CustomerMobile</div>
                                    </td>

                                    <!-- Issue / Category -->
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-30 text-light border border-secondary border-opacity-30">
                                            @(comp.ReasonCategory ?? comp.Issue)
                                        </span>
                                    </td>

                                    <!-- Description (Truncated) -->
                                    <td style="max-width: 220px;" class="text-truncate text-secondary small" title="@comp.Description">
                                        @comp.Description
                                    </td>

                                    <!-- Attachment -->
                                    <td style="text-align: center;">
                                        @if (!string.IsNullOrEmpty(comp.AttachmentUrl))
                                        {
                                            <a href="@comp.AttachmentUrl" target="_blank" class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30 text-decoration-none">
                                                <i class="fa-solid fa-paperclip me-1"></i> Proof
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">&mdash;</span>
                                        }
                                    </td>

                                    <!-- Priority -->
                                    <td>
                                        @if (comp.Priority == "Urgent" || comp.Priority == "High")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2 py-0.5 rounded-pill">
                                                <i class="fa-solid fa-bolt me-1"></i> @comp.Priority
                                            </span>
                                        }
                                        else if (comp.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning px-2 py-0.5 rounded-pill">
                                                @comp.Priority
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light px-2 py-0.5 rounded-pill">
                                                @comp.Priority
                                            </span>
                                        }
                                    </td>

                                    <!-- Status (Open, Under Investigation, Resolved, Rejected, Closed) -->
                                    <td style="text-align: center;" id="complaint-status-cell-@comp.Id">
                                        @if (comp.Status == "Open")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-exclamation me-1"></i> Open
                                            </span>
                                        }
                                        else if (comp.Status == "Under Investigation" || comp.Status == "In Progress")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation
                                            </span>
                                        }
                                        else if (comp.Status == "Resolved")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Resolved
                                            </span>
                                        }
                                        else if (comp.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-ban me-1"></i> Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-lock me-1"></i> @comp.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- Date -->
                                    <td class="text-secondary small font-monospace">
                                        @comp.Date
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <!-- [View] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewAdminComplaintModal(@comp.Id)" title="View Complaint Details">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>
                                            <!-- [Update Status] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openUpdateComplaintStatusModal(@comp.Id, '@comp.Status', '@Html.Raw((comp.ResolutionNotes ?? "").Replace("'", "\\'"))')" title="Update Ticket Status">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Status
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 15. TAB: REPORTS (Point 45: Complete 9-Module Financial & Operational Reports Suite) -->
        <div class="tab-panel-container" id="panel-reports">
            <div class="glass-card mb-4">
                <!-- Header & Action Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-chart-line text-info me-2"></i> Financial &amp; Operational Reports Suite</h3>
                        <p class="text-secondary small mb-0">Platform-wide analytics across Sales, Orders, Customers, Sellers, Products, Payments, Returns, Refunds, and Commissions with dynamic date filtering.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-outline-info btn-sm rounded-pill px-3 shadow-sm" onclick="exportCurrentReportCsv()">
                            <i class="fa-solid fa-file-arrow-down me-1"></i> Export CSV
                        </button>
                        <button class="btn btn-outline-light btn-sm rounded-pill px-3 shadow-sm" onclick="window.print()">
                            <i class="fa-solid fa-print me-1"></i> Print / PDF
                        </button>
                    </div>
                </div>

                <!-- Universal Date Filter Toolbar (Today, 7 Days, 30 Days, Custom) -->
                <div class="p-3 rounded-4 mb-4 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.75);">
                    <div class="row g-3 align-items-center">
                        <div class="col-lg-5 col-md-12">
                            <label class="form-label text-secondary small fw-bold mb-2"><i class="fa-solid fa-calendar-days text-info me-1"></i> Date Filter Window:</label>
                            <div class="d-flex gap-2 flex-wrap" id="reportDateFilterButtons">
                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 report-date-btn" data-filter="Today" onclick="setReportDateFilter('Today')">
                                    <i class="fa-solid fa-calendar-day me-1"></i> Today
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 report-date-btn" data-filter="7Days" onclick="setReportDateFilter('7Days')">
                                    <i class="fa-solid fa-calendar-week me-1"></i> 7 Days
                                </button>
                                <button type="button" class="btn btn-sm btn-info text-dark fw-bold rounded-pill px-3 report-date-btn active" data-filter="30Days" onclick="setReportDateFilter('30Days')">
                                    <i class="fa-solid fa-calendar me-1"></i> 30 Days
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 report-date-btn" data-filter="Custom" onclick="setReportDateFilter('Custom')">
                                    <i class="fa-solid fa-sliders me-1"></i> Custom Range
                                </button>
                            </div>
                        </div>

                        <!-- Custom Date Pickers (Shown for Custom Filter) -->
                        <div class="col-lg-7 col-md-12" id="customDateRangeBox" style="display: none;">
                            <div class="row g-2 align-items-end">
                                <div class="col-sm-5">
                                    <label class="form-label text-secondary small mb-1">Start Date</label>
                                    <input type="date" class="form-control form-control-sm bg-dark text-white border-secondary" id="reportCustomStartDate" value="@Model.Reports.StartDate" />
                                </div>
                                <div class="col-sm-5">
                                    <label class="form-label text-secondary small mb-1">End Date</label>
                                    <input type="date" class="form-control form-control-sm bg-dark text-white border-secondary" id="reportCustomEndDate" value="@Model.Reports.EndDate" />
                                </div>
                                <div class="col-sm-2">
                                    <button class="btn btn-info btn-sm text-dark fw-bold w-100" onclick="applyCustomReportDateRange()">
                                        <i class="fa-solid fa-filter me-1"></i> Apply
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filtered KPI Aggregate Summary Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4 border border-info border-opacity-30 h-100" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(15, 23, 42, 0.7));">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-secondary fw-semibold text-uppercase">Gross Sales (GMV)</small>
                                    <h3 class="fw-bold text-white mb-0 mt-1" id="kpiReportGrossSales">₹@Model.Reports.TotalGrossSales.ToString("N2")</h3>
                                </div>
                                <div class="p-3 rounded-circle bg-info bg-opacity-20 text-info fs-4">
                                    <i class="fa-solid fa-indian-rupee-sign"></i>
                                </div>
                            </div>
                            <small class="text-info d-block mt-2"><i class="fa-solid fa-arrow-trend-up me-1"></i> Filtered Time Window</small>
                        </div>
                    </div>

                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4 border border-primary border-opacity-30 h-100" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(15, 23, 42, 0.7));">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-secondary fw-semibold text-uppercase">Orders Volume</small>
                                    <h3 class="fw-bold text-white mb-0 mt-1" id="kpiReportTotalOrders">@Model.Reports.TotalOrdersCount</h3>
                                </div>
                                <div class="p-3 rounded-circle bg-primary bg-opacity-20 text-primary fs-4">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </div>
                            </div>
                            <small class="text-primary d-block mt-2"><i class="fa-solid fa-chart-simple me-1"></i> Total Orders Processed</small>
                        </div>
                    </div>

                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4 border border-success border-opacity-30 h-100" style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), rgba(15, 23, 42, 0.7));">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
