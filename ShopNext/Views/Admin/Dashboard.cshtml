    function toggleSellerParticipationCheck(id, isChecked) {
        $.ajax({
            url: '@Url.Action("ToggleSellerSaleParticipation", "Admin")',
            type: 'POST',
            data: { id: id, isParticipating: isChecked },
            success: function(res) {
                if (res && res.success) {
                    showToast(res.message);
                    const label = document.getElementById(`part-check-label-${id}`);
                    const row = document.getElementById(`part-row-${id}`);
                    const statusCell = document.getElementById(`part-status-cell-${id}`);
                    
                    if (label) {
                        label.innerText = isChecked ? "☑ Participate in Mega Sale" : "☐ Not Participating";
                        label.className = `form-check-label ${isChecked ? "text-success fw-bold" : "text-secondary"} small`;
                    }
                    if (row) {
                        row.setAttribute('data-participating', isChecked ? 'true' : 'false');
                        row.setAttribute('data-status', isChecked ? 'pending' : 'optedout');
                    }
                    if (statusCell && res.data) {
                        statusCell.innerHTML = isChecked
                            ? '<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-clock me-1"></i> Pending Admin Approval</span>'
                            : '<span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> Opted Out</span>';
                    }
                    refreshParticipationCounters();
                } else {
                    showToast(res ? res.message : "Error updating participation.", true);
                }
            },
            error: function() {
                showToast("Connection error updating participation.", true);
            }
        });
    }

