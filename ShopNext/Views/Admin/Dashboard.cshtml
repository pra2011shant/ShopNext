            showToast("Please enter a category name.", true);
            return;
        }

        const btn = document.getElementById("btnSubmitAddCat");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("AddCategory", "Admin")',
            type: 'POST',
            data: { name: name, icon: icon, description: desc, status: status },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('addCategoryModal'))?.hide();
                if (res.success && res.category) {
                    showToast(res.message);
                    const cat = res.category;
                    const newRow = `
                        <tr id="category-row-${cat.id}">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="p-2.5 rounded-3 bg-primary bg-opacity-15 text-primary fs-5" id="cat-icon-wrap-${cat.id}">
                                        <i class="${cat.icon}" id="cat-icon-${cat.id}"></i>
                                    </div>
                                    <div>
                                        <strong class="text-white fs-6" id="cat-name-${cat.id}">${cat.name}</strong>
                                        <div class="text-secondary small font-monospace">ID: #CAT-${cat.id.toString().padStart(3, '0')}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="text-secondary small" id="cat-desc-${cat.id}">${cat.description || 'New Category'}</div>
                            </td>
                            <td>
                                <span class="text-info fw-bold font-monospace">0</span>
                                <small class="text-secondary">items</small>
                            </td>
                            <td>
