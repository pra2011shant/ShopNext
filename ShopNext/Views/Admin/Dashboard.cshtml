    function renderEvidenceStage(outboundList, inboundList) {
        // Outbound
        document.getElementById("outboundEvidCount").innerText = `${outboundList.length} Photos`;
        const outStrip = document.getElementById("evidOutboundThumbStrip");
        outStrip.innerHTML = "";
        if (outboundList.length > 0) {
            const first = outboundList[0];
            selectOutboundEvidence(first);

            outboundList.forEach((ev, idx) => {
                const thumb = document.createElement("div");
                thumb.className = `rounded-2 overflow-hidden border ${idx === 0 ? 'border-info border-2' : 'border-secondary border-opacity-40'} cursor-pointer flex-shrink-0`;
                thumb.style = "width: 58px; height: 58px; cursor: pointer; background: #070d18;";
                thumb.innerHTML = `<img src="${ev.photoUrl}" class="w-100 h-100 object-fit-cover" title="${ev.title}" alt="${ev.title}" onerror="this.src='https://images.unsplash.com/photo-1610945415295-d9bbf067e59c?w=100'" />`;
                thumb.onclick = function() {
                    Array.from(outStrip.children).forEach(c => c.className = "rounded-2 overflow-hidden border border-secondary border-opacity-40 cursor-pointer flex-shrink-0");
                    thumb.className = "rounded-2 overflow-hidden border border-info border-2 cursor-pointer flex-shrink-0";
                    selectOutboundEvidence(ev);
                };
                outStrip.appendChild(thumb);
            });
        }

        // Inbound
        document.getElementById("inboundEvidCount").innerText = `${inboundList.length} Photos`;
        const inStrip = document.getElementById("evidInboundThumbStrip");
        inStrip.innerHTML = "";
        if (inboundList.length > 0) {
            const first = inboundList[0];
            selectInboundEvidence(first);

            inboundList.forEach((ev, idx) => {
                const thumb = document.createElement("div");
                thumb.className = `rounded-2 overflow-hidden border ${idx === 0 ? 'border-danger border-2' : 'border-secondary border-opacity-40'} cursor-pointer flex-shrink-0`;
                thumb.style = "width: 58px; height: 58px; cursor: pointer; background: #070d18;";
                thumb.innerHTML = `<img src="${ev.photoUrl}" class="w-100 h-100 object-fit-cover" title="${ev.title}" alt="${ev.title}" onerror="this.src='https://images.unsplash.com/photo-1569429593410-b498b3fb3387?w=100'" />`;
                thumb.onclick = function() {
                    Array.from(inStrip.children).forEach(c => c.className = "rounded-2 overflow-hidden border border-secondary border-opacity-40 cursor-pointer flex-shrink-0");
                    thumb.className = "rounded-2 overflow-hidden border border-danger border-2 cursor-pointer flex-shrink-0";
                    selectInboundEvidence(ev);
                };
                inStrip.appendChild(thumb);
            });
        }
    }

    function selectOutboundEvidence(ev) {
        document.getElementById("evidMainOutboundImg").src = ev.photoUrl;
        document.getElementById("evidOutboundTitle").innerText = ev.title;
        document.getElementById("evidOutboundUploader").innerText = `Uploaded by ${ev.uploadedBy || ev.role}`;
        document.getElementById("evidOutboundDate").innerText = ev.uploadedAt || ev.date;
        document.getElementById("evidOutboundDesc").innerText = ev.description || "Verified outbound photo.";
        document.getElementById("outboundActiveBadge").innerText = (ev.type || '').replace(/Photo/g, '');

        // Point 77 Audit Trail
        updateEvidenceAuditTrail(ev);
    }

    function selectInboundEvidence(ev) {
        document.getElementById("evidMainInboundImg").src = ev.photoUrl;
        document.getElementById("evidInboundTitle").innerText = ev.title;
        document.getElementById("evidInboundUploader").innerText = `Uploaded by ${ev.uploadedBy || ev.role}`;
        document.getElementById("evidInboundDate").innerText = ev.uploadedAt || ev.date;
        document.getElementById("evidInboundDesc").innerText = ev.description || "Reported inbound condition photo.";
        document.getElementById("inboundActiveBadge").innerText = (ev.type || '').replace(/Photo/g, '');

        // Point 77 Audit Trail
        updateEvidenceAuditTrail(ev);
    }

    function updateEvidenceAuditTrail(ev) {
        if (!ev) return;
        document.getElementById("evidAuditCode").innerText = ev.evidenceCode || `EV${String(ev.id || '1001').padStart(4, '0')}`;
        document.getElementById("evidAuditUploadedBy").innerText = ev.uploadedBy || ev.role || "Customer";
        document.getElementById("evidAuditUploadedAt").innerText = ev.uploadedAt || ev.date || "10:35 AM";
        document.getElementById("evidAuditViewedBy").innerText = ev.viewedBy || "Admin";
        document.getElementById("evidAuditViewedAt").innerText = ev.viewedAt || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
        const decBadge = document.getElementById("evidAuditDecision");
        const decText = ev.decision || "Under Review";
        decBadge.innerText = decText;
        if (decText.includes("Approved") || decText.includes("Accepted")) {
            decBadge.className = "badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2 py-0.5 rounded-pill small fw-bold";
        } else if (decText.includes("Rejected")) {
            decBadge.className = "badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2 py-0.5 rounded-pill small fw-bold";
        } else {
            decBadge.className = "badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2 py-0.5 rounded-pill small fw-bold";
        }
        
        document.getElementById("evidAuditDecisionBy").innerText = `By: ${ev.decisionBy || 'Admin'}`;
    }

    function toggleUploadEvidenceCollapse() {
        const col = document.getElementById("evidUploadCollapse");
        col.style.display = col.style.display === "none" ? "block" : "none";
    }

    function submitUploadEvidencePhoto() {
        const orderId = document.getElementById("evidTargetOrderId").value;
        const type = document.getElementById("uploadEvidType").value;
        const title = document.getElementById("uploadEvidTitle").value.trim();
        const photoUrl = document.getElementById("uploadEvidUrl").value.trim();
        const token = $('input[name="__RequestVerificationToken"]').val();

        if (!photoUrl) {
            showToast("Please provide an image URL.", true);
            return;
        }

        $.ajax({
            url: '@Url.Action("UploadOrderEvidence", "Admin")',
            type: 'POST',
            data: {
                __RequestVerificationToken: token,
                orderId: orderId,
                evidenceType: type,
                title: title || "Additional Photo Evidence",
                photoUrl: photoUrl
            },
            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    document.getElementById("uploadEvidTitle").value = "";
                    document.getElementById("uploadEvidUrl").value = "";
                    document.getElementById("evidUploadCollapse").style.display = "none";
                    openReturnEvidenceModal(orderId); // Refresh modal
                } else {
                    showToast(res.message, true);
                }
            },
            error: function() {
                showToast("Connection error uploading photo evidence.", true);
            }
        });
    }

    function submitEvidenceDecision(decision) {
        const orderId = document.getElementById("evidTargetOrderId").value;
        const notes = document.getElementById("evidResolutionNotesInput").value.trim();
        const token = $('input[name="__RequestVerificationToken"]').val();

        let confirmMsg = "";
        if (decision === 'Approve') {
            confirmMsg = "Are you sure you want to approve this return and issue refund based on visual evidence?";
        } else if (decision === 'Reject') {
            confirmMsg = "Are you sure you want to reject this return due to evidence mismatch / product damage?";
        } else {
            confirmMsg = "Mark this return as Under Investigation for supervisor / lab audit?";
        }

        if (!confirm(confirmMsg)) return;

        $.ajax({
            url: '@Url.Action("ProcessEvidenceDecision", "Admin")',
            type: 'POST',
            data: {
                __RequestVerificationToken: token,
                orderId: orderId,
                decision: decision,
                notes: notes
            },
            success: function(res) {
                bootstrap.Modal.getInstance(document.getElementById('returnEvidenceModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    const cell = document.getElementById(`return-status-cell-${orderId}`);
                    if (cell) {
                        if (decision === 'Approve') {
                            cell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Approved</span>';
                        } else if (decision === 'Investigate') {
                            cell.innerHTML = '<span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Verification</span>';
                        } else {
                            cell.innerHTML = '<span class="badge bg-secondary bg-opacity-30 text-light border border-secondary px-2.5 py-1 rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>';
                        }
                    }
                } else {
                    showToast(res.message, true);
                }
            },
            error: function() {
                showToast("Connection error submitting evidence decision.", true);
            }
        });
    }

