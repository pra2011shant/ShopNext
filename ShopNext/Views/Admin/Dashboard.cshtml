    let activeAdminComplaintId = 0;
    let activeAdminCustomerId = 0;

    function viewAdminComplaintModal(id) {
        const modal = new bootstrap.Modal(document.getElementById('adminComplaintDetailsModal'));
        document.getElementById("adminComplaintModalLoader").style.display = "block";
        document.getElementById("adminComplaintModalContent").style.display = "none";
        document.getElementById("adminComplaintActionNotes").value = "";
        modal.show();

        $.ajax({
            url: '@Url.Action("GetComplaintDetails", "Admin")',
            type: 'GET',
            data: { id: id },
            success: function(res) {
                document.getElementById("adminComplaintModalLoader").style.display = "none";
                if (res.success && res.complaint) {
                    const c = res.complaint;
                    const stmts = res.statements || {};
                    const custStmt = stmts.customer || res.customerStatement || {};
                    const sellerStmt = stmts.seller || {};
                    const riderStmt = stmts.rider || res.riderStatement || {};
                    const audit = res.audit || {};
                    const auditOrder = audit.order || {};
                    const auditPay = audit.payment || {};
                    const auditRet = audit.returnDetails || {};
                    const ev = audit.evidence || res.evidence || {};
                    const ch = res.customerHistory || {};
                    
                    activeAdminComplaintId = c.id;
                    activeAdminCustomerId = ch.customerId || c.customerId;

                    document.getElementById("adminComplaintModalContent").style.display = "block";

                    // Header Title & Ticket Info
                    document.getElementById("mComplaintDisputeTitle").innerText = c.disputeNumber || `Dispute #D${c.id}`;
                    document.getElementById("mComplaintTicketSub").innerText = `Ticket #${c.ticketNumber}`;
                    document.getElementById("mComplaintDateSub").innerText = c.createdDate;

                    // Header Status Badge & Step Pipeline Indicator
                    const badge = document.getElementById("mComplaintStatusBadge");
                    badge.className = "badge px-3 py-1 rounded-pill fs-7";

                    // Reset pipeline step styles
                    const stepOpen = document.getElementById("mStepOpen");
                    const stepInv = document.getElementById("mStepInvestigation");
                    const stepRes = document.getElementById("mStepResolved");
                    const stepRej = document.getElementById("mStepRejected");

                    [stepOpen, stepInv, stepRes, stepRej].forEach(el => {
                        if (el) {
                            el.style.opacity = "0.5";
                            el.style.boxShadow = "none";
                        }
                    });

                    if (c.status === "Open") {
                        badge.classList.add("bg-danger", "bg-opacity-25", "text-danger", "border", "border-danger", "border-opacity-30");
                        badge.innerHTML = '<i class="fa-solid fa-circle-exclamation me-1"></i> Open';
                        if (stepOpen) { stepOpen.style.opacity = "1"; stepOpen.style.boxShadow = "0 0 12px rgba(239, 68, 68, 0.4)"; }
                    } else if (c.status === "Under Investigation" || c.status === "In Progress") {
                        badge.classList.add("bg-warning", "bg-opacity-25", "text-warning", "border", "border-warning", "border-opacity-30");
                        badge.innerHTML = '<i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation';
                        if (stepInv) { stepInv.style.opacity = "1"; stepInv.style.boxShadow = "0 0 12px rgba(245, 158, 11, 0.4)"; }
                    } else if (c.status === "Resolved") {
                        badge.classList.add("bg-success", "bg-opacity-25", "text-success", "border", "border-success", "border-opacity-30");
                        badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Resolved';
                        if (stepRes) { stepRes.style.opacity = "1"; stepRes.style.boxShadow = "0 0 12px rgba(34, 197, 94, 0.4)"; }
                    } else if (c.status === "Rejected") {
                        badge.classList.add("bg-danger", "bg-opacity-25", "text-danger", "border", "border-danger", "border-opacity-30");
                        badge.innerHTML = '<i class="fa-solid fa-ban me-1"></i> Rejected';
                        if (stepRej) { stepRej.style.opacity = "1"; stepRej.style.boxShadow = "0 0 12px rgba(100, 116, 139, 0.4)"; }
                    } else {
                        badge.classList.add("bg-secondary", "bg-opacity-30", "text-light");
                        badge.innerHTML = `<i class="fa-solid fa-lock me-1"></i> ${c.status}`;
                    }

                    // -------------------------------------------------------------
                    // 1. 3-PARTY STATEMENTS
                    // -------------------------------------------------------------
                    // (A) Customer Statement
                    document.getElementById("mCustStatementName").innerText = custStmt.name || c.customerName;
                    document.getElementById("mCustStatementPhone").innerText = custStmt.phone || c.customerMobile;
                    document.getElementById("mCustStatementEmail").innerText = custStmt.email || c.customerEmail;
                    document.getElementById("mCustStatementCategory").innerText = custStmt.issueCategory || c.reasonCategory || "Delivery Dispute";
                    document.getElementById("mCustStatementDesc").innerText = custStmt.statement || custStmt.description || c.description;
                    document.getElementById("mCustStatementDate").innerText = custStmt.date || c.createdDate;

                    const custAttach = document.getElementById("mCustAttachmentWrap");
                    if (custStmt.attachmentUrl || c.attachmentUrl) {
                        const url = custStmt.attachmentUrl || c.attachmentUrl;
                        custAttach.style.display = "inline-block";
                        document.getElementById("mCustAttachmentLink").href = url;
                    } else {
                        custAttach.style.display = "none";
                    }

                    // (B) Seller Statement
                    document.getElementById("mSellerShopName").innerText = sellerStmt.shopName || auditOrder.shopName || "Merchant Partner";
                    document.getElementById("mSellerOwnerName").innerText = sellerStmt.sellerName || "Store Manager";
                    document.getElementById("mSellerPhone").innerText = sellerStmt.phone || "N/A";
                    document.getElementById("mSellerDispatchStatus").innerText = sellerStmt.dispatchStatus || "Dispatched";
                    document.getElementById("mSellerStatementDesc").innerText = sellerStmt.statement || "Dispatched in original factory condition with tamper-evident seal and barcode verification.";
                    document.getElementById("mSellerStatementDate").innerText = sellerStmt.date !== "N/A" ? sellerStmt.date : c.createdDate;

                    // (C) Rider Statement
                    document.getElementById("mRiderStatementName").innerText = riderStmt.name || "Assigned Rider";
                    document.getElementById("mRiderStatementPhone").innerText = riderStmt.phone || "N/A";
                    document.getElementById("mRiderVehicle").innerText = riderStmt.vehicle || "Delivery Bike";
                    document.getElementById("mRiderStatementDesc").innerText = riderStmt.statement || (ev.isOtpVerified ? `Handover completed at customer doorstep. Verified with OTP #${ev.deliveryOtp}.` : "Rider assigned for delivery. Handover logged in telemetry.");
                    document.getElementById("mRiderTotalDeliveries").innerText = riderStmt.totalDeliveries || 0;
                    document.getElementById("mRiderPastComplaints").innerText = riderStmt.complaintsCount || 0;
                    document.getElementById("mRiderOtpTag").innerText = ev.isOtpVerified ? "OTP Verified" : "In Transit";

                    // -------------------------------------------------------------
                    // 2. 4-PILLAR AUDIT DATA
                    // -------------------------------------------------------------
                    // Pillar 1: Order Details
                    document.getElementById("mAuditOrderNum").innerText = auditOrder.orderNumber || c.orderNumber;
                    document.getElementById("mAuditOrderDate").innerText = auditOrder.orderDate || c.createdDate;
                    document.getElementById("mAuditOrderStatus").innerText = auditOrder.orderStatus || "Delivered";
                    document.getElementById("mAuditOrderShop").innerText = auditOrder.shopName || sellerStmt.shopName || "Store";

                    const itemsContainer = document.getElementById("mAuditOrderItemsList");
                    itemsContainer.innerHTML = "";
                    if (auditOrder.items && auditOrder.items.length > 0) {
                        auditOrder.items.forEach(item => {
                            const row = document.createElement("div");
                            row.className = "d-flex justify-content-between border-bottom border-secondary border-opacity-20 py-0.5";
                            row.innerHTML = `<span class="text-truncate" style="max-width: 140px;">${item.productName}</span> <span class="font-monospace text-info">x${item.quantity} (₹${item.price})</span>`;
                            itemsContainer.appendChild(row);
                        });
                    } else {
                        itemsContainer.innerHTML = `<span class="text-secondary small">Order item records verified.</span>`;
                    }

                    // Pillar 2: Payment Details
                    document.getElementById("mAuditPaymentMode").innerText = auditPay.paymentMode || ev.paymentMode || "COD";
                    document.getElementById("mAuditPaymentAmount").innerText = `₹${auditPay.totalAmount || ev.orderAmount || '0.00'}`;
                    document.getElementById("mAuditPaymentStatus").innerText = auditPay.paymentStatus || "Paid";
                    document.getElementById("mAuditPaymentChannel").innerText = (auditPay.paymentMode === "COD" || ev.paymentMode === "COD") ? "Cash On Delivery" : "Online Gateway (Prepaid)";

                    // Pillar 3: Return Details
                    document.getElementById("mAuditReturnStatus").innerText = auditRet.returnStatus !== "N/A" ? auditRet.returnStatus : "None";
                    document.getElementById("mAuditReturnReason").innerText = auditRet.returnReason !== "No Return Requested" ? auditRet.returnReason : (custStmt.issueCategory || "Disputed");
                    document.getElementById("mAuditReturnDate").innerText = auditRet.returnRequestedDate !== "N/A" ? auditRet.returnRequestedDate : c.createdDate;
                    document.getElementById("mAuditReturnNotes").innerText = auditRet.returnVerificationNotes !== "No return verification remarks" ? auditRet.returnVerificationNotes : "Dispute filed under resolution audit.";

                    // Pillar 4: Evidence (OTP & Telemetry)
                    const otpBadge = document.getElementById("mAuditEvidenceOtpBadge");
                    if (ev.isOtpVerified) {
                        otpBadge.className = "badge bg-success bg-opacity-25 text-success border border-success border-opacity-30";
                        otpBadge.innerHTML = `<i class="fa-solid fa-shield-check me-1"></i> OTP: ${ev.deliveryOtp} ✓`;
                    } else {
                        otpBadge.className = "badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30";
                        otpBadge.innerHTML = `<i class="fa-solid fa-clock me-1"></i> OTP: ${ev.deliveryOtp || 'Pending'}`;
                    }
                    document.getElementById("mAuditDeliveredTime").innerText = ev.deliveredDate !== "N/A" ? ev.deliveredDate : (ev.otpVerifiedDate !== "N/A" ? ev.otpVerifiedDate : "Recorded in Telemetry");

                    const logsContainer = document.getElementById("mAuditEvidenceLogs");
                    logsContainer.innerHTML = "";
                    if (ev.evidenceList && ev.evidenceList.length > 0) {
                        ev.evidenceList.forEach(e => {
                            const item = document.createElement("div");
                            item.className = "p-1 rounded bg-black bg-opacity-30 mb-1 d-flex justify-content-between align-items-center";
                            item.innerHTML = `
                                <span class="text-secondary" style="font-size: 10px;">${e.title}: <strong class="text-light">${e.uploadedBy}</strong></span>
                                ${e.photoUrl ? `<a href="${e.photoUrl}" target="_blank" class="badge bg-info bg-opacity-30 text-info text-decoration-none" style="font-size: 9px;"><i class="fa-solid fa-image me-0.5"></i> Proof</a>` : ''}
                            `;
                            logsContainer.appendChild(item);
                        });
                    } else {
                        logsContainer.innerHTML = `<span class="text-secondary small fst-italic" style="font-size: 10px;"><i class="fa-solid fa-shield-check text-success me-1"></i> Verified OTP & GPS Telemetry log intact.</span>`;
                    }

                    // -------------------------------------------------------------
                    // 3. CUSTOMER HISTORY & RISK PROFILE
                    // -------------------------------------------------------------
                    const riskBadge = document.getElementById("mCustRiskBadge");
                    riskBadge.className = "badge px-3 py-1 rounded-pill";
                    if (ch.riskLevel === "High" || ch.riskScore >= 70) {
                        riskBadge.classList.add("bg-danger", "bg-opacity-25", "text-danger", "border", "border-danger", "border-opacity-30");
                        riskBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation me-1"></i> High Risk (${ch.riskScore}/100)`;
                    } else if (ch.riskLevel === "Medium" || ch.riskScore >= 30) {
                        riskBadge.classList.add("bg-warning", "bg-opacity-25", "text-warning", "border", "border-warning", "border-opacity-30");
                        riskBadge.innerHTML = `<i class="fa-solid fa-circle-exclamation me-1"></i> Medium Risk (${ch.riskScore}/100)`;
                    } else {
                        riskBadge.classList.add("bg-success", "bg-opacity-25", "text-success", "border", "border-success", "border-opacity-30");
                        riskBadge.innerHTML = `<i class="fa-solid fa-shield-check me-1"></i> Low Risk (${ch.riskScore}/100)`;
                    }

                    const codBtnWrap = document.getElementById("mBtnCodActionWrap");
                    const codStatusEl = document.getElementById("mCustCodStatus");
                    if (ch.isCodDisabled) {
                        codStatusEl.className = "text-danger font-monospace fs-6";
                        codStatusEl.innerText = "Restricted";
                        codBtnWrap.innerHTML = `
                            <button type="button" class="btn btn-outline-success btn-sm w-100 py-1.5 rounded-3 fw-bold" style="font-size: 11px;" onclick="executeComplaintWorkflowAction('EnableCOD')">
                                <i class="fa-solid fa-check me-1"></i> Enable COD
                            </button>
                        `;
                    } else {
                        codStatusEl.className = "text-success font-monospace fs-6";
                        codStatusEl.innerText = "Enabled";
                        codBtnWrap.innerHTML = `
                            <button type="button" id="mBtnToggleCod" class="btn btn-outline-danger btn-sm w-100 py-1.5 rounded-3 fw-bold" style="font-size: 11px;" onclick="executeComplaintWorkflowAction('DisableCOD')">
                                <i class="fa-solid fa-ban me-1"></i> Disable COD
                            </button>
                        `;
                    }

                    document.getElementById("mCustTotalOrders").innerText = ch.totalOrders;
                    document.getElementById("mCustDeliveredCount").innerText = ch.deliveredCount;
                    document.getElementById("mCustCancelRate").innerText = `${ch.cancellationRate}%`;
                    document.getElementById("mCustReturnRate").innerText = `${ch.returnRate}%`;
                    document.getElementById("mCustPastComplaints").innerText = ch.pastComplaintsCount;

                    // Status update trigger
                    document.getElementById("mBtnUpdateStatusFromDetails").onclick = function() {
                        bootstrap.Modal.getInstance(document.getElementById('adminComplaintDetailsModal'))?.hide();
                        openUpdateComplaintStatusModal(c.id, c.status, c.resolutionNotes);
                    };
                } else {
                    showToast(res.message || "Failed to load dispute telemetry.", true);
                }
            },
            error: function() {
                document.getElementById("adminComplaintModalLoader").style.display = "none";
                showToast("Connection error fetching dispute audit records.", true);
            }
        });
    }

    function executeComplaintWorkflowAction(actionType) {
        if (!activeAdminComplaintId || !activeAdminCustomerId) {
            showToast("Dispute ticket context missing. Please refresh.", true);
            return;
        }

        const notes = document.getElementById("adminComplaintActionNotes").value.trim();
        const actionLabels = {
            'SetUnderInvestigation': 'Mark Dispute as Under Investigation',
            'ApproveRefund': 'Approve Full Refund for Customer',
            'ReleaseSellerPayout': 'Release Merchant Payout & Dismiss Customer Claim',
            'RejectDispute': 'Reject Dispute Based on Evidence',
            'IssueWarning': 'Issue Warning to Customer',
            'DisableCOD': 'Disable Cash on Delivery (COD) for Customer',
            'EnableCOD': 'Re-enable Cash on Delivery (COD)',
            'IncreaseRisk': 'Increase Customer Risk Profile to High',
            'BlockCustomer': 'Block / Suspend Customer Account',
            'IssueRiderWarning': 'Issue Formal Warning to Delivery Rider',
            'SuspendRider': 'Suspend Rider from Dispatch Pool',
            'ResolveTicket': 'Mark Dispute Resolved & Close Ticket'
        };

        const confirmMsg = `Are you sure you want to enforce action: "${actionLabels[actionType] || actionType}"?`;
        if (!confirm(confirmMsg)) return;

        $.ajax({
            url: '@Url.Action("TakeComplaintAction", "Admin")',
            type: 'POST',
            data: {
                complaintId: activeAdminComplaintId,
                customerId: activeAdminCustomerId,
                actionType: actionType,
                notes: notes
            },
            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    
                    const row = document.getElementById("complaint-row-" + activeAdminComplaintId);
                    const cell = document.getElementById("complaint-status-cell-" + activeAdminComplaintId);

                    if (actionType === 'SetUnderInvestigation') {
                        if (row) row.setAttribute("data-status", "Under Investigation");
                        if (cell) {
                            cell.innerHTML = '<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation</span>';
                        }
                        viewAdminComplaintModal(activeAdminComplaintId);
                    } else if (actionType === 'ApproveRefund' || actionType === 'ReleaseSellerPayout' || actionType === 'ResolveTicket') {
                        bootstrap.Modal.getInstance(document.getElementById('adminComplaintDetailsModal'))?.hide();
                        if (row) row.setAttribute("data-status", "Resolved");
                        if (cell) {
                            cell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Resolved</span>';
                        }
                    } else if (actionType === 'RejectDispute') {
                        bootstrap.Modal.getInstance(document.getElementById('adminComplaintDetailsModal'))?.hide();
                        if (row) row.setAttribute("data-status", "Rejected");
                        if (cell) {
                            cell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> Rejected</span>';
                        }
                    } else {
                        // Re-fetch to refresh modal data
                        viewAdminComplaintModal(activeAdminComplaintId);
                    }
                } else {
                    showToast(res.message || "Action execution failed.", true);
                }
            },
            error: function() {
                showToast("Connection error executing dispute action.", true);
            }
        });
    }

    function openUpdateComplaintStatusModal(id, currentStatus, currentNotes) {
        document.getElementById("updateTargetComplaintId").value = id;
        document.getElementById("updateComplaintTicketDisplay").innerText = `Dispute #${id}`;
        document.getElementById("updateComplaintStatusSelect").value = currentStatus || "Open";
        document.getElementById("updateComplaintNotesInput").value = currentNotes || "";

        new bootstrap.Modal(document.getElementById('adminUpdateComplaintStatusModal')).show();
    }

    function submitUpdateComplaintStatus() {
        const id = document.getElementById("updateTargetComplaintId").value;
        const status = document.getElementById("updateComplaintStatusSelect").value;
        const notes = document.getElementById("updateComplaintNotesInput").value.trim();

        const btn = document.getElementById("btnSubmitUpdateComplaintStatus");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("UpdateComplaintStatus", "Admin")',
            type: 'POST',
            data: { id: id, status: status, resolutionNotes: notes },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('adminUpdateComplaintStatusModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    const row = document.getElementById("complaint-row-" + id);
                    if (row) {
                        row.setAttribute("data-status", status);
                        const cell = document.getElementById("complaint-status-cell-" + id);
                        if (cell) {
                            if (status === "Open") {
                                cell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-exclamation me-1"></i> Open</span>';
                            } else if (status === "Under Investigation" || status === "In Progress") {
                                cell.innerHTML = '<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation</span>';
                            } else if (status === "Resolved") {
                                cell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Resolved</span>';
                            } else if (status === "Rejected") {
                                cell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> Rejected</span>';
                            } else {
                                cell.innerHTML = `<span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill"><i class="fa-solid fa-lock me-1"></i> ${status}</span>`;
                            }
                        }
                    }
                } else {
                    showToast(res.message || "Error updating dispute status.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error updating dispute status.", true);
            }
        });
    }

