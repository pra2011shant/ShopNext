    function submitEditSellerDeal() {
        const id = parseInt(document.getElementById("modalEditSellerPartId").value) || 0;
        const salePrice = parseFloat(document.getElementById("modalEditSellerSalePrice").value) || 0;
        const stock = parseInt(document.getElementById("modalEditSellerStock").value) || 0;
        const isPart = document.getElementById("modalEditSellerParticipatingCheck").checked;
        const notes = document.getElementById("modalEditSellerNotes").value;
        const btn = document.getElementById("btnSubmitEditSellerDeal");

        if (salePrice <= 0) {
            showToast("Please enter a valid sale price (> 0).", true);
            return;
        }

        if (btn) btn.disabled = true;

        $.ajax({
            url: '@Url.Action("ToggleSellerSaleParticipation", "Admin")',
            type: 'POST',
            data: {
                id: id,
                isParticipating: isPart,
                salePrice: salePrice,
                allocatedStock: stock,
                notes: notes
            },
            success: function(res) {
                if (btn) btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('editSellerDealModal'))?.hide();
                if (res && res.success) {
                    showToast(res.message);
                    setTimeout(() => { location.reload(); }, 600);
                } else {
                    showToast(res ? res.message : "Error saving deal.", true);
                }
            },
            error: function() {
                if (btn) btn.disabled = false;
                showToast("Connection error saving deal.", true);
            }
        });
    }

