                        <input type="number" step="1" id="editOfferPrice" class="form-control bg-dark text-white border-secondary font-monospace fw-bold text-success" oninput="recalcOfferDiscount('edit')" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small fw-bold">Calculated Discount (%)</label>
                        <div class="input-group">
                            <input type="number" step="0.1" id="editOfferDiscount" class="form-control bg-dark text-danger border-secondary font-monospace fw-bold" readonly />
                            <span class="input-group-text bg-danger bg-opacity-20 text-danger border-secondary">% OFF</span>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label text-secondary small fw-bold">Start Date</label>
                        <input type="date" id="editOfferStart" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small fw-bold">End Date</label>
                        <input type="date" id="editOfferEnd" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small fw-bold">Status</label>
                        <select id="editOfferStatus" class="form-select bg-dark text-white border-secondary">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label text-secondary small fw-bold">Banner / Creative URL</label>
                    <input type="text" id="editOfferBanner" class="form-control bg-dark text-white border-secondary" />
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-3 py-2" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning px-4 py-2 fw-bold text-dark" id="btnSubmitEditOffer" onclick="submitEditOffer()">
                    <i class="fa-solid fa-check me-1"></i> Update Deal
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 23: [Delete] Offer Modal (Point 41: Offers Management) -->
<div class="modal fade" id="deleteOfferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-trash me-2"></i> Delete Promotional Offer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2">Kya aap sach me offer <strong id="deleteOfferTitleDisplay" class="text-white">Deal Title</strong> ko delete karna chahte hain?</p>
                <input type="hidden" id="deleteTargetOfferId" />
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger small mb-0">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Delete hone ke baad ye offer customer homepage "🔥 Today's Deals" se turant remove ho jayega.
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-3 py-2" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4 py-2 fw-bold" id="btnConfirmDeleteOffer" onclick="confirmDeleteOffer()">
                    <i class="fa-solid fa-trash me-1"></i> Confirm Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 24: [Hide] Inappropriate Review Modal (Point 42: Review Management) -->
<div class="modal fade" id="hideReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-eye-slash me-2"></i> Hide Inappropriate Review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">Kya aap customer <strong id="hideReviewCustomerDisplay" class="text-white">Customer</strong> ke review ko customer-facing product pages se hide karna chahte hain?</p>
                <input type="hidden" id="hideTargetReviewId" />
                
                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold">Reason for Moderation / Hiding <span class="text-danger">*</span></label>
                    <textarea id="hideReviewReasonInput" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Specify why the review is being moderated (e.g. Abusive language, Fake duplicate rating, Irrelevant spam)"></textarea>
                </div>

                <div class="text-secondary small">
                    Quick reason templates:
                    <div class="d-flex gap-1.5 flex-wrap mt-1">
                        <a href="javascript:void(0)" class="badge bg-secondary bg-opacity-25 text-light text-decoration-none" onclick="setHideReviewReason('Abusive or offensive language violating platform guidelines.')">Abusive Language</a>
                        <a href="javascript:void(0)" class="badge bg-secondary bg-opacity-25 text-light text-decoration-none" onclick="setHideReviewReason('Unverified fake rating or competitor defamation attempt.')">Fake Rating</a>
                        <a href="javascript:void(0)" class="badge bg-secondary bg-opacity-25 text-light text-decoration-none" onclick="setHideReviewReason('Irrelevant spam content unrelated to product performance.')">Spam Content</a>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-3 py-2" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning px-4 py-2 fw-bold text-dark" id="btnConfirmHideReview" onclick="confirmHideReview()">
                    <i class="fa-solid fa-eye-slash me-1"></i> Hide Review
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 25: [Delete] Review Modal (Point 42: Review Management) -->
<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-trash me-2"></i> Delete Customer Review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2">Kya aap sach me customer <strong id="deleteReviewCustomerDisplay" class="text-white">Customer</strong> ke review ko database se permanently remove karna chahte hain?</p>
                <input type="hidden" id="deleteTargetReviewId" />
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger small mb-0">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Delete hone ke baad product ki average rating score re-calculate ho jayegi.
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-3 py-2" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4 py-2 fw-bold" id="btnConfirmDeleteReview" onclick="confirmDeleteReview()">
                    <i class="fa-solid fa-trash me-1"></i> Confirm Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Feedback Container -->
<div class="toast-container-custom">
    <div class="toast-custom p-3" id="adminToast">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-check text-success fs-4" id="toastIcon"></i>
            <div id="toastMessage" class="fw-semibold">Action completed successfully!</div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ==========================================
    // SIDEBAR TAB NAVIGATION
    // ==========================================
    function switchAdminTab(tabKey, clickedEl) {
        document.querySelectorAll('.nav-sidebar-item').forEach(el => el.classList.remove('active'));
        if (clickedEl) {
            clickedEl.classList.add('active');
        } else {
            const el = document.getElementById('nav-' + tabKey);
            if (el) el.classList.add('active');
        }

        document.querySelectorAll('.tab-panel-container').forEach(panel => panel.classList.remove('active'));
        const activePanel = document.getElementById('panel-' + tabKey);
        if (activePanel) {
            activePanel.classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    }

    // ==========================================
    // POINT 34: SELLER MANAGEMENT (Approve, Reject, Block, Unblock, View)
    // ==========================================

    // Status Filter Handler
    function filterSellerTable(status, btn) {
        document.querySelectorAll('.seller-filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.seller-table-row');
        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            if (status === 'all' || rowStatus.toLowerCase() === status.toLowerCase()) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // [View] Seller Details Modal
    function viewSellerModal(shopId) {
        const modal = new bootstrap.Modal(document.getElementById('sellerDetailsModal'));
        document.getElementById("sellerModalLoader").style.display = "block";
        document.getElementById("sellerModalDetailsContent").style.display = "none";
        modal.show();

        $.ajax({
            url: '@Url.Action("GetSellerDetails", "Admin")',
            type: 'GET',
            data: { shopId: shopId },
            success: function(res) {
                document.getElementById("sellerModalLoader").style.display = "none";
                if (res.success && res.seller) {
                    const s = res.seller;
                    document.getElementById("mSellerShopName").innerText = s.shopName;
                    document.getElementById("mSellerOwner").innerText = s.owner;
                    document.getElementById("mSellerEmail").innerText = s.email;
                    document.getElementById("mSellerMobile").innerText = s.mobile;
                    document.getElementById("mSellerCategory").innerText = s.category;
                    document.getElementById("mSellerAddress").innerText = s.address;
                    document.getElementById("mSellerProducts").innerText = s.totalProducts + " items";
                    document.getElementById("mSellerOrders").innerText = s.totalOrders + " orders";
                    document.getElementById("mSellerRating").innerText = "⭐ " + s.rating.toFixed(1) + " / 5.0";
                    document.getElementById("mSellerRegDate").innerText = s.registrationDate;

                    const badge = document.getElementById("mSellerStatusBadge");
                    if (s.status === "Approved") {
                        badge.className = "badge bg-success bg-opacity-25 text-success px-3 py-1 rounded-pill";
                        badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Approved';
                    } else if (s.status === "Pending") {
                        badge.className = "badge bg-warning bg-opacity-25 text-warning px-3 py-1 rounded-pill";
                        badge.innerHTML = '<i class="fa-solid fa-clock me-1"></i> Pending';
                    } else if (s.status === "Rejected") {
                        badge.className = "badge bg-danger bg-opacity-25 text-danger px-3 py-1 rounded-pill";
                        badge.innerHTML = '<i class="fa-solid fa-xmark me-1"></i> Rejected';
                    } else if (s.status === "Blocked") {
                        badge.className = "badge bg-danger bg-opacity-25 text-danger px-3 py-1 rounded-pill";
                        badge.innerHTML = '<i class="fa-solid fa-ban me-1"></i> Blocked';
                    }

                    const remarkRow = document.getElementById("mSellerRemarkRow");
                    if (s.remark) {
                        document.getElementById("mSellerRemark").innerText = s.remark;
                        remarkRow.style.display = "flex";
                    } else {
                        remarkRow.style.display = "none";
                    }

                    document.getElementById("sellerModalDetailsContent").style.display = "block";
                }
            }
        });
    }

    // [Approve] Seller
    function approveSeller(shopId) {
        $.ajax({
            url: '@Url.Action("ApproveSeller", "Admin")',
            type: 'POST',
            data: { shopId: shopId },
            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    const row = document.getElementById("seller-row-" + shopId);
                    if (row) row.setAttribute('data-status', 'Approved');

                    const statusCell = document.getElementById("seller-status-cell-" + shopId);
                    if (statusCell) {
                        statusCell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Approved</span>';
                    }

                    const shopName = document.getElementById("seller-name-" + shopId)?.innerText || "Store";
                    const actionCell = document.getElementById("seller-action-cell-" + shopId);
                    if (actionCell) {
                        actionCell.innerHTML = `
                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewSellerModal(${shopId})" title="View Details">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3 fw-bold" onclick="openBlockSellerModal(${shopId}, '${shopName.replace(/'/g, "\\'")}') " title="Block Seller">
                                    <i class="fa-solid fa-ban me-1"></i> Block
                                </button>
                            </div>
                        `;
                    }
                } else {
                    showToast(res.message, true);
                }
            }
        });
    }

    // [Reject] Seller Application
    function openRejectSellerModal(shopId, shopName) {
        document.getElementById("rejectTargetSellerId").value = shopId;
        document.getElementById("rejectSellerNameDisplay").innerText = shopName;
        document.getElementById("rejectSellerReasonInput").value = "";
        new bootstrap.Modal(document.getElementById('rejectSellerModal')).show();
    }

    function confirmRejectSeller() {
        const shopId = document.getElementById("rejectTargetSellerId").value;
        const reason = document.getElementById("rejectSellerReasonInput").value;
        const btn = document.getElementById("btnConfirmRejectSeller");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("RejectSeller", "Admin")',
            type: 'POST',
            data: { shopId: shopId, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('rejectSellerModal'))?.hide();
                if (res.success) {
                    showToast(res.message, true);
                    const row = document.getElementById("seller-row-" + shopId);
                    if (row) row.setAttribute('data-status', 'Rejected');

                    const statusCell = document.getElementById("seller-status-cell-" + shopId);
                    if (statusCell) {
                        statusCell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>';
                    }

                    const actionCell = document.getElementById("seller-action-cell-" + shopId);
                    if (actionCell) {
                        actionCell.innerHTML = `
                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewSellerModal(${shopId})" title="View Details">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm px-2 py-1 rounded-3 fw-bold" onclick="approveSeller(${shopId})" title="Re-approve Seller">
                                    <i class="fa-solid fa-check me-1"></i> Approve
                                </button>
                            </div>
                        `;
                    }
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error rejecting seller.", true);
            }
        });
    }

    // [Block] Seller Store
    function openBlockSellerModal(shopId, shopName) {
        document.getElementById("blockTargetSellerId").value = shopId;
        document.getElementById("blockSellerNameDisplay").innerText = shopName;
        document.getElementById("blockSellerReasonInput").value = "";
        new bootstrap.Modal(document.getElementById('blockSellerModal')).show();
    }

    function confirmBlockSeller() {
        const shopId = document.getElementById("blockTargetSellerId").value;
        const reason = document.getElementById("blockSellerReasonInput").value;
        const btn = document.getElementById("btnConfirmBlockSeller");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("BlockSeller", "Admin")',
            type: 'POST',
            data: { shopId: shopId, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('blockSellerModal'))?.hide();
                if (res.success) {
                    showToast(res.message, true);
                    const row = document.getElementById("seller-row-" + shopId);
                    if (row) row.setAttribute('data-status', 'Blocked');

                    const statusCell = document.getElementById("seller-status-cell-" + shopId);
                    if (statusCell) {
                        statusCell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> Blocked</span>';
                    }

                    const actionCell = document.getElementById("seller-action-cell-" + shopId);
                    if (actionCell) {
                        actionCell.innerHTML = `
                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewSellerModal(${shopId})" title="View Details">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm px-2 py-1 rounded-3 fw-bold" onclick="unblockSeller(${shopId})" title="Unblock Seller">
                                    <i class="fa-solid fa-lock-open me-1"></i> Unblock
                                </button>
                            </div>
                        `;
                    }
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error blocking seller.", true);
            }
        });
    }

    // [Unblock] Seller Store
    function unblockSeller(shopId) {
        $.ajax({
            url: '@Url.Action("UnblockSeller", "Admin")',
            type: 'POST',
            data: { shopId: shopId },
            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    const row = document.getElementById("seller-row-" + shopId);
                    if (row) row.setAttribute('data-status', 'Approved');

                    const statusCell = document.getElementById("seller-status-cell-" + shopId);
                    if (statusCell) {
                        statusCell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Approved</span>';
                    }

                    const shopName = document.getElementById("seller-name-" + shopId)?.innerText || "Store";
                    const actionCell = document.getElementById("seller-action-cell-" + shopId);
                    if (actionCell) {
                        actionCell.innerHTML = `
                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewSellerModal(${shopId})" title="View Details">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3 fw-bold" onclick="openBlockSellerModal(${shopId}, '${shopName.replace(/'/g, "\\'")}')" title="Block Seller">
                                    <i class="fa-solid fa-ban me-1"></i> Block
                                </button>
                            </div>
                        `;
                    }
                }
            }
        });
    }

    // ==========================================
    // POINT 33: CUSTOMER MANAGEMENT & ORDER/RETURN HISTORY
    // ==========================================

    // [View] Customer Order & Return History Modal
    function viewCustomerModal(customerId) {
        const modal = new bootstrap.Modal(document.getElementById('customerDetailsModal'));
        document.getElementById("custModalLoader").style.display = "block";
        document.getElementById("custModalContent").style.display = "none";
        modal.show();

        $.ajax({
            url: '@Url.Action("GetCustomerHistory", "Admin")',
            type: 'GET',
            data: { customerId: customerId },
            success: function(res) {
                document.getElementById("custModalLoader").style.display = "none";
                if (res.success && res.data) {
                    const c = res.data;
                    document.getElementById("mCustName").innerText = c.customerName;
                    document.getElementById("mCustEmail").innerText = c.email;
                    document.getElementById("mCustMobile").innerText = c.mobile || c.phone;
                    document.getElementById("mCustCity").innerText = c.city || "Patna";
                    document.getElementById("mCustAddress").innerText = c.address;
                    document.getElementById("mCustRegDate").innerText = c.registrationDate;

                    // Point 33: 6-Stat Key Metrics
                    document.getElementById("mCustOrdersCount").innerText = c.totalOrders;
                    document.getElementById("mCustDeliveredCount").innerText = c.deliveredOrders;
                    document.getElementById("mCustCancelledCount").innerText = c.cancelledOrders;
                    document.getElementById("mCustReturnedCount").innerText = c.returnedOrders;
                    document.getElementById("mCustRefundedCount").innerText = c.refundedOrders;
                    document.getElementById("mCustTotalSpent").innerText = "₹" + Number(c.totalAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 });

                    // Risk & Rate Badges
                    document.getElementById("mCustReturnRateVal").innerText = c.returnRate.toFixed(1) + "%";
                    document.getElementById("mCustCancelRateVal").innerText = c.cancellationRate.toFixed(1) + "%";

                    const badge = document.getElementById("mCustStatusBadge");
                    if (c.status === "Blocked") {
                        badge.className = "badge bg-danger bg-opacity-25 text-danger px-3 py-1.5 rounded-pill fs-6";
                        badge.innerHTML = '<i class="fa-solid fa-ban me-1"></i> Blocked';
                    } else {
                        badge.className = "badge bg-success bg-opacity-25 text-success px-3 py-1.5 rounded-pill fs-6";
                        badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Active';
                    }

                    // Render Order History Table
                    let tableHtml = '';
                    if (c.orders && c.orders.length > 0) {
                        c.orders.forEach(o => {
                            let statusBadge = `<span class="badge bg-success bg-opacity-25 text-success">${o.orderStatus}</span>`;
                            if (o.orderStatus === 'Cancelled') {
                                statusBadge = `<span class="badge bg-danger bg-opacity-25 text-danger">Cancelled</span>`;
                            } else if (o.orderStatus.includes('Return') || o.orderStatus === 'Returned') {
                                statusBadge = `<span class="badge bg-warning bg-opacity-25 text-warning">Returned</span>`;
                            } else if (o.orderStatus === 'Refunded') {
                                statusBadge = `<span class="badge bg-info bg-opacity-25 text-info">Refunded</span>`;
                            } else if (o.orderStatus === 'Pending' || o.orderStatus === 'Accepted') {
                                statusBadge = `<span class="badge bg-primary bg-opacity-25 text-primary">${o.orderStatus}</span>`;
                            }

                            tableHtml += `
                                <tr>
                                    <td class="font-monospace fw-bold text-info">${o.orderNumber}</td>
                                    <td class="text-white fw-semibold">${o.shopName}</td>
                                    <td class="fw-bold font-monospace text-success">₹${Number(o.totalAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                                    <td><span class="badge bg-secondary bg-opacity-30 text-light">${o.paymentMode}</span></td>
                                    <td>${statusBadge}</td>
                                    <td class="text-secondary small">${o.orderDate}</td>
                                    <td class="text-secondary small">${o.returnReason || '<span class="text-muted">-</span>'}</td>
                                </tr>
                            `;
                        });
                    } else {
                        tableHtml = `<tr><td colspan="7" class="text-center py-3 text-secondary">No prior order records found for this customer.</td></tr>`;
                    }
                    document.getElementById("mCustOrderHistoryBody").innerHTML = tableHtml;

                    document.getElementById("custModalContent").style.display = "block";
                } else {
                    showToast("Could not load customer history.", true);
                }
            },
            error: function() {
                document.getElementById("custModalLoader").style.display = "none";
                showToast("Connection error loading customer history.", true);
            }
        });
    }

    // [Block] Customer
    function openBlockCustomerModal(customerId, customerName) {
        document.getElementById("blockTargetCustId").value = customerId;
        document.getElementById("blockCustNameDisplay").innerText = customerName;
        document.getElementById("blockReasonInput").value = "";
        new bootstrap.Modal(document.getElementById('blockCustomerModal')).show();
    }

    function confirmBlockCustomer() {
        const customerId = document.getElementById("blockTargetCustId").value;
        const reason = document.getElementById("blockReasonInput").value;
        const btn = document.getElementById("btnConfirmBlockCust");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("BlockCustomer", "Admin")',
            type: 'POST',
            data: { customerId: customerId, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('blockCustomerModal'))?.hide();
                if (res.success) {
                    showToast(res.message, true);
                    const statusCell = document.getElementById("cust-status-cell-" + customerId);
                    if (statusCell) {
                        statusCell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> Blocked</span>';
                    }
                    const actionCell = document.getElementById("cust-action-cell-" + customerId);
                    if (actionCell) {
                        actionCell.innerHTML = `
                            <div class="d-inline-flex gap-2">
                                <button type="button" class="btn btn-outline-info btn-sm px-2.5 py-1 rounded-3" onclick="viewCustomerModal(${customerId})">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="unblockCustomer(${customerId})">
                                    <i class="fa-solid fa-lock-open me-1"></i> Unblock
                                </button>
                            </div>
                        `;
                    }
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error blocking customer.", true);
            }
        });
    }

    // [Unblock] Customer
    function unblockCustomer(customerId) {
        $.ajax({
            url: '@Url.Action("UnblockCustomer", "Admin")',
            type: 'POST',
            data: { customerId: customerId },
            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    const statusCell = document.getElementById("cust-status-cell-" + customerId);
                    if (statusCell) {
                        statusCell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Active</span>';
                    }
                    const actionCell = document.getElementById("cust-action-cell-" + customerId);
                    const custName = document.getElementById("cust-name-" + customerId)?.innerText || "Customer";
                    if (actionCell) {
                        actionCell.innerHTML = `
                            <div class="d-inline-flex gap-2">
                                <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1 rounded-3" onclick="openCustomerRiskModal(${customerId})" title="Inspect Risk Profile">
                                    <i class="fa-solid fa-shield-halved me-1"></i> Risk
                                </button>
                                <button type="button" class="btn btn-outline-info btn-sm px-2.5 py-1 rounded-3" onclick="viewCustomerModal(${customerId})">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="openBlockCustomerModal(${customerId}, '${custName.replace(/'/g, "\\'")}')">
                                    <i class="fa-solid fa-ban me-1"></i> Block
                                </button>
                            </div>
                        `;
                    }
                }
            }
        });
    }

    // ==========================================
    // POINT 36: SUSPICIOUS CUSTOMER RISK & FRAUD DETECTION
    // ==========================================

    let activeRiskCustomerId = null;
    let currentRiskData = null;

    function openCustomerRiskModal(customerId) {
        activeRiskCustomerId = customerId;
        document.getElementById("currentRiskCustId").value = customerId;
        const modal = new bootstrap.Modal(document.getElementById('customerRiskDetailsModal'));
        document.getElementById("custRiskModalLoader").style.display = "block";
        document.getElementById("custRiskModalContent").style.display = "none";
        modal.show();

        fetchCustomerRiskData(customerId);
    }

    function fetchCustomerRiskData(customerId) {
        $.ajax({
            url: '@Url.Action("GetCustomerRiskDetails", "Admin")',
            type: 'GET',
            data: { customerId: customerId },
            success: function(res) {
                document.getElementById("custRiskModalLoader").style.display = "none";
                if (res.success && res.risk) {
                    currentRiskData = res.risk;
                    renderCustomerRiskUI(res.risk);
                    document.getElementById("custRiskModalContent").style.display = "block";
                } else {
                    showToast(res.message || "Unable to load customer risk assessment.", true);
                }
            },
            error: function() {
                document.getElementById("custRiskModalLoader").style.display = "none";
                showToast("Connection error evaluating customer risk telemetry.", true);
            }
        });
    }

    function renderCustomerRiskUI(r) {
        document.getElementById("rCustName").innerText = r.customerName;
        document.getElementById("rCustPhone").innerText = r.phone || "N/A";
        document.getElementById("rCustEmail").innerText = r.email || "N/A";
        document.getElementById("rEvaluatedAt").innerText = r.evaluatedAt || "Just now";

        const statusBadge = document.getElementById("rCustStatus");
        if (r.status === "Blocked") {
            statusBadge.className = "badge bg-danger bg-opacity-25 text-danger";
            statusBadge.innerText = "Blocked";
        } else {
            statusBadge.className = "badge bg-success bg-opacity-25 text-success";
            statusBadge.innerText = "Active";
        }

        // Score, Gauge & Header Badge
        const score = r.riskScore;
        const scoreVal = document.getElementById("rScoreVal");
        const progressBar = document.getElementById("rScoreProgressBar");
        const headerBadge = document.getElementById("riskHeaderBadge");
        const gaugeBox = document.getElementById("riskGaugeContainer");

        scoreVal.innerText = score;
        progressBar.style.width = score + "%";

        if (score >= 70 || r.riskLevel === "High") {
            scoreVal.style.color = "#ef4444";
            progressBar.className = "progress-bar bg-danger";
            headerBadge.className = "badge bg-danger bg-opacity-25 text-danger px-2.5 py-1 rounded-pill font-monospace";
            headerBadge.innerHTML = `<span class="spinner-grow spinner-grow-sm text-danger me-1" style="width: 0.5rem; height: 0.5rem;" role="status"></span> High Risk 🔴`;
            gaugeBox.style.background = "rgba(239, 68, 68, 0.12)";
            gaugeBox.style.border = "1px solid rgba(239, 68, 68, 0.35)";
        } else if (score >= 30 || r.riskLevel === "Medium") {
            scoreVal.style.color = "#f59e0b";
            progressBar.className = "progress-bar bg-warning";
            headerBadge.className = "badge bg-warning bg-opacity-25 text-warning px-2.5 py-1 rounded-pill font-monospace";
            headerBadge.innerHTML = `Medium Risk 🟡`;
            gaugeBox.style.background = "rgba(245, 158, 11, 0.12)";
            gaugeBox.style.border = "1px solid rgba(245, 158, 11, 0.35)";
        } else {
            scoreVal.style.color = "#10b981";
            progressBar.className = "progress-bar bg-success";
            headerBadge.className = "badge bg-success bg-opacity-25 text-success px-2.5 py-1 rounded-pill font-monospace";
            headerBadge.innerHTML = `Low Risk 🟢`;
            gaugeBox.style.background = "rgba(16, 185, 129, 0.12)";
            gaugeBox.style.border = "1px solid rgba(16, 185, 129, 0.35)";
        }

        // COD & Flag status
        const codBadge = document.getElementById("rCodBadge");
        const toggleCodText = document.getElementById("btnToggleCodText");
        const toggleCodBtn = document.getElementById("btnToggleCod");
        if (r.isCodDisabled) {
            codBadge.className = "badge bg-danger bg-opacity-25 text-danger px-2.5 py-1 rounded-pill";
            codBadge.innerHTML = '<i class="fa-solid fa-ban me-1"></i> COD Disabled (Prepaid Only)';
            toggleCodText.innerText = "Enable COD (Allow Doorstep Pay)";
            toggleCodBtn.className = "btn btn-outline-success px-3 py-2 rounded-3";
        } else {
            codBadge.className = "badge bg-success bg-opacity-25 text-success px-2.5 py-1 rounded-pill";
            codBadge.innerHTML = '<i class="fa-solid fa-money-bill-wave me-1"></i> COD Allowed';
            toggleCodText.innerText = "Disable COD (Prepaid Only)";
            toggleCodBtn.className = "btn btn-outline-warning px-3 py-2 rounded-3";
        }

        const flagBadge = document.getElementById("rFlagBadge");
        const toggleFlagText = document.getElementById("btnToggleFlagText");
        const toggleFlagBtn = document.getElementById("btnToggleFlag");
        if (r.isFlaggedForReview) {
            flagBadge.className = "badge bg-warning bg-opacity-25 text-warning px-2.5 py-1 rounded-pill";
            flagBadge.innerHTML = '<i class="fa-solid fa-flag me-1"></i> Flagged for Manual Inspection';
            toggleFlagText.innerText = "Unflag (Normal Queue)";
            toggleFlagBtn.className = "btn btn-outline-secondary px-3 py-2 rounded-3";
        } else {
            flagBadge.className = "badge bg-secondary bg-opacity-25 text-light px-2.5 py-1 rounded-pill";
            flagBadge.innerHTML = '<i class="fa-solid fa-check me-1"></i> Normal Dispatch Queue';
            toggleFlagText.innerText = "Flag for Manual Inspection";
            toggleFlagBtn.className = "btn btn-outline-info px-3 py-2 rounded-3";
        }

        // Metrics stats
        document.getElementById("rTotalOrders").innerText = r.totalOrders;
        document.getElementById("rReturnRate").innerText = (r.returnRate || 0).toFixed(1) + "%";
        document.getElementById("rCancelRate").innerText = (r.cancellationRate || 0).toFixed(1) + "%";
        document.getElementById("rSwappedFraud").innerText = r.swappedFraudCount || 0;
        document.getElementById("rCodRejects").innerText = r.codRejectedOrders || 0;
        document.getElementById("rComplaintsCount").innerText = r.complaintsCount || 0;

        // Risk Factors List
        const list = document.getElementById("rFactorsList");
        if (r.riskFactors && r.riskFactors.length > 0) {
            list.innerHTML = r.riskFactors.map(f => {
                let icon = '<i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>';
                let cls = 'text-warning';
                if (f.includes('Wrong Product') || f.includes('Fraud') || f.includes('exceeding')) {
                    icon = '<i class="fa-solid fa-circle-exclamation text-danger me-2"></i>';
                    cls = 'text-danger fw-semibold';
                } else if (f.includes('Normal')) {
                    icon = '<i class="fa-solid fa-circle-check text-success me-2"></i>';
                    cls = 'text-success';
                }
                return `<li class="py-1.5 border-bottom border-secondary border-opacity-15 small d-flex align-items-center ${cls}">${icon} ${f}</li>`;
            }).join('');
        } else {
            list.innerHTML = `<li class="py-1.5 small text-success"><i class="fa-solid fa-circle-check text-success me-2"></i> Safe shopping profile. No malicious patterns detected.</li>`;
        }
    }

    function toggleCustomerCodAction() {
        if (!activeRiskCustomerId) return;
        const btn = document.getElementById("btnToggleCod");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("ToggleCustomerCod", "Admin")',
            type: 'POST',
            data: { customerId: activeRiskCustomerId },
            success: function(res) {
                btn.disabled = false;
                if (res.success) {
                    showToast(res.message);
                    if (currentRiskData) {
                        currentRiskData.isCodDisabled = res.isCodDisabled;
                        renderCustomerRiskUI(currentRiskData);
                    }
                    updateTableRowRiskBadges(activeRiskCustomerId, currentRiskData);
                } else {
                    showToast(res.message || "Failed to update COD permission.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Network error updating customer COD permissions.", true);
            }
        });
    }

    function toggleCustomerFlagAction() {
        if (!activeRiskCustomerId) return;
        const btn = document.getElementById("btnToggleFlag");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("ToggleCustomerFlag", "Admin")',
            type: 'POST',
            data: { customerId: activeRiskCustomerId },
            success: function(res) {
                btn.disabled = false;
                if (res.success) {
                    showToast(res.message);
                    if (currentRiskData) {
                        currentRiskData.isFlaggedForReview = res.isFlaggedForReview;
                        renderCustomerRiskUI(currentRiskData);
                    }
                    updateTableRowRiskBadges(activeRiskCustomerId, currentRiskData);
                } else {
                    showToast(res.message || "Failed to update review flag.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Network error updating customer review flag.", true);
            }
        });
    }

    function recalculateCustomerRiskAction() {
        if (!activeRiskCustomerId) return;
        const btn = document.getElementById("btnRecalculateRisk");
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1.5"></i> Scoring...';

        $.ajax({
            url: '@Url.Action("RecalculateCustomerRisk", "Admin")',
            type: 'POST',
            data: { customerId: activeRiskCustomerId },
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                if (res.success && res.risk) {
                    showToast(res.message);
                    currentRiskData = res.risk;
                    renderCustomerRiskUI(res.risk);
                    updateTableRowRiskBadges(activeRiskCustomerId, res.risk);
                } else {
                    showToast(res.message || "Failed to recalculate score.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                showToast("Network error executing risk calculation algorithm.", true);
            }
        });
    }

    function triggerBlockFromRisk() {
        if (!activeRiskCustomerId || !currentRiskData) return;
        bootstrap.Modal.getInstance(document.getElementById('customerRiskDetailsModal'))?.hide();
        openBlockCustomerModal(activeRiskCustomerId, currentRiskData.customerName);
    }

    function updateTableRowRiskBadges(customerId, risk) {
        if (!risk) return;
        const riskCell = document.getElementById("cust-risk-cell-" + customerId);
        if (riskCell) {
            let badgeHtml = '';
            if (risk.riskLevel === 'High' || risk.riskScore >= 70) {
                badgeHtml = `
                    <button type="button" class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-pill shadow-sm" onclick="openCustomerRiskModal(${customerId})" title="High Fraud / Abuse Risk Detected">
                        <span class="spinner-grow spinner-grow-sm text-danger me-1" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                        <span class="fw-bold">High 🔴</span>
                        <span class="badge bg-danger ms-1">${risk.riskScore}/100</span>
                    </button>
                `;
            } else if (risk.riskLevel === 'Medium' || risk.riskScore >= 30) {
                badgeHtml = `
                    <button type="button" class="btn btn-sm btn-outline-warning px-2.5 py-1 rounded-pill" onclick="openCustomerRiskModal(${customerId})" title="Medium Risk">
                        <span class="fw-bold">Medium 🟡</span>
                        <span class="badge bg-warning text-dark ms-1">${risk.riskScore}/100</span>
                    </button>
                `;
            } else {
                badgeHtml = `
                    <button type="button" class="btn btn-sm btn-outline-success px-2.5 py-1 rounded-pill" onclick="openCustomerRiskModal(${customerId})" title="Low Risk">
                        <span class="fw-bold">Low 🟢</span>
                        <span class="badge bg-success ms-1">${risk.riskScore}/100</span>
                    </button>
                `;
            }

            if (risk.isCodDisabled) {
                badgeHtml += `<div class="mt-1"><span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30" style="font-size: 0.68rem;"><i class="fa-solid fa-ban me-0.5"></i> COD Blocked</span></div>`;
            }
            if (risk.isFlaggedForReview) {
                badgeHtml += `<div class="mt-1"><span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30" style="font-size: 0.68rem;"><i class="fa-solid fa-flag me-0.5"></i> Manual Review</span></div>`;
            }

            riskCell.innerHTML = badgeHtml;
        }
    }

    // ==========================================
    // POINT 46: GRANULAR CUSTOMER RESTRICTION MANAGEMENT
    // Levels: Normal, Warning, COD Restricted, Return Restricted, Account Suspended, Account Blocked
    // ==========================================

    let activeRestrictionCustomerId = null;
    let selectedRestrictionTier = "Normal";

    function openCustomerRestrictionModal(customerId) {
        activeRestrictionCustomerId = customerId;
        document.getElementById("targetRestrictionCustId").value = customerId;
        
        const modal = new bootstrap.Modal(document.getElementById('customerRestrictionModal'));
        document.getElementById("custRestrictModalLoader").style.display = "block";
        document.getElementById("custRestrictModalContent").style.display = "none";
        modal.show();

        $.ajax({
            url: '@Url.Action("GetCustomerRestrictionDetails", "Admin")',
            type: 'GET',
            data: { customerId: customerId },
            success: function(res) {
                document.getElementById("custRestrictModalLoader").style.display = "none";
                if (res.success && res.customer) {
                    const c = res.customer;
                    const st = res.stats || {};
                    document.getElementById("custRestrictModalContent").style.display = "block";

                    document.getElementById("mRestrictCustName").innerText = c.name;
                    document.getElementById("mRestrictCustPhone").innerText = c.phone || "N/A";
                    document.getElementById("mRestrictCustEmail").innerText = c.email || "N/A";
                    document.getElementById("mRestrictReasonDisplay").innerText = c.restrictionReason || "No active restrictions";
                    document.getElementById("mRestrictReasonNotes").value = c.restrictionReason && c.restrictionReason !== "No active restrictions" ? c.restrictionReason : "";

                    document.getElementById("mRestrictTotalOrders").innerText = st.totalOrders || 0;
                    document.getElementById("mRestrictReturnRate").innerText = (st.returnRate || 0).toFixed(1) + "%";
                    document.getElementById("mRestrictPastDisputes").innerText = st.pastDisputes || 0;

                    // Risk Badge
                    const rBadge = document.getElementById("mRestrictRiskBadge");
                    if (c.riskLevel === "High" || c.riskScore >= 70) {
                        rBadge.className = "badge bg-danger bg-opacity-25 text-danger font-monospace";
                        rBadge.innerText = `High Risk: ${c.riskScore}/100`;
                    } else if (c.riskLevel === "Medium" || c.riskScore >= 30) {
                        rBadge.className = "badge bg-warning bg-opacity-25 text-warning font-monospace";
                        rBadge.innerText = `Medium Risk: ${c.riskScore}/100`;
                    } else {
                        rBadge.className = "badge bg-success bg-opacity-25 text-success font-monospace";
                        rBadge.innerText = `Low Risk: ${c.riskScore}/100`;
                    }

                    // Current restriction status header badge
                    const curBadge = document.getElementById("mRestrictCurrentBadge");
                    curBadge.className = "badge px-2.5 py-1 rounded-pill font-monospace";
                    if (c.restrictionLevel === "Account Blocked" || !c.isActive) {
                        curBadge.classList.add("bg-danger", "text-white");
                        curBadge.innerHTML = `<i class="fa-solid fa-user-slash me-1"></i> Blocked`;
                    } else if (c.restrictionLevel === "Account Suspended" || c.isAccountSuspended) {
                        curBadge.classList.add("bg-secondary", "bg-opacity-40", "text-light");
                        curBadge.innerHTML = `<i class="fa-solid fa-clock me-1"></i> Suspended (${c.suspendedUntilDate})`;
                    } else if (c.restrictionLevel === "Return Restricted" || c.isReturnDisabled) {
                        curBadge.classList.add("bg-warning", "bg-opacity-25", "text-warning");
                        curBadge.innerHTML = `<i class="fa-solid fa-rotate-left me-1"></i> Return Restricted`;
                    } else if (c.restrictionLevel === "COD Restricted" || c.isCodDisabled) {
                        curBadge.classList.add("bg-danger", "bg-opacity-25", "text-danger");
                        curBadge.innerHTML = `<i class="fa-solid fa-ban me-1"></i> COD Restricted`;
                    } else if (c.restrictionLevel === "Warning") {
                        curBadge.classList.add("bg-warning", "bg-opacity-25", "text-warning");
                        curBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation me-1"></i> Warning`;
                    } else {
                        curBadge.classList.add("bg-success", "bg-opacity-25", "text-success");
                        curBadge.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i> Normal`;
                    }

                    // Set active selection card
                    const initialTier = c.restrictionLevel || (c.isActive ? (c.isCodDisabled ? "COD Restricted" : "Normal") : "Account Blocked");
                    selectRestrictionTier(initialTier);
                } else {
                    showToast(res.message || "Failed to load customer restriction details.", true);
                }
            },
            error: function() {
                document.getElementById("custRestrictModalLoader").style.display = "none";
                showToast("Connection error fetching customer restriction record.", true);
            }
        });
    }

    function selectRestrictionTier(tier) {
        selectedRestrictionTier = tier;

        // Update radio inputs
        const radio = document.getElementById("radioTier-" + tier.replace(/ /g, '-'));
        if (radio) radio.checked = true;

        // Visual highlights
        $(".restriction-tier-card").each(function() {
            $(this).css({
                "border-width": "1px",
                "box-shadow": "none",
                "transform": "none"
            });
        });

        const activeCard = document.getElementById("tierCard-" + tier.replace(/ /g, '-'));
        if (activeCard) {
            activeCard.style.borderWidth = "2px";
            activeCard.style.boxShadow = "0 0 14px rgba(239, 68, 68, 0.35)";
            activeCard.style.transform = "scale(1.02)";
        }

        // Toggle Suspension duration
        const suspWrap = document.getElementById("mSuspensionDaysWrap");
        if (tier === "Account Suspended") {
            suspWrap.style.display = "block";
        } else {
            suspWrap.style.display = "none";
        }

        // Update real-time permission indicators
        const codEl = document.getElementById("mPermCodStatus");
        const retEl = document.getElementById("mPermReturnStatus");
        const prepaidEl = document.getElementById("mPermPrepaid");

        if (tier === "Normal" || tier === "Warning") {
            prepaidEl.innerHTML = `<span class="text-muted d-block" style="font-size: 10px;">Prepaid Orders</span><strong class="text-success"><i class="fa-solid fa-check"></i> Enabled</strong>`;
            codEl.className = "text-success";
            codEl.innerHTML = `<i class="fa-solid fa-check"></i> Enabled`;
            retEl.className = "text-success";
            retEl.innerHTML = `<i class="fa-solid fa-check"></i> Enabled`;
        } else if (tier === "COD Restricted") {
            prepaidEl.innerHTML = `<span class="text-muted d-block" style="font-size: 10px;">Prepaid Orders</span><strong class="text-success"><i class="fa-solid fa-check"></i> Enabled</strong>`;
            codEl.className = "text-danger";
            codEl.innerHTML = `<i class="fa-solid fa-ban"></i> Restricted`;
            retEl.className = "text-success";
            retEl.innerHTML = `<i class="fa-solid fa-check"></i> Enabled`;
        } else if (tier === "Return Restricted") {
            prepaidEl.innerHTML = `<span class="text-muted d-block" style="font-size: 10px;">Prepaid Orders</span><strong class="text-success"><i class="fa-solid fa-check"></i> Enabled</strong>`;
            codEl.className = "text-success";
            codEl.innerHTML = `<i class="fa-solid fa-check"></i> Enabled`;
            retEl.className = "text-danger";
            retEl.innerHTML = `<i class="fa-solid fa-ban"></i> Restricted`;
        } else if (tier === "Account Suspended") {
            prepaidEl.innerHTML = `<span class="text-muted d-block" style="font-size: 10px;">Prepaid Orders</span><strong class="text-danger"><i class="fa-solid fa-pause"></i> Paused</strong>`;
            codEl.className = "text-danger";
            codEl.innerHTML = `<i class="fa-solid fa-pause"></i> Paused`;
            retEl.className = "text-danger";
            retEl.innerHTML = `<i class="fa-solid fa-pause"></i> Paused`;
        } else if (tier === "Account Blocked") {
            prepaidEl.innerHTML = `<span class="text-muted d-block" style="font-size: 10px;">Prepaid Orders</span><strong class="text-danger"><i class="fa-solid fa-ban"></i> Blocked</strong>`;
            codEl.className = "text-danger";
            codEl.innerHTML = `<i class="fa-solid fa-ban"></i> Blocked`;
            retEl.className = "text-danger";
            retEl.innerHTML = `<i class="fa-solid fa-ban"></i> Blocked`;
        }
    }

    function onRestrictionPresetChange() {
        const preset = document.getElementById("mRestrictReasonPreset").value;
        const notes = document.getElementById("mRestrictReasonNotes");
        if (preset && preset !== "Custom") {
            notes.value = preset;
        }
    }

    function submitUpdateCustomerRestriction() {
        if (!activeRestrictionCustomerId) return;
        const tier = selectedRestrictionTier;
        const reason = document.getElementById("mRestrictReasonNotes").value.trim();
        const suspDays = document.getElementById("mSuspensionDaysSelect").value;

        if (tier !== "Normal" && !reason) {
            showToast("Please select or enter the reason for this restriction.", true);
            return;
        }

        const confirmMsg = `Are you sure you want to apply restriction "${tier}" to this customer?`;
        if (!confirm(confirmMsg)) return;

        const btn = document.getElementById("btnSaveCustomerRestriction");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("UpdateCustomerRestriction", "Admin")',
            type: 'POST',
            data: {
                customerId: activeRestrictionCustomerId,
                restrictionLevel: tier,
                reason: reason,
                suspensionDays: suspDays
            },
            success: function(res) {
                btn.disabled = false;
                if (res.success) {
                    showToast(res.message);
                    bootstrap.Modal.getInstance(document.getElementById('customerRestrictionModal'))?.hide();

                    // Update Table Row Status & Badges
                    updateCustomerTableRowRestriction(activeRestrictionCustomerId, res);
                } else {
                    showToast(res.message || "Failed to update customer restriction.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error updating customer restriction policy.", true);
            }
        });
    }

    function updateCustomerTableRowRestriction(customerId, data) {
        const cell = document.getElementById("cust-status-cell-" + customerId);
        if (cell) {
            const level = data.restrictionLevel;
            if (level === "Account Blocked" || !data.isActive) {
                cell.innerHTML = '<span class="badge bg-danger text-white border border-danger px-2.5 py-1 rounded-pill"><i class="fa-solid fa-user-slash me-1"></i> Blocked</span>';
            } else if (level === "Account Suspended" || data.isAccountSuspended) {
                cell.innerHTML = '<span class="badge bg-secondary bg-opacity-35 text-light border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-clock me-1"></i> Suspended</span>';
            } else if (level === "Return Restricted" || data.isReturnDisabled) {
                cell.innerHTML = '<span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill" style="color: #fb923c !important;"><i class="fa-solid fa-rotate-left me-1"></i> Return Restricted</span>';
            } else if (level === "COD Restricted" || data.isCodDisabled) {
                cell.innerHTML = '<span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-ban me-1"></i> COD Restricted</span>';
            } else if (level === "Warning") {
                cell.innerHTML = '<span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Warning</span>';
            } else {
                cell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Normal</span>';
            }
        }
    }

