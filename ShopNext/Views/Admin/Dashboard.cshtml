                    document.getElementById("fraudModalContact").innerText = (a.customerEmail || "") + " • " + (a.customerPhone || "");
                    document.getElementById("fraudModalRiskBadge").innerText = "Risk Score: " + a.riskScore + "/100 (" + a.riskLevel + ")";
                    document.getElementById("fraudModalRiskBadge").className = "badge " + (a.riskLevel === 'Critical' ? 'bg-danger' : (a.riskLevel === 'High Risk' ? 'bg-warning text-dark' : 'bg-info text-dark')) + " px-3 py-1.5 rounded-pill fs-6 fw-bold";
                    
                    document.getElementById("fraudModalStatusText").innerHTML = "Status: <strong class='text-warning'>" + a.status + "</strong>";
                    document.getElementById("fraudModalIp").innerText = a.ipAddress || "N/A";
                    document.getElementById("fraudModalDevice").innerText = a.deviceFingerprint || "N/A";
                    document.getElementById("fraudModalLocation").innerText = a.location || "India";

                    document.getElementById("fraudModalAbuseCategory").innerText = a.abuseCategory;
                    document.getElementById("fraudModalDetectedTime").innerText = "Detected: " + (a.detectedAtFormatted || "Recently");
                    document.getElementById("fraudModalTriggerSummary").innerText = a.triggerSummary;
                    document.getElementById("fraudModalDetails").innerText = a.details;

                    document.getElementById("fraudModalOrders").innerText = a.totalOrdersDuringSale || 0;
                    document.getElementById("fraudModalCancels").innerText = a.cancellationsDuringSale || 0;
                    document.getElementById("fraudModalCoupons").innerText = a.couponsUsedCount || 0;
                    document.getElementById("fraudModalLoss").innerText = a.preventedFraudAmountFormatted || "₹0";

                    // Populate Incident Logs
                    const logsContainer = document.getElementById("fraudModalIncidentLogs");
                    if (logsContainer) {
                        let logHtml = '';
                        if (a.incidentLogs && a.incidentLogs.length > 0) {
                            a.incidentLogs.forEach(log => {
                                const sevBadge = log.severity === 'Critical' ? 'badge bg-danger' : (log.severity === 'Warning' ? 'badge bg-warning text-dark' : 'badge bg-info text-dark');
                                logHtml += `
                                    <div class="p-2 rounded-2 bg-black bg-opacity-40 border border-secondary border-opacity-20 d-flex align-items-start gap-2 small">
                                        <span class="font-monospace text-secondary" style="font-size: 0.72rem;">${log.timestamp}</span>
                                        <span class="${sevBadge}" style="font-size: 0.68rem;">${log.eventName}</span>
                                        <span class="text-light flex-grow-1">${log.message}</span>
                                    </div>
                                `;
                            });
                        } else {
                            logHtml = '<div class="text-secondary small">No extra incident logs recorded.</div>';
                        }
                        logsContainer.innerHTML = logHtml;
                    }

                    // Reset radio & admin notes
                    document.getElementById("actionRestrictCoupons").checked = true;
                    document.getElementById("fraudModalAdminNotes").value = a.adminNotes || "";

                    new bootstrap.Modal(document.getElementById('saleFraudReviewModal')).show();
                } else {
                    showToast("Error retrieving fraud alert details.", true);
                }
            },
            error: function() {
                showToast("Connection error retrieving suspicious alert details.", true);
            }
        });
    }

    function submitSaleFraudReview() {
        const alertId = parseInt(document.getElementById("fraudModalAlertId").value) || 0;
        const actionRadio = document.querySelector('input[name="fraudActionRadio"]:checked');
        const action = actionRadio ? actionRadio.value : 'restrict_coupons';
        const notes = document.getElementById("fraudModalAdminNotes").value;
        const btn = document.getElementById("btnSubmitFraudReview");

        if (alertId <= 0) {
            showToast("Invalid alert selection.", true);
            return;
        }

        if (btn) btn.disabled = true;

        $.ajax({
            url: '@Url.Action("ReviewSaleFraudAlert", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                alertId: alertId,
                action: action,
                adminNotes: notes
            }),
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(res) {
                if (btn) btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('saleFraudReviewModal'))?.hide();

                if (res && res.success) {
                    showToast(res.message);
                    
                    // Update table status badge & spotlight card live
                    const tbBadge = document.getElementById("table-status-badge-" + alertId);
                    const spBadge = document.getElementById("badge-spotlight-status-" + alertId);
                    const updatedStatus = res.data ? res.data.status : "Action Enforced";
                    const updatedClass = res.data ? res.data.statusBadgeClass : "bg-danger";

                    if (tbBadge) {
                        tbBadge.className = "badge " + updatedClass + " font-monospace px-2.5 py-1 rounded-pill";
                        tbBadge.innerText = updatedStatus;
                    }
                    if (spBadge) {
                        spBadge.className = "badge " + updatedClass + " font-monospace";
                        spBadge.innerText = updatedStatus;
                    }

                    // Update KPI counters
                    setTimeout(() => { refreshSaleFraudAlerts(false); }, 500);
                } else {
                    showToast(res ? res.message : "Error executing enforcement action.", true);
                }
            },
            error: function() {
                if (btn) btn.disabled = false;
                showToast("Connection error submitting review action.", true);
            }
        });
    }

    function filterSaleFraudTable(filter, btnEl) {
        document.querySelectorAll('.fraud-filter-btn').forEach(b => b.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');

        const rows = document.querySelectorAll('#saleFraudTableBody tr.fraud-row');
        rows.forEach(r => {
            const risk = r.getAttribute('data-risk') || '';
            const status = r.getAttribute('data-status') || '';

            if (filter === 'all') {
                r.style.display = '';
            } else if (filter === 'critical') {
                r.style.display = risk === 'critical' ? '' : 'none';
            } else if (filter === 'review') {
                r.style.display = status === 'under review' ? '' : 'none';
            } else if (filter === 'enforced') {
                r.style.display = (status === 'blocked' || status === 'coupons restricted' || status === 'cod disabled' || status === 'cleared') ? '' : 'none';
            }
        });
    }

    function searchSaleFraudTable(query) {
        query = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#saleFraudTableBody tr.fraud-row');
        rows.forEach(r => {
            const text = r.innerText.toLowerCase();
            r.style.display = text.includes(query) ? '' : 'none';
        });
    }

    function refreshSaleFraudAlerts(showSuccessToast = true) {
        $.ajax({
            url: '@Url.Action("GetSaleFraudAlerts", "Admin")',
            type: 'GET',
            success: function(res) {
                if (res && res.success && res.data) {
                    const d = res.data;
                    const kTotal = document.getElementById("kpiFraudTotal");
                    const kReview = document.getElementById("kpiFraudUnderReview");
                    const kLoss = document.getElementById("kpiFraudPreventedLoss");
                    const kEnforced = document.getElementById("kpiFraudEnforced");
                    const sbBadge = document.getElementById("sidebarSaleFraudBadge");

                    if (kTotal) kTotal.innerText = d.totalSuspiciousActivitiesCount;
                    if (kReview) kReview.innerText = d.underReviewCount;
                    if (kLoss) kLoss.innerText = d.preventedLossFormatted;
                    if (kEnforced) kEnforced.innerText = (d.blockedCount + d.clearedCount);
                    if (sbBadge) sbBadge.innerText = d.underReviewCount + " Alert";

                    if (showSuccessToast) showToast("🚨 Live suspicious activities refreshed!");
                }
            }
        });
    }

    function exportSaleFraudCsv() {
        showToast("📥 Generating Sale Fraud & Abuse Audit CSV...");
        window.location.href = '@Url.Action("ExportSaleFraudReport", "Admin")?format=csv';
    }

    // ==========================================
    // TOAST NOTIFICATIONS
    // ==========================================
    function showToast(message, isError = false) {
        const toast = document.getElementById("adminToast");
        document.getElementById("toastMessage").innerText = message;
        document.getElementById("toastIcon").className = isError ? "fa-solid fa-circle-xmark text-danger fs-4" : "fa-solid fa-circle-check text-success fs-4";
        $(toast).fadeIn(300);
        setTimeout(() => { $(toast).fadeOut(300); }, 3500);
    }
</script>
}
