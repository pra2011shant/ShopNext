    function filterCodAbuseTable(filter, btn) {
        document.querySelectorAll('.cod-filter-btn').forEach(b => {
            b.classList.remove('active', 'btn-warning', 'text-dark');
            b.classList.add('btn-dark');
        });
        if (btn) {
            btn.classList.add('active', 'btn-warning', 'text-dark');
            btn.classList.remove('btn-dark');
        }

        const rows = document.querySelectorAll('#codAbuseMainTable tbody tr.cod-row');
        rows.forEach(row => {
            const risk = row.getAttribute('data-risk') || '';
            const status = row.getAttribute('data-status') || '';
            const alert = row.getAttribute('data-alert') || '';

            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'high-risk') {
                if (risk === 'High' || alert.includes('High COD Failure')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            } else if (filter === 'restricted') {
                if (status === 'Restricted' || status.includes('Prepaid')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            } else if (filter === 'medium-risk') {
                if (risk === 'Medium') {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            } else if (filter === 'healthy') {
                if (risk === 'Low') {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    }

