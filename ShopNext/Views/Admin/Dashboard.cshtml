    function submitReturnVerification(action) {
        const orderId = document.getElementById("returnTargetOrderId").value;
        const isSkuMatched = document.getElementById("chkReturnSkuMatch").checked;
        const isSerialMatched = document.getElementById("chkReturnSerialMatch").checked;
        const isConditionMatched = document.getElementById("chkReturnConditionMatch").checked;
        const receivedSerial = document.getElementById("mReturnReceivedSerialInput").value.trim();
        const remarks = document.getElementById("mReturnRemarksInput").value.trim();
        const token = $('input[name="__RequestVerificationToken"]').val();

        if (action === 'Approve' && (!isSkuMatched || !isSerialMatched || !isConditionMatched)) {
            if (!confirm("⚠️ WARNING: SKU, Serial or Condition mismatch detected!\n\nApproving will trigger refund fraud prevention and mark this as 'Product Swapped / Fraud' hold.\n\nDo you want to proceed with fraud logging?")) {
                return;
            }
        }

        $.ajax({
            url: '@Url.Action("VerifyAndProcessReturn", "Admin")',
            type: 'POST',
            data: {
                __RequestVerificationToken: token,
                orderId: orderId,
                isSkuMatched: isSkuMatched,
                isSerialMatched: isSerialMatched,
                isConditionMatched: isConditionMatched,
                receivedSerial: receivedSerial,
                action: action,
                remarks: remarks
            },
            success: function(res) {
                bootstrap.Modal.getInstance(document.getElementById('verifyReturnModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    const cell = document.getElementById(`return-status-cell-${orderId}`);
                    if (cell) {
                        if (action === 'Approve') {
                            cell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Approved</span>';
                        } else if (action === 'Under_Verification') {
                            cell.innerHTML = '<span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Verification</span>';
                        } else {
                            cell.innerHTML = '<span class="badge bg-secondary bg-opacity-30 text-light border border-secondary px-2.5 py-1 rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>';
                        }
                    }
                } else {
                    showToast(res.message, true);
                    if (res.isFraud) {
                        const cell = document.getElementById(`return-status-cell-${orderId}`);
                        if (cell) {
                            cell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Swapped / Hold</span>';
                        }
                    }
                }
            },
            error: function() {
                showToast("Connection error submitting return verification.", true);
            }
        });
    }

