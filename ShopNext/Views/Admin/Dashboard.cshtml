    function submitSaveSaleCampaign() {
        const id = parseInt(document.getElementById('modalCampIdHidden').value, 10) || 0;
        const name = document.getElementById('modalCampName').value.trim();
        if (!name) {
            showToast('Please enter a Campaign Name.', true);
            return;
        }

        const tagline = document.getElementById('modalCampTagline').value.trim();
        const theme = document.getElementById('modalCampTheme').value;
        const startDate = document.getElementById('modalCampStartDate').value.trim();
        const startTime = document.getElementById('modalCampStartTime').value.trim();
        const endDate = document.getElementById('modalCampEndDate').value.trim();
        const endTime = document.getElementById('modalCampEndTime').value.trim();
        const defaultDisc = parseFloat(document.getElementById('modalCampDefaultDisc').value) || 20;
        const coupon = document.getElementById('modalCampCoupon').value.trim();
        const minOrder = parseFloat(document.getElementById('modalCampMinOrder').value) || 0;
        const maxDiscRaw = document.getElementById('modalCampMaxDisc').value;
        const maxDisc = maxDiscRaw ? parseFloat(maxDiscRaw) : null;
        const sellersScope = document.getElementById('modalCampSellersScope').value;
        const productsScope = document.getElementById('modalCampProductsScope').value;
        const description = document.getElementById('modalCampDescription').value.trim();
        const isActive = document.getElementById('modalCampIsActive').checked;

        // Compile category discounts
        const categories = [
            { categoryName: "Mobiles", discountPercentage: parseFloat(document.getElementById('modalDiscMobiles').value) || 20 },
            { categoryName: "Fashion", discountPercentage: parseFloat(document.getElementById('modalDiscFashion').value) || 40 },
            { categoryName: "Electronics", discountPercentage: parseFloat(document.getElementById('modalDiscElectronics').value) || 30 },
            { categoryName: "Home & Living", discountPercentage: parseFloat(document.getElementById('modalDiscHome').value) || 35 },
            { categoryName: "Groceries", discountPercentage: parseFloat(document.getElementById('modalDiscGroceries').value) || 20 },
            { categoryName: "Beauty & Care", discountPercentage: parseFloat(document.getElementById('modalDiscBeauty').value) || 35 }
        ];

        const btn = document.getElementById('btnSaveSaleCampaign');
        const origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

        const token = $('input[name="__RequestVerificationToken"]').val();
        const url = id > 0 ? '@Url.Action("UpdateSaleCampaign", "Admin")' : '@Url.Action("CreateSaleCampaign", "Admin")';

        const payload = {
            Id: id > 0 ? id : null,
            CampaignName: name,
            Tagline: tagline,
            BannerTheme: theme,
            StartDate: startDate,
            StartTime: startTime,
            EndDate: endDate,
            EndTime: endTime,
            DefaultDiscountPct: defaultDisc,
            CouponCode: coupon,
            MinOrderAmount: minOrder,
            MaxDiscountAmount: maxDisc,
            ProductsScope: productsScope,
            SellersScope: sellersScope,
            Description: description,
            IsActive: isActive,
            CategoryDiscountsJson: JSON.stringify(categories)
        };

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            data: JSON.stringify(payload),
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = origHtml;

                if (res && res.success) {
                    showToast(res.message || 'Sale Campaign saved successfully!');

                    // Hide modal
                    const modalEl = document.getElementById('saleCampaignModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    // Reload page after short delay to refresh all festival cards and tables cleanly
                    setTimeout(() => { location.reload(); }, 1200);
                } else {
                    showToast(res ? res.message : 'Error saving campaign.', true);
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = origHtml;
                showToast('Server communication error.', true);
            }
        });
    }

    function toggleSaleCampaignStatus(campaignId) {
        if (!campaignId) return;

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("ToggleSaleCampaignStatus", "Admin")',
            type: 'POST',
            data: { campaignId: campaignId },
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            success: function(res) {
                if (res && res.success) {
                    showToast(res.message || 'Campaign status updated.');

                    const statusCell = document.getElementById('camp-status-cell-' + campaignId);
                    const btnToggle = document.getElementById('btn-toggle-camp-' + campaignId);
                    const row = document.getElementById('camp-row-' + campaignId);

                    if (res.isActive) {
                        if (statusCell) statusCell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill fw-bold"><i class="fa-solid fa-circle-dot fa-fade me-1 text-danger"></i> Live Now</span>';
