        // Refund Report Table
        if (data.refundReports) {
            let refHtml = '';
            data.refundReports.forEach(rf => {
                refHtml += `<tr>
                    <td class="fw-bold text-danger">${rf.refundId}</td>
                    <td class="text-light">${rf.orderNumber}</td>
                    <td class="fw-semibold text-white">${rf.customerName}</td>
                    <td class="fw-bold text-danger">₹${Number(rf.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td><span class="badge bg-secondary bg-opacity-30 text-light">${rf.paymentMethod}</span></td>
                    <td class="text-secondary font-monospace small">${rf.gatewayRef}</td>
                    <td class="text-light small">${rf.reason}</td>
                    <td><span class="badge bg-success bg-opacity-25 text-success">${rf.status}</span></td>
                    <td class="text-secondary small">${rf.processedDate}</td>
                </tr>`;
            });
            const refTbody = document.getElementById('refundReportTableBody');
            if (refTbody) refTbody.innerHTML = refHtml;
        }

        // Commission Report Table
        if (data.commissionReports) {
            let commHtml = '';
            data.commissionReports.forEach(cm => {
                commHtml += `<tr>
                    <td class="fw-bold text-info">${cm.commissionId}</td>
                    <td class="text-light">${cm.orderNumber}</td>
                    <td class="text-secondary small">${cm.orderDate}</td>
                    <td class="fw-semibold text-white">${cm.shopName}</td>
                    <td class="fw-bold text-white">₹${Number(cm.grossAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td><span class="badge bg-secondary bg-opacity-40 text-light">${cm.commissionRate}%</span></td>
                    <td class="fw-bold text-success">₹${Number(cm.commissionAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td class="fw-bold text-info">₹${Number(cm.netSellerPayout).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td><span class="badge bg-success bg-opacity-25 text-success">${cm.payoutStatus}</span></td>
                    <td class="text-secondary small">${cm.settlementDate}</td>
                </tr>`;
            });
            const commTbody = document.getElementById('commissionReportTableBody');
            if (commTbody) commTbody.innerHTML = commHtml;
        }
    }

    function exportCurrentReportCsv() {
        showToast('Generating ' + currentReportType + ' CSV download...');
        const url = `@Url.Action("ExportReportCsv", "Admin")?reportType=${encodeURIComponent(currentReportType)}&dateFilter=${encodeURIComponent(currentReportDateFilter)}&startDate=${encodeURIComponent(currentReportStartDate || '')}&endDate=${encodeURIComponent(currentReportEndDate || '')}`;
        window.location.href = url;
    }

    function filterReportTableRows(input, tableBodyId) {
        const filter = input.value.toLowerCase();
        const rows = document.querySelectorAll('#' + tableBodyId + ' tr');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    }

    // ==========================================
    // TOAST NOTIFICATIONS
    // ==========================================
    function showToast(message, isError = false) {
        const toast = document.getElementById("adminToast");
        document.getElementById("toastMessage").innerText = message;
        document.getElementById("toastIcon").className = isError ? "fa-solid fa-circle-xmark text-danger fs-4" : "fa-solid fa-circle-check text-success fs-4";
        $(toast).fadeIn(300);
        setTimeout(() => { $(toast).fadeOut(300); }, 3500);
    }
</script>
}

