                            var themeBg = camp.BannerTheme == "flame-red" ? "rgba(239, 68, 68, 0.12)" : (camp.BannerTheme == "festive-gold" ? "rgba(245, 158, 11, 0.12)" : "rgba(147, 51, 234, 0.15)");
                            
                            <div class="col-lg-4 col-md-6">
                                <div class="p-3.5 rounded-3 h-100 border @themeBorder border-opacity-40 position-relative d-flex flex-column justify-content-between" style="background: @themeBg; backdrop-filter: blur(10px);">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge @(camp.IsActive ? "bg-danger" : "bg-secondary") text-white fw-bold px-2.5 py-1 rounded-pill">
                                                @(camp.IsActive ? "🔥 " + camp.Status : "⏸ " + camp.Status)
                                            </span>
                                            @if (!string.IsNullOrEmpty(camp.CouponCode))
                                            {
                                                <span class="badge bg-dark border border-secondary text-warning font-monospace px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-ticket me-1"></i> @camp.CouponCode
                                                </span>
                                            }
                                        </div>

                                        <h5 class="fw-bold text-white mb-1">@camp.CampaignName</h5>
                                        <div class="text-secondary small mb-2.5">@camp.Tagline</div>

                                        <!-- Timeline Pill -->
                                        <div class="d-flex align-items-center gap-2 p-2 rounded-2 bg-dark bg-opacity-60 border border-secondary border-opacity-25 mb-3">
                                            <i class="fa-regular fa-calendar text-warning fs-5"></i>
                                            <div class="small">
                                                <span class="text-white fw-semibold">@camp.StartDate</span>
                                                <span class="text-secondary mx-1">&darr;</span>
                                                <span class="text-white fw-semibold">@camp.EndDate</span>
                                            </div>
                                        </div>

                                        <!-- Category Discounts Matrix (Exact matching prompt format) -->
                                        <div class="p-2.5 rounded-2 bg-dark bg-opacity-75 border border-secondary border-opacity-25 mb-3">
                                            <div class="text-secondary small fw-semibold mb-1.5 text-uppercase" style="font-size: 0.72rem;">Category Discounts:</div>
                                            <div class="d-flex flex-wrap gap-1.5">
                                                @foreach (var cat in camp.CategoryDiscounts)
                                                {
                                                    <span class="badge bg-@cat.BadgeColor bg-opacity-20 text-@cat.BadgeColor border border-@cat.BadgeColor border-opacity-30 px-2 py-1 rounded-pill small">
                                                        <i class="fa-solid @cat.IconClass me-1"></i> @cat.CategoryName &rarr; <strong>@cat.DiscountPercentage.ToString("N0")% OFF</strong>
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Bottom Footer / Actions -->
                                    <div class="pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center mt-2">
                                        <div class="small text-secondary">
                                            Min: <strong class="text-light">₹@camp.MinOrderAmount.ToString("N0")</strong>
                                            @if (camp.MaxDiscountAmount.HasValue)
                                            {
                                                <span class="ms-1">| Cap: <strong class="text-info">₹@camp.MaxDiscountAmount.Value.ToString("N0")</strong></span>
                                            }
                                        </div>
                                        <div class="d-flex gap-1.5">
                                            <button type="button" class="btn btn-sm btn-outline-success px-2.5 py-1 rounded-2" onclick="openSaleAnalyticsModal(@camp.Id)" title="📊 Post-Sale Analytics">
                                                <i class="fa-solid fa-chart-pie"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-warning px-2.5 py-1 rounded-2" onclick="openEditCampaignModal(@camp.Id)" title="Edit Campaign Settings">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-info px-2.5 py-1 rounded-2" onclick="openViewCampaignModal(@camp.Id)" title="View Details">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- POINT 56: POST-SALE PERFORMANCE REPORT (MEGA SALE REPORT EXECUTIVE CARD) -->
                <div class="glass-card mb-4 p-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 27, 75, 0.8) 50%, rgba(17, 24, 39, 0.95) 100%); border: 1px solid rgba(99, 102, 241, 0.35); border-radius: 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.35);">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="p-2.5 rounded-3 bg-indigo bg-opacity-25 text-indigo fs-4" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc;">
                                <i class="fa-solid fa-chart-pie"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h4 class="fw-bold text-white mb-0" id="inlineReportCampName">📊 Mega Sale Report</h4>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill small fw-bold" id="inlineReportCampStatus">CONCLUDED &bull; 100% RECONCILED</span>
                                    <span class="badge bg-indigo bg-opacity-25 text-indigo border border-indigo border-opacity-30 px-2 py-0.5 rounded-pill small fw-bold" style="color:#c7d2fe; border-color: rgba(199,210,254,0.3);">Point 56</span>
                                </div>
                                <div class="text-secondary small mt-0.5" id="inlineReportDateRange">Sale ke baad Admin dekhe: Executive Post-Campaign Intelligence &amp; Unit Economics</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <select class="form-select form-select-sm bg-dark text-white border-secondary border-opacity-40 rounded-3" style="min-width: 210px;" id="inlineReportCampSelector" onchange="switchSaleAnalyticsCampaign(this.value)">
                                @if (Model.AvailableCampaignReports != null && Model.AvailableCampaignReports.Any())
                                {
                                    @foreach (var c in Model.AvailableCampaignReports)
                                    {
                                        <option value="@c.CampaignId" selected="@(c.CampaignId == 1)">@c.CampaignName (@c.DateRange)</option>
                                    }
                                }
                                else
                                {
                                    <option value="1" selected>🔥 Mega Shopping Sale (10 Sep - 15 Sep)</option>
                                    <option value="2">🌙 Midnight Super Flash Sale (05 Sep - 06 Sep)</option>
                                    <option value="3">⚡ Diwali Grand Festival Sale (Scheduled)</option>
                                }
                            </select>

                            <button type="button" class="btn btn-sm btn-outline-light px-3 py-1.5 rounded-3 fw-semibold" onclick="exportSaleAnalyticsCsv(document.getElementById('inlineReportCampSelector').value)">
                                <i class="fa-solid fa-download me-1 text-info"></i> CSV
                            </button>
                            <button type="button" class="btn btn-sm btn-indigo text-white px-3 py-1.5 rounded-3 fw-bold" style="background: #6366f1;" onclick="openSaleAnalyticsModal(document.getElementById('inlineReportCampSelector').value)">
                                <i class="fa-solid fa-magnifying-glass-chart me-1"></i> Full Drilldown
                            </button>
                        </div>
                    </div>

                    <!-- 3 Main Data Pillars (Exact matching prompt structure) -->
                    <div class="row g-3">
                        <!-- Pillar 1: High Level Totals -->
                        <div class="col-lg-4 col-md-6">
                            <div class="p-3.5 rounded-3 h-100" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="text-secondary small fw-bold text-uppercase tracking-wider mb-2.5 d-flex align-items-center justify-content-between">
                                    <span><i class="fa-solid fa-wallet text-success me-1.5"></i> Order Volume &amp; Revenue</span>
                                    <span class="badge bg-success bg-opacity-20 text-success font-monospace">100% Realized</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary">Total Orders</span>
                                    <span class="value text-white font-monospace fs-5 fw-bold" id="inlineReportTotalOrders">25,500</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary">Products Sold</span>
                                    <span class="value text-info font-monospace fs-5 fw-bold" id="inlineReportProductsSold">38,200</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary">Revenue</span>
                                    <span class="value text-success font-monospace fs-4 fw-extrabold" id="inlineReportRevenue" style="color: #34d399;">₹2.5 Crore</span>
                                </div>
                            </div>
                        </div>

                        <!-- Pillar 2: Top Champions (Top Category, Top Product, Top Seller) -->
                        <div class="col-lg-4 col-md-6">
                            <div class="p-3.5 rounded-3 h-100" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="text-secondary small fw-bold text-uppercase tracking-wider mb-2.5 d-flex align-items-center justify-content-between">
                                    <span><i class="fa-solid fa-trophy text-warning me-1.5"></i> Top Champions</span>
                                    <span class="badge bg-warning bg-opacity-20 text-warning font-monospace">Leaderboard</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary"><i class="fa-solid fa-layer-group text-warning me-1"></i> Top Category</span>
                                    <span class="value text-warning fw-bold" id="inlineReportTopCategory">Electronics</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary"><i class="fa-solid fa-mobile-screen-button text-primary me-1"></i> Top Product</span>
                                    <span class="value text-primary fw-bold" id="inlineReportTopProduct" style="color: #60a5fa !important;">Samsung Mobile</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary"><i class="fa-solid fa-store text-emerald me-1"></i> Top Seller</span>
                                    <span class="value text-emerald fw-bold" id="inlineReportTopSeller" style="color: #34d399 !important;">ABC Electronics</span>
                                </div>
                            </div>
                        </div>

                        <!-- Pillar 3: Post-Sale Risk (Returns & Cancellations) -->
                        <div class="col-lg-4 col-md-12">
                            <div class="p-3.5 rounded-3 h-100" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="text-secondary small fw-bold text-uppercase tracking-wider mb-2.5 d-flex align-items-center justify-content-between">
                                    <span><i class="fa-solid fa-triangle-exclamation text-danger me-1.5"></i> Post-Sale Telemetry</span>
                                    <span class="badge bg-danger bg-opacity-20 text-danger font-monospace">Risk Metrics</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary"><i class="fa-solid fa-rotate-left text-danger me-1"></i> Returns</span>
                                    <span class="value text-danger font-monospace fs-5 fw-bold" id="inlineReportReturns">1,250</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary"><i class="fa-solid fa-ban text-secondary me-1"></i> Cancellations</span>
                                    <span class="value text-secondary font-monospace fs-5 fw-bold" id="inlineReportCancellations">850</span>
                                </div>
                                <div class="detail-row">
                                    <span class="label text-secondary"><i class="fa-solid fa-circle-check text-success me-1"></i> Fulfilled Success Rate</span>
                                    <span class="value text-success font-monospace fw-bold" id="inlineReportFulfillmentRate">91.8% (23,400 orders)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Campaigns Table Header & Filter Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                        <button type="button" class="btn btn-sm btn-dark camp-filter-btn active" onclick="filterCampaignsTable('all', this)">All Campaigns</button>
                        <button type="button" class="btn btn-sm btn-dark camp-filter-btn" onclick="filterCampaignsTable('live', this)">
                            <i class="fa-solid fa-fire text-danger me-1"></i> Live Now
                        </button>
                        <button type="button" class="btn btn-sm btn-dark camp-filter-btn" onclick="filterCampaignsTable('upcoming', this)">
                            <i class="fa-solid fa-clock text-warning me-1"></i> Upcoming
                        </button>
                        <button type="button" class="btn btn-sm btn-dark camp-filter-btn" onclick="filterCampaignsTable('paused', this)">
                            <i class="fa-solid fa-pause text-secondary me-1"></i> Paused / Draft
                        </button>
                    </div>

                    <div class="input-group input-group-sm" style="max-width: 320px;">
                        <span class="input-group-text bg-dark text-secondary border-secondary border-opacity-25"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control bg-dark text-white border-secondary border-opacity-25" placeholder="Search Campaign, Coupon, Category..." onkeyup="searchCampaignsTable(this.value)" id="campaignSearchInput" />
                    </div>
                </div>

                <!-- Main Campaigns Table -->
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" id="campaignsMainTable">
                        <thead>
                            <tr class="text-secondary small text-uppercase border-bottom border-secondary border-opacity-25">
                                <th>Campaign Details</th>
                                <th>Validity Period</th>
                                <th>Category Discounts Matrix</th>
                                <th>Coupon &amp; Limits</th>
                                <th>Sellers &amp; Products</th>
                                <th>GMV / Orders</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="campaignsTableBody">
                            @foreach (var camp in Model.SaleCampaignsList)
                            {
                                <tr class="camp-row border-bottom border-secondary border-opacity-10" id="camp-row-@camp.Id"
                                    data-status="@(camp.IsActive ? "live" : "paused")"
                                    data-stage="@camp.Status.ToLowerInvariant()">
                                    <!-- Campaign Details -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2.5">
                                            <div class="p-2.5 rounded-3 bg-danger bg-opacity-20 text-danger fs-4 flex-shrink-0">
                                                <i class="fa-solid fa-fire"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-white fs-6" id="camp-name-@camp.Id">@camp.CampaignName</div>
                                                <div class="text-secondary small" id="camp-tagline-@camp.Id">@camp.Tagline</div>
                                                <span class="badge bg-dark border border-secondary text-secondary small mt-1 font-monospace">Theme: @camp.BannerTheme</span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Validity Period -->
                                    <td>
                                        <div class="font-monospace small">
                                            <div class="text-success"><i class="fa-regular fa-calendar-check me-1"></i> @camp.StartDate (@camp.StartTime)</div>
                                            <div class="text-danger mt-0.5"><i class="fa-regular fa-calendar-xmark me-1"></i> @camp.EndDate (@camp.EndTime)</div>
                                            <div class="badge @(camp.Status == "Live Now" ? "bg-danger" : (camp.Status == "Upcoming" ? "bg-warning text-dark" : "bg-secondary")) bg-opacity-25 font-monospace small px-2 py-1 mt-1.5 d-block text-start border border-secondary border-opacity-25 camp-row-timer" id="camp-timer-@camp.Id" data-seconds="@camp.TotalSecondsRemaining" data-label="@camp.CountdownLabel">
                                                <i class="fa-regular fa-clock me-1"></i> @camp.CountdownLabel @camp.CountdownFormatted
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Category Discounts Breakdown -->
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var cat in camp.CategoryDiscounts)
                                            {
                                                <div class="d-flex align-items-center gap-1.5">
                                                    <span class="badge bg-@cat.BadgeColor bg-opacity-20 text-@cat.BadgeColor border border-@cat.BadgeColor border-opacity-30 px-2 py-0.5 rounded-pill font-monospace small">
                                                        <i class="fa-solid @cat.IconClass me-1"></i> @cat.CategoryName: <strong>@cat.DiscountPercentage.ToString("N0")% OFF</strong>
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <!-- Coupon & Limits -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(camp.CouponCode))
                                        {
                                            <div class="badge bg-primary bg-opacity-20 text-info border border-primary border-opacity-30 font-monospace px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-ticket me-1"></i> @camp.CouponCode
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">No Coupon (Auto-Applied)</span>
                                        }
                                        <div class="text-secondary small mt-1">Min Order: <strong class="text-light">₹@camp.MinOrderAmount.ToString("N0")</strong></div>
                                        <div class="text-secondary small">Max Cap: <strong class="text-light">@(camp.MaxDiscountAmount.HasValue ? $"₹{camp.MaxDiscountAmount.Value:N0}" : "Uncapped")</strong></div>
                                    </td>

                                    <!-- Scope & Sellers -->
                                    <td>
                                        <div class="text-light small"><i class="fa-solid fa-store text-success me-1"></i> @camp.SellersScope</div>
                                        <div class="text-secondary small mt-0.5"><i class="fa-solid fa-boxes-stacked text-info me-1"></i> @camp.ProductsScope</div>
                                    </td>

                                    <!-- GMV / Orders -->
                                    <td>
                                        <div class="font-monospace text-success fw-bold">₹@camp.TotalGrossRevenue.ToString("N0")</div>
                                        <div class="text-secondary small">@camp.TotalOrdersGenerated.ToString("N0") orders</div>
                                    </td>

                                    <!-- Status (Point 51: Scheduled / Active / Expired) -->
                                    <td style="text-align: center;" id="camp-status-cell-@camp.Id">
                                        @if (camp.Status == "Live Now")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                <i class="fa-solid fa-circle-dot fa-fade me-1 text-danger"></i> ACTIVE (Live)
                                            </span>
                                            <div class="text-secondary small mt-0.5" style="font-size: 0.7rem;">Auto-Expires at End</div>
                                        }
                                        else if (camp.Status == "Upcoming")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                <i class="fa-solid fa-clock me-1"></i> SCHEDULED
                                            </span>
                                            <div class="text-secondary small mt-0.5" style="font-size: 0.7rem;">Auto-Starts at Start</div>
                                        }
                                        else if (camp.Status == "Expired")
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-hourglass-end me-1"></i> EXPIRED
                                            </span>
                                            <div class="text-secondary small mt-0.5" style="font-size: 0.7rem;">Auto-Concluded</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-pause me-1"></i> Paused
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <!-- [Sale Analytics Report] -->
                                            <button type="button" class="btn btn-outline-success btn-sm px-2 py-1 rounded-3" onclick="openSaleAnalyticsModal(@camp.Id)" title="📊 Post-Sale Analytics Report">
                                                <i class="fa-solid fa-chart-pie"></i>
                                            </button>
                                            <!-- [Edit] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openEditCampaignModal(@camp.Id)" title="Edit Campaign">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <!-- [Toggle Status] -->
                                            <button type="button" class="btn btn-outline-@(camp.IsActive ? "danger" : "success") btn-sm px-2 py-1 rounded-3" onclick="toggleSaleCampaignStatus(@camp.Id)" title="@(camp.IsActive ? "Pause Campaign" : "Activate Campaign")" id="btn-toggle-camp-@camp.Id">
                                                <i class="fa-solid fa-@(camp.IsActive ? "pause" : "play")"></i>
                                            </button>
                                            <!-- [View Details] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="openViewCampaignModal(@camp.Id)" title="View Details">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>
                                            <!-- [Delete] -->
                                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 rounded-3 text-danger" onclick="deleteSaleCampaign(@camp.Id)" title="Delete Campaign">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ========================================== -->
                <!-- POINT 55: SELLER SALE PARTICIPATION & ADMIN APPROVAL -->
                <!-- Example: Samsung Mobile ☑, Laptop ☐, Headphone ☑ -->
                <!-- ========================================== -->
                <div class="mt-5 pt-4 border-top border-secondary border-opacity-25" id="section-seller-participation">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold font-monospace fs-6">
                                    <i class="fa-solid fa-store me-1 text-dark"></i> 🏪 SELLER SALE PARTICIPATION
                                </span>
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small">
                                    Point 55: Seller Opt-In &amp; Admin Final Approval
                                </span>
                            </div>
                            <h4 class="fw-bold text-white mb-0">Seller Products Campaign Opt-In &amp; Approval Governance</h4>
                            <p class="text-secondary small mb-0 mt-1">
                                Sellers decide which products participate in Mega Sales (☑ Participate vs ☐ Opt Out). Admin reviews discounts and grants final approval.
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm rounded-pill px-3 py-2 fw-semibold" onclick="refreshSellerParticipations()">
                                <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh List
                            </button>
                            <button type="button" class="btn btn-warning btn-sm rounded-pill px-3.5 py-2 fw-bold text-dark shadow-sm" onclick="openOptInDemoModal()">
                                <i class="fa-solid fa-plus me-1"></i> + New Seller Product Opt-In
                            </button>
                        </div>
                    </div>

                    <!-- 4 Mini Metric Badges for Participation -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25">
                                <div class="text-secondary small fw-semibold">Total Submitted Items</div>
                                <div class="text-white fw-bold fs-4 mt-0.5" id="countPartTotal">@Model.SellerSaleParticipationsList.Count</div>
                                <div class="text-secondary small" style="font-size: 0.72rem;">Across all sellers</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-3 rounded-3 bg-dark border border-success border-opacity-30">
                                <div class="text-success small fw-semibold">☑ Approved (Live in Sale)</div>
                                <div class="text-success fw-bold fs-4 mt-0.5" id="countPartApproved">@Model.SellerSaleParticipationsList.Count(x => x.ApprovalStatus == "Approved")</div>
                                <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-circle-check text-success me-1"></i> Admin Approved</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-3 rounded-3 bg-dark border border-warning border-opacity-30">
                                <div class="text-warning small fw-semibold">⏳ Pending Admin Approval</div>
                                <div class="text-warning fw-bold fs-4 mt-0.5" id="countPartPending">@Model.SellerSaleParticipationsList.Count(x => x.ApprovalStatus == "Pending")</div>
                                <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-clock text-warning me-1"></i> Requires Review</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25">
                                <div class="text-secondary small fw-semibold">☐ Opted Out / Excluded</div>
                                <div class="text-secondary fw-bold fs-4 mt-0.5" id="countPartOptedOut">@Model.SellerSaleParticipationsList.Count(x => x.ApprovalStatus == "OptedOut" || !x.IsParticipating)</div>
                                <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-ban text-secondary me-1"></i> Regular Price Only</div>
                            </div>
                        </div>
                    </div>

                    <!-- Filter Bar & Search -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-warning text-dark fw-bold seller-part-filter-btn" onclick="filterSellerParticipation('all', this)">
                                All Products (@Model.SellerSaleParticipationsList.Count)
                            </button>
                            <button type="button" class="btn btn-outline-secondary text-light seller-part-filter-btn" onclick="filterSellerParticipation('pending', this)">
                                ⏳ Pending Approval (@Model.SellerSaleParticipationsList.Count(x => x.ApprovalStatus == "Pending"))
                            </button>
                            <button type="button" class="btn btn-outline-secondary text-light seller-part-filter-btn" onclick="filterSellerParticipation('approved', this)">
                                ✅ Approved (@Model.SellerSaleParticipationsList.Count(x => x.ApprovalStatus == "Approved"))
                            </button>
                            <button type="button" class="btn btn-outline-secondary text-light seller-part-filter-btn" onclick="filterSellerParticipation('optedout', this)">
                                ☐ Opted Out (@Model.SellerSaleParticipationsList.Count(x => x.ApprovalStatus == "OptedOut" || !x.IsParticipating))
                            </button>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary rounded-pill px-3" 
                                   style="width: 220px;" placeholder="Search seller or product..." onkeyup="searchSellerParticipation(this.value)" />
                        </div>
                    </div>

                    <!-- Seller Participation Table matching Prompt Example -->
                    <div class="table-responsive" style="border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08);">
                        <table class="table table-dark table-hover align-middle mb-0 text-nowrap" id="tableSellerParticipation">
                            <thead class="bg-dark" style="border-bottom: 1px solid rgba(255,255,255,0.12);">
                                <tr class="text-secondary small text-uppercase">
                                    <th>Product Details</th>
                                    <th>Seller / Store</th>
                                    <th>Target Campaign</th>
                                    <th>Regular vs Sale Price</th>
                                    <th>Sale Stock</th>
                                    <th>Seller Decision</th>
                                    <th>Admin Approval Status</th>
                                    <th>Admin Remarks</th>
                                    <th style="text-align: center;">Admin Actions</th>
                                </tr>
                            </thead>
                            <tbody id="sellerParticipationTableBody">
                                @foreach (var item in Model.SellerSaleParticipationsList)
                                {
                                    <tr class="seller-part-row" id="part-row-@item.Id" 
                                        data-status="@item.ApprovalStatus.ToLower()" 
                                        data-participating="@(item.IsParticipating ? "true" : "false")"
                                        data-name="@item.ProductName" 
                                        data-shop="@item.ShopName">
                                        <!-- Product Details -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2.5">
                                                <img src="@item.ProductImage" alt="@item.ProductName" 
                                                     class="rounded-3 border border-secondary border-opacity-30" 
                                                     style="width: 44px; height: 44px; object-fit: cover;" 
                                                     onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100'" />
                                                <div>
                                                    <div class="text-white fw-bold">@item.ProductName</div>
                                                    <span class="badge bg-secondary bg-opacity-30 text-secondary small" style="font-size: 0.7rem;">@item.Category</span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Seller / Store -->
                                        <td>
                                            <div class="text-light fw-semibold small">@item.ShopName</div>
                                            <div class="text-secondary small" style="font-size: 0.7rem;">Verified Merchant</div>
                                        </td>

                                        <!-- Target Campaign -->
                                        <td>
                                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small">
                                                @item.CampaignName
                                            </span>
                                        </td>

                                        <!-- Regular vs Sale Price -->
                                        <td>
                                            <div class="d-flex align-items-center gap-1.5 font-monospace">
                                                <span class="text-decoration-line-through text-secondary small">₹@item.RegularPrice.ToString("N0")</span>
                                                <i class="fa-solid fa-arrow-right text-secondary small" style="font-size: 0.65rem;"></i>
                                                <span class="text-warning fw-bold fs-6">₹@item.SalePrice.ToString("N0")</span>
                                            </div>
                                            @if (item.DiscountPct > 0)
                                            {
                                                <div class="text-success small fw-bold" style="font-size: 0.72rem;">@item.DiscountPct% OFF</div>
                                            }
                                        </td>

                                        <!-- Sale Stock -->
                                        <td class="font-monospace">
                                            @if (item.IsParticipating && item.AllocatedSaleStock > 0)
                                            {
                                                <span class="badge bg-info bg-opacity-20 text-info px-2.5 py-1 rounded-pill">
                                                    @item.AllocatedSaleStock Units
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary small">&mdash;</span>
                                            }
                                        </td>

                                        <!-- Seller Decision (Prompt Checkbox) -->
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="part-check-@item.Id" 
                                                       @(item.IsParticipating ? "checked" : "") 
                                                       onchange="toggleSellerParticipationCheck(@item.Id, this.checked)" />
                                                <label class="form-check-label @(item.IsParticipating ? "text-success fw-bold" : "text-secondary") small" for="part-check-@item.Id" id="part-check-label-@item.Id">
                                                    @(item.IsParticipating ? "☑ Participate in Mega Sale" : "☐ Not Participating")
                                                </label>
                                            </div>
                                        </td>

                                        <!-- Admin Approval Status -->
                                        <td id="part-status-cell-@item.Id">
                                            @if (item.ApprovalStatus == "Approved")
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-circle-check me-1"></i> Approved (Live in Sale)
                                                </span>
                                            }
                                            else if (item.ApprovalStatus == "Pending")
                                            {
                                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-clock me-1"></i> Pending Admin Approval
                                                </span>
                                            }
                                            else if (item.ApprovalStatus == "Rejected")
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-circle-xmark me-1"></i> Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-ban me-1"></i> Opted Out
                                                </span>
                                            }
                                        </td>

                                        <!-- Admin Remarks -->
                                        <td>
                                            <small class="text-secondary font-monospace" id="part-remarks-@item.Id" style="font-size: 0.75rem;">
                                                @item.AdminRemarks
                                            </small>
                                        </td>

                                        <!-- Admin Actions -->
                                        <td style="text-align: center;">
                                            <div class="d-inline-flex gap-1.5 justify-content-center" id="part-actions-@item.Id">
                                                @if (item.ApprovalStatus == "Pending" || item.ApprovalStatus == "Rejected" || item.ApprovalStatus == "OptedOut")
                                                {
                                                    <!-- [Approve] -->
                                                    <button type="button" class="btn btn-outline-success btn-sm px-2.5 py-1 rounded-3 fw-bold" 
                                                            onclick="approveSellerParticipation(@item.Id, '@item.ProductName')" title="Grant Admin Approval">
                                                        <i class="fa-solid fa-check me-1"></i> Approve
                                                    </button>
                                                }
                                                @if (item.ApprovalStatus == "Pending" || item.ApprovalStatus == "Approved")
                                                {
                                                    <!-- [Reject] -->
                                                    <button type="button" class="btn btn-outline-danger btn-sm px-2.5 py-1 rounded-3" 
                                                            onclick="rejectSellerParticipation(@item.Id, '@item.ProductName')" title="Reject Participation">
                                                        <i class="fa-solid fa-xmark me-1"></i> Reject
                                                    </button>
                                                }
                                                <!-- [Edit Deal] -->
                                                <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 rounded-3" 
                                                        onclick="openEditSellerDealModal(@item.Id, '@item.ProductName', @item.RegularPrice, @item.SalePrice, @item.AllocatedSaleStock)" title="Edit Pricing & Stock">
                                                    <i class="fa-solid fa-sliders"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- POINT 52: FLASH SALE (Limited Stock & Live Countdown Automation) -->
        <div class="tab-panel-container" id="panel-flashsales">
            <!-- Header Banner -->
            <div class="glass-card mb-4" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.12) 0%, rgba(245, 158, 11, 0.12) 50%, rgba(15, 23, 42, 0.8) 100%); border-color: rgba(245, 158, 11, 0.3);">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold font-monospace fs-6">
                                <i class="fa-solid fa-bolt me-1 fa-beat text-danger"></i> ⚡ FLASH SALE ENGINE
                            </span>
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small">
                                Point 52: High Urgency Limited Stock
                            </span>
                        </div>
                        <h2 class="fw-bold text-white mb-1">Flash Deals & Real-Time Stock Allocation</h2>
                        <p class="text-secondary small mb-0">High-velocity lightning sales with ticking countdown timers, allocated unit caps, and automatic <strong>SOLD OUT</strong> stock triggers.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-outline-warning rounded-pill px-3 py-2 btn-sm" onclick="syncFlashSaleSchedulesManually(false)">
                            <i class="fa-solid fa-arrows-rotate me-1"></i> Sync Deal Clocks
                        </button>
                        <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-4 py-2" onclick="openCreateFlashSaleModal()">
                            <i class="fa-solid fa-plus me-1"></i> Create Flash Sale
                        </button>
                    </div>
                </div>
            </div>

            <!-- Top 4 KPI Metrics -->
            @{
                var flashDeals = Model.FlashSalesList ?? new List<ShopNext.Models.AdminFlashSaleDto>();
                var activeFlashDeals = flashDeals.Where(f => f.IsActive && !f.IsSoldOut && !f.IsExpired).ToList();
                var soldOutDeals = flashDeals.Where(f => f.IsSoldOut).ToList();
                int totalUnitsAllocated = flashDeals.Sum(f => f.TotalStockUnits);
                int totalUnitsClaimed = flashDeals.Sum(f => f.ClaimedUnits);
                decimal totalFlashGmv = flashDeals.Sum(f => f.FlashPrice * f.ClaimedUnits);
                double overallClaimVelocity = totalUnitsAllocated > 0 ? ((double)totalUnitsClaimed / totalUnitsAllocated) * 100 : 0;
            }
            <div class="row g-3 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-warning border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Live Flash Deals</small>
                                <h3 class="fw-bold text-white mt-1 mb-0 font-monospace">@activeFlashDeals.Count <span class="fs-6 text-secondary fw-normal">/ @flashDeals.Count Total</span></h3>
                                <small class="text-warning"><i class="fa-solid fa-bolt me-1"></i> Real-Time Active Deals</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-warning bg-opacity-15 text-warning fs-4">
                                <i class="fa-solid fa-bolt"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-danger border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Stock Claim Velocity</small>
                                <h3 class="fw-bold text-white mt-1 mb-0 font-monospace">@totalUnitsClaimed <span class="fs-6 text-secondary fw-normal">/ @totalUnitsAllocated Units</span></h3>
                                <small class="text-danger fw-semibold"><i class="fa-solid fa-fire me-1"></i> @overallClaimVelocity.ToString("F1")% Units Claimed</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-danger bg-opacity-15 text-danger fs-4">
                                <i class="fa-solid fa-cubes-stacked"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-secondary border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Sold Out Deals</small>
                                <h3 class="fw-bold text-white mt-1 mb-0 font-monospace">@soldOutDeals.Count</h3>
                                <small class="text-secondary"><i class="fa-solid fa-ban me-1 text-danger"></i> Stock Exhausted (Sold Out)</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-danger bg-opacity-15 text-danger fs-4">
                                <i class="fa-solid fa-tags"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-success border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Flash GMV Generated</small>
                                <h3 class="fw-bold text-success mt-1 mb-0 font-monospace">₹@((totalFlashGmv / 100000).ToString("F2")) L</h3>
                                <small class="text-success"><i class="fa-solid fa-arrow-trend-up me-1"></i> Lightning Sale Turnover</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-success bg-opacity-15 text-success fs-4">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Flash Deal Showcase Grid (Highlighting User Prompt Example) -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-fire text-danger"></i> Live Flash Deal Showcase
                        <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 rounded-pill fs-7">Real-Time Ticking Clocks</span>
                    </h5>
                    <small class="text-secondary">Simulate live customer purchases or restock units dynamically</small>
                </div>
                <div class="row g-3" id="flashShowcaseCardsGrid">
                    @foreach (var deal in flashDeals)
                    {
                        var isSoldOut = deal.IsSoldOut || deal.RemainingUnits <= 0;
                        var isUrgent = deal.RemainingUnits > 0 && deal.RemainingUnits <= 5;
                        var cardBorder = isSoldOut ? "border-danger border-opacity-30" : "border-warning border-opacity-40";
                        var bgGlow = isSoldOut ? "background: rgba(15, 23, 42, 0.95);" : "background: linear-gradient(145deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.7) 100%);";

                        <div class="col-xl-3 col-lg-6 col-md-6" id="flash-card-@deal.Id">
                            <div class="glass-card p-3.5 h-100 position-relative border @cardBorder" style="@bgGlow">
                                <!-- Top Bar -->
                                <div class="d-flex justify-content-between align-items-center mb-2.5">
                                    <span class="badge bg-warning text-dark fw-bold font-monospace px-2.5 py-1 rounded-pill">
                                        <i class="fa-solid fa-bolt me-1 text-danger"></i> ⚡ FLASH SALE
                                    </span>
                                    <span class="badge bg-danger text-white fw-bold px-2 py-0.5 rounded-pill font-monospace small">
                                        @deal.DiscountPercentage% OFF
                                    </span>
                                </div>

                                <!-- Product Image & Titles -->
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="rounded-3 overflow-hidden border border-secondary border-opacity-30 position-relative" style="width: 64px; height: 64px; flex-shrink: 0; background: #0f172a;">
                                        <img src="@deal.ProductImageUrl" class="w-100 h-100 object-fit-cover" alt="@deal.ProductName" onerror="this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=300';" />
                                        @if (isSoldOut)
                                        {
                                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-black bg-opacity-80">
                                                <span class="badge bg-danger text-white fw-bold" style="font-size: 0.65rem;">SOLD OUT</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h6 class="fw-bold text-white mb-0 text-truncate" title="@deal.Title">@deal.Title</h6>
                                        <small class="text-secondary d-block text-truncate">@deal.ProductName</small>
                                        <span class="badge bg-secondary bg-opacity-30 text-light py-0.5 px-2 rounded-pill mt-1" style="font-size: 0.68rem;">
                                            @deal.Category
                                        </span>
                                    </div>
                                </div>

                                <!-- Pricing Box: ₹40,000 → ₹32,999 -->
                                <div class="p-2.5 rounded-3 mb-3 text-center border border-secondary border-opacity-20" style="background: rgba(0, 0, 0, 0.35);">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <span class="text-secondary text-decoration-line-through font-monospace">₹@deal.OriginalPrice.ToString("N0")</span>
                                        <span class="text-warning fs-5 fw-bold font-monospace">→ ₹@deal.FlashPrice.ToString("N0")</span>
                                    </div>
                                </div>

                                <!-- Stock Units Info: Only 50 Units / Claimed Progress -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                                        <span class="text-secondary fw-semibold">
                                            <i class="fa-solid fa-boxes-stacked me-1 text-info"></i> Total: <strong>@deal.TotalStockUnits Units</strong>
                                        </span>
                                        @if (isSoldOut)
                                        {
                                            <span class="badge bg-danger text-white fw-bold px-2 py-0.5 rounded-pill font-monospace" id="flash-card-stock-badge-@deal.Id">
                                                Stock khatam: SOLD OUT
                                            </span>
                                        }
                                        else if (deal.RemainingUnits <= 5)
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 fw-bold px-2 py-0.5 rounded-pill font-monospace" id="flash-card-stock-badge-@deal.Id">
                                                Only @deal.RemainingUnits Units Left!
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 fw-bold px-2 py-0.5 rounded-pill font-monospace" id="flash-card-stock-badge-@deal.Id">
                                                @deal.RemainingUnits Units Left
                                            </span>
                                        }
                                    </div>
                                    <div class="progress" style="height: 8px; background: rgba(255, 255, 255, 0.1); border-radius: 6px;">
                                        <div class="progress-bar @(isSoldOut ? "bg-danger" : (deal.ClaimPercentage > 85 ? "bg-danger" : "bg-warning"))" 
                                             role="progressbar" 
                                             id="flash-card-progress-@deal.Id"
                                             style="width: @deal.ClaimPercentage%;" 
                                             aria-valuenow="@deal.ClaimPercentage" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100"></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1 text-secondary" style="font-size: 0.72rem;">
                                        <span id="flash-card-claimed-txt-@deal.Id">Claimed: @deal.ClaimedUnits / @deal.TotalStockUnits</span>
                                        <span id="flash-card-claimpct-@deal.Id">@deal.ClaimPercentage.ToString("F0")% Claimed</span>
                                    </div>
                                </div>

                                <!-- Countdown Timer: Ends in: 00:25:10 -->
                                <div class="p-2.5 rounded-3 mb-3 text-center border @(isSoldOut ? "border-danger border-opacity-30 bg-danger bg-opacity-10" : "border-warning border-opacity-30 bg-warning bg-opacity-10")">
                                    @if (isSoldOut)
                                    {
                                        <div class="text-danger fw-bold font-monospace fs-6">
                                            <i class="fa-solid fa-ban me-1"></i> SOLD OUT
                                        </div>
                                        <small class="text-secondary" style="font-size: 0.72rem;">Deal stock fully exhausted</small>
                                    }
                                    else
                                    {
                                        <div class="text-secondary small fw-semibold mb-1">
                                            <i class="fa-regular fa-clock me-1 text-warning"></i> Ends in:
                                        </div>
                                        <div class="text-warning fw-bold font-monospace fs-5 flash-timer-display" 
                                             id="flash-timer-@deal.Id" 
                                             data-deal-id="@deal.Id" 
                                             data-remaining-seconds="@deal.RemainingSeconds">
                                            @deal.FormattedRemainingTime
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    @if (isSoldOut)
                                    {
                                        <button type="button" class="btn btn-danger disabled w-100 fw-bold py-1.5 rounded-pill" id="btn-flash-claim-@deal.Id" disabled>
                                            <i class="fa-solid fa-ban me-1"></i> SOLD OUT
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-warning text-dark fw-bold w-100 py-1.5 rounded-pill" id="btn-flash-claim-@deal.Id" onclick="simulateClaimFlashDeal(@deal.Id)">
                                            <i class="fa-solid fa-bolt me-1 text-danger"></i> Claim 1 Unit (Simulate Buy)
                                        </button>
                                    }
                                    <div class="d-flex gap-1.5">
                                        <button type="button" class="btn btn-outline-info btn-sm flex-grow-1 rounded-3 py-1" onclick="openRestockFlashModal(@deal.Id, '@deal.Title', @deal.TotalStockUnits, @deal.ClaimedUnits)">
                                            <i class="fa-solid fa-plus me-1"></i> Restock
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-3 py-1 px-2.5" onclick="openEditFlashSaleModal(@deal.Id)" title="Edit Deal">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-3 py-1 px-2.5" onclick="deleteFlashSale(@deal.Id)" title="Delete Deal">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Flash Sales Master Table -->
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="fa-solid fa-list-check text-warning me-1"></i> Flash Sale Inventory Table
                        </h5>
                        <span class="badge bg-secondary bg-opacity-30 text-light font-monospace" id="flashSaleTableCountBadge">
                            @flashDeals.Count Deals
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <span class="input-group-text bg-dark border-secondary border-opacity-30 text-secondary">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" class="form-control bg-dark border-secondary border-opacity-30 text-light" 
                                   id="flashSaleSearchInput" placeholder="Search mobile, brand..." onkeyup="searchFlashSaleTable(this.value)" />
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-warning text-dark active flash-filter-btn" onclick="filterFlashSaleTable('all', this)">All</button>
                            <button type="button" class="btn btn-dark flash-filter-btn" onclick="filterFlashSaleTable('live', this)">⚡ Live</button>
                            <button type="button" class="btn btn-dark flash-filter-btn" onclick="filterFlashSaleTable('soldout', this)">🔴 Sold Out</button>
                            <button type="button" class="btn btn-dark flash-filter-btn" onclick="filterFlashSaleTable('paused', this)">⏸️ Paused</button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table approved-table align-middle" id="flashSalesMainTable">
                        <thead>
                            <tr>
                                <th>Flash Deal & Product</th>
                                <th>Category</th>
                                <th>Pricing (Orig → Flash)</th>
                                <th>Stock Allocation & Claim Velocity</th>
                                <th>Timer (Ends In)</th>
                                <th>Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!flashDeals.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-secondary">
                                        <i class="fa-solid fa-bolt fs-1 text-warning text-opacity-50 mb-3 d-block"></i>
                                        <h6>No Flash Sales active</h6>
                                        <p class="small mb-3">Create your first limited-unit lightning deal now.</p>
                                        <button type="button" class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3" onclick="openCreateFlashSaleModal()">
                                            <i class="fa-solid fa-plus me-1"></i> Create Flash Sale
                                        </button>
                                    </td>
                                </tr>
                            }
                            @foreach (var d in flashDeals)
                            {
                                var isSold = d.IsSoldOut || d.RemainingUnits <= 0;
                                var rowStatus = isSold ? "soldout" : (d.IsActive ? "live" : "paused");

                                <tr class="flash-table-row" id="flash-row-@d.Id" data-status="@rowStatus" data-deal-id="@d.Id">
                                    <td>
                                        <div class="d-flex align-items-center gap-2.5">
                                            <div class="rounded-3 overflow-hidden border border-secondary border-opacity-30 position-relative" style="width: 44px; height: 44px; flex-shrink: 0; background: #0b1324;">
                                                <img src="@d.ProductImageUrl" class="w-100 h-100 object-fit-cover" alt="@d.ProductName" onerror="this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=300';" />
                                            </div>
                                            <div>
                                                <div class="fw-bold text-white d-flex align-items-center gap-1.5">
                                                    <span>@d.Title</span>
                                                    @if (isSold)
                                                    {
                                                        <span class="badge bg-danger text-white rounded-pill" style="font-size: 0.65rem;">SOLD OUT</span>
                                                    }
                                                </div>
                                                <small class="text-secondary d-block font-monospace">@d.ProductName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                            @d.Category
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <span class="text-secondary text-decoration-line-through small font-monospace">₹@d.OriginalPrice.ToString("N0")</span>
                                            <span class="text-warning fw-bold font-monospace">₹@d.FlashPrice.ToString("N0")</span>
                                        </div>
                                        <small class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-1.5 py-0.5 rounded-pill font-monospace" style="font-size: 0.68rem;">
                                            @d.DiscountPercentage% OFF
                                        </small>
                                    </td>
                                    <td style="min-width: 200px;">
                                        <div class="d-flex justify-content-between align-items-center small mb-1">
                                            <span class="text-secondary fw-semibold" id="table-claimed-txt-@d.Id">@d.ClaimedUnits / @d.TotalStockUnits Units</span>
                                            @if (isSold)
                                            {
                                                <span class="badge bg-danger text-white font-monospace" style="font-size: 0.68rem;">SOLD OUT</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning font-monospace" id="table-remaining-txt-@d.Id">@d.RemainingUnits Left</span>
                                            }
                                        </div>
                                        <div class="progress" style="height: 6px; background: rgba(255, 255, 255, 0.1);">
                                            <div class="progress-bar @(isSold ? "bg-danger" : (d.ClaimPercentage > 85 ? "bg-danger" : "bg-warning"))" 
                                                 id="table-progress-@d.Id"
                                                 style="width: @d.ClaimPercentage%;"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="font-monospace fw-bold @(isSold ? "text-danger" : "text-warning") flash-table-timer" 
                                             id="table-timer-@d.Id" 
                                             data-deal-id="@d.Id"
                                             data-remaining-seconds="@d.RemainingSeconds">
                                            @if (isSold)
                                            {
                                                <span><i class="fa-solid fa-ban me-1"></i> SOLD OUT</span>
                                            }
                                            else
                                            {
                                                <span><i class="fa-regular fa-clock me-1"></i> @d.FormattedRemainingTime</span>
                                            }
                                        </div>
                                    </td>
                                    <td id="table-status-cell-@d.Id">
                                        @if (isSold)
                                        {
                                            <span class="badge bg-danger text-white px-2.5 py-1 rounded-pill fw-bold">
                                                <i class="fa-solid fa-ban me-1"></i> SOLD OUT
                                            </span>
                                        }
                                        else if (d.IsActive)
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                <i class="fa-solid fa-bolt me-1 text-danger"></i> Live Deal
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-pause me-1"></i> Paused
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="d-flex align-items-center justify-content-end gap-1.5">
                                            <button type="button" class="btn btn-warning btn-sm text-dark fw-bold px-2 py-1 rounded-3" 
                                                    id="table-btn-claim-@d.Id"
                                                    onclick="simulateClaimFlashDeal(@d.Id)" 
                                                    title="Claim 1 Unit" @(isSold ? "disabled" : "")>
                                                <i class="fa-solid fa-bolt text-danger"></i> Claim
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" 
                                                    onclick="openRestockFlashModal(@d.Id, '@d.Title', @d.TotalStockUnits, @d.ClaimedUnits)" 
                                                    title="Restock Inventory">
                                                <i class="fa-solid fa-plus"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 rounded-3" 
                                                    id="table-btn-toggle-@d.Id"
                                                    onclick="toggleFlashSaleStatus(@d.Id)" 
                                                    title="Toggle Pause / Live">
                                                <i class="fa-solid @(d.IsActive ? "fa-pause text-warning" : "fa-play text-success")"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm px-2 py-1 rounded-3" 
                                                    onclick="openEditFlashSaleModal(@d.Id)" 
                                                    title="Edit Deal">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" 
                                                    onclick="deleteFlashSale(@d.Id)" 
                                                    title="Delete Deal">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 10.5 TAB: INVENTORY PROTECTION & CONCURRENCY (Point 54: Sale Inventory Protection & Zero Overselling) -->
        <div class="tab-panel-container" id="panel-inventoryprotection">
            <!-- Header Banner -->
            <div class="glass-card mb-4" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(6, 182, 212, 0.12) 50%, rgba(15, 23, 42, 0.8) 100%); border-color: rgba(16, 185, 129, 0.3);">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success text-dark px-3 py-1 rounded-pill fw-bold font-monospace fs-6">
                                <i class="fa-solid fa-shield-halved me-1 text-dark"></i> 📦 INVENTORY PROTECTION ENGINE
                            </span>
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small">
                                Point 54: High-Concurrency Overselling Prevention
                            </span>
                            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill small">
                                <i class="fa-solid fa-lock me-1"></i> ACID DB Transactions &amp; Atomic Row Guard
                            </span>
                        </div>
                        <h3 class="text-white fw-bold mb-1">Sale Inventory Protection &amp; Concurrency Control</h3>
                        <p class="text-secondary small mb-0">
                            Safeguards limited flash sale stock against massive high-concurrency race conditions (e.g. 10 units stock vs 100 parallel buyers). Strict ACID database locking ensures <strong>zero overselling</strong>.
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-info rounded-pill px-3 py-2 fw-semibold" onclick="refreshProtectionTelemetry()">
                            <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Telemetry
                        </button>
                        <button type="button" class="btn btn-success rounded-pill px-3 py-2 fw-bold text-dark shadow-sm" onclick="runConcurrencySimulation()">
                            <i class="fa-solid fa-bolt me-1"></i> ⚡ Run 100 Users Stress Test
                        </button>
                    </div>
                </div>
            </div>

            <!-- Top 4 KPI Metrics -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-success h-100">
                        <div class="rounded-circle p-3 bg-success bg-opacity-20 text-success fs-4">
                            <i class="fa-solid fa-shield-check"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Zero-Oversell Rate</div>
                            <div class="text-success fw-bold fs-3 mt-0.5" id="kpiOversellRate">100.0%</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-circle-check text-success me-1"></i> 0 Oversell Incidents</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-info h-100">
                        <div class="rounded-circle p-3 bg-info bg-opacity-20 text-info fs-4">
                            <i class="fa-solid fa-users-rays"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Concurrent Requests Evaluated</div>
                            <div class="text-white fw-bold fs-3 mt-0.5" id="kpiTotalEvaluations">@(Model.InventoryProtection?.TotalEvaluations.ToString("N0") ?? "100")</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-network-wired text-info me-1"></i> Parallel Stress Tests</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="col-12 glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-danger h-100">
                        <div class="rounded-circle p-3 bg-danger bg-opacity-20 text-danger fs-4">
                            <i class="fa-solid fa-hand"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Oversell Attempts Prevented</div>
                            <div class="text-danger fw-bold fs-3 mt-0.5" id="kpiOversellPrevented">@(Model.InventoryProtection?.OversellAttemptsPrevented.ToString("N0") ?? "97")</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-ban text-danger me-1"></i> Out of Stock Safely Blocked</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-warning h-100">
                        <div class="rounded-circle p-3 bg-warning bg-opacity-20 text-warning fs-4">
                            <i class="fa-solid fa-cubes-stacked"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Guarded Flash Sale SKUs</div>
                            <div class="text-warning fw-bold fs-3 mt-0.5">@(Model.InventoryProtection?.TotalProtectedProducts.ToString("N0") ?? "32")</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-lock text-warning me-1"></i> Row-Level Lock Active</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Point 54 Showcase: Concurrency Simulator & Visual Workflow -->
            <div class="row g-4 mb-4">
                <!-- Left: Interactive Test Bench & Presets -->
                <div class="col-lg-5">
                    <div class="glass-card p-4 h-100">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="text-white fw-bold mb-0">
                                <i class="fa-solid fa-sliders text-success me-2"></i> Concurrency Stress Test Bench
                            </h5>
                            <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 rounded-pill px-2.5 py-1">
                                Point 54 Demo
                            </span>
                        </div>
                        <p class="text-secondary small mb-3">
                            Configure simulation parameters to observe how the database engine handles high-volume simultaneous order attempts.
                        </p>

                        <!-- Quick Presets -->
                        <div class="mb-3">
                            <label class="form-label text-light small fw-bold mb-1.5"><i class="fa-solid fa-wand-magic-sparkles text-info me-1"></i> Quick Test Presets</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-semibold" onclick="setSimulationPreset('prompt10')">
                                    ⚡ Prompt: 10 Units vs 100 Users
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill fw-semibold" onclick="setSimulationPreset('flash50')">
                                    🔥 50 Units vs 250 Users
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill fw-semibold" onclick="setSimulationPreset('single1')">
                                    🎯 1 Unit vs 50 Clicks
                                </button>
                            </div>
                        </div>

                        <!-- Parameter Inputs -->
                        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mb-3">
                            <div class="mb-2.5">
                                <label class="form-label text-secondary small fw-bold">Target Sale Product</label>
                                <select id="simProductName" class="form-select bg-dark text-white border-secondary small">
                                    <option value="Samsung Mobile (Galaxy S24 Flagship - 10 Units Stock)" selected>Samsung Mobile (Galaxy S24 Flagship)</option>
                                    <option value="Apple AirPods Pro (2nd Gen - Flash Deal)">Apple AirPods Pro (2nd Gen)</option>
                                    <option value="Sony WH-1000XM5 Wireless Headphones">Sony WH-1000XM5 Wireless</option>
                                </select>
                            </div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label text-warning small fw-bold mb-1">
                                        <i class="fa-solid fa-cubes me-1"></i> Initial Stock
                                    </label>
                                    <input type="number" id="simInitialStock" class="form-control bg-dark text-warning border-warning border-opacity-50 font-monospace fw-bold" value="10" min="1" max="500" />
                                    <small class="text-secondary" style="font-size: 0.72rem;">Available items</small>
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-info small fw-bold mb-1">
                                        <i class="fa-solid fa-users-viewfinder me-1"></i> Concurrent Users
                                    </label>
                                    <input type="number" id="simConcurrentUsers" class="form-control bg-dark text-info border-info border-opacity-50 font-monospace fw-bold" value="100" min="5" max="500" />
                                    <small class="text-secondary" style="font-size: 0.72rem;">Parallel order tasks</small>
                                </div>
                            </div>
                        </div>

                        <!-- Prompt Visual Timeline Box -->
                        <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25 mb-3">
                            <div class="text-success fw-bold small mb-2">
                                <i class="fa-solid fa-diagram-project me-1"></i> Point 54 Execution Sequence:
                            </div>
                            <div class="small font-monospace text-light">
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>📦 Initial Stock:</span>
                                    <span class="text-warning fw-bold">10 Units</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>⚡ Order A &rarr; 2 Units:</span>
                                    <span class="text-success fw-bold">Stock 8 (Success)</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>⚡ Order B &rarr; 3 Units:</span>
                                    <span class="text-success fw-bold">Stock 5 (Success)</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>⚡ Order C &rarr; 5 Units:</span>
                                    <span class="text-success fw-bold">Stock 0 (Success)</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 text-danger">
                                    <span>❌ Next Orders (4 &ndash; 100):</span>
                                    <span class="text-danger fw-bold">Out of Stock (Blocked)</span>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-success w-100 py-2.5 fw-bold text-dark rounded-pill shadow-sm" id="btnRunSim" onclick="runConcurrencySimulation()">
                            <i class="fa-solid fa-play me-1"></i> Launch Multi-Threaded Stress Test
                        </button>
                    </div>
                </div>

                <!-- Right: Live Simulation Telemetry & Outcome Card -->
                <div class="col-lg-7">
                    <div class="glass-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="text-white fw-bold mb-0">
                                    <i class="fa-solid fa-chart-pie text-info me-2"></i> Live Concurrency Telemetry &amp; Proof of Zero Overselling
                                </h5>
                                <small class="text-secondary" id="simSubTitleDisplay">Simulation ID: @(Model.InventoryProtection?.LastSimulationResult?.SimulationId ?? "SIM-INIT") | Multi-Threaded Task Pool</small>
                            </div>
                            <span class="badge bg-success text-dark fw-bold px-3 py-1.5 rounded-pill font-monospace" id="simOversellProofBadge">
                                <i class="fa-solid fa-lock me-1"></i> Oversold: 0 Units (Protected)
                            </span>
                        </div>

                        <!-- Progress Bar of Results -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span><i class="fa-solid fa-square text-success me-1"></i> Fulfilled Units: <strong class="text-success" id="simFulfilledUnitsText">@(Model.InventoryProtection?.LastSimulationResult?.TotalUnitsSold ?? 10) Units</strong></span>
                                <span><i class="fa-solid fa-square text-danger me-1"></i> Blocked Requests: <strong class="text-danger" id="simBlockedText">@(Model.InventoryProtection?.LastSimulationResult?.OutOfStockRejectedCount ?? 97) Users</strong></span>
                                <span><i class="fa-solid fa-gauge-high text-info me-1"></i> Latency: <strong class="text-info" id="simLatencyText">@(Model.InventoryProtection?.LastSimulationResult?.TotalElapsedMs ?? 32)ms</strong></span>
                            </div>
                            <div class="progress" style="height: 12px; background-color: rgba(255,255,255,0.08); border-radius: 6px;">
                                <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="simFulfilledBar" style="width: 10%;"></div>
                                <div class="progress-bar bg-danger" id="simBlockedBar" style="width: 90%;"></div>
                            </div>
                        </div>

                        <!-- 4 Mini Metric Badges -->
                        <div class="row g-2 mb-3">
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-secondary border-opacity-25 text-center">
                                    <div class="text-secondary small" style="font-size: 0.72rem;">Total Competitors</div>
                                    <div class="text-white fw-bold fs-5" id="simTotalUsersBadge">@(Model.InventoryProtection?.LastSimulationResult?.TotalRequests ?? 100)</div>
                                </div>
                            </div>
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-success border-opacity-25 text-center">
                                    <div class="text-success small" style="font-size: 0.72rem;">Orders Fulfilled</div>
                                    <div class="text-success fw-bold fs-5" id="simFulfilledOrdersBadge">@(Model.InventoryProtection?.LastSimulationResult?.FulfilledOrdersCount ?? 3)</div>
                                </div>
                            </div>
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-danger border-opacity-25 text-center">
                                    <div class="text-danger small" style="font-size: 0.72rem;">Out of Stock Prevented</div>
                                    <div class="text-danger fw-bold fs-5" id="simRejectedOrdersBadge">@(Model.InventoryProtection?.LastSimulationResult?.OutOfStockRejectedCount ?? 97)</div>
                                </div>
                            </div>
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-warning border-opacity-25 text-center">
                                    <div class="text-warning small" style="font-size: 0.72rem;">Final Stock</div>
                                    <div class="text-warning fw-bold fs-5" id="simFinalStockBadge">@(Model.InventoryProtection?.LastSimulationResult?.FinalStock ?? 0)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Mechanism Info Card -->
                        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mt-auto">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-microchip text-info"></i>
                                <span class="text-white fw-semibold small">Active Concurrency Guard Mechanism:</span>
                            </div>
                            <div class="text-secondary small font-monospace" style="font-size: 0.75rem;">
                                <code>UPDATE Products SET Stock = Stock - @@Qty, StockStatus = CASE WHEN Stock - @@Qty &lt;= 0 THEN 'OutOfStock' ELSE 'InStock' END WHERE Id = @@Id AND Stock &gt;= @@Qty;</code>
                            </div>
                            <div class="text-success small mt-1" style="font-size: 0.72rem;">
                                <i class="fa-solid fa-circle-check me-1"></i> ACID Compliance Guaranteed: Zero Dirty Reads &bull; Zero Race Conditions &bull; Guaranteed Zero Overselling.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detailed Multi-Threaded Order Log Table -->
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <div>
                        <h5 class="text-white fw-bold mb-0">
                            <i class="fa-solid fa-list-check text-info me-2"></i> Real-Time Concurrency Order Audit Trail
                        </h5>
                        <p class="text-secondary small mb-0">Chronological execution log of all concurrent order reservation attempts</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-info text-dark fw-bold inv-log-filter-btn" onclick="filterSimulationLogs('all', this)">
                                All (<span id="countLogAll">@(Model.InventoryProtection?.LastSimulationResult?.Logs?.Count ?? 100)</span>)
                            </button>
                            <button type="button" class="btn btn-outline-secondary text-light inv-log-filter-btn" onclick="filterSimulationLogs('success', this)">
                                ✅ Fulfilled (<span id="countLogSuccess">@(Model.InventoryProtection?.LastSimulationResult?.FulfilledOrdersCount ?? 3)</span>)
                            </button>
                            <button type="button" class="btn btn-outline-secondary text-light inv-log-filter-btn" onclick="filterSimulationLogs('rejected', this)">
                                ❌ Out of Stock (<span id="countLogRejected">@(Model.InventoryProtection?.LastSimulationResult?.OutOfStockRejectedCount ?? 97)</span>)
                            </button>
                        </div>
                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary rounded-pill px-3" 
                               style="width: 180px;" placeholder="Search buyer or order..." onkeyup="searchSimulationLogs(this.value)" />
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-dark table-hover align-middle mb-0 text-nowrap" id="invLogsTable">
                        <thead class="sticky-top bg-dark" style="z-index: 2;">
                            <tr class="text-secondary small border-bottom border-secondary border-opacity-30">
                                <th># Step</th>
                                <th>Order Ref</th>
                                <th>Buyer / Customer</th>
                                <th>Qty Req</th>
                                <th>Stock Before &rarr; After</th>
                                <th>Status</th>
                                <th>Thread ID</th>
                                <th>Timestamp</th>
                                <th>ACID Remark</th>
                            </tr>
                        </thead>
                        <tbody id="simLogsTableBody">
                            @if (Model.InventoryProtection?.LastSimulationResult?.Logs != null && Model.InventoryProtection.LastSimulationResult.Logs.Any())
                            {
                                foreach (var log in Model.InventoryProtection.LastSimulationResult.Logs)
                                {
                                    <tr class="inv-log-row" data-status="@(log.IsSuccess ? "success" : "rejected")" data-order="@log.OrderId" data-cust="@log.CustomerName">
                                        <td class="font-monospace text-secondary">#@log.Step</td>
                                        <td class="fw-bold font-monospace @(log.IsSuccess ? "text-success" : "text-light")">
                                            @log.OrderId
                                        </td>
                                        <td class="text-white">@log.CustomerName</td>
                                        <td class="font-monospace fw-bold text-center">
                                            <span class="badge @(log.IsSuccess ? "bg-success bg-opacity-25 text-success border border-success" : "bg-secondary bg-opacity-25 text-secondary") px-2.5 py-1">
                                                @log.QuantityRequested units
                                            </span>
                                        </td>
                                        <td class="font-monospace">
                                            <span class="text-warning fw-bold">@log.StockBefore</span>
                                            <i class="fa-solid fa-arrow-right text-secondary mx-1 small"></i>
                                            <span class="@(log.StockAfter == 0 ? "text-danger fw-bold" : "text-success fw-bold")">@log.StockAfter</span>
                                        </td>
                                        <td>
                                            @if (log.IsSuccess)
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-circle-check me-1"></i> SUCCESS (Reserved)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-ban me-1"></i> OUT OF STOCK (Blocked)
                                                </span>
                                            }
                                        </td>
                                        <td class="font-monospace text-info small">@log.ThreadId</td>
                                        <td class="font-monospace text-secondary small">@log.TimestampFormatted</td>
                                        <td class="text-secondary small font-monospace">@log.Remark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-secondary">
                                        <i class="fa-solid fa-spinner fa-spin me-2"></i> Launch a stress test to view live concurrency logs.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 11. TAB: COUPONS (Point 40 & 53: Campaign-Specific Sale Coupons & Usage Telemetry) -->
        <div class="tab-panel-container" id="panel-coupons">
            <!-- Header Banner -->
            <div class="glass-card mb-4" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.12) 0%, rgba(99, 102, 241, 0.12) 50%, rgba(15, 23, 42, 0.8) 100%); border-color: rgba(6, 182, 212, 0.3);">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-info text-dark px-3 py-1 rounded-pill fw-bold font-monospace fs-6">
                                <i class="fa-solid fa-ticket me-1 text-primary"></i> 🎟️ SALE COUPONS ENGINE
                            </span>
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small">
                                Point 53: Campaign-Specific & Strict Usage Limits
                            </span>
                        </div>
                        <h2 class="fw-bold text-white mb-1">Campaign Coupons & Real-Time Usage Limits</h2>
                        <p class="text-secondary small mb-0">Manage festival-exclusive coupons (e.g., <strong>BIGSALE500</strong>), enforce minimum order thresholds, and track live usage limits (Total, Used, Remaining).</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-info text-dark fw-bold rounded-pill px-4 py-2" onclick="openAddCouponModal()">
                            <i class="fa-solid fa-plus me-1"></i> Add Coupon
                        </button>
                    </div>
                </div>
            </div>

            <!-- Top 4 KPI Metrics -->
            @{
                var allCouponsList = Model.CouponsList ?? new List<ShopNext.Models.AdminCouponDto>();
                var saleLinkedCoupons = allCouponsList.Where(c => c.IsValidOnlyDuringSale || !string.IsNullOrEmpty(c.CampaignName)).ToList();
                int totalCouponsUsageLimit = allCouponsList.Sum(c => c.TotalUsageLimit);
                int totalCouponsUsed = allCouponsList.Sum(c => c.UsedCount);
                int totalCouponsRemaining = Math.Max(0, totalCouponsUsageLimit - totalCouponsUsed);
                double overallCouponsRedeemPct = totalCouponsUsageLimit > 0 ? ((double)totalCouponsUsed / totalCouponsUsageLimit) * 100 : 0;
            }
            <div class="row g-3 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-info border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Total Active Coupons</small>
                                <h3 class="fw-bold text-white mt-1 mb-0 font-monospace">@allCouponsList.Count(c => c.IsActive) <span class="fs-6 text-secondary fw-normal">/ @allCouponsList.Count Total</span></h3>
                                <small class="text-info"><i class="fa-solid fa-ticket me-1"></i> Promo & Sale Codes</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-info bg-opacity-15 text-info fs-4">
                                <i class="fa-solid fa-tags"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-danger border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Sale-Exclusive Coupons</small>
                                <h3 class="fw-bold text-white mt-1 mb-0 font-monospace">@saleLinkedCoupons.Count</h3>
                                <small class="text-danger fw-semibold"><i class="fa-solid fa-fire me-1"></i> Valid Only During Sale</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-danger bg-opacity-15 text-danger fs-4">
                                <i class="fa-solid fa-fire"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-warning border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Total Usage Telemetry</small>
                                <h3 class="fw-bold text-warning mt-1 mb-0 font-monospace">@totalCouponsUsed.ToString("N0") <span class="fs-6 text-secondary fw-normal">/ @totalCouponsUsageLimit.ToString("N0")</span></h3>
                                <small class="text-warning"><i class="fa-solid fa-chart-pie me-1"></i> @overallCouponsRedeemPct.ToString("F1")% Redeemed (@totalCouponsRemaining.ToString("N0") Remaining)</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-warning bg-opacity-15 text-warning fs-4">
                                <i class="fa-solid fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="glass-card p-3.5 h-100 border-start border-success border-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <small class="text-secondary fw-semibold text-uppercase">Discount Savings Granted</small>
                                <h3 class="fw-bold text-success mt-1 mb-0 font-monospace">₹@(((totalCouponsUsed * 500m) / 100000m).ToString("F1")) L</h3>
                                <small class="text-success"><i class="fa-solid fa-arrow-trend-up me-1"></i> Customer Savings Velocity</small>
                            </div>
                            <div class="p-2.5 rounded-3 bg-success bg-opacity-15 text-success fs-4">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Campaign-Specific Sale Coupons Showcase Grid -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-fire text-danger"></i> Campaign-Specific Sale Coupons
                        <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 rounded-pill fs-7">Strict Usage Limits</span>
                    </h5>
                    <small class="text-secondary">Simulate live redemptions or extend usage limits dynamically</small>
                </div>
                <div class="row g-3">
                    @foreach (var sc in saleLinkedCoupons)
                    {
                        var isExhausted = sc.IsUsageExhausted;
                        var cardBorder = isExhausted ? "border-danger border-opacity-30" : "border-info border-opacity-40";
                        var bgGlow = isExhausted ? "background: rgba(15, 23, 42, 0.95);" : "background: linear-gradient(145deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.7) 100%);";

                        <div class="col-xl-4 col-md-6" id="sale-coupon-card-@sc.Id">
                            <div class="glass-card p-3.5 h-100 position-relative border @cardBorder" style="@bgGlow">
                                <!-- Top Bar -->
                                <div class="d-flex justify-content-between align-items-center mb-2.5">
                                    <span class="badge bg-danger text-white fw-bold px-2.5 py-1 rounded-pill font-monospace small">
                                        <i class="fa-solid fa-fire me-1"></i> @(sc.CampaignName ?? "Campaign Sale")
                                    </span>
                                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2 py-0.5 rounded-pill small">
                                        <i class="fa-solid fa-calendar-check me-1"></i> Valid only during Sale
                                    </span>
                                </div>

                                <!-- Coupon Code & Discount Header -->
                                <div class="p-3 rounded-3 mb-3 text-center border border-info border-opacity-30 position-relative" style="background: rgba(6, 182, 212, 0.08);">
                                    <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                                        <h4 class="fw-bold text-info font-monospace mb-0" id="showcase-code-@sc.Id">@sc.Code</h4>
                                        <button type="button" class="btn btn-outline-info btn-sm rounded-circle p-1" onclick="copyCouponCode('@sc.Code')" title="Copy Code" style="width: 28px; height: 28px;">
                                            <i class="fa-regular fa-copy" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </div>
                                    <div class="text-success fw-bold font-monospace fs-5">@sc.Discount</div>
                                    <small class="text-secondary d-block">Minimum Order: <strong class="text-white">₹@sc.MinOrder.ToString("N0")</strong></small>
                                </div>

                                <!-- Description -->
                                <p class="text-secondary small mb-3" style="min-height: 38px;">@sc.Description</p>

                                <!-- Admin Usage Limit Matrix: Total, Used, Remaining -->
                                <div class="p-2.5 rounded-3 mb-3 border border-secondary border-opacity-25" style="background: rgba(0, 0, 0, 0.35);">
                                    <div class="d-flex justify-content-between align-items-center mb-1 text-secondary small">
                                        <span><i class="fa-solid fa-chart-simple text-info me-1"></i> Admin Usage Limit</span>
                                        <span class="badge @(isExhausted ? "bg-danger" : "bg-info bg-opacity-20 text-info") font-monospace fw-bold" id="card-usage-badge-@sc.Id">
                                            @(isExhausted ? "EXHAUSTED" : $"{sc.UsagePercentage:F1}% Used")
                                        </span>
                                    </div>
                                    <div class="row g-2 text-center my-1.5">
                                        <div class="col-4">
                                            <div class="p-1.5 rounded-2 bg-dark border border-secondary border-opacity-20">
                                                <small class="text-secondary d-block" style="font-size: 0.68rem;">Total Usage</small>
                                                <span class="text-white fw-bold font-monospace small" id="card-total-@sc.Id">@sc.TotalUsageLimit.ToString("N0")</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-1.5 rounded-2 bg-dark border border-secondary border-opacity-20">
                                                <small class="text-secondary d-block" style="font-size: 0.68rem;">Used</small>
                                                <span class="text-warning fw-bold font-monospace small" id="card-used-@sc.Id">@sc.UsedCount.ToString("N0")</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-1.5 rounded-2 bg-dark border border-secondary border-opacity-20">
                                                <small class="text-secondary d-block" style="font-size: 0.68rem;">Remaining</small>
                                                <span class="fw-bold font-monospace small @(isExhausted ? "text-danger" : "text-success")" id="card-rem-@sc.Id">@sc.RemainingCount.ToString("N0")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="progress mt-2" style="height: 6px; background: rgba(255,255,255,0.1);">
                                        <div class="progress-bar @(isExhausted ? "bg-danger" : "bg-info")" 
                                             id="card-progress-@sc.Id" 
                                             style="width: @sc.UsagePercentage%;"></div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-info text-dark fw-bold w-100 py-1.5 rounded-pill" 
                                            id="btn-redeem-@sc.Id" 
                                            onclick="simulateRedeemCoupon(@sc.Id)" @(isExhausted ? "disabled" : "")>
                                        <i class="fa-solid fa-bolt me-1 text-danger"></i> Simulate 1 Redeem
                                    </button>
                                    <div class="d-flex gap-1.5">
                                        <button type="button" class="btn btn-outline-info btn-sm flex-grow-1 rounded-3 py-1" onclick="openRestockCouponModal(@sc.Id, '@sc.Code', @sc.TotalUsageLimit, @sc.UsedCount)">
                                            <i class="fa-solid fa-plus me-1"></i> Restock Limit
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-3 py-1 px-2.5" onclick="openEditCouponModal(@sc.Id)" title="Edit Coupon">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-3 py-1 px-2.5" onclick="openDeleteCouponModal(@sc.Id, '@sc.Code')" title="Delete Coupon">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Master Coupons Inventory Table -->
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="fa-solid fa-list-check text-info me-1"></i> Promotional & Sale Coupons Table
                        </h5>
                        <span class="badge bg-secondary bg-opacity-30 text-light font-monospace" id="couponTableCountBadge">
                            @allCouponsList.Count Coupons Active
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <span class="input-group-text bg-dark border-secondary border-opacity-30 text-secondary">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" class="form-control bg-dark border-secondary border-opacity-30 text-light" 
                                   id="couponSearchInput" placeholder="Search code, campaign..." onkeyup="searchCouponTable(this.value)" />
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-info text-dark active coupon-filter-btn" onclick="filterCouponTable('all', this)">All</button>
                            <button type="button" class="btn btn-dark coupon-filter-btn" onclick="filterCouponTable('sale', this)">🔥 Sale Only</button>
                            <button type="button" class="btn btn-dark coupon-filter-btn" onclick="filterCouponTable('active', this)">⚡ Active</button>
                            <button type="button" class="btn btn-dark coupon-filter-btn" onclick="filterCouponTable('exhausted', this)">🔴 Exhausted</button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table approved-table align-middle" id="couponsMainTable">
                        <thead>
                            <tr>
                                <th>Coupon Code & Campaign</th>
                                <th>Discount</th>
                                <th>Minimum Order</th>
                                <th>Maximum Discount</th>
                                <th>Validity Period</th>
                                <th>Usage Limit Telemetry</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="couponsTableBody">
                            @foreach (var c in allCouponsList)
                            {
                                var isExh = c.IsUsageExhausted;
                                var isSale = c.IsValidOnlyDuringSale || !string.IsNullOrEmpty(c.CampaignName);
                                var rowFilter = isExh ? "exhausted" : (isSale ? "sale" : (c.IsActive ? "active" : "inactive"));

                                <tr class="coupon-table-row" id="coupon-row-@c.Id" data-status="@rowFilter" data-code="@c.Code" data-campaign="@(c.CampaignName ?? "")">
                                    <!-- Coupon Code & Scope -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary bg-opacity-20 text-info px-3 py-1.5 rounded-pill font-monospace fw-bold fs-6 border border-primary border-opacity-30" id="coupon-code-@c.Id">
                                                @c.Code
                                            </span>
                                            @if (c.IsValidOnlyDuringSale)
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2 py-0.5 rounded-pill font-monospace small">
                                                    <i class="fa-solid fa-fire me-1"></i> Sale Only
                                                </span>
                                            }
                                        </div>
                                        <div class="text-secondary small mt-1" id="coupon-desc-@c.Id">@c.Description</div>
                                        @if (!string.IsNullOrEmpty(c.CampaignName))
                                        {
                                            <small class="text-warning fw-semibold"><i class="fa-solid fa-bullhorn me-1"></i> @c.CampaignName</small>
                                        }
                                    </td>

                                    <!-- Discount -->
                                    <td>
                                        <strong class="text-success font-monospace fs-6" id="coupon-disc-@c.Id">@c.Discount</strong>
                                        <div class="text-secondary small">Type: @c.DiscountType</div>
                                    </td>

                                    <!-- Minimum Order -->
                                    <td>
                                        <div class="font-monospace text-white fw-bold" id="coupon-min-@c.Id">₹@c.MinOrder.ToString("N0")</div>
                                        <small class="text-secondary">Min Cart</small>
                                    </td>

                                    <!-- Maximum Discount -->
                                    <td>
                                        <div class="font-monospace text-info" id="coupon-max-@c.Id">@(c.MaxDiscount.HasValue ? $"₹{c.MaxDiscount.Value:N0}" : "Uncapped")</div>
                                    </td>

                                    <!-- Validity Period -->
                                    <td class="text-secondary small font-monospace" id="coupon-validity-@c.Id">
                                        <div><i class="fa-regular fa-calendar-check text-success me-1"></i> @c.StartDate</div>
                                        <div><i class="fa-regular fa-calendar-xmark text-danger me-1"></i> @c.EndDate</div>
                                    </td>

                                    <!-- Usage Limit Matrix (Total, Used, Remaining) -->
                                    <td style="min-width: 190px;">
                                        <div class="d-flex justify-content-between align-items-center small mb-1 font-monospace">
                                            <span class="text-secondary" id="table-used-txt-@c.Id">Used: @c.UsedCount.ToString("N0") / @c.TotalUsageLimit.ToString("N0")</span>
                                            <span class="@(isExh ? "text-danger fw-bold" : "text-success")" id="table-rem-txt-@c.Id">@c.RemainingCount.ToString("N0") Left</span>
                                        </div>
                                        <div class="progress" style="height: 5px; background: rgba(255,255,255,0.1);">
                                            <div class="progress-bar @(isExh ? "bg-danger" : "bg-info")" 
                                                 id="table-progress-@c.Id" 
                                                 style="width: @c.UsagePercentage%;"></div>
                                        </div>
                                    </td>

                                    <!-- Status -->
                                    <td style="text-align: center;" id="coupon-status-cell-@c.Id">
                                        @if (isExh)
                                        {
                                            <span class="badge bg-danger text-white px-2.5 py-1 rounded-pill fw-bold">
                                                <i class="fa-solid fa-ban me-1"></i> Limit Exhausted
                                            </span>
                                        }
                                        else if (c.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Active
                                            </span>
                                        }
                                        else if (c.Status == "Expired")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-clock me-1"></i> Expired
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: right;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-end">
                                            <button type="button" class="btn btn-info btn-sm text-dark fw-bold px-2 py-1 rounded-3" 
                                                    id="table-btn-redeem-@c.Id"
                                                    onclick="simulateRedeemCoupon(@c.Id)" 
                                                    title="Simulate 1 Redemption" @(isExh ? "disabled" : "")>
                                                <i class="fa-solid fa-bolt text-danger"></i> Redeem
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" 
                                                    onclick="openRestockCouponModal(@c.Id, '@c.Code', @c.TotalUsageLimit, @c.UsedCount)" 
                                                    title="Extend Usage Limit">
                                                <i class="fa-solid fa-plus"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openEditCouponModal(@c.Id)" title="Edit Coupon">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 rounded-3" onclick="toggleCouponStatus(@c.Id)" title="Toggle Active Status">
                                                <i class="fa-solid fa-power-off"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openDeleteCouponModal(@c.Id, '@c.Code')" title="Delete Coupon">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 12. TAB: OFFERS (Point 41: Offers Management) -->
        <div class="tab-panel-container" id="panel-offers">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill small fw-bold">
                                <i class="fa-solid fa-fire me-1"></i> TODAY'S DEALS &bull; PROMOTIONS
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-bullhorn text-warning me-2"></i> Promotional Offers Management</h3>
                        <p class="text-secondary small mb-0">Manage special pricing, time-limited flash deals, and featured homepage discount banners.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="offersCountBadge">
                            @Model.OffersList.Count Offers Live
                        </span>
                        <button type="button" class="btn btn-warning btn-sm px-3.5 py-2 fw-bold rounded-3 shadow-sm text-dark" onclick="openAddOfferModal()">
                            <i class="fa-solid fa-plus me-1.5"></i> Add Offer
                        </button>
                    </div>
                </div>

                <!-- Point 41: Offers Management Table (Product, MRP, Selling Price, Discount, Start Date, End Date, Status, Actions) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>MRP</th>
                                <th>Selling Price</th>
                                <th>Discount</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="offersTableBody">
                            @if (!Model.OffersList.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-secondary">
                                        <i class="fa-solid fa-tags fs-3 mb-2 d-block opacity-50"></i>
                                        No promotional offers created yet. Click "Add Offer" to create your first flash deal.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var off in Model.OffersList)
                                {
                                    <tr id="offer-row-@off.Id">
                                        <!-- Product -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2.5">
                                                <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25" style="width: 44px; height: 44px; flex-shrink: 0; background: #0b1324;">
                                                    <img src="@off.ProductImage" class="w-100 h-100 object-fit-cover" id="offer-img-@off.Id" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100';" />
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-white" id="offer-title-@off.Id">@off.ProductName</div>
                                                    <div class="d-flex gap-1.5 align-items-center mt-0.5">
                                                        <span class="badge bg-secondary bg-opacity-30 text-light" style="font-size: 0.7rem;" id="offer-cat-@off.Id">@off.Category</span>
                                                        <small class="text-secondary font-monospace" style="font-size: 0.72rem;">@off.ShopName</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- MRP -->
                                        <td>
                                            <div class="font-monospace text-secondary text-decoration-line-through" id="offer-mrp-@off.Id">₹@off.Mrp.ToString("N0")</div>
                                        </td>

                                        <!-- Selling Price -->
                                        <td>
                                            <strong class="font-monospace text-success fs-6" id="offer-price-@off.Id">₹@off.SellingPrice.ToString("N0")</strong>
                                        </td>

                                        <!-- Discount -->
                                        <td>
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill font-monospace fw-bold" id="offer-disc-@off.Id">
                                                @off.DiscountFormatted
                                            </span>
                                        </td>

                                        <!-- Start Date -->
                                        <td>
                                            <div class="text-secondary small font-monospace" id="offer-start-@off.Id">
                                                <i class="fa-regular fa-calendar-check text-success me-1"></i> @off.StartDate
                                            </div>
                                        </td>

                                        <!-- End Date -->
                                        <td>
                                            <div class="text-secondary small font-monospace" id="offer-end-@off.Id">
                                                <i class="fa-regular fa-calendar-xmark text-danger me-1"></i> @off.EndDate
                                            </div>
                                        </td>

                                        <!-- Status -->
                                        <td style="text-align: center;" id="offer-status-cell-@off.Id">
                                            @if (off.Status == "Active")
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-circle-check me-1"></i> Active
                                                </span>
                                            }
                                            else if (off.Status == "Expired")
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-clock me-1"></i> Expired
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions -->
                                        <td style="text-align: center;">
                                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                                <!-- [Edit] -->
                                                <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openEditOfferModal(@off.Id)" title="Edit Offer">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <!-- [Toggle Status] -->
                                                <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="toggleOfferStatus(@off.Id)" title="Toggle Active/Inactive">
                                                    <i class="fa-solid fa-power-off"></i>
                                                </button>
                                                <!-- [Delete] -->
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openDeleteOfferModal(@off.Id, '@off.ProductName.Replace("'", "\\'")')" title="Delete Offer">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 13. TAB: REVIEWS (Point 42: Review Management) -->
        <div class="tab-panel-container" id="panel-reviews">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small fw-bold">
                                <i class="fa-solid fa-shield-halved me-1"></i> POLICY &bull; REVIEW MODERATION
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-star text-warning me-2"></i> Customer Review Moderation</h3>
                        <p class="text-secondary small mb-0">Audit product ratings and remove inappropriate, abusive, or fake reviews from customer visibility.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="reviewsCountBadge">
                            @Model.ReviewsList.Count Total Reviews
                        </span>
                    </div>
                </div>

                <!-- Review Status Filter Pills -->
                <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                    <span class="text-secondary small fw-bold text-uppercase me-1"><i class="fa-solid fa-filter me-1"></i> Filter:</span>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 active review-filter-btn" onclick="filterReviewTable('all', this)">All Reviews</button>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 review-filter-btn" onclick="filterReviewTable('visible', this)"><i class="fa-solid fa-eye me-1"></i> Visible</button>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 review-filter-btn" onclick="filterReviewTable('hidden', this)"><i class="fa-solid fa-eye-slash me-1"></i> Hidden / Flagged</button>
                </div>

                <!-- Point 42: Review Management Table (Product, Customer, Rating, Review, Date, Actions: [Hide], [Delete]) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Customer</th>
                                <th style="text-align: center;">Rating</th>
                                <th style="min-width: 250px;">Review Comment</th>
                                <th>Date</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="reviewsTableBody">
                            @if (!Model.ReviewsList.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-secondary">
                                        <i class="fa-solid fa-comment-slash fs-3 mb-2 d-block opacity-50"></i>
                                        No customer reviews recorded yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model.ReviewsList)
                                {
                                    <tr id="review-row-@r.Id" class="review-table-row" data-status="@(r.IsHidden ? "hidden" : "visible")">
                                        <!-- Product -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25" style="width: 40px; height: 40px; flex-shrink: 0; background: #0b1324;">
                                                    <img src="@r.ProductImage" class="w-100 h-100 object-fit-cover" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100';" />
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-white small" id="rev-pname-@r.Id">@r.ProductName</div>
                                                    <small class="text-secondary font-monospace" style="font-size: 0.72rem;">@r.ShopName</small>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Customer -->
                                        <td>
                                            <div class="text-white fw-bold small" id="rev-cname-@r.Id">@r.CustomerName</div>
                                            <small class="text-secondary font-monospace">@r.CustomerPhone</small>
                                        </td>

                                        <!-- Rating (1 to 5 Stars) -->
                                        <td style="text-align: center;">
                                            <div class="text-warning font-monospace fw-bold" style="font-size: 0.95rem;">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= r.Rating)
                                                    {
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-regular fa-star text-secondary opacity-50"></i>
                                                    }
                                                }
                                            </div>
                                            <small class="text-secondary font-monospace">@r.Rating.0 / 5.0</small>
                                        </td>

                                        <!-- Review Comment -->
                                        <td>
                                            <div class="text-light small fst-italic" id="rev-comment-@r.Id">
                                                "@r.Comment"
                                            </div>
                                            @if (r.IsHidden && !string.IsNullOrWhiteSpace(r.ModerationReason))
                                            {
                                                <div class="mt-1" id="rev-reason-badge-@r.Id">
                                                    <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30" style="font-size: 0.7rem;">
                                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Reason: @r.ModerationReason
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <!-- Date -->
                                        <td class="text-secondary small font-monospace">
                                            @r.Date
                                        </td>

                                        <!-- Status -->
                                        <td style="text-align: center;" id="review-status-cell-@r.Id">
                                            @if (r.IsHidden)
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-eye-slash me-1"></i> Hidden
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-eye me-1"></i> Visible
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions: [Hide] / [Unhide], [Delete] -->
                                        <td style="text-align: center;" id="review-action-cell-@r.Id">
                                            <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                                @if (r.IsHidden)
                                                {
                                                    <button type="button" class="btn btn-outline-success btn-sm px-2.5 py-1 rounded-3" onclick="unhideReview(@r.Id)" title="Make Review Visible to Customers">
                                                        <i class="fa-solid fa-eye me-1"></i> Unhide
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1 rounded-3" onclick="openHideReviewModal(@r.Id, '@r.CustomerName.Replace("'", "\\'")')" title="Hide Inappropriate Review">
                                                        <i class="fa-solid fa-eye-slash me-1"></i> Hide
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3" onclick="openDeleteReviewModal(@r.Id, '@r.CustomerName.Replace("'", "\\'")')" title="Permanently Delete Review">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 14. TAB: COMPLAINTS (Point 43: Customer Complaints & Support Desk) -->
        <div class="tab-panel-container" id="panel-complaints">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-headset text-danger me-2"></i> Complaint / Support Management</h3>
                        <p class="text-secondary small mb-0">Audit and resolve customer order complaints, defective items, delivery escalations, and refund requests.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background: rgba(239, 68, 68, 0.2); color: #f87171;" id="complaintTotalBadge">
                            @Model.ComplaintsList.Count Total Tickets
                        </span>
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="complaintOpenBadge">
                            @Model.ComplaintsList.Count(c => c.Status == "Open" || c.Status == "In Progress") Pending Action
                        </span>
                    </div>
                </div>

                <!-- Point 43: Filter Pills (All, Open, In Progress, Resolved, Closed) & Search -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold complaint-filter-btn active" onclick="filterComplaintTable('all', this)">
                            All (<span id="count-comp-all">@Model.ComplaintsList.Count</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Open', this)">
                            <i class="fa-solid fa-circle-exclamation me-1"></i> Open (<span id="count-comp-open">@Model.ComplaintsList.Count(c => c.Status == "Open")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Under Investigation', this)">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation (<span id="count-comp-investigation">@Model.ComplaintsList.Count(c => c.Status == "Under Investigation" || c.Status == "In Progress")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Resolved', this)">
                            <i class="fa-solid fa-circle-check me-1"></i> Resolved (<span id="count-comp-resolved">@Model.ComplaintsList.Count(c => c.Status == "Resolved")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Rejected', this)">
                            <i class="fa-solid fa-ban me-1"></i> Rejected (<span id="count-comp-rejected">@Model.ComplaintsList.Count(c => c.Status == "Rejected")</span>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold complaint-filter-btn" onclick="filterComplaintTable('Closed', this)">
                            <i class="fa-solid fa-lock me-1"></i> Closed (<span id="count-comp-closed">@Model.ComplaintsList.Count(c => c.Status == "Closed")</span>)
                        </button>
                    </div>
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text bg-dark text-secondary border-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="complaintSearchInput" class="form-control bg-dark text-white border-secondary" placeholder="Search Ticket, Order, Customer..." oninput="searchComplaintTable()" />
                    </div>
                </div>

                <!-- Point 43 & 45: Complaints / Disputes Table (Ticket #, Order ID, Customer, Issue, Description, Attachment, Priority, Status, Date, Actions) -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Dispute / Ticket</th>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Issue / Category</th>
                                <th>Description</th>
                                <th style="text-align: center;">Attachment</th>
                                <th>Priority</th>
                                <th style="text-align: center;">Status</th>
                                <th>Date</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="complaintsTableBody">
                            @foreach (var comp in Model.ComplaintsList)
                            {
                                <tr class="complaint-table-row" id="complaint-row-@comp.Id" data-status="@comp.Status" data-search="@comp.TicketId #D@(comp.Id) @comp.OrderNumber @comp.CustomerName @comp.CustomerMobile @comp.Issue @comp.Description">
                                    <!-- Ticket Number & Dispute Number -->
                                    <td>
                                        <div class="fw-bold text-danger font-monospace">#D@(comp.Id)</div>
                                        <small class="text-secondary font-monospace" style="font-size: 11px;">@comp.TicketId</small>
                                    </td>

                                    <!-- Order Number -->
                                    <td>
                                        <span class="font-monospace text-info fw-bold">@comp.OrderNumber</span>
                                    </td>

                                    <!-- Customer -->
                                    <td>
                                        <strong class="text-white">@comp.CustomerName</strong>
                                        <div class="text-secondary small font-monospace">@comp.CustomerMobile</div>
                                    </td>

                                    <!-- Issue / Category -->
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-30 text-light border border-secondary border-opacity-30">
                                            @(comp.ReasonCategory ?? comp.Issue)
                                        </span>
                                    </td>

                                    <!-- Description (Truncated) -->
                                    <td style="max-width: 220px;" class="text-truncate text-secondary small" title="@comp.Description">
                                        @comp.Description
                                    </td>

                                    <!-- Attachment -->
                                    <td style="text-align: center;">
                                        @if (!string.IsNullOrEmpty(comp.AttachmentUrl))
                                        {
                                            <a href="@comp.AttachmentUrl" target="_blank" class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30 text-decoration-none">
                                                <i class="fa-solid fa-paperclip me-1"></i> Proof
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">&mdash;</span>
                                        }
                                    </td>

                                    <!-- Priority -->
                                    <td>
                                        @if (comp.Priority == "Urgent" || comp.Priority == "High")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2 py-0.5 rounded-pill">
                                                <i class="fa-solid fa-bolt me-1"></i> @comp.Priority
                                            </span>
                                        }
                                        else if (comp.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning px-2 py-0.5 rounded-pill">
                                                @comp.Priority
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light px-2 py-0.5 rounded-pill">
                                                @comp.Priority
                                            </span>
                                        }
                                    </td>

                                    <!-- Status (Open, Under Investigation, Resolved, Rejected, Closed) -->
                                    <td style="text-align: center;" id="complaint-status-cell-@comp.Id">
                                        @if (comp.Status == "Open")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-exclamation me-1"></i> Open
                                            </span>
                                        }
                                        else if (comp.Status == "Under Investigation" || comp.Status == "In Progress")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation
                                            </span>
                                        }
                                        else if (comp.Status == "Resolved")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Resolved
                                            </span>
                                        }
                                        else if (comp.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-ban me-1"></i> Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-30 text-light px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-lock me-1"></i> @comp.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- Date -->
                                    <td class="text-secondary small font-monospace">
                                        @comp.Date
                                    </td>

                                    <!-- Actions -->
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                            <!-- [View] -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1 rounded-3" onclick="viewAdminComplaintModal(@comp.Id)" title="View Complaint Details">
                                                <i class="fa-solid fa-eye me-1"></i> View
                                            </button>
                                            <!-- [Update Status] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2 py-1 rounded-3" onclick="openUpdateComplaintStatusModal(@comp.Id, '@comp.Status', '@Html.Raw((comp.ResolutionNotes ?? "").Replace("'", "\\'"))')" title="Update Ticket Status">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Status
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 15. TAB: REPORTS (Point 45: Complete 9-Module Financial & Operational Reports Suite) -->
        <div class="tab-panel-container" id="panel-reports">
            <div class="glass-card mb-4">
