        document.getElementById("adminOrderModalLoader").style.display = "block";
        document.getElementById("adminOrderModalContent").style.display = "none";
        modal.show();

        $.ajax({
            url: '@Url.Action("GetOrderDetails", "Admin")',
            type: 'GET',
            data: { id: orderId },
