        <div class="nav-sidebar-item" onclick="switchAdminTab('salefraud', this)" id="nav-salefraud">
            <span><i class="fa-solid fa-triangle-exclamation text-danger"></i> Sale Fraud Monitor</span>
            <span class="sidebar-badge bg-danger bg-opacity-20 text-danger" id="sidebarSaleFraudBadge">@(Model.SaleFraudAlertsList?.Count(x => x.Status == "Under Review") ?? 0) Alert</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('smartrisk', this)" id="nav-smartrisk">
            <span><i class="fa-solid fa-brain text-warning"></i> Smart Risk Dashboard</span>
            <span class="sidebar-badge bg-warning bg-opacity-20 text-warning" id="sidebarSmartRiskBadge">@Model.SmartRiskDashboard.TotalRiskAlerts Alerts</span>
        </div>
        <div class="nav-sidebar-item" onclick="switchAdminTab('coupons', this)" id="nav-coupons">
            <span><i class="fa-solid fa-ticket text-info"></i> Coupons</span>
