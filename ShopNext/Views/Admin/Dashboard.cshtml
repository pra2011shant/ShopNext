                    if (usedCountEl) usedCountEl.innerText = Number(res.usedCount).toLocaleString();
                    if (remCountEl) remCountEl.innerText = `${Number(res.remaining).toLocaleString()} left`;
                    if (progressEl) progressEl.style.width = `${res.usagePercentage}%`;
                    if (pctEl) pctEl.innerText = `${res.usagePercentage.toFixed(1)}% claimed`;

                    // Update showcase card if present
