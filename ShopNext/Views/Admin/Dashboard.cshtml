                        badge.classList.add("bg-warning", "bg-opacity-25", "text-warning", "border", "border-warning", "border-opacity-30");
                    } else if (o.status === 'Cancelled' || o.status === 'Returned') {
                        badge.classList.add("bg-danger", "bg-opacity-25", "text-danger", "border", "border-danger", "border-opacity-30");
                    } else {
                        badge.classList.add("bg-secondary", "bg-opacity-25", "text-secondary", "border", "border-secondary", "border-opacity-30");
                    }
                    badge.innerHTML = `<i class="fa-solid fa-circle-dot me-1"></i> ${o.status}`;

                    document.getElementById("mOrderPayMode").innerText = o.paymentMethod || 'Online';
                    const payBadge = document.getElementById("mOrderPayStatus");
                    payBadge.innerText = o.paymentStatus || 'Paid';
                    if (o.paymentStatus === 'Success' || o.paymentStatus === 'Paid') {
                        payBadge.className = "badge bg-success bg-opacity-20 text-success px-2 py-1 rounded";
                    } else if (o.paymentStatus === 'Refunded') {
                        payBadge.className = "badge bg-danger bg-opacity-20 text-danger px-2 py-1 rounded";
                    } else {
                        payBadge.className = "badge bg-warning bg-opacity-20 text-warning px-2 py-1 rounded";
                    }

                    // Customer & Merchant
                    document.getElementById("mOrderCustName").innerText = o.customerName;
                    document.getElementById("mOrderCustMobile").innerText = o.customerPhone || 'N/A';
                    document.getElementById("mOrderCustEmail").innerText = o.customerEmail || 'N/A';
                    document.getElementById("mOrderCustAddress").innerText = o.deliveryAddress || 'Standard Delivery';

                    document.getElementById("mOrderShopName").innerText = o.shopName;
                    document.getElementById("mOrderSellerOwner").innerText = o.sellerOwner || 'Verified Merchant';
                    document.getElementById("mOrderSellerMobile").innerText = o.sellerMobile || 'N/A';
                    document.getElementById("mOrderRiderName").innerText = o.riderName || 'Local Store Fleet';

                    // Items table
                    const tbody = document.getElementById("mOrderItemsBody");
                    tbody.innerHTML = '';
                    if (o.items && o.items.length > 0) {
                        o.items.forEach(item => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-2 overflow-hidden border border-secondary border-opacity-25" style="width: 38px; height: 38px; flex-shrink: 0; background: #0b1324;">
                                            <img src="${item.productImage || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100'}" class="w-100 h-100 object-fit-cover" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100';" />
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white small">${item.productName}</div>
                                            <small class="text-secondary font-monospace">${item.sku || 'SKU-001'}</small>
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align: center;" class="font-monospace text-white">${item.quantity}</td>
                                <td class="font-monospace text-secondary">₹${item.unitPrice.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                                <td style="text-align: right;" class="font-monospace text-info fw-bold">₹${item.totalPrice.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }

                    // Amounts
                    document.getElementById("mOrderSubtotal").innerText = `₹${o.totalAmount.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
                    document.getElementById("mOrderPlatformFee").innerText = `₹${o.platformFee.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
                    document.getElementById("mOrderTotalAmount").innerText = `₹${o.totalAmount.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;

                    // Cancellation/Return remarks
                    const reasonBox = document.getElementById("mOrderReasonBox");
                    if (o.cancellationReason) {
                        reasonBox.style.display = "block";
                        document.getElementById("mOrderReasonTitle").innerText = o.status === 'Returned' ? 'Return Reason:' : 'Cancellation Reason:';
                        document.getElementById("mOrderReasonText").innerText = o.cancellationReason;
                    } else {
                        reasonBox.style.display = "none";
                    }

                    // Change status button bind
                    document.getElementById("mBtnOpenStatusChange").onclick = function() {
                        bootstrap.Modal.getInstance(document.getElementById('adminOrderDetailsModal'))?.hide();
                        openUpdateOrderStatusModal(o.id, o.status, o.orderNumber);
                    };
                } else {
                    showToast(res.message || "Failed to load order telemetry.", true);
                }
            },
            error: function() {
                document.getElementById("adminOrderModalLoader").style.display = "none";
                showToast("Connection error fetching order details.", true);
            }
        });
    }

    function openUpdateOrderStatusModal(orderId, currentStatus, orderNum) {
        document.getElementById("statusTargetOrderId").value = orderId;
        document.getElementById("statusOrderNumDisplay").innerText = orderNum ? `#${orderNum}` : `#ORD-${orderId}`;
        const select = document.getElementById("statusOrderSelect");
        if (select && currentStatus) {
            select.value = currentStatus;
        }
        document.getElementById("statusOrderReasonInput").value = "";
        new bootstrap.Modal(document.getElementById('adminUpdateOrderStatusModal')).show();
    }

    function confirmUpdateOrderStatus() {
        const orderId = document.getElementById("statusTargetOrderId").value;
        const newStatus = document.getElementById("statusOrderSelect").value;
        const reason = document.getElementById("statusOrderReasonInput").value.trim();
        const btn = document.getElementById("btnConfirmUpdateOrderStatus");

        if (newStatus === "Cancelled" && !reason) {
            alert("Please specify a reason when cancelling an order.");
            return;
        }

        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("UpdateOrderStatus", "Admin")',
            type: 'POST',
            data: { id: orderId, status: newStatus, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('adminUpdateOrderStatusModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    updateOrderRowInTable(orderId, newStatus);
                } else {
                    showToast(res.message || "Error updating order status.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error updating order status.", true);
            }
        });
    }

    function updateOrderRowInTable(orderId, newStatus) {
        const row = document.getElementById("order-row-" + orderId);
        if (row) {
            row.setAttribute("data-status", newStatus);
        }

        const statusCell = document.getElementById("order-status-cell-" + orderId);
        if (statusCell) {
            if (newStatus === 'Delivered') {
                statusCell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Delivered</span>';
            } else if (newStatus === 'OutForDelivery') {
                statusCell.innerHTML = '<span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-truck-fast me-1"></i> Out For Delivery</span>';
            } else if (newStatus === 'Preparing' || newStatus === 'Accepted') {
                statusCell.innerHTML = `<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-kitchen-set me-1"></i> ${newStatus}</span>`;
            } else if (newStatus === 'Cancelled') {
                statusCell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-circle-xmark me-1"></i> Cancelled</span>';
            } else {
                statusCell.innerHTML = `<span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-clock me-1"></i> ${newStatus}</span>`;
            }
        }
    }

    // ==========================================
    // POINT 39: PAYMENT MANAGEMENT
    // ==========================================
    function filterPaymentTable(status, btn) {
        document.querySelectorAll('.payment-status-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.payment-table-row');
        let count = 0;
        rows.forEach(row => {
            const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();
            if (status === 'all' || rowStatus === status.toLowerCase()) {
                row.style.display = '';
                count++;
            } else {
                row.style.display = 'none';
            }
        });

        const badge = document.getElementById("paymentsTotalBadge");
        if (badge) badge.innerText = `${count} Transactions`;
    }

    function searchPaymentTable() {
        const query = (document.getElementById("paymentSearchInput")?.value || '').trim().toLowerCase();
        const rows = document.querySelectorAll('.payment-table-row');
        let count = 0;
        rows.forEach(row => {
            const searchData = (row.getAttribute('data-search') || '').toLowerCase();
            if (!query || searchData.includes(query)) {
                row.style.display = '';
                count++;
            } else {
                row.style.display = 'none';
            }
        });

        const badge = document.getElementById("paymentsTotalBadge");
        if (badge) badge.innerText = `${count} Transactions`;
    }

    function viewPaymentDetailsModal(paymentId) {
        const modal = new bootstrap.Modal(document.getElementById('adminPaymentDetailsModal'));
        document.getElementById("payModalLoader").style.display = "block";
        document.getElementById("payModalContent").style.display = "none";
        modal.show();

        $.ajax({
            url: '@Url.Action("GetPaymentDetails", "Admin")',
            type: 'GET',
            data: { id: paymentId },
            success: function(res) {
                document.getElementById("payModalLoader").style.display = "none";
                if (res.success && res.payment) {
                    const p = res.payment;
                    document.getElementById("payModalContent").style.display = "block";

                    document.getElementById("mPayId").innerText = p.paymentCode || `PAY-${p.id.toString().padStart(5, '0')}`;
                    document.getElementById("mPayAmount").innerText = `₹${p.amount.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;

                    const badge = document.getElementById("mPayStatusBadge");
                    badge.className = "badge px-3 py-1 rounded-pill";
                    if (p.status === 'Success' || p.status === 'Paid') {
                        badge.classList.add("bg-success", "bg-opacity-25", "text-success", "border", "border-success", "border-opacity-30");
                    } else if (p.status === 'Refunded') {
                        badge.classList.add("bg-info", "bg-opacity-25", "text-info", "border", "border-info", "border-opacity-30");
                    } else if (p.status === 'Failed') {
                        badge.classList.add("bg-danger", "bg-opacity-25", "text-danger", "border", "border-danger", "border-opacity-30");
                    } else {
                        badge.classList.add("bg-warning", "bg-opacity-25", "text-warning", "border", "border-warning", "border-opacity-30");
                    }
                    badge.innerText = p.status;

                    document.getElementById("mPayOrderId").innerText = `#${p.orderNumber}`;
                    document.getElementById("mPayCustomer").innerText = p.customerName;
