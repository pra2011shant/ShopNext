    function filterSellerParticipation(filter, btnEl) {
        document.querySelectorAll('.seller-part-filter-btn').forEach(b => {
            b.classList.remove('btn-warning', 'text-dark', 'fw-bold');
            b.classList.add('btn-outline-secondary', 'text-light');
        });
        if (btnEl) {
            btnEl.classList.remove('btn-outline-secondary', 'text-light');
            btnEl.classList.add('btn-warning', 'text-dark', 'fw-bold');
        }

        const rows = document.querySelectorAll('.seller-part-row');
        rows.forEach(r => {
            const status = r.getAttribute('data-status');
            const isPart = r.getAttribute('data-participating') === 'true';

            if (filter === 'all') {
                r.style.display = '';
            } else if (filter === 'pending') {
                r.style.display = (status === 'pending') ? '' : 'none';
            } else if (filter === 'approved') {
                r.style.display = (status === 'approved') ? '' : 'none';
            } else if (filter === 'optedout') {
                r.style.display = (status === 'optedout' || !isPart) ? '' : 'none';
            }
        });
    }

    function searchSellerParticipation(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.seller-part-row');
        rows.forEach(r => {
            const name = (r.getAttribute('data-name') || '').toLowerCase();
            const shop = (r.getAttribute('data-shop') || '').toLowerCase();
            const text = r.innerText.toLowerCase();
            if (!q || name.includes(q) || shop.includes(q) || text.includes(q)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function refreshParticipationCounters() {
        const rows = document.querySelectorAll('.seller-part-row');
        let total = rows.length;
        let approved = 0;
        let pending = 0;
        let optedOut = 0;

        rows.forEach(r => {
            const s = r.getAttribute('data-status');
            const isP = r.getAttribute('data-participating') === 'true';
            if (s === 'approved') approved++;
            else if (s === 'pending') pending++;
            else if (s === 'optedout' || !isP) optedOut++;
        });

        const cTotal = document.getElementById("countPartTotal");
        const cApp = document.getElementById("countPartApproved");
        const cPend = document.getElementById("countPartPending");
        const cOpt = document.getElementById("countPartOptedOut");

        if (cTotal) cTotal.innerText = total;
        if (cApp) cApp.innerText = approved;
        if (cPend) cPend.innerText = pending;
        if (cOpt) cOpt.innerText = optedOut;
    }

