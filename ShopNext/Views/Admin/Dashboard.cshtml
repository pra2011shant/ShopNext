    function openUpdateOrderStatusModal(orderId, currentStatus, orderNum) {
        document.getElementById("statusTargetOrderId").value = orderId;
        document.getElementById("statusOrderNumDisplay").innerText = orderNum ? `#${orderNum}` : `#ORD-${orderId}`;
        const select = document.getElementById("statusOrderSelect");
        if (select && currentStatus) {
            select.value = currentStatus;
        }
        document.getElementById("statusOrderReasonInput").value = "";
        new bootstrap.Modal(document.getElementById('adminUpdateOrderStatusModal')).show();
    }

    function confirmUpdateOrderStatus() {
        const orderId = document.getElementById("statusTargetOrderId").value;
        const newStatus = document.getElementById("statusOrderSelect").value;
        const reason = document.getElementById("statusOrderReasonInput").value.trim();
        const btn = document.getElementById("btnConfirmUpdateOrderStatus");

        if (newStatus === "Cancelled" && !reason) {
            alert("Please specify a reason when cancelling an order.");
            return;
        }

        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("UpdateOrderStatus", "Admin")',
            type: 'POST',
            data: { id: orderId, status: newStatus, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('adminUpdateOrderStatusModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    updateOrderRowInTable(orderId, newStatus);
                } else {
                    showToast(res.message || "Error updating order status.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error updating order status.", true);
            }
        });
    }

    function updateOrderRowInTable(orderId, newStatus) {
        const row = document.getElementById("order-row-" + orderId);
        if (row) {
            row.setAttribute("data-status", newStatus);
        }

        const statusCell = document.getElementById("order-status-cell-" + orderId);
        if (statusCell) {
            if (newStatus === 'Delivered') {
                statusCell.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Delivered</span>';
            } else if (newStatus === 'OutForDelivery') {
                statusCell.innerHTML = '<span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-truck-fast me-1"></i> Out For Delivery</span>';
            } else if (newStatus === 'Preparing' || newStatus === 'Accepted') {
                statusCell.innerHTML = `<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-kitchen-set me-1"></i> ${newStatus}</span>`;
            } else if (newStatus === 'Cancelled') {
                statusCell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-circle-xmark me-1"></i> Cancelled</span>';
            } else {
                statusCell.innerHTML = `<span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-30 px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-clock me-1"></i> ${newStatus}</span>`;
            }
        }
    }

    // ==========================================
    // POINT 39: PAYMENT MANAGEMENT
    // ==========================================
    function filterPaymentTable(status, btn) {
        document.querySelectorAll('.payment-status-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.payment-table-row');
        let count = 0;
        rows.forEach(row => {
            const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();
            if (status === 'all' || rowStatus === status.toLowerCase()) {
                row.style.display = '';
                count++;
            } else {
                row.style.display = 'none';
            }
        });

        const badge = document.getElementById("paymentsTotalBadge");
        if (badge) badge.innerText = `${count} Transactions`;
    }

    function searchPaymentTable() {
        const query = (document.getElementById("paymentSearchInput")?.value || '').trim().toLowerCase();
        const rows = document.querySelectorAll('.payment-table-row');
        let count = 0;
        rows.forEach(row => {
            const searchData = (row.getAttribute('data-search') || '').toLowerCase();
            if (!query || searchData.includes(query)) {
                row.style.display = '';
                count++;
            } else {
                row.style.display = 'none';
            }
        });

        const badge = document.getElementById("paymentsTotalBadge");
        if (badge) badge.innerText = `${count} Transactions`;
    }

