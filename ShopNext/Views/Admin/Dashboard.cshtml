                    }

                    // Signals tab
                    document.getElementById('modalClusSignalAddress').innerText = c.commonSignalValue;
                    document.getElementById('modalClusSignalDevice').innerText = (c.accounts && c.accounts[0] ? c.accounts[0].deviceHashMasked : 'client_hash_8a2f***') + ' (Privacy-Masked SHA-256)';

                    // Form controls
                    document.getElementById('modalClusStatusSelect').value = c.clusterStatus || 'Under Review';
                    document.getElementById('modalClusRestrictCouponsCheck').checked = c.restrictFirstOrderCoupons;
                    document.getElementById('modalClusAdminNotes').value = c.adminNotes || '';

                    // Linked Accounts table
                    let accHtml = '';
                    if (c.accounts && c.accounts.length > 0) {
                        c.accounts.forEach(a => {
                            let restrictionBadge = `<span class="badge bg-success bg-opacity-20 text-success">Normal</span>`;
                            if (a.restrictionLevel === 'Account Blocked') {
                                restrictionBadge = `<span class="badge bg-danger text-white">Blocked</span>`;
                            } else if (a.restrictionLevel === 'Account Suspended') {
                                restrictionBadge = `<span class="badge bg-secondary">Suspended</span>`;
                            } else if (a.restrictionLevel === 'COD Restricted') {
                                restrictionBadge = `<span class="badge bg-warning bg-opacity-25 text-warning">COD Restricted</span>`;
                            } else if (a.restrictionLevel === 'Warning') {
                                restrictionBadge = `<span class="badge bg-warning bg-opacity-25 text-warning">Warning</span>`;
                            }

                            let voucherBadge = a.usedFirstOrderCoupon 
                                ? `<span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30"><i class="fa-solid fa-tag me-1"></i> Claimed</span>`
                                : `<span class="badge bg-secondary bg-opacity-30 text-light">Not Used</span>`;

                            accHtml += `<tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-35">${a.accountLabel}</span>
                                        <div>
                                            <div class="fw-bold text-white">${a.customerName}</div>
                                            <div class="text-secondary small font-monospace">ID: #${a.customerId}</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-light small">${a.email}</div>
                                    <div class="font-monospace text-secondary small">${a.phoneNumber}</div>
                                </td>
                                <td class="text-secondary small font-monospace">${a.registrationDate}</td>
                                <td>
                                    <div class="fw-bold text-white">${a.ordersCount} Orders</div>
                                    <div class="text-secondary small font-monospace">₹${Number(a.totalSpent).toLocaleString('en-IN')}</div>
                                </td>
                                <td>${voucherBadge}</td>
                                <td>${restrictionBadge}</td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn btn-outline-info btn-sm rounded-pill py-0.5 px-2.5 small"
                                            onclick="openCustomerRestrictionModal(${a.customerId}, '${a.customerName}')">
                                        <i class="fa-solid fa-user-shield me-1"></i> Inspect
                                    </button>
                                </td>
                            </tr>`;
                        });
                    } else {
                        accHtml = '<tr><td colspan="7" class="text-center py-3 text-secondary">No linked accounts found in this cluster.</td></tr>';
                    }
                    document.getElementById('modalClusAccountsTableBody').innerHTML = accHtml;
                } else {
                    showToast(res ? res.message : 'Could not load cluster details.', true);
                }
            },
            error: function() {
                showToast('Failed to fetch multi-account cluster details.', true);
            }
        });
    }

    function submitUpdateClusterStatus() {
        const clusterId = document.getElementById('modalClusIdHidden').value;
        const status = document.getElementById('modalClusStatusSelect').value;
        const notes = document.getElementById('modalClusAdminNotes').value;
        const restrictCoupons = document.getElementById('modalClusRestrictCouponsCheck').checked;

        if (!clusterId) return;

        const btn = document.getElementById('btnSaveClusterStatus');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("UpdateMultiAccountClusterStatus", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            data: JSON.stringify({
                ClusterId: clusterId,
                Status: status,
                AdminNotes: notes,
                RestrictFirstOrderCoupons: restrictCoupons
            }),
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;

                if (res && res.success) {
                    showToast(res.message || 'Cluster status saved successfully.');

                    // Update live table row
                    const statusContainer = document.getElementById('cluster-status-container-' + clusterId);
                    if (statusContainer) {
                        let newBadge = '';
                        if (status === 'Under Review') {
                            newBadge = '<span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill fw-bold"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Review</span>';
                        } else if (status === 'Legitimate Household / Family') {
                            newBadge = '<span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill fw-bold"><i class="fa-solid fa-house-user me-1"></i> Family / Household</span>';
                        } else if (status === 'Promo Abuse Restricted') {
                            newBadge = '<span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill fw-bold"><i class="fa-solid fa-ticket-simple me-1"></i> Promo Restricted</span>';
                        } else {
                            newBadge = '<span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill fw-bold"><i class="fa-solid fa-circle-check me-1"></i> ' + status + '</span>';
                        }
                        statusContainer.innerHTML = newBadge;
                    }

                    const couponIndicator = document.getElementById('cluster-coupon-indicator-' + clusterId);
                    if (couponIndicator) {
                        if (restrictCoupons) couponIndicator.classList.remove('d-none');
                        else couponIndicator.classList.add('d-none');
                    }

                    const row = document.getElementById('cluster-row-' + clusterId);
                    if (row) {
                        row.setAttribute('data-status', status);
                        if (status === 'Under Review') row.classList.add('under-review');
