                    document.getElementById("mReturnCustomerReason").innerText = `"${d.returnReason}"`;
                    
                    // Outbound Dispatch Record
                    document.getElementById("mReturnOutboundSku").innerText = d.sku;
                    document.getElementById("mReturnOutboundSerial").innerText = d.serialNumber;
                    document.getElementById("mReturnOutboundCondition").innerText = d.dispatchCondition;
                    
                    // Inbound Physical Verification
                    document.getElementById("mReturnReceivedSerialInput").value = d.receivedSerial || '';
                    document.getElementById("chkReturnSkuMatch").checked = d.isReturnSkuMatched !== false;
                    document.getElementById("chkReturnSerialMatch").checked = d.isReturnSerialMatched !== false;
                    document.getElementById("chkReturnConditionMatch").checked = d.isReturnConditionMatched !== false;
                    document.getElementById("mReturnRemarksInput").value = d.verificationRemarks || '';

                    // Badge
                    const badge = document.getElementById("mReturnStatusBadge");
                    badge.innerText = (d.returnStatus || 'Return_Requested').replace(/_/g, ' ');
                } else {
                    showToast(res.message || "Failed to load return verification details.", true);
