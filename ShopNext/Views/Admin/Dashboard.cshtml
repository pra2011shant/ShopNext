    // Status Filter Handler for Products
    function filterProductTable(status, btn) {
        document.querySelectorAll('.product-filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.product-table-row');
        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            if (status === 'all' || rowStatus.toLowerCase() === status.toLowerCase()) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // [View] Product Approval Modal
    function viewProductApprovalModal(productId) {
        const modal = new bootstrap.Modal(document.getElementById('productDetailsApprovalModal'));
        document.getElementById("prodModalLoader").style.display = "block";
        document.getElementById("prodModalContent").style.display = "none";
        modal.show();

        $.ajax({
