    function submitSaveFlashSale() {
        const id = parseInt(document.getElementById('modalFlashIdHidden').value, 10) || 0;
        const title = document.getElementById('modalFlashTitle').value.trim();
        const productName = document.getElementById('modalFlashProductName').value.trim();
        
        if (!title || !productName) {
            showToast('Please enter both Deal Title and Product Name.', true);
            return;
        }

        const category = document.getElementById('modalFlashCategory').value;
        const imageUrl = document.getElementById('modalFlashImageUrl').value.trim();
        const origPrice = parseFloat(document.getElementById('modalFlashOrigPrice').value) || 0;
        const flashPrice = parseFloat(document.getElementById('modalFlashPrice').value) || 0;
        const totalUnits = parseInt(document.getElementById('modalFlashTotalUnits').value, 10) || 50;
        const claimedUnits = parseInt(document.getElementById('modalFlashClaimedUnits').value, 10) || 0;
        const durationMins = parseInt(document.getElementById('modalFlashDurationMinutes').value, 10) || 25;
        const maxPerCust = parseInt(document.getElementById('modalFlashMaxPerCust').value, 10) || 1;
        const description = document.getElementById('modalFlashDescription').value.trim();
        const isActive = document.getElementById('modalFlashIsActive').checked;

        const btn = document.getElementById('btnSaveFlashSale');
        const origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

        const token = $('input[name="__RequestVerificationToken"]').val();
        const url = id > 0 ? '@Url.Action("UpdateFlashSale", "Admin")' : '@Url.Action("CreateFlashSale", "Admin")';

        const payload = {
            Id: id > 0 ? id : null,
            Title: title,
            ProductName: productName,
            Category: category,
            ProductImageUrl: imageUrl,
            OriginalPrice: origPrice,
            FlashPrice: flashPrice,
            TotalStockUnits: totalUnits,
            ClaimedUnits: claimedUnits,
            DurationMinutes: durationMins,
            MaxUnitsPerCustomer: maxPerCust,
            Description: description,
            IsActive: isActive
        };

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            data: JSON.stringify(payload),
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = origHtml;

                if (res && res.success) {
                    showToast(res.message || 'Flash sale saved successfully!');
                    const modalEl = document.getElementById('flashSaleModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    setTimeout(() => { location.reload(); }, 1000);
                } else {
                    showToast(res ? res.message : 'Error saving flash sale.', true);
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = origHtml;
                showToast('Server communication error.', true);
            }
        });
    }

    function simulateClaimFlashDeal(flashSaleId) {
        if (!flashSaleId) return;

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("ClaimFlashSale", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            data: JSON.stringify({
                FlashSaleId: flashSaleId,
                Quantity: 1,
                CustomerId: 1
            }),
            success: function(res) {
                if (res && res.success && res.data) {
                    const d = res.data;
                    showToast(res.message || `Claimed 1 unit! Remaining: ${d.remainingUnits}`);

                    // 1. Update Showcase Card live
                    const stockBadge = document.getElementById('flash-card-stock-badge-' + flashSaleId);
                    const progressEl = document.getElementById('flash-card-progress-' + flashSaleId);
                    const claimedTxt = document.getElementById('flash-card-claimed-txt-' + flashSaleId);
                    const claimPctTxt = document.getElementById('flash-card-claimpct-' + flashSaleId);
                    const claimBtn = document.getElementById('btn-flash-claim-' + flashSaleId);

                    if (claimedTxt) claimedTxt.innerText = `Claimed: ${d.claimedUnits} / ${d.totalStockUnits}`;
                    if (claimPctTxt) claimPctTxt.innerText = `${d.claimPercentage.toFixed(0)}% Claimed`;
                    if (progressEl) {
                        progressEl.style.width = d.claimPercentage + '%';
                        if (d.isSoldOut || d.claimPercentage > 85) {
                            progressEl.className = 'progress-bar bg-danger';
                        }
                    }

                    if (d.isSoldOut) {
                        if (stockBadge) {
                            stockBadge.innerText = 'Stock khatam: SOLD OUT';
                            stockBadge.className = 'badge bg-danger text-white fw-bold px-2 py-0.5 rounded-pill font-monospace';
                        }
                        if (claimBtn) {
                            claimBtn.className = 'btn btn-danger disabled w-100 fw-bold py-1.5 rounded-pill';
                            claimBtn.innerHTML = '<i class="fa-solid fa-ban me-1"></i> SOLD OUT';
                            claimBtn.disabled = true;
                        }
                    } else if (stockBadge) {
                        if (d.remainingUnits <= 5) {
                            stockBadge.innerText = `Only ${d.remainingUnits} Units Left!`;
                            stockBadge.className = 'badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 fw-bold px-2 py-0.5 rounded-pill font-monospace';
                        } else {
                            stockBadge.innerText = `${d.remainingUnits} Units Left`;
                        }
                    }

                    // 2. Update Table Row live
                    const tableClaimed = document.getElementById('table-claimed-txt-' + flashSaleId);
                    const tableRemaining = document.getElementById('table-remaining-txt-' + flashSaleId);
                    const tableProgress = document.getElementById('table-progress-' + flashSaleId);
                    const tableClaimBtn = document.getElementById('table-btn-claim-' + flashSaleId);
                    const tableStatus = document.getElementById('table-status-cell-' + flashSaleId);
                    const tableRow = document.getElementById('flash-row-' + flashSaleId);

                    if (tableClaimed) tableClaimed.innerText = `${d.claimedUnits} / ${d.totalStockUnits} Units`;
                    if (tableProgress) tableProgress.style.width = d.claimPercentage + '%';

                    if (d.isSoldOut) {
                        if (tableRemaining) tableRemaining.innerHTML = '<span class="badge bg-danger text-white font-monospace">SOLD OUT</span>';
                        if (tableClaimBtn) tableClaimBtn.disabled = true;
                        if (tableStatus) tableStatus.innerHTML = '<span class="badge bg-danger text-white px-2.5 py-1 rounded-pill fw-bold"><i class="fa-solid fa-ban me-1"></i> SOLD OUT</span>';
                        if (tableRow) tableRow.setAttribute('data-status', 'soldout');
                    } else if (tableRemaining) {
                        tableRemaining.innerText = `${d.remainingUnits} Left`;
                    }
                } else {
                    showToast(res ? res.message : 'Claim failed.', true);
                }
            },
            error: function() {
                showToast('Server communication error claiming deal.', true);
            }
        });
    }

