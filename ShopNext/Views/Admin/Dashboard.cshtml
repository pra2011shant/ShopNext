    function confirmHideReview() {
        const id = document.getElementById("hideTargetReviewId").value;
        const reason = document.getElementById("hideReviewReasonInput").value.trim();
        const btn = document.getElementById("btnConfirmHideReview");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("HideReview", "Admin")',
            type: 'POST',
            data: { id: id, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('hideReviewModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    const row = document.getElementById("review-row-" + id);
                    if (row) {
                        row.setAttribute("data-status", "Hidden");
                        const statusCell = document.getElementById("review-status-cell-" + id);
                        if (statusCell) {
                            statusCell.innerHTML = `<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-eye-slash me-1"></i> Hidden</span><div class="text-secondary small mt-0.5 fst-italic text-truncate" style="max-width: 120px;" title="${reason}">"${reason}"</div>`;
                        }
                        const actionCell = document.getElementById("review-action-cell-" + id);
                        if (actionCell) {
                            actionCell.innerHTML = `
                                <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
