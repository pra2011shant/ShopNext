    function confirmHideReview() {
        const id = document.getElementById("hideTargetReviewId").value;
        const reason = document.getElementById("hideReviewReasonInput").value.trim();
        const btn = document.getElementById("btnConfirmHideReview");
        btn.disabled = true;

        $.ajax({
            url: '@Url.Action("HideReview", "Admin")',
            type: 'POST',
            data: { id: id, reason: reason },
            success: function(res) {
                btn.disabled = false;
                bootstrap.Modal.getInstance(document.getElementById('hideReviewModal'))?.hide();
                if (res.success) {
                    showToast(res.message);
                    const row = document.getElementById("review-row-" + id);
                    if (row) {
                        row.setAttribute("data-status", "Hidden");
                        const statusCell = document.getElementById("review-status-cell-" + id);
                        if (statusCell) {
                            statusCell.innerHTML = `<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-eye-slash me-1"></i> Hidden</span><div class="text-secondary small mt-0.5 fst-italic text-truncate" style="max-width: 120px;" title="${reason}">"${reason}"</div>`;
                        }
                        const actionCell = document.getElementById("review-action-cell-" + id);
                        if (actionCell) {
                            actionCell.innerHTML = `
                                <div class="d-inline-flex gap-1.5 flex-wrap justify-content-center">
                                    <button type="button" class="btn btn-outline-success btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="unhideReview(${id})" title="Restore Review Visibility">
                                        <i class="fa-solid fa-eye me-1"></i> Unhide
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm px-2.5 py-1 rounded-3" onclick="openDeleteReviewModal(${id}, '${document.getElementById("hideReviewCustomerDisplay").innerText}')" title="Permanently Delete Review">
                                        <i class="fa-solid fa-trash me-1"></i> Delete
                                    </button>
                                </div>`;
                        }
                    }
                    // Update counts
                    const countVisible = document.getElementById("count-rev-visible");
                    const countHidden = document.getElementById("count-rev-hidden");
                    if (countVisible) countVisible.innerText = Math.max(0, parseInt(countVisible.innerText) - 1);
                    if (countHidden) countHidden.innerText = (parseInt(countHidden.innerText) || 0) + 1;
                } else {
                    showToast(res.message || "Error hiding review.", true);
                }
            },
            error: function() {
                btn.disabled = false;
                showToast("Connection error hiding review.", true);
            }
        });
    }

    function unhideReview(id) {
        $.ajax({
