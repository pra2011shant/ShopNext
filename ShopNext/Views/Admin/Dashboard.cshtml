    function onOfferProductSelect(select, mode) {
        const option = select.options[select.selectedIndex];
        if (!option || !option.value) return;

        const mrp = parseFloat(option.getAttribute("data-mrp")) || 0;
        const price = parseFloat(option.getAttribute("data-price")) || 0;

        if (mode === 'add') {
            document.getElementById("addOfferMrp").value = mrp.toFixed(2);
            document.getElementById("addOfferPrice").value = price.toFixed(2);
            recalcOfferDiscount('add');
        } else {
            document.getElementById("editOfferMrp").value = mrp.toFixed(2);
            document.getElementById("editOfferPrice").value = price.toFixed(2);
            recalcOfferDiscount('edit');
        }
    }

    function recalcOfferDiscount(mode) {
        const mrpInput = mode === 'add' ? document.getElementById("addOfferMrp") : document.getElementById("editOfferMrp");
        const priceInput = mode === 'add' ? document.getElementById("addOfferPrice") : document.getElementById("editOfferPrice");
        const discInput = mode === 'add' ? document.getElementById("addOfferDiscountVal") : document.getElementById("editOfferDiscountVal");

        const mrp = parseFloat(mrpInput.value) || 0;
        const price = parseFloat(priceInput.value) || 0;

        if (mrp > 0 && price > 0 && mrp > price) {
            const discPct = Math.round(((mrp - price) / mrp) * 100);
            discInput.value = discPct;
        }
    }

