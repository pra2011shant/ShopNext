    function submitUpdateAddressInvestigation() {
        const addressKey = document.getElementById('modalAddrKeyHidden').value;
        const status = document.getElementById('modalAddrStatusSelect').value;
        const notes = document.getElementById('modalAddrAdminNotes').value;
        const requireManualOtp = document.getElementById('modalAddrRequireOtpCheck').checked;

        if (!addressKey) return;

        const btn = document.getElementById('btnSaveAddressInvestigation');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("UpdateAddressInvestigation", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": token,
                "X-CSRF-TOKEN": token
            },
            data: JSON.stringify({
                AddressKey: addressKey,
                InvestigationStatus: status,
                AdminNotes: notes,
                RequireManualOtpVerification: requireManualOtp
            }),
            success: function(res) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;

                if (res && res.success) {
                    showToast(res.message || 'Address investigation status saved successfully.');

                    // Update live table row
                    const safeKey = addressKey.replace(/[^a-zA-Z0-9]/g, '_');
                    const statusContainer = document.getElementById('status-badge-container-' + safeKey);
                    if (statusContainer) {
                        let newBadge = '';
                        if (status === 'Under Investigation') {
                            newBadge = '<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-40 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation</span>';
                        } else if (status === 'Flagged for Review') {
                            newBadge = '<span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-flag me-1"></i> Flagged for Review</span>';
                        } else if (status === 'Verified / Clean') {
                            newBadge = '<span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-circle-check me-1"></i> Verified / Clean</span>';
                        } else {
                            newBadge = '<span class="badge bg-secondary bg-opacity-40 text-light border border-secondary border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold"><i class="fa-solid fa-eye me-1"></i> Monitoring</span>';
                        }
                        statusContainer.innerHTML = newBadge;
                    }

                    const otpIndicator = document.getElementById('manual-verify-indicator-' + safeKey);
                    if (otpIndicator) {
                        if (requireManualOtp) otpIndicator.classList.remove('d-none');
                        else otpIndicator.classList.add('d-none');
                    }

                    const row = document.getElementById('address-row-' + safeKey);
                    if (row) {
                        row.setAttribute('data-status', status);
                        if (status === 'Under Investigation') row.classList.add('under-investigation');
                        else row.classList.remove('under-investigation');
                        if (status === 'Verified / Clean') row.classList.add('clean');
                        else row.classList.remove('clean');
                    }

                    // Hide modal
                    const modalEl = document.getElementById('addressRiskModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                } else {
                    showToast(res ? res.message : 'Error updating investigation status.', true);
                }
            },
            error: function() {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                showToast('Server communication error.', true);
            }
        });
    }

