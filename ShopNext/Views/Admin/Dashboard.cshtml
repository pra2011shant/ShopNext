    function simulateRedeemCoupon(id) {
        $.ajax({
            url: '@Url.Action("SimulateRedeemCoupon", "Admin")',
            type: 'POST',
            data: { id: id },
            success: function(res) {
                if (res.success) {
                    showToast(res.message);
                    // Update table row telemetry live
                    const usedCountEl = document.getElementById(`coupon-used-${id}`);
                    const remCountEl = document.getElementById(`coupon-remaining-${id}`);
                    const progressEl = document.getElementById(`coupon-progress-${id}`);
                    const pctEl = document.getElementById(`coupon-pct-${id}`);
                    const statusCell = document.getElementById(`coupon-status-cell-${id}`);
                    const rowEl = document.getElementById(`coupon-row-${id}`);

                    if (usedCountEl) usedCountEl.innerText = Number(res.usedCount).toLocaleString();
                    if (remCountEl) remCountEl.innerText = `${Number(res.remaining).toLocaleString()} left`;
                    if (progressEl) progressEl.style.width = `${res.usagePercentage}%`;
                    if (pctEl) pctEl.innerText = `${res.usagePercentage.toFixed(1)}% claimed`;

                    // Update showcase card if present
                    const cardUsedEl = document.getElementById(`card-coupon-used-${id}`);
                    const cardRemEl = document.getElementById(`card-coupon-remaining-${id}`);
                    const cardProgressEl = document.getElementById(`card-coupon-progress-${id}`);
                    const cardPctEl = document.getElementById(`card-coupon-pct-${id}`);

                    if (cardUsedEl) cardUsedEl.innerText = Number(res.usedCount).toLocaleString();
                    if (cardRemEl) cardRemEl.innerText = Number(res.remaining).toLocaleString();
                    if (cardProgressEl) cardProgressEl.style.width = `${res.usagePercentage}%`;
                    if (cardPctEl) cardPctEl.innerText = `${res.usagePercentage.toFixed(1)}% claimed`;

                    if (res.isExhausted) {
                        if (rowEl) rowEl.setAttribute('data-exhausted', 'true');
                        if (statusCell) {
                            statusCell.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill"><i class="fa-solid fa-triangle-exclamation me-1"></i> Exhausted</span>';
                        }
                        const redeemBtn = document.getElementById(`coupon-redeem-btn-${id}`);
                        if (redeemBtn) {
                            redeemBtn.disabled = true;
                            redeemBtn.classList.add('disabled');
                        }
                    }
                } else {
                    showToast(res.message || "Redemption limit reached!", true);
                }
            },
            error: function() {
                showToast("Connection error simulating coupon redemption.", true);
            }
        });
    }

