    function filterReviewTable(filter, btn) {
        $(".review-filter-btn").removeClass("active");
        $(btn).addClass("active");

        const rows = document.querySelectorAll(".review-table-row");
        rows.forEach(row => {
            const status = row.getAttribute("data-status");
            if (filter === "all") {
                row.style.display = "";
            } else if (filter === "Visible" && status === "Visible") {
                row.style.display = "";
            } else if (filter === "Hidden" && status === "Hidden") {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

