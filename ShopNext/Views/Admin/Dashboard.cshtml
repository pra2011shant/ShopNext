    function updateIconPreview(inputId, previewId) {
        const val = document.getElementById(inputId).value.trim();
        const preview = document.getElementById(previewId);
        if (preview) {
            preview.innerHTML = `<i class="${val || 'fa-solid fa-layer-group'}"></i>`;
        }
    }

    function setIconInput(inputId, iconClass, previewId) {
        document.getElementById(inputId).value = iconClass;
        updateIconPreview(inputId, previewId);
    }

    // [Add] Category
    function openAddCategoryModal() {
        document.getElementById("addCatName").value = "";
        document.getElementById("addCatIcon").value = "fa-solid fa-layer-group";
        document.getElementById("addCatDesc").value = "";
        document.getElementById("addCatStatus").value = "Active";
        updateIconPreview('addCatIcon', 'addCatIconPreview');
        new bootstrap.Modal(document.getElementById('addCategoryModal')).show();
    }

