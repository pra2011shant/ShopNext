@model ShopNext.Models.AdminDashboardViewModel
        <div class="tab-panel-container" id="panel-addressrisk">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 class="fw-bold text-white mb-0"><i class="fa-solid fa-map-location-dot text-danger me-2"></i> Address Risk Management</h3>
                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 rounded-pill px-3 py-1">POINT 47</span>
                        </div>
                        <p class="text-secondary small mb-0">Cluster telemetry to detect abnormal order spikes, returns, and cancellation patterns at specific addresses without auto-punishing customers.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-info btn-sm rounded-pill px-3 py-2" onclick="location.reload()">
                            <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Telemetry
                        </button>
                    </div>
                </div>

                <!-- 4 Top KPI Cards for Address Risk -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-secondary small fw-semibold text-uppercase">Monitored Clusters</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.AddressRiskList.Count</div>
                                </div>
                                <div class="p-3 rounded-3 bg-primary bg-opacity-15 text-primary fs-4">
                                    <i class="fa-solid fa-map-pin"></i>
                                </div>
                            </div>
                            <div class="text-secondary small mt-2"><i class="fa-solid fa-city text-info me-1"></i> Across Patna & Bihar</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-danger small fw-semibold text-uppercase">⚠ High Activity Hotspots</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.AddressRiskList.Count(x => x.AlertBadge == "⚠ High Activity" || x.RiskLevel == "High Risk")</div>
                                </div>
                                <div class="p-3 rounded-3 bg-danger bg-opacity-20 text-danger fs-4">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                            </div>
                            <div class="text-danger small mt-2"><i class="fa-solid fa-arrow-trend-up me-1"></i> High Order/Return Spikes</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-warning small fw-semibold text-uppercase">Return Spike Zones</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.AddressRiskList.Count(x => x.ReturnRate >= 35)</div>
                                </div>
                                <div class="p-3 rounded-3 bg-warning bg-opacity-20 text-warning fs-4">
                                    <i class="fa-solid fa-rotate-left"></i>
                                </div>
                            </div>
                            <div class="text-warning small mt-2"><i class="fa-solid fa-percent me-1"></i> Return Rate &ge; 35%</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-success small fw-semibold text-uppercase">Active Investigations</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.AddressRiskList.Count(x => x.InvestigationStatus == "Under Investigation")</div>
                                </div>
                                <div class="p-3 rounded-3 bg-success bg-opacity-20 text-success fs-4">
                                    <i class="fa-solid fa-magnifying-glass-chart"></i>
                                </div>
                            </div>
                            <div class="text-success small mt-2"><i class="fa-solid fa-shield-halved me-1"></i> Non-punitive monitoring</div>
                        </div>
                    </div>
                </div>

                <!-- Anti-Bias Safeguard Notice Banner -->
                <div class="p-3 mb-4 rounded-4" style="background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-primary bg-opacity-25 text-primary fs-3 flex-shrink-0">
                            <i class="fa-solid fa-scale-balanced"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="fw-bold text-white mb-0">🛡️ Fair Play & Non-Punitive Address Risk Telemetry Policy</h6>
                                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">Safe Operational Guideline</span>
                            </div>
                            <p class="text-light text-opacity-80 small mb-0 mt-1">
                                Ek address par agar abnormal suspicious orders/returns (e.g. 50 Orders, 30 Returns, 10 Cancellations) ho rahe hon, toh yeh alert sirf <strong>Admin Investigation</strong> ke liye flag karta hai.
                                <span class="text-warning fw-semibold">Sirf area ya address ke basis par customer ko guilty maan kar automatic account block ya penalize nahi kiya jata.</span>
                                Admin manual review karke sirf high-value packages par optional pre-dispatch verification enable kar sakta hai.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Filters & Live Search Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="btn-group bg-dark p-1 rounded-3 border border-secondary border-opacity-25" role="group">
                        <button type="button" class="btn btn-sm btn-dark address-filter-btn active" onclick="filterAddressRiskTable('all', this)">All Clusters</button>
                        <button type="button" class="btn btn-sm btn-dark address-filter-btn" onclick="filterAddressRiskTable('high-activity', this)">
                            <span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> ⚠ High Activity</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-dark address-filter-btn" onclick="filterAddressRiskTable('high-return', this)">
                            <span class="text-warning"><i class="fa-solid fa-rotate-left me-1"></i> High Returns</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-dark address-filter-btn" onclick="filterAddressRiskTable('under-investigation', this)">
                            <span class="text-info"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-dark address-filter-btn" onclick="filterAddressRiskTable('clean', this)">
                            <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Verified Clean</span>
                        </button>
                    </div>

                    <div class="input-group" style="max-width: 340px;">
                        <span class="input-group-text bg-dark border-secondary border-opacity-25 text-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control bg-dark text-white border-secondary border-opacity-25" placeholder="Search Area, Road, Pincode..." onkeyup="searchAddressRiskTable(this.value)" id="addressRiskSearchInput" />
                    </div>
                </div>

                <!-- Address Risk Management Table -->
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" id="addressRiskMainTable">
                        <thead>
                            <tr class="text-secondary small text-uppercase border-bottom border-secondary border-opacity-25">
                                <th style="width: 28%;">Address / Area & Pincode</th>
                                <th style="width: 22%;">Activity Breakdown (Orders / Returns / Cancels)</th>
                                <th style="width: 12%; text-align: center;">Accounts</th>
                                <th style="width: 14%;">Risk Classification</th>
                                <th style="width: 14%;">Investigation Status</th>
                                <th style="width: 10%; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AddressRiskList)
                            {
                                string filterClass = "all";
                                if (item.AlertBadge == "⚠ High Activity" || item.RiskLevel == "High Risk") { filterClass += " high-activity"; }
                                if (item.ReturnRate >= 35 || item.AlertBadge == "High Return Rate") { filterClass += " high-return"; }
                                if (item.InvestigationStatus == "Under Investigation") { filterClass += " under-investigation"; }
                                if (item.InvestigationStatus == "Verified / Clean") { filterClass += " clean"; }

                                string rowIdSafe = System.Text.RegularExpressions.Regex.Replace(item.AddressKey, @"[^a-zA-Z0-9]", "_");

                                <tr class="address-risk-row @filterClass" 
                                    data-address-key="@item.AddressKey"
                                    data-locality="@item.Locality"
                                    data-pincode="@item.Pincode"
                                    data-risk-level="@item.RiskLevel"
                                    data-alert-badge="@item.AlertBadge"
                                    data-status="@item.InvestigationStatus"
                                    id="address-row-@rowIdSafe">
                                    <td>
                                        <div class="d-flex align-items-start gap-2.5">
                                            <div class="p-2.5 rounded-3 bg-secondary bg-opacity-20 text-white flex-shrink-0 mt-0.5">
                                                <i class="fa-solid fa-location-dot @(item.RiskLevel == "High Risk" ? "text-danger" : (item.RiskLevel == "Medium Risk" ? "text-warning" : "text-success"))"></i>
                                            </div>
                                            <div>
                                                <div class="text-white fw-bold mb-0.5 addr-name">@item.AddressKey</div>
                                                <div class="text-secondary small text-truncate" style="max-width: 320px;">@item.FormattedAddress</div>
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <span class="badge bg-secondary bg-opacity-35 text-light border border-secondary border-opacity-30 rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">PIN: @item.Pincode</span>
                                                    <span class="badge bg-info bg-opacity-15 text-info border border-info border-opacity-30 rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">@item.City</span>
                                                    <span class="text-secondary small font-monospace">₹@item.TotalAmount.ToString("N0") gross</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                                <span class="text-white fw-bold font-monospace">@item.TotalOrders Orders</span>
                                                <span class="text-secondary">@item.DeliveredOrders Deliv &bull; <strong class="text-danger">@item.ReturnedOrders Ret</strong> &bull; <strong class="text-warning">@item.CancelledOrders Canc</strong></span>
                                            </div>
                                            <!-- Mini Progress Bar Breakdown -->
                                            <div class="progress" style="height: 7px; background: rgba(255,255,255,0.1); border-radius: 6px; overflow: hidden;">
                                                @{
                                                    decimal delivPct = item.TotalOrders > 0 ? (decimal)item.DeliveredOrders / item.TotalOrders * 100m : 0m;
                                                    decimal retPct = item.TotalOrders > 0 ? (decimal)item.ReturnedOrders / item.TotalOrders * 100m : 0m;
                                                    decimal canPct = item.TotalOrders > 0 ? (decimal)item.CancelledOrders / item.TotalOrders * 100m : 0m;
                                                }
                                                <div class="progress-bar bg-success" style="width: @delivPct%" title="Delivered: @item.DeliveredOrders"></div>
                                                <div class="progress-bar bg-danger" style="width: @retPct%" title="Returned: @item.ReturnedOrders (@item.ReturnRate%)"></div>
                                                <div class="progress-bar bg-warning" style="width: @canPct%" title="Cancelled: @item.CancelledOrders (@item.CancellationRate%)"></div>
                                            </div>
                                            <div class="d-flex justify-content-between text-secondary small mt-1 font-monospace" style="font-size: 0.73rem;">
                                                <span class="text-danger">Return: @item.ReturnRate%</span>
                                                <span class="text-warning">Cancel: @item.CancellationRate%</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="badge bg-secondary bg-opacity-40 text-light border border-secondary border-opacity-30 rounded-pill px-3 py-1.5 font-monospace fs-6">
                                            <i class="fa-solid fa-users me-1 text-info"></i> @item.DistinctCustomersCount
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.AlertBadge == "⚠ High Activity" || (item.TotalOrders >= 40 && item.ReturnedOrders >= 20))
                                        {
                                            <span class="badge bg-danger text-white border border-danger px-2.5 py-1.5 rounded-pill fw-bold">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i> ⚠ High Activity
                                            </span>
                                        }
                                        else if (item.AlertBadge == "High Return Rate" || item.ReturnRate >= 35)
                                        {
                                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold">
                                                <i class="fa-solid fa-rotate-left me-1"></i> High Return Rate
                                            </span>
                                        }
                                        else if (item.AlertBadge == "Multi-Account Cluster")
                                        {
                                            <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold">
                                                <i class="fa-solid fa-people-arrows me-1"></i> Multi-Account Cluster
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold">
                                                <i class="fa-solid fa-circle-check me-1"></i> Normal Activity
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div id="status-badge-container-@rowIdSafe">
                                            @if (item.InvestigationStatus == "Under Investigation")
                                            {
                                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-40 px-2.5 py-1.5 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-magnifying-glass me-1"></i> Under Investigation
                                                </span>
                                            }
                                            else if (item.InvestigationStatus == "Flagged for Review")
                                            {
                                                <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-flag me-1"></i> Flagged for Review
                                                </span>
                                            }
                                            else if (item.InvestigationStatus == "Verified / Clean")
                                            {
                                                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-circle-check me-1"></i> Verified / Clean
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-40 text-light border border-secondary border-opacity-30 px-2.5 py-1.5 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-eye me-1"></i> Monitoring
                                                </span>
                                            }
                                        </div>
                                        @if (item.RequireManualOtpVerification)
                                        {
                                            <div class="small text-info mt-1" style="font-size: 0.72rem;" id="manual-verify-indicator-@rowIdSafe">
                                                <i class="fa-solid fa-shield-halved me-1"></i> Manual OTP / Call Active
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-info mt-1 d-none" style="font-size: 0.72rem;" id="manual-verify-indicator-@rowIdSafe">
                                                <i class="fa-solid fa-shield-halved me-1"></i> Manual OTP / Call Active
                                            </div>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-1.5 fw-semibold"
                                                onclick="openAddressRiskModal('@item.AddressKey')">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i> Investigate
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>