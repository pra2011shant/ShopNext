@model ShopNext.Models.AdminDashboardViewModel
        <div class="tab-panel-container" id="panel-multiaccounts">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 class="fw-bold text-white mb-0"><i class="fa-solid fa-users-viewfinder text-warning me-2"></i> Multiple Account Detection</h3>
                            <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 rounded-pill px-3 py-1">POINT 48</span>
                        </div>
                        <p class="text-secondary small mb-0">Identifies multiple accounts created from identical delivery addresses, similar phone patterns, or privacy-safe client tokens.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-info btn-sm rounded-pill px-3 py-2" onclick="location.reload()">
                            <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Multi-Account Clusters
                        </button>
                    </div>
                </div>

                <!-- 4 Top KPI Cards for Multi-Account Detection -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-secondary small fw-semibold text-uppercase">Detected Clusters</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.MultiAccountClustersList.Count</div>
                                </div>
                                <div class="p-3 rounded-3 bg-primary bg-opacity-15 text-primary fs-4">
                                    <i class="fa-solid fa-people-group"></i>
                                </div>
                            </div>
                            <div class="text-secondary small mt-2"><i class="fa-solid fa-link me-1 text-info"></i> Address / Phone / Client Signals</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-warning small fw-semibold text-uppercase">⚠ Possible Multi-Accounts</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.MultiAccountClustersList.Count(x => x.AlertBadge.Contains("Possible Multiple Accounts"))</div>
                                </div>
                                <div class="p-3 rounded-3 bg-warning bg-opacity-20 text-warning fs-4">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                            </div>
                            <div class="text-warning small mt-2"><i class="fa-solid fa-clock-rotate-left me-1"></i> Active Review Backlog</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-danger small fw-semibold text-uppercase">Promo Abuse Flags</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.MultiAccountClustersList.Count(x => x.RestrictFirstOrderCoupons || x.ClusterStatus == "Promo Abuse Restricted")</div>
                                </div>
                                <div class="p-3 rounded-3 bg-danger bg-opacity-20 text-danger fs-4">
                                    <i class="fa-solid fa-ticket-simple"></i>
                                </div>
                            </div>
                            <div class="text-danger small mt-2"><i class="fa-solid fa-ban me-1"></i> Welcome Voucher Cycling Blocked</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6">
                        <div class="p-3 rounded-4" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-success small fw-semibold text-uppercase">Family / Shared Homes</div>
                                    <div class="text-white fw-bold fs-3 mt-1">@Model.MultiAccountClustersList.Count(x => x.ClusterStatus == "Legitimate Household / Family")</div>
                                </div>
                                <div class="p-3 rounded-3 bg-success bg-opacity-20 text-success fs-4">
                                    <i class="fa-solid fa-house-user"></i>
                                </div>
                            </div>
                            <div class="text-success small mt-2"><i class="fa-solid fa-circle-check me-1"></i> Verified Legitimate Households</div>
                        </div>
                    </div>
                </div>

                <!-- Privacy Compliance Safeguard Banner -->
                <div class="p-3 mb-4 rounded-4" style="background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(245, 158, 11, 0.3);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-warning bg-opacity-20 text-warning fs-3 flex-shrink-0">
                            <i class="fa-solid fa-user-lock"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="fw-bold text-white mb-0">🔒 Privacy-Compliant Signal Tracking &amp; Fair Policy</h6>
                                <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30 rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">DPDP &amp; Privacy Compliant</span>
                            </div>
                            <p class="text-light text-opacity-80 small mb-0 mt-1">
                                Privacy compliance ke liye system kisi invasive device tracking (IMEI/MAC/Hardware ID) ko store nahi karta. Keval <strong>anonymized SHA-256 client token hashes</strong>, <strong>common delivery addresses</strong>, aur <strong>phone patterns</strong> ko correlate kiya jata hai.
                                <span class="text-warning fw-semibold">Family members aur flatmates ke legitimate accounts permitted hain.</span> 
                                Flagging ka main focus multi-account signup coupon abuse aur return fraud prevention par hota hai.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Filters & Live Search Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="btn-group bg-dark p-1 rounded-3 border border-secondary border-opacity-25" role="group">
                        <button type="button" class="btn btn-sm btn-dark multi-filter-btn active" onclick="filterMultiAccountTable('all', this)">All Clusters</button>
                        <button type="button" class="btn btn-sm btn-dark multi-filter-btn" onclick="filterMultiAccountTable('alert', this)">
                            <span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> ⚠ Possible Multi-Accounts</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-dark multi-filter-btn" onclick="filterMultiAccountTable('high-confidence', this)">
                            <span class="text-danger"><i class="fa-solid fa-bullseye me-1"></i> High Confidence</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-dark multi-filter-btn" onclick="filterMultiAccountTable('under-review', this)">
                            <span class="text-info"><i class="fa-solid fa-magnifying-glass me-1"></i> Under Review</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-dark multi-filter-btn" onclick="filterMultiAccountTable('family', this)">
                            <span class="text-success"><i class="fa-solid fa-house-user me-1"></i> Family / Household</span>
                        </button>
                    </div>

                    <div class="input-group" style="max-width: 340px;">
                        <span class="input-group-text bg-dark border-secondary border-opacity-25 text-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control bg-dark text-white border-secondary border-opacity-25" placeholder="Search Cluster, Name, Address..." onkeyup="searchMultiAccountTable(this.value)" id="multiAccountSearchInput" />
                    </div>
                </div>

                <!-- Multi-Account Table -->
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" id="multiAccountMainTable">
                        <thead>
                            <tr class="text-secondary small text-uppercase border-bottom border-secondary border-opacity-25">
                                <th style="width: 22%;">Cluster &amp; Match Factor</th>
                                <th style="width: 28%;">Linked Accounts Cluster</th>
                                <th style="width: 14%;">Common Signal Value</th>
                                <th style="width: 14%;">Activity &amp; Confidence</th>
                                <th style="width: 12%;">Cluster Status</th>
                                <th style="width: 10%; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var clus in Model.MultiAccountClustersList)
                            {
                                string filterClass = "all";
                                if (clus.AlertBadge.Contains("Possible Multiple Accounts")) { filterClass += " alert"; }
                                if (clus.MatchConfidence == "High") { filterClass += " high-confidence"; }
                                if (clus.ClusterStatus == "Under Review") { filterClass += " under-review"; }
                                if (clus.ClusterStatus == "Legitimate Household / Family") { filterClass += " family"; }

                                <tr class="multi-account-row @filterClass"
                                    data-cluster-id="@clus.ClusterId"
                                    data-name="@clus.ClusterName"
                                    data-factor="@clus.PrimaryMatchFactor"
                                    data-signal="@clus.CommonSignalValue"
                                    data-confidence="@clus.MatchConfidence"
                                    data-status="@clus.ClusterStatus"
                                    id="cluster-row-@clus.ClusterId">
                                    <td>
                                        <div class="d-flex align-items-start gap-2.5">
                                            <div class="p-2.5 rounded-3 bg-warning bg-opacity-15 text-warning flex-shrink-0 mt-0.5">
                                                <i class="fa-solid fa-users-viewfinder"></i>
                                            </div>
                                            <div>
                                                <div class="text-white fw-bold mb-0.5 cluster-name">@clus.ClusterName</div>
                                                <div class="text-info small font-monospace">@clus.ClusterId &bull; @clus.CreatedDate</div>
                                                <span class="badge bg-secondary bg-opacity-35 text-light border border-secondary border-opacity-30 rounded-pill px-2 py-0.5 mt-1" style="font-size: 0.72rem;">
                                                    <i class="fa-solid fa-fingerprint me-1 text-warning"></i> @clus.PrimaryMatchFactor
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <div class="d-flex flex-wrap gap-1 mb-1.5">
                                                @foreach (var acc in clus.Accounts)
                                                {
                                                    <span class="badge bg-dark border border-secondary border-opacity-35 text-light px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                                                        <strong class="text-warning">@acc.AccountLabel:</strong> @acc.CustomerName
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-secondary small font-monospace">
                                                Total Accounts: <strong class="text-white">@clus.TotalAccountsCount</strong> &bull; Combined: <strong class="text-white">@clus.TotalCombinedOrders Orders (₹@clus.TotalCombinedSpent.ToString("N0"))</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-light small text-truncate" style="max-width: 220px;" title="@clus.CommonSignalValue">
                                            @clus.CommonSignalValue
                                        </div>
                                        <div class="text-secondary small mt-0.5 font-monospace" style="font-size: 0.72rem;">
                                            <i class="fa-solid fa-link me-1 text-info"></i> Correlated Signal
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            @if (clus.AlertBadge.Contains("Possible Multiple Accounts"))
                                            {
                                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-40 px-2.5 py-1 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @clus.AlertBadge
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-circle-check me-1"></i> Normal
                                                </span>
                                            }
                                            <div class="d-flex align-items-center gap-1 mt-1">
                                                <span class="text-secondary small" style="font-size: 0.73rem;">Confidence:</span>
                                                <span class="badge @(clus.MatchConfidence == "High" ? "bg-danger" : "bg-warning") text-white rounded-pill px-2 py-0.2" style="font-size: 0.7rem;">@clus.MatchConfidence</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div id="cluster-status-container-@clus.ClusterId">
                                            @if (clus.ClusterStatus == "Under Review")
                                            {
                                                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-magnifying-glass me-1"></i> Under Review
                                                </span>
                                            }
                                            else if (clus.ClusterStatus == "Legitimate Household / Family")
                                            {
                                                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-house-user me-1"></i> Family / Household
                                                </span>
                                            }
                                            else if (clus.ClusterStatus == "Promo Abuse Restricted")
                                            {
                                                <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-ticket-simple me-1"></i> Promo Restricted
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill fw-bold">
                                                    <i class="fa-solid fa-circle-check me-1"></i> @clus.ClusterStatus
                                                </span>
                                            }
                                        </div>
                                        @if (clus.RestrictFirstOrderCoupons)
                                        {
                                            <div class="small text-danger mt-1" style="font-size: 0.72rem;" id="cluster-coupon-indicator-@clus.ClusterId">
                                                <i class="fa-solid fa-ban me-1"></i> Welcome Vouchers Restricted
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-danger mt-1 d-none" style="font-size: 0.72rem;" id="cluster-coupon-indicator-@clus.ClusterId">
                                                <i class="fa-solid fa-ban me-1"></i> Welcome Vouchers Restricted
                                            </div>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-1.5 fw-semibold"
                                                onclick="openMultiAccountClusterModal('@clus.ClusterId')">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i> Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>