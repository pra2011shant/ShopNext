@model ShopNext.Models.AdminDashboardViewModel
        <div class="tab-panel-container" id="panel-settings">
            <div class="glass-card">
                <h3 class="section-title">
                    <span><i class="fa-solid fa-sliders text-secondary me-2"></i> Platform Commission & Operational Settings</span>
                    <span class="badge bg-secondary">System Config</span>
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.6);">
                            <label class="form-label text-secondary small fw-bold">Platform Standard Commission (%)</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" value="5.0" />
                            <small class="text-muted">Standard rate applied across merchant sales.</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.6);">
                            <label class="form-label text-secondary small fw-bold">Hyperlocal Delivery Radius (KM)</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" value="10" />
                            <small class="text-muted">Default coverage zone for store matching.</small>
                        </div>
                    </div>
                </div>
                <div class="mt-4 text-end">
                    <button class="btn btn-primary px-4 py-2 rounded-pill fw-bold" onclick="showToast('Platform settings saved successfully!')">Save Configuration</button>
                </div>
            </div>
        </div>