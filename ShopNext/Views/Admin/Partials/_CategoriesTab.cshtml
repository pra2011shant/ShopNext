@model ShopNext.Models.AdminDashboardViewModel
        <div class="tab-panel-container" id="panel-categories">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-layer-group text-primary me-2"></i> Category Management</h3>
                        <p class="text-secondary small mb-0">Manage platform product classifications, taxonomy icons, and store departments.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- [Add] Category Action -->
                        <button type="button" class="btn btn-primary btn-sm px-3.5 py-2 fw-bold rounded-3 shadow-sm" onclick="openAddCategoryModal()">
                            <i class="fa-solid fa-plus me-1.5"></i> Add Category
                        </button>
                        <span class="badge bg-primary bg-opacity-25 text-primary px-3 py-2 rounded-pill font-monospace" id="categoryTotalBadge">@Model.CategoriesList.Count Categories</span>
                    </div>
                </div>

                <!-- 5 Target Categories Grid & Table -->
                <div class="table-responsive">
                    <table class="table approved-table">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Description / Scope</th>
                                <th>Products</th>
                                <th>Total GMV</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="categoriesTableBody">
                            @foreach (var cat in Model.CategoriesList)
                            {
                                <tr id="category-row-@cat.Id">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="p-2.5 rounded-3 bg-primary bg-opacity-15 text-primary fs-5" id="cat-icon-wrap-@cat.Id">
                                                <i class="@cat.Icon" id="cat-icon-@cat.Id"></i>
                                            </div>
                                            <div>
                                                <strong class="text-white fs-6" id="cat-name-@cat.Id">@cat.Name</strong>
                                                <div class="text-secondary small font-monospace">ID: #CAT-@cat.Id.ToString("D3")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-secondary small" id="cat-desc-@cat.Id">@cat.Description</div>
                                    </td>
                                    <td>
                                        <span class="text-info fw-bold font-monospace">@cat.ProductCount.ToString("N0")</span>
                                        <small class="text-secondary">items</small>
                                    </td>
                                    <td>
                                        <span class="text-success fw-bold font-monospace">₹@cat.TotalSales.ToString("N0")</span>
                                    </td>
                                    <td style="text-align: center;" id="cat-status-cell-@cat.Id">
                                        @if (cat.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-check me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-30 px-2.5 py-1 rounded-pill">
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="d-inline-flex gap-1.5">
                                            <!-- [Edit] -->
                                            <button type="button" class="btn btn-outline-warning btn-sm px-2.5 py-1 rounded-3 fw-bold" onclick="openEditCategoryModal(@cat.Id)" title="Edit Category">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                            </button>
                                            <!-- [Delete] -->
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2.5 py-1 rounded-3" onclick="openDeleteCategoryModal(@cat.Id, '@Html.Raw(cat.Name.Replace("'", "\\'"))')" title="Delete Category">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>