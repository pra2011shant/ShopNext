@model ShopNext.Models.AdminDashboardViewModel
        <div class="tab-panel-container" id="panel-notifications">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-white mb-1"><i class="fa-solid fa-bell text-warning me-2"></i> Platform System Notifications</h3>
                        <p class="text-secondary small mb-0">System alerts for Admin (New Sellers, New Complaints, New Returns), Sellers (New Orders, Return Requests, Product Status), and Customers (Order &amp; Refund updates).</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning bg-opacity-20 text-warning px-3 py-2 rounded-pill font-monospace" id="adminNotifCountBadge">
                            @Model.NotificationsList.Count Notifications
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2.5">
                    @foreach (var n in Model.NotificationsList)
                    {
                        <div class="p-3 rounded-4 border border-secondary border-opacity-25 d-flex justify-content-between align-items-center flex-wrap gap-3 transition-all" style="background: rgba(15, 23, 42, 0.65);" id="notif-item-@n.Id">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center p-2.5" style="width: 44px; height: 44px; background: rgba(234, 179, 8, 0.15); color: #eab308;">
                                    @if (n.Type == "Seller")
                                    {
                                        <i class="fa-solid fa-store fs-5"></i>
                                    }
                                    else if (n.Type == "Complaint")
                                    {
                                        <i class="fa-solid fa-headset fs-5 text-danger"></i>
                                    }
                                    else if (n.Type == "Return")
                                    {
                                        <i class="fa-solid fa-rotate-left fs-5 text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-bell fs-5 text-info"></i>
                                    }
                                </div>
                                <div>
                                    <div class="fw-bold text-white fs-6">
                                        @n.Title
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-30 px-2 py-0.5 rounded-pill ms-2 small">New</span>
                                        }
                                    </div>
                                    <div class="text-secondary small">@n.Message</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="text-secondary small font-monospace"><i class="fa-regular fa-clock me-1"></i> @n.Time</span>
                                @if (!string.IsNullOrEmpty(n.LinkUrl))
                                {
                                    <a href="@n.LinkUrl" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                                        <i class="fa-solid fa-arrow-right me-1"></i> View
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>