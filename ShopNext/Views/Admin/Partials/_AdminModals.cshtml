                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-semibold">Max Units Per Customer</label>
                            <input type="number" class="form-control bg-dark border-secondary border-opacity-30 text-light font-monospace" 
                                   id="modalFlashMaxPerCust" placeholder="1" min="1" value="1" />
