                    <div class="col-md-4">
                        <label class="form-label text-secondary small fw-bold">Original MRP (₹) <span class="text-danger">*</span></label>
                        <input type="number" step="1" id="addOfferMrp" class="form-control bg-dark text-white border-secondary font-monospace" placeholder="e.g. 24999" oninput="recalcOfferDiscount('add')" />
                    </div>
