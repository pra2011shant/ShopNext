                        <option value="">-- Choose Product to Promote --</option>
                        @foreach (var prod in Model.ProductsList)
                        {
                            <option value="@prod.Id" data-price="@prod.Price" data-mrp="@(prod.Mrp ?? prod.Price * 1.25m)" data-img="@prod.ImageUrl" data-name="@prod.ProductName" data-cat="@prod.Category">
                                @prod.ProductName (₹@prod.Price.ToString("N0") &bull; @prod.Category)
                            </option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-7">
                        <label class="form-label text-secondary small fw-bold">Campaign Offer Title</label>
                        <input type="text" id="addOfferTitle" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Mega 5G Smartphone Flash Deal" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label text-secondary small fw-bold">Tagline Ribbon</label>
                        <input type="text" id="addOfferTagline" class="form-control bg-dark text-white border-secondary" value="🔥 Deal of the Day" />
