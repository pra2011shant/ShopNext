                                   id="modalFlashProductName" placeholder="e.g., Samsung Galaxy S24 5G (8GB/128GB)" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-secondary small fw-semibold">Product Image URL</label>
                            <input type="text" class="form-control bg-dark border-secondary border-opacity-30 text-light" 
