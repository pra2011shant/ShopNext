                            <label class="form-label text-secondary small fw-semibold">Duration (Minutes from now) *</label>
                            <input type="number" class="form-control bg-dark border-secondary border-opacity-30 text-light font-monospace" 
                                   id="modalFlashDurationMinutes" placeholder="25" min="1" value="25" />
