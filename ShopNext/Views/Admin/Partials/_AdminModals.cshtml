@model ShopNext.Models.AdminDashboardViewModel

<!-- ========================================== -->
<!-- MODALS SECTION                             -->
<!-- ========================================== -->

<!-- Modal 1: [View] Seller Profile Modal (Point 34: Seller Management) -->
<div class="modal fade" id="sellerDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-store me-2"></i> Seller Store Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="sellerModalBody">
                <div class="text-center py-4" id="sellerModalLoader">
                    <i class="fa-solid fa-spinner fa-spin fs-2 text-warning"></i>
                    <div class="text-secondary small mt-2">Loading seller profile...</div>
                </div>
                <div id="sellerModalDetailsContent" style="display: none;">
                    <div class="text-center mb-3">
                        <div class="p-3 rounded-circle bg-warning bg-opacity-20 text-warning fs-3 d-inline-flex mb-2">
                            <i class="fa-solid fa-shop"></i>
                        </div>
                        <h4 class="fw-bold mb-1 text-white" id="mSellerShopName">ABC Electronics</h4>
                        <span class="badge bg-success bg-opacity-25 text-success px-3 py-1 rounded-pill" id="mSellerStatusBadge">
                            <i class="fa-solid fa-circle-check me-1"></i> Approved
                        </span>
                    </div>
                    <div class="p-3 rounded-4 mb-3" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--card-border);">
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-user me-2 text-primary"></i> Owner Name</span><span class="value" id="mSellerOwner">Rajesh Kumar</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-envelope me-2 text-info"></i> Email</span><span class="value font-monospace" id="mSellerEmail">abc.electronics@shopnext.com</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-phone me-2 text-success"></i> Mobile</span><span class="value font-monospace" id="mSellerMobile">+91 98765 11223</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-layer-group me-2 text-warning"></i> Category</span><span class="value" id="mSellerCategory">Electronics</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-location-dot me-2 text-danger"></i> Address</span><span class="value" id="mSellerAddress">Boring Road, Patna, Bihar</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-boxes-stacked me-2 text-info"></i> Total Products</span><span class="value text-info fw-bold" id="mSellerProducts">120 Items</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-bag-shopping me-2 text-emerald"></i> Total Orders</span><span class="value text-success fw-bold" id="mSellerOrders">500 Orders</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-solid fa-star me-2 text-warning"></i> Store Rating</span><span class="value text-warning fw-bold" id="mSellerRating">⭐ 4.5 / 5.0</span></div>
                        <div class="detail-row"><span class="label"><i class="fa-regular fa-calendar me-2 text-secondary"></i> Registered On</span><span class="value font-monospace" id="mSellerRegDate">15 Jan 2026</span></div>
                        <div class="detail-row" id="mSellerRemarkRow" style="display: none;"><span class="label"><i class="fa-solid fa-note-sticky me-2 text-danger"></i> Remarks</span><span class="value text-danger small" id="mSellerRemark"></span></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-4 py-2" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: [Reject] Seller Application Modal (Point 34: Seller Management) -->
<div class="modal fade" id="rejectSellerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-xmark me-2"></i> Reject Seller Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">Kya aap sach me shop <strong id="rejectSellerNameDisplay" class="text-white">Store</strong> ki seller application reject karna chahte hain?</p>
                <input type="hidden" id="rejectTargetSellerId" />
                <label class="form-label text-secondary small fw-bold">Rejection Reason</label>
                <input type="text" id="rejectSellerReasonInput" class="form-control bg-dark text-white border-secondary" placeholder="Reason (e.g. Incomplete GSTIN / Address verification failed)" />
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-3 py-2" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4 py-2 fw-bold" id="btnConfirmRejectSeller" onclick="confirmRejectSeller()">
                    <i class="fa-solid fa-xmark me-1"></i> Confirm Reject
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: [Block] Seller Store Modal (Point 34: Seller Management) -->
<div class="modal fade" id="blockSellerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-ban me-2"></i> Block Seller Store</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">Kya aap sach me shop <strong id="blockSellerNameDisplay" class="text-white">Store</strong> ko block karna chahte hain? Block hone ke baad yeh store catalog me display nahi hoga.</p>
                <input type="hidden" id="blockTargetSellerId" />
                <label class="form-label text-secondary small fw-bold">Restriction Reason</label>
                <input type="text" id="blockSellerReasonInput" class="form-control bg-dark text-white border-secondary" placeholder="Reason (e.g. Counterfeit products / high return rate)" />
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-3 py-2" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4 py-2 fw-bold" id="btnConfirmBlockSeller" onclick="confirmBlockSeller()">
                    <i class="fa-solid fa-ban me-1"></i> Confirm Block
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 4: [View] Customer Order & Return History Modal (Point 33: Customer Order & Return History) -->
<div class="modal fade" id="customerDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-content-glass shadow-lg">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <div>
                    <h5 class="modal-title fw-bold text-info mb-1"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Customer Order &amp; Return History</h5>
                    <p class="text-secondary small mb-0">Complete lifecycle audit: Lifetime orders, returns, cancellations, and risk ratios.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="custModalBody">
                <div class="text-center py-4" id="custModalLoader">
                    <i class="fa-solid fa-spinner fa-spin fs-2 text-info"></i>
                    <div class="text-secondary small mt-2">Loading complete customer history...</div>
                </div>
                <div id="custModalContent" style="display: none;">
                    <!-- Customer Identity Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 p-3 rounded-4" style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--card-border);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-3 rounded-circle bg-primary bg-opacity-20 text-primary fs-3 d-inline-flex">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1 text-white" id="mCustName">Rahul Kumar</h4>
                                <div class="text-secondary small">
                                    <span class="font-monospace text-light" id="mCustEmail">rahul@example.com</span> &bull; 
                                    <span class="font-monospace text-info" id="mCustMobile">+91 98112 23344</span> &bull; 
                                    <span class="text-muted" id="mCustCity">Patna</span>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-success bg-opacity-25 text-success px-3 py-1.5 rounded-pill fs-6" id="mCustStatusBadge">
                                <i class="fa-solid fa-circle-check me-1"></i> Active
                            </span>
                            <div class="text-secondary small font-monospace mt-1">Joined: <span id="mCustRegDate">15 Jan 2026</span></div>
                        </div>
                    </div>

                    <!-- 6-Stat Key Metrics Grid (Point 33) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25);">
                                <div class="text-secondary small text-uppercase fw-semibold" style="font-size: 0.72rem;">Total Orders</div>
                                <div class="fs-5 fw-extrabold text-white font-monospace" id="mCustOrdersCount">25</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25);">
                                <div class="text-success small text-uppercase fw-semibold" style="font-size: 0.72rem;">Delivered</div>
                                <div class="fs-5 fw-extrabold text-success font-monospace" id="mCustDeliveredCount">18</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25);">
                                <div class="text-danger small text-uppercase fw-semibold" style="font-size: 0.72rem;">Cancelled</div>
                                <div class="fs-5 fw-extrabold text-danger font-monospace" id="mCustCancelledCount">3</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25);">
                                <div class="text-warning small text-uppercase fw-semibold" style="font-size: 0.72rem;">Returned</div>
                                <div class="fs-5 fw-extrabold text-warning font-monospace" id="mCustReturnedCount">4</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.25);">
                                <div class="text-info small text-uppercase fw-semibold" style="font-size: 0.72rem;">Refunded</div>
                                <div class="fs-5 fw-extrabold text-info font-monospace" id="mCustRefundedCount">4</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35);">
                                <div class="text-success small text-uppercase fw-semibold" style="font-size: 0.72rem;">Total Amount</div>
                                <div class="fs-5 fw-extrabold text-success font-monospace" id="mCustTotalSpent">₹85,000</div>
                            </div>
                        </div>
                    </div>

                    <!-- Risk & Ratio Indicators -->
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2.5 rounded-3 flex-wrap gap-2" style="background: rgba(15, 23, 42, 0.5); border: 1px solid var(--card-border);">
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <span class="text-secondary small me-1">Return Rate:</span>
                                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-2.5 py-1 rounded-pill fw-bold" id="mCustReturnRateBadge">
                                    <i class="fa-solid fa-rotate-left me-1"></i> <span id="mCustReturnRateVal">22.0%</span>
                                </span>
                            </div>
                            <div>
                                <span class="text-secondary small me-1">Cancellation Rate:</span>
                                <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill fw-bold" id="mCustCancelRateBadge">
                                    <i class="fa-solid fa-ban me-1"></i> <span id="mCustCancelRateVal">12.0%</span>
                                </span>
                            </div>
                        </div>
                        <div class="text-secondary small">
                            <i class="fa-solid fa-location-dot me-1 text-danger"></i> Address: <span id="mCustAddress" class="text-light">Boring Road, Patna, Bihar</span>
                        </div>
                    </div>

                    <!-- Lifetime Orders Breakdown Table -->
                    <div class="table-responsive rounded-3 border border-secondary border-opacity-25" style="max-height: 280px; overflow-y: auto;">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead style="position: sticky; top: 0; background: #0f172a; z-index: 2;">
                                <tr class="text-secondary small text-uppercase">
                                    <th>Order #</th>
                                    <th>Store</th>
                                    <th>Amount</th>
                                    <th>Payment</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Remark / Reason</th>
                                </tr>
                            </thead>
                            <tbody id="mCustOrderHistoryBody">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary px-4 py-2" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================================== -->
<!-- POINT 36: SUSPICIOUS CUSTOMER RISK & FRAUD DETECTION MODAL                    -->
<!-- ============================================================================== -->
<div class="modal fade" id="customerRiskDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-content-glass shadow-lg border-danger border-opacity-25">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4" style="background: rgba(239, 68, 68, 0.08);">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-danger bg-opacity-20 text-danger fs-4 d-inline-flex">
                        <i class="fa-solid fa-shield-virus"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title fw-bold text-white mb-0">Customer Fraud Risk &amp; Abuse Detection</h5>
                            <span id="riskHeaderBadge" class="badge bg-danger bg-opacity-25 text-danger px-2.5 py-1 rounded-pill font-monospace">High Risk 🔴</span>
                        </div>
                        <p class="text-secondary small mb-0">Point 36: Algorithmic assessment of returns, cancellations, swap fraud &amp; doorstep rejections.</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="custRiskModalBody">
                <div class="text-center py-5" id="custRiskModalLoader">
                    <i class="fa-solid fa-circle-notch fa-spin fs-2 text-danger"></i>
                    <div class="text-secondary small mt-2">Evaluating live risk telemetry and fraud signals...</div>
                </div>
                <div id="custRiskModalContent" style="display: none;">
                    <input type="hidden" id="currentRiskCustId" />

                    <!-- Customer Profile & Score Card -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <div class="p-3 rounded-4 h-100" style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--card-border);">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="fw-bold text-white mb-0" id="rCustName">Rahul Kumar</h5>
                                        <div class="text-secondary small font-monospace mt-0.5">
                                            <span id="rCustPhone">+91 98112 23344</span> &bull; <span id="rCustEmail">rahul@example.com</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success bg-opacity-25 text-success" id="rCustStatus">Active</span>
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
                                    <span id="rCodBadge" class="badge bg-success bg-opacity-25 text-success px-2.5 py-1 rounded-pill">
                                        <i class="fa-solid fa-money-bill-wave me-1"></i> COD Allowed
                                    </span>
                                    <span id="rFlagBadge" class="badge bg-secondary bg-opacity-25 text-light px-2.5 py-1 rounded-pill">
                                        <i class="fa-solid fa-flag me-1"></i> Normal Queue
                                    </span>
                                    <span class="text-secondary small font-monospace ms-auto">
                                        Evaluated: <span id="rEvaluatedAt" class="text-info">Just now</span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Big Gauge Meter -->
                        <div class="col-md-5">
                            <div class="p-3 rounded-4 text-center h-100 d-flex flex-column justify-content-center" id="riskGaugeContainer" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3);">
                                <div class="text-secondary small text-uppercase fw-bold tracking-wider mb-1" style="font-size: 0.75rem;">Calculated Risk Index</div>
                                <div class="d-flex justify-content-center align-items-baseline gap-1 my-1">
                                    <span class="display-5 fw-black font-monospace" id="rScoreVal" style="color: #ef4444;">85</span>
                                    <span class="fs-5 text-secondary">/100</span>
                                </div>
                                <div class="progress rounded-pill bg-dark bg-opacity-60 mb-2" style="height: 10px;">
                                    <div id="rScoreProgressBar" class="progress-bar bg-danger" role="progressbar" style="width: 85%;"></div>
                                </div>
                                <div class="d-flex justify-content-between text-secondary" style="font-size: 0.68rem;">
                                    <span class="text-success">0 Low 🟢</span>
                                    <span class="text-warning">30 Med 🟡</span>
                                    <span class="text-danger">70 High 🔴 100</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 6-Metric Telemetry Stats -->
                    <div class="row g-2 mb-4">
                        <div class="col-4 col-md-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--card-border);">
                                <div class="text-secondary small" style="font-size: 0.7rem;">Orders</div>
                                <div class="fs-6 fw-bold text-white font-monospace" id="rTotalOrders">25</div>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25);">
                                <div class="text-warning small" style="font-size: 0.7rem;">Return %</div>
                                <div class="fs-6 fw-bold text-warning font-monospace" id="rReturnRate">28%</div>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25);">
                                <div class="text-danger small" style="font-size: 0.7rem;">Cancel %</div>
                                <div class="fs-6 fw-bold text-danger font-monospace" id="rCancelRate">16%</div>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35);">
                                <div class="text-danger small" style="font-size: 0.7rem;">Swap Fraud</div>
                                <div class="fs-6 fw-bold text-danger font-monospace" id="rSwappedFraud">0</div>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(234, 88, 12, 0.1); border: 1px solid rgba(234, 88, 12, 0.25);">
                                <div class="text-orange small" style="font-size: 0.7rem; color: #fb923c;">COD Reject</div>
                                <div class="fs-6 fw-bold font-monospace" id="rCodRejects" style="color: #fb923c;">0</div>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="p-2.5 rounded-3 text-center" style="background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.25);">
                                <div class="text-info small" style="font-size: 0.7rem;">Disputes</div>
                                <div class="fs-6 fw-bold text-info font-monospace" id="rComplaintsCount">1</div>
                            </div>
                        </div>
                    </div>

                    <!-- Risk Factors Checklist -->
                    <div class="p-3 rounded-4 mb-4" style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--card-border);">
                        <h6 class="fw-bold text-white mb-2 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                            Detected Abuse &amp; Risk Triggers
                        </h6>
                        <ul class="list-unstyled mb-0" id="rFactorsList">
                            <!-- Populated dynamically -->
                        </ul>
                    </div>

                    <!-- Security Action Controls -->
                    <div class="p-3 rounded-4" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <h6 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-gavel text-primary"></i> Administrative Risk Controls
                        </h6>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <!-- Toggle COD -->
                            <button type="button" class="btn btn-outline-warning px-3 py-2 rounded-3" id="btnToggleCod" onclick="toggleCustomerCodAction()">
                                <i class="fa-solid fa-money-bill-transfer me-1.5"></i> <span id="btnToggleCodText">Disable COD (Prepaid Only)</span>
                            </button>

                            <!-- Toggle Flag Review -->
                            <button type="button" class="btn btn-outline-info px-3 py-2 rounded-3" id="btnToggleFlag" onclick="toggleCustomerFlagAction()">
                                <i class="fa-solid fa-flag me-1.5"></i> <span id="btnToggleFlagText">Flag for Inspection</span>
                            </button>

                            <!-- Block Account -->
                            <button type="button" class="btn btn-outline-danger px-3 py-2 rounded-3" id="btnBlockFromRisk" onclick="triggerBlockFromRisk()">
                                <i class="fa-solid fa-ban me-1.5"></i> Block Account
                            </button>

                            <!-- Recalculate -->
                            <button type="button" class="btn btn-primary ms-auto px-3 py-2 rounded-3" id="btnRecalculateRisk" onclick="recalculateCustomerRiskAction()">
