                        <label class="form-label text-secondary small fw-bold">Deal Selling Price (₹) <span class="text-danger">*</span></label>
                        <input type="number" step="1" id="addOfferPrice" class="form-control bg-dark text-white border-secondary font-monospace fw-bold text-success" placeholder="e.g. 16999" oninput="recalcOfferDiscount('add')" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small fw-bold">Calculated Discount (%)</label>
                        <div class="input-group">
                            <input type="number" step="0.1" id="addOfferDiscount" class="form-control bg-dark text-danger border-secondary font-monospace fw-bold" readonly />
                            <span class="input-group-text bg-danger bg-opacity-20 text-danger border-secondary">% OFF</span>
                        </div>
                    </div>
                </div>

                <!-- Start Date & End Date -->
