                                       id="modalFlashOrigPrice" placeholder="40000" min="1" required oninput="calculateFlashDiscountPreview()" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label text-warning small fw-semibold">Flash Deal Price (₹) *</label>
                                <input type="number" class="form-control bg-dark border-warning border-opacity-50 text-warning fw-bold font-monospace" 
