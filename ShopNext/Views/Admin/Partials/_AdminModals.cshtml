<div class="modal fade" id="adminUpdateComplaintStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
                <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-pen-to-square me-2"></i> Update Dispute Status</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="updateTargetComplaintId" />
                <div class="p-3 rounded-3 bg-black bg-opacity-30 border border-secondary mb-3">
                    <span class="text-muted small d-block">Target Dispute:</span>
                    <strong class="text-white fs-6 font-monospace" id="updateComplaintTicketDisplay">Dispute #D1001</strong>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-light"><i class="fa-solid fa-signal text-info me-1"></i> Select Dispute Status *</label>
                    <select id="updateComplaintStatusSelect" class="form-select bg-dark text-white border-secondary">
                        <option value="Open">Open (Dispute Registered)</option>
                        <option value="Under Investigation">Under Investigation (Audit in Progress)</option>
                        <option value="In Progress">In Progress (Reverse Pickup / Verification)</option>
                        <option value="Resolved">Resolved (Settled with Refund / Payout)</option>
                        <option value="Rejected">Rejected (Claim Dismissed)</option>
                        <option value="Closed">Closed (Case Completed)</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-bold text-light"><i class="fa-solid fa-clipboard-check text-success me-1"></i> Admin Resolution Remarks / Findings</label>
                    <textarea id="updateComplaintNotesInput" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Provide resolution notes, refund ID, seller payout release info, or dismissal rationale..."></textarea>
                    <small class="text-secondary mt-1 d-block">These notes will be logged in the dispute audit trail and notified to the involved parties.</small>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 p-3">
                <button type="button" class="btn btn-secondary rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm" id="btnSubmitUpdateComplaintStatus" onclick="submitUpdateComplaintStatus()">
                    <i class="fa-solid fa-check me-1.5"></i> Save Status
                </button>
            </div>
        </div>
    </div>
</div>
