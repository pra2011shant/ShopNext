@model ShopNext.Models.AdminDashboardViewModel
        <div class="tab-panel-container" id="panel-inventoryprotection">
            <!-- Header Banner -->
            <div class="glass-card mb-4" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(6, 182, 212, 0.12) 50%, rgba(15, 23, 42, 0.8) 100%); border-color: rgba(16, 185, 129, 0.3);">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success text-dark px-3 py-1 rounded-pill fw-bold font-monospace fs-6">
                                <i class="fa-solid fa-shield-halved me-1 text-dark"></i> 📦 INVENTORY PROTECTION ENGINE
                            </span>
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill small">
                                Point 54: High-Concurrency Overselling Prevention
                            </span>
                            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill small">
                                <i class="fa-solid fa-lock me-1"></i> ACID DB Transactions &amp; Atomic Row Guard
                            </span>
                        </div>
                        <h3 class="text-white fw-bold mb-1">Sale Inventory Protection &amp; Concurrency Control</h3>
                        <p class="text-secondary small mb-0">
                            Safeguards limited flash sale stock against massive high-concurrency race conditions (e.g. 10 units stock vs 100 parallel buyers). Strict ACID database locking ensures <strong>zero overselling</strong>.
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-info rounded-pill px-3 py-2 fw-semibold" onclick="refreshProtectionTelemetry()">
                            <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Telemetry
                        </button>
                        <button type="button" class="btn btn-success rounded-pill px-3 py-2 fw-bold text-dark shadow-sm" onclick="runConcurrencySimulation()">
                            <i class="fa-solid fa-bolt me-1"></i> ⚡ Run 100 Users Stress Test
                        </button>
                    </div>
                </div>
            </div>

            <!-- Top 4 KPI Metrics -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-success h-100">
                        <div class="rounded-circle p-3 bg-success bg-opacity-20 text-success fs-4">
                            <i class="fa-solid fa-shield-check"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Zero-Oversell Rate</div>
                            <div class="text-success fw-bold fs-3 mt-0.5" id="kpiOversellRate">100.0%</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-circle-check text-success me-1"></i> 0 Oversell Incidents</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-info h-100">
                        <div class="rounded-circle p-3 bg-info bg-opacity-20 text-info fs-4">
                            <i class="fa-solid fa-users-rays"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Concurrent Requests Evaluated</div>
                            <div class="text-white fw-bold fs-3 mt-0.5" id="kpiTotalEvaluations">@(Model.InventoryProtection?.TotalEvaluations.ToString("N0") ?? "100")</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-network-wired text-info me-1"></i> Parallel Stress Tests</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="col-12 glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-danger h-100">
                        <div class="rounded-circle p-3 bg-danger bg-opacity-20 text-danger fs-4">
                            <i class="fa-solid fa-hand"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Oversell Attempts Prevented</div>
                            <div class="text-danger fw-bold fs-3 mt-0.5" id="kpiOversellPrevented">@(Model.InventoryProtection?.OversellAttemptsPrevented.ToString("N0") ?? "97")</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-ban text-danger me-1"></i> Out of Stock Safely Blocked</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center gap-3 border-start border-4 border-warning h-100">
                        <div class="rounded-circle p-3 bg-warning bg-opacity-20 text-warning fs-4">
                            <i class="fa-solid fa-cubes-stacked"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold">Guarded Flash Sale SKUs</div>
                            <div class="text-warning fw-bold fs-3 mt-0.5">@(Model.InventoryProtection?.TotalProtectedProducts.ToString("N0") ?? "32")</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;"><i class="fa-solid fa-lock text-warning me-1"></i> Row-Level Lock Active</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Point 54 Showcase: Concurrency Simulator & Visual Workflow -->
            <div class="row g-4 mb-4">
                <!-- Left: Interactive Test Bench & Presets -->
                <div class="col-lg-5">
                    <div class="glass-card p-4 h-100">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="text-white fw-bold mb-0">
                                <i class="fa-solid fa-sliders text-success me-2"></i> Concurrency Stress Test Bench
                            </h5>
                            <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 rounded-pill px-2.5 py-1">
                                Point 54 Demo
                            </span>
                        </div>
                        <p class="text-secondary small mb-3">
                            Configure simulation parameters to observe how the database engine handles high-volume simultaneous order attempts.
                        </p>

                        <!-- Quick Presets -->
                        <div class="mb-3">
                            <label class="form-label text-light small fw-bold mb-1.5"><i class="fa-solid fa-wand-magic-sparkles text-info me-1"></i> Quick Test Presets</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-semibold" onclick="setSimulationPreset('prompt10')">
                                    ⚡ Prompt: 10 Units vs 100 Users
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill fw-semibold" onclick="setSimulationPreset('flash50')">
                                    🔥 50 Units vs 250 Users
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill fw-semibold" onclick="setSimulationPreset('single1')">
                                    🎯 1 Unit vs 50 Clicks
                                </button>
                            </div>
                        </div>

                        <!-- Parameter Inputs -->
                        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mb-3">
                            <div class="mb-2.5">
                                <label class="form-label text-secondary small fw-bold">Target Sale Product</label>
                                <select id="simProductName" class="form-select bg-dark text-white border-secondary small">
                                    <option value="Samsung Mobile (Galaxy S24 Flagship - 10 Units Stock)" selected>Samsung Mobile (Galaxy S24 Flagship)</option>
                                    <option value="Apple AirPods Pro (2nd Gen - Flash Deal)">Apple AirPods Pro (2nd Gen)</option>
                                    <option value="Sony WH-1000XM5 Wireless Headphones">Sony WH-1000XM5 Wireless</option>
                                </select>
                            </div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label text-warning small fw-bold mb-1">
                                        <i class="fa-solid fa-cubes me-1"></i> Initial Stock
                                    </label>
                                    <input type="number" id="simInitialStock" class="form-control bg-dark text-warning border-warning border-opacity-50 font-monospace fw-bold" value="10" min="1" max="500" />
                                    <small class="text-secondary" style="font-size: 0.72rem;">Available items</small>
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-info small fw-bold mb-1">
                                        <i class="fa-solid fa-users-viewfinder me-1"></i> Concurrent Users
                                    </label>
                                    <input type="number" id="simConcurrentUsers" class="form-control bg-dark text-info border-info border-opacity-50 font-monospace fw-bold" value="100" min="5" max="500" />
                                    <small class="text-secondary" style="font-size: 0.72rem;">Parallel order tasks</small>
                                </div>
                            </div>
                        </div>

                        <!-- Prompt Visual Timeline Box -->
                        <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25 mb-3">
                            <div class="text-success fw-bold small mb-2">
                                <i class="fa-solid fa-diagram-project me-1"></i> Point 54 Execution Sequence:
                            </div>
                            <div class="small font-monospace text-light">
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>📦 Initial Stock:</span>
                                    <span class="text-warning fw-bold">10 Units</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>⚡ Order A &rarr; 2 Units:</span>
                                    <span class="text-success fw-bold">Stock 8 (Success)</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>⚡ Order B &rarr; 3 Units:</span>
                                    <span class="text-success fw-bold">Stock 5 (Success)</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 border-bottom border-secondary border-opacity-20">
                                    <span>⚡ Order C &rarr; 5 Units:</span>
                                    <span class="text-success fw-bold">Stock 0 (Success)</span>
                                </div>
                                <div class="d-flex justify-content-between py-0.5 text-danger">
                                    <span>❌ Next Orders (4 &ndash; 100):</span>
                                    <span class="text-danger fw-bold">Out of Stock (Blocked)</span>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-success w-100 py-2.5 fw-bold text-dark rounded-pill shadow-sm" id="btnRunSim" onclick="runConcurrencySimulation()">
                            <i class="fa-solid fa-play me-1"></i> Launch Multi-Threaded Stress Test
                        </button>
                    </div>
                </div>

                <!-- Right: Live Simulation Telemetry & Outcome Card -->
                <div class="col-lg-7">
                    <div class="glass-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="text-white fw-bold mb-0">
                                    <i class="fa-solid fa-chart-pie text-info me-2"></i> Live Concurrency Telemetry &amp; Proof of Zero Overselling
                                </h5>
                                <small class="text-secondary" id="simSubTitleDisplay">Simulation ID: @(Model.InventoryProtection?.LastSimulationResult?.SimulationId ?? "SIM-INIT") | Multi-Threaded Task Pool</small>
                            </div>
                            <span class="badge bg-success text-dark fw-bold px-3 py-1.5 rounded-pill font-monospace" id="simOversellProofBadge">
                                <i class="fa-solid fa-lock me-1"></i> Oversold: 0 Units (Protected)
                            </span>
                        </div>

                        <!-- Progress Bar of Results -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span><i class="fa-solid fa-square text-success me-1"></i> Fulfilled Units: <strong class="text-success" id="simFulfilledUnitsText">@(Model.InventoryProtection?.LastSimulationResult?.TotalUnitsSold ?? 10) Units</strong></span>
                                <span><i class="fa-solid fa-square text-danger me-1"></i> Blocked Requests: <strong class="text-danger" id="simBlockedText">@(Model.InventoryProtection?.LastSimulationResult?.OutOfStockRejectedCount ?? 97) Users</strong></span>
                                <span><i class="fa-solid fa-gauge-high text-info me-1"></i> Latency: <strong class="text-info" id="simLatencyText">@(Model.InventoryProtection?.LastSimulationResult?.TotalElapsedMs ?? 32)ms</strong></span>
                            </div>
                            <div class="progress" style="height: 12px; background-color: rgba(255,255,255,0.08); border-radius: 6px;">
                                <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="simFulfilledBar" style="width: 10%;"></div>
                                <div class="progress-bar bg-danger" id="simBlockedBar" style="width: 90%;"></div>
                            </div>
                        </div>

                        <!-- 4 Mini Metric Badges -->
                        <div class="row g-2 mb-3">
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-secondary border-opacity-25 text-center">
                                    <div class="text-secondary small" style="font-size: 0.72rem;">Total Competitors</div>
                                    <div class="text-white fw-bold fs-5" id="simTotalUsersBadge">@(Model.InventoryProtection?.LastSimulationResult?.TotalRequests ?? 100)</div>
                                </div>
                            </div>
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-success border-opacity-25 text-center">
                                    <div class="text-success small" style="font-size: 0.72rem;">Orders Fulfilled</div>
                                    <div class="text-success fw-bold fs-5" id="simFulfilledOrdersBadge">@(Model.InventoryProtection?.LastSimulationResult?.FulfilledOrdersCount ?? 3)</div>
                                </div>
                            </div>
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-danger border-opacity-25 text-center">
                                    <div class="text-danger small" style="font-size: 0.72rem;">Out of Stock Prevented</div>
                                    <div class="text-danger fw-bold fs-5" id="simRejectedOrdersBadge">@(Model.InventoryProtection?.LastSimulationResult?.OutOfStockRejectedCount ?? 97)</div>
                                </div>
                            </div>
                            <div class="col-sm-3 col-6">
                                <div class="p-2.5 rounded-3 bg-dark border border-warning border-opacity-25 text-center">
                                    <div class="text-warning small" style="font-size: 0.72rem;">Final Stock</div>
                                    <div class="text-warning fw-bold fs-5" id="simFinalStockBadge">@(Model.InventoryProtection?.LastSimulationResult?.FinalStock ?? 0)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Mechanism Info Card -->
                        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mt-auto">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-microchip text-info"></i>
                                <span class="text-white fw-semibold small">Active Concurrency Guard Mechanism:</span>
                            </div>
                            <div class="text-secondary small font-monospace" style="font-size: 0.75rem;">
                                <code>UPDATE Products SET Stock = Stock - @@Qty, StockStatus = CASE WHEN Stock - @@Qty &lt;= 0 THEN 'OutOfStock' ELSE 'InStock' END WHERE Id = @@Id AND Stock &gt;= @@Qty;</code>
                            </div>
                            <div class="text-success small mt-1" style="font-size: 0.72rem;">
                                <i class="fa-solid fa-circle-check me-1"></i> ACID Compliance Guaranteed: Zero Dirty Reads &bull; Zero Race Conditions &bull; Guaranteed Zero Overselling.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detailed Multi-Threaded Order Log Table -->
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <div>
                        <h5 class="text-white fw-bold mb-0">
                            <i class="fa-solid fa-list-check text-info me-2"></i> Real-Time Concurrency Order Audit Trail
                        </h5>
                        <p class="text-secondary small mb-0">Chronological execution log of all concurrent order reservation attempts</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-info text-dark fw-bold inv-log-filter-btn" onclick="filterSimulationLogs('all', this)">
                                All (<span id="countLogAll">@(Model.InventoryProtection?.LastSimulationResult?.Logs?.Count ?? 100)</span>)
                            </button>
                            <button type="button" class="btn btn-outline-secondary text-light inv-log-filter-btn" onclick="filterSimulationLogs('success', this)">
                                ✅ Fulfilled (<span id="countLogSuccess">@(Model.InventoryProtection?.LastSimulationResult?.FulfilledOrdersCount ?? 3)</span>)
                            </button>
                            <button type="button" class="btn btn-outline-secondary text-light inv-log-filter-btn" onclick="filterSimulationLogs('rejected', this)">
                                ❌ Out of Stock (<span id="countLogRejected">@(Model.InventoryProtection?.LastSimulationResult?.OutOfStockRejectedCount ?? 97)</span>)
                            </button>
                        </div>
                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary rounded-pill px-3" 
                               style="width: 180px;" placeholder="Search buyer or order..." onkeyup="searchSimulationLogs(this.value)" />
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-dark table-hover align-middle mb-0 text-nowrap" id="invLogsTable">
                        <thead class="sticky-top bg-dark" style="z-index: 2;">
                            <tr class="text-secondary small border-bottom border-secondary border-opacity-30">
                                <th># Step</th>
                                <th>Order Ref</th>
                                <th>Buyer / Customer</th>
                                <th>Qty Req</th>
                                <th>Stock Before &rarr; After</th>
                                <th>Status</th>
                                <th>Thread ID</th>
                                <th>Timestamp</th>
                                <th>ACID Remark</th>
                            </tr>
                        </thead>
                        <tbody id="simLogsTableBody">
                            @if (Model.InventoryProtection?.LastSimulationResult?.Logs != null && Model.InventoryProtection.LastSimulationResult.Logs.Any())
                            {
                                foreach (var log in Model.InventoryProtection.LastSimulationResult.Logs)
                                {
                                    <tr class="inv-log-row" data-status="@(log.IsSuccess ? "success" : "rejected")" data-order="@log.OrderId" data-cust="@log.CustomerName">
                                        <td class="font-monospace text-secondary">#@log.Step</td>
                                        <td class="fw-bold font-monospace @(log.IsSuccess ? "text-success" : "text-light")">
                                            @log.OrderId
                                        </td>
                                        <td class="text-white">@log.CustomerName</td>
                                        <td class="font-monospace fw-bold text-center">
                                            <span class="badge @(log.IsSuccess ? "bg-success bg-opacity-25 text-success border border-success" : "bg-secondary bg-opacity-25 text-secondary") px-2.5 py-1">
                                                @log.QuantityRequested units
                                            </span>
                                        </td>
                                        <td class="font-monospace">
                                            <span class="text-warning fw-bold">@log.StockBefore</span>
                                            <i class="fa-solid fa-arrow-right text-secondary mx-1 small"></i>
                                            <span class="@(log.StockAfter == 0 ? "text-danger fw-bold" : "text-success fw-bold")">@log.StockAfter</span>
                                        </td>
                                        <td>
                                            @if (log.IsSuccess)
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-circle-check me-1"></i> SUCCESS (Reserved)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-30 px-2.5 py-1 rounded-pill">
                                                    <i class="fa-solid fa-ban me-1"></i> OUT OF STOCK (Blocked)
                                                </span>
                                            }
                                        </td>
                                        <td class="font-monospace text-info small">@log.ThreadId</td>
                                        <td class="font-monospace text-secondary small">@log.TimestampFormatted</td>
                                        <td class="text-secondary small font-monospace">@log.Remark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-secondary">
                                        <i class="fa-solid fa-spinner fa-spin me-2"></i> Launch a stress test to view live concurrency logs.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>