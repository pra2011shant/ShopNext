@{
    ViewData["Title"] = "Admin Portal Login - ShopNext";
}

<div class="row justify-content-center align-items-center py-5" style="min-height: 80vh;">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="glass-card shadow-2xl p-4 p-md-5 border-0 rounded-4" style="background: linear-gradient(145deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 27, 75, 0.92) 100%); border: 1px solid rgba(255, 255, 255, 0.12) !important; backdrop-filter: blur(24px); box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(239, 68, 68, 0.15);">
            
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle mb-3 shadow-lg" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.35) 100%); border: 1px solid rgba(239, 68, 68, 0.5);">
                    <i class="fa-solid fa-crown fa-2x text-danger"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">Admin Portal Access</h3>
                <p class="text-secondary small mb-0">Sign in to oversee operations, merchant approvals, and financial logs</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-20 border border-danger border-opacity-40 text-white rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5 text-danger"></i>
                    <div class="text-white fw-medium">@ViewBag.Error</div>
                </div>
            }

            <form asp-controller="Admin" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label class="form-label fw-bold text-white small"><i class="fa-solid fa-user me-1 text-danger"></i> Username or Admin Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-black bg-opacity-50 border-secondary border-opacity-30 text-secondary">
                            <i class="fa-regular fa-user"></i>
                        </span>
                        <input type="text" name="username" id="adminUsernameInp" class="form-control bg-black bg-opacity-50 border-secondary border-opacity-30 text-white shadow-none" placeholder="e.g. admin" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-white small"><i class="fa-solid fa-lock me-1 text-danger"></i> Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-black bg-opacity-50 border-secondary border-opacity-30 text-secondary">
                            <i class="fa-solid fa-key"></i>
                        </span>
                        <input type="password" name="password" id="adminPasswordInp" class="form-control bg-black bg-opacity-50 border-secondary border-opacity-30 text-white shadow-none" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2.5 fw-bold rounded-3 mb-4 shadow-lg d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border: none;">
                    <i class="fa-solid fa-shield-halved"></i> Sign In to Admin Control Panel
                </button>

                <div class="text-center pt-2 border-top border-secondary border-opacity-25">
                    <a asp-controller="Account" asp-action="Login" class="text-secondary small text-decoration-none hover-white">
                        <i class="fa-solid fa-arrow-left me-1"></i> Return to Unified Platform Login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
