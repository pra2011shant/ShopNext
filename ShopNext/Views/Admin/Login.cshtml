@{
    ViewData["Title"] = "Admin Portal Login - ShopNext Command Center";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

<style>
    .admin-login-wrapper {
        min-height: 84vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
        font-family: 'Outfit', sans-serif;
    }

    .admin-login-card {
        width: 100%;
        max-width: 480px;
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.96) 0%, rgba(26, 17, 43, 0.94) 100%);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(239, 68, 68, 0.35);
        border-radius: 26px;
        padding: 2.75rem 2.25rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 45px rgba(239, 68, 68, 0.18);
        position: relative;
        overflow: hidden;
    }

    .admin-login-card::before {
        content: '';
        position: absolute;
        top: -120px;
        right: -120px;
        width: 250px;
        height: 250px;
        background: radial-gradient(circle, rgba(239, 68, 68, 0.25) 0%, transparent 70%);
        pointer-events: none;
    }

    .admin-brand-icon {
        width: 68px;
        height: 68px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.25) 0%, rgba(185, 28, 28, 0.35) 100%);
        border: 1px solid rgba(239, 68, 68, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: #f87171;
        margin: 0 auto 1.25rem;
        box-shadow: 0 10px 25px rgba(239, 68, 68, 0.25);
    }

    .admin-input-box {
        background: rgba(10, 15, 30, 0.75) !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        color: #ffffff !important;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: all 0.25s ease;
    }

    .admin-input-box::placeholder {
        color: #64748b !important;
    }

    .admin-input-box:focus {
        border-color: #ef4444 !important;
        box-shadow: 0 0 20px rgba(239, 68, 68, 0.28) !important;
        background: rgba(15, 23, 42, 0.92) !important;
    }

    .admin-input-group-text {
        background: rgba(10, 15, 30, 0.75) !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        border-right: none !important;
        color: #94a3b8 !important;
        border-radius: 12px 0 0 12px !important;
    }

    .btn-admin-submit {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
        border: none;
        color: #ffffff;
        font-weight: 700;
        font-size: 1.02rem;
        padding: 0.85rem;
        border-radius: 14px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.25s ease;
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
        cursor: pointer;
    }

    .btn-admin-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(239, 68, 68, 0.55);
        color: #ffffff;
    }
</style>

<div class="admin-login-wrapper">
    <div class="admin-login-card">
        
        <!-- Brand Header -->
        <div class="text-center mb-4">
            <div class="admin-brand-icon">
                <i class="fa-solid fa-crown"></i>
            </div>
            <h2 class="fw-bold text-white mb-1" style="font-size: 1.75rem; letter-spacing: -0.02em;">
                Admin <span style="background: linear-gradient(135deg, #f87171 0%, #ef4444 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Portal</span>
            </h2>
            <p class="small mb-0" style="color: #cbd5e1;">Sign in to oversee operations, merchant approvals & system health</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-20 border border-danger border-opacity-40 text-white rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa-solid fa-circle-exclamation fs-5 text-danger"></i>
                <div class="text-white fw-medium">@ViewBag.Error</div>
            </div>
        }

        <!-- Quick 1-Click Demo Fill Badge -->
        <div class="mb-4 p-3 rounded-3" style="background: rgba(239, 68, 68, 0.08); border: 1px dashed rgba(239, 68, 68, 0.35);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold text-danger d-flex align-items-center gap-1.5" style="font-size: 0.82rem;">
                    <i class="fa-solid fa-wand-magic-sparkles text-danger"></i> Quick Admin Demo Fill
                </span>
                <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30" style="font-size: 0.7rem;">Demo Credentials</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-danger btn-sm w-100 py-1.5 fw-semibold d-flex align-items-center justify-content-center gap-1.5" style="font-size: 0.8rem; border-radius: 9px;" onclick="fillAdminCredentials('admin', 'Admin@123')">
                    <i class="fa-solid fa-key"></i> Auto-fill <code>admin / Admin@123</code>
                </button>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="Login" method="post" id="adminLoginForm">
            @Html.AntiForgeryToken()

            <!-- Username or Admin Email -->
            <div class="mb-3">
                <label class="form-label text-white small fw-bold mb-1">
                    <i class="fa-solid fa-user-shield me-1 text-danger"></i> Username or Admin Email
                </label>
                <div class="input-group">
                    <span class="input-group-text admin-input-group-text">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <input type="text" name="username" id="adminUsernameInp" class="form-control admin-input-box" style="border-radius: 0 12px 12px 0;" placeholder="e.g. admin or admin@shopnext.com" autocomplete="username" required autofocus />
                </div>
            </div>

            <!-- Password -->
            <div class="mb-4">
                <label class="form-label text-white small fw-bold mb-1">
                    <i class="fa-solid fa-lock me-1 text-danger"></i> Password
                </label>
                <div class="input-group">
                    <span class="input-group-text admin-input-group-text">
                        <i class="fa-solid fa-key"></i>
                    </span>
                    <input type="password" name="password" id="adminPasswordInp" class="form-control admin-input-box" style="border-radius: 0 !important;" placeholder="••••••••" autocomplete="current-password" required />
                    <button type="button" class="btn admin-input-box" style="border-left: none !important; border-radius: 0 12px 12px 0; color: #94a3b8;" onclick="toggleAdminPasswordVisibility()">
                        <i class="fa-solid fa-eye" id="toggleAdminPasswordIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-admin-submit mb-4" id="adminLoginSubmitBtn">
                <i class="fa-solid fa-shield-halved"></i> Sign In to Admin Control Panel
            </button>

            <!-- Links -->
            <div class="text-center pt-3 border-top border-white border-opacity-10">
                <a asp-controller="Account" asp-action="Login" class="text-secondary small text-decoration-none hover-white d-inline-flex align-items-center gap-1.5">
                    <i class="fa-solid fa-arrow-left"></i> Return to Unified Platform Login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function fillAdminCredentials(user, pass) {
        document.getElementById('adminUsernameInp').value = user;
        document.getElementById('adminPasswordInp').value = pass;
        if (window.Swal) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Admin demo credentials filled!',
                showConfirmButton: false,
                timer: 1500
            });
        }
    }

    function toggleAdminPasswordVisibility() {
        const pwd = document.getElementById('adminPasswordInp');
        const icon = document.getElementById('toggleAdminPasswordIcon');
        if (pwd.type === 'password') {
            pwd.type = 'text';
            icon.className = 'fa-solid fa-eye-slash';
        } else {
            pwd.type = 'password';
            icon.className = 'fa-solid fa-eye';
        }
    }
</script>
}
