{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=ShopNext;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;Max Pool Size=100;"
  },
  "SecuritySettings": {
    "EnableHttps": true,
    "EnableHsts": true,
    "MaxUploadFileSizeMB": 5,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "CacheSettings": {
    "DefaultSlidingExpirationMinutes": 30,
    "DefaultAbsoluteExpirationMinutes": 120
  }
}
